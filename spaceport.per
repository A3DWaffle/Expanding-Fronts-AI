; BETWEEN THE BOTS

; FOOD
; ASKING FOR IT
(defrule
	(current-age > tech-level-2)
	(players-current-age any-computer-ally == tech-level-4)
	(food-amount < 50)
	(timer-triggered t-tribute)
=>
	(chat-to-player every-computer "3")
)

; GIVING IT
(defrule
	(taunt-detected any-computer-ally 3)
	(research-completed rt-galactic-banking)
	(food-amount > 3000)
	(food-amount > 1000)
=>
	(tribute-to-player this-any-computer-ally food 500)
	(chat-local-to-self "WAFFLE: Giving food to ally AI")
)
(defrule
	(taunt-detected any-computer-ally 3)
	(research-completed rt-galactic-banking)
	(food-amount > 3000)
	(food-amount > 500)
=>
	(tribute-to-player this-any-computer-ally food 200)
	(chat-local-to-self "WAFFLE: Giving food to ally AI")
)
(defrule
	(taunt-detected any-computer-ally 3)
	(research-completed rt-galactic-banking)
	(food-amount > 3000)
	(food-amount > 200)
=>
	(tribute-to-player this-any-computer-ally food 100)
	(chat-local-to-self "WAFFLE: Giving food to ally AI")
)

