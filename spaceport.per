; timer rules, nothing to see here

(defrule
		(current-age >= tech-level-3)
		(building-type-count BLDG-SPACEPORT > 0)
		(goal scn-detected NO)
=>
		(enable-timer t-tribute 60)
		(disable-self)
)
; turn off in scenario
(defrule
	(goal scn-detected YES)
=>
	(disable-timer t-tribute)
	(disable-self)
)



(defrule
		(player-number 1)
		(timer-triggered t-tribute)
=>
        (disable-timer t-tribute)
        (enable-timer t-tribute 61)
)

(defrule
		(player-number 2)
		(timer-triggered t-tribute)
=>
        (disable-timer t-tribute)
        (enable-timer t-tribute 62)
)

