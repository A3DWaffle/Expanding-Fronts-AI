; =====================================================
; CHAPTER X: CIV SPACEPORT TECH CATCHUP
; =====================================================

(defrule
	; TF Neimoidian Endorsement
	(can-research-with-escrow rt-neimoidian-endorse)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-neimoidian-endorse)
)

(defrule
	; TF Insider Trading
	(can-research-with-escrow rt-insider-trading)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-insider-trading)
)

(defrule
	; GE Altered Bargains
	(can-research-with-escrow rt-altered-bargains)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-altered-bargains)
)

(defrule
	; TF Market Control
	(can-research-with-escrow rt-market-control)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-market-control)
)

(defrule
	; CF Confederacy Alliance
	(can-research-with-escrow rt-confalli)
	(goal tradestatus ALLOW)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-confalli)
)

(defrule
	; ZC Piracy
	(can-research-with-escrow rt-piracy)
	(goal tradestatus ALLOW)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-piracy)
)

(defrule
	; BS Cloaked Smuggling
	(can-research-with-escrow rt-cloakedsmug)
	(goal tradestatus ALLOW)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-cloakedsmug)
)
