)
(defrule
	(goal attackTSAlevel 9)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 10) ; final value
)
(defrule
	(goal attackTSAlevel 10)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(chat-to-all "267 Woah! I can't seem to find your base to attack it... ")
	(chat-to-all "I'll go looking, but you're not playing on an islands map, are you?")
	(chat-to-all "The AI needs a land route between players to work correctly!")
	(set-goal attackTSAlevel 11)
)

; RESET WHEN DONE

(defrule
	(goal attackTSAhold EXHAUSTED)
	(not (strategic-number sn-maximum-town-size == TL4-townsize))
=>
	(set-strategic-number sn-maximum-town-size TL4-townsize)
	(set-strategic-number sn-sentry-distance TL4-sentry-distance)
	; (chat-local-to-self "WAFFLE: TS Mismatch, TS now NORM")
)
















; Wall Behaviour

(defrule
	(goal wonder-attempt ATTACK)
	(game-time > 300) ; 10min is the halfway point. But that's way too long, frequent jams as the AI takes a while to delete it. How's 5min?
	(building-type-count 117 > 0)
=>
	(delete-complete-building 117)
)

; 117 = Medium Wall. Other IDs (155 Heavy Wall, 195 Shield Wall) do not fire
; Gate does also not work correctly - you could probably fish up its ID but I'm really not in a hurry
; given gates have like 50 different IDs
(defrule
	(goal wonder-attempt DEFEND)
	(game-time > 900) ; 15min 
	(building-type-count 117 > 0)
=>
	(delete-complete-building 117)
)
