; For everyone, follow the modified fortress template


(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 2) ; always have some AA turrets
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
=>
	(build BLDG-MISSILE-LINE)
)

; when one fort is built, allow misc more ore buildings

; aa turrets
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 4) 
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
=>
	(build BLDG-MISSILE-LINE)
)


; when second fort is up, allow even more buildings
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 6)
	(building-type-count-total BLDG-GOVTCTR > 1)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-TURRET-LINE < 3)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
=>
	(build BLDG-TURRET-LINE)
)

; build more things as the five forts come online

; and the AA turrets

(defrule
	(building-type-count-total BLDG-GOVTCTR > 2)
	(building-type-count-total BLDG-MISSILE-LINE < 8)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
=>
	(build BLDG-MISSILE-LINE)
)

; at this point what the AI should do depends on a lot of things

; we want it to throw down more turrets on hard/hardest
; we want it to build a billion extra forts

; rules could probably do with a little more tuning but that's the idea
#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

(defrule
	(building-type-count-total BLDG-GOVTCTR > 3)
	(building-type-count-total BLDG-MISSILE-LINE < 10)
	(building-type-count-total BLDG-SHLDGEN > 1)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 3)
	(building-type-count-total BLDG-TURRET-LINE < 7) ; don't go as ham on these
	(building-type-count-total BLDG-SHLDGEN > 1)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
=>
	(build BLDG-TURRET-LINE)
)


#end-if
#end-if
#end-if






;********************* Fort Dump ******************************
;Waffle Guide: I have to define Fort rules different since AI goes crazy with it.
;Putting this on the bottom so it just trails into the abyss.

;*********** FORTRESS ***********

(defrule
		(building-type-count-total BLDG-GOVTCTR < 3)
        (current-age == tech-level-4)
        (can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
        =>
        (build BLDG-GOVTCTR)
)

;*********** AIR CRUISER ***********

; Legacy direct-train block disabled by default.  Modern synced production
; files now own unit composition; this old block made every civ overfocus
; Air Cruisers and unique units in Defend Monument.
#load-if-defined WONDER_KILL_LEGACY_DIRECT_TRAIN

(defrule
	(game-time > 480)
        (current-age >= tech-level-4)
	(not (goal special-map WATER))
        (true)
        (unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm)
        (can-train UNIT-AIR-CRUISER)
        =>
        (train UNIT-AIR-CRUISER)
)

(defrule
		(game-time > 360) ; 6min mark
        (can-train UNIT-AIR-CRUISER)
        =>
        (train UNIT-AIR-CRUISER) ; Everyone gets one AC. Partly to help out with random tree clumps
		(disable-self)
)

(defrule
	(game-time > 480)
        (current-age >= tech-level-4)
        (true)
	(goal special-map WATER)
        (unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm-water)
        (can-train UNIT-AIR-CRUISER)
        =>
        (train UNIT-AIR-CRUISER)
)

;*********** CANNON ***********

(defrule
        (true)
		(goal support-artillery YES)
		(goal wonder-attempt ATTACK)
        (current-age == tech-level-4)
			(building-type-count-total SIEGE-CANNON-LINE < 2)
			(unit-type-count-total SIEGE-CANNON-LINE < 2)
        (can-train SIEGE-CANNON-LINE)
        =>
        (train SIEGE-CANNON-LINE)
)
		

(defrule
        (true)
		(goal support-artillery YES)
		(goal wonder-attempt ATTACK)
        (current-age >= tech-level-4)
		(game-time > 480)
			(building-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm)
			(unit-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm)
        (can-train SIEGE-CANNON-LINE)
        =>
        (train SIEGE-CANNON-LINE)
)

(defrule
        (true)
		(goal support-artillery YES)
		(goal wonder-attempt ATTACK)
        (current-age >= tech-level-4)
		(game-time > 480)
			(building-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm-water)
			(unit-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm-water)
        (can-train SIEGE-CANNON-LINE)
        =>
        (train SIEGE-CANNON-LINE)
)

;********** BOUNTY **********


; tidied up just a smidge

(defrule
        (true)
		(not (goal special-map WATER))
        (current-age == tech-level-4)
        (unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect)
		(goal enemyjedisighted YES)
        (can-train UNIT-BOUNTY)
        =>
        (train UNIT-BOUNTY)
)


(defrule
        (true)
		(goal special-map WATER)
        (current-age == tech-level-4)
        (unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect)
		(goal enemyjedisighted YES)
        (can-train UNIT-BOUNTY)
        =>
        (train UNIT-BOUNTY)
)


