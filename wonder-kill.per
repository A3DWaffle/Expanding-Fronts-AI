; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

#load-if-defined DEFEND-MONUMENT
;Written by A3DWaffle :D
;Edited by Zeldrake
;And not the other way round :D

;**************** START GOALS ****************

(defrule
	(true)
=>
	(set-goal importantT2research DONE) ; since research is not loaded we need these
	(set-goal importantT3research DONE)
	(set-goal importantT4research DONE)

	(set-goal attackTSAlevel 0) ; attack shenanigans
	(set-goal amisummoned NO)
	(disable-self)
)

(defrule
	(can-build BLDG-SPACEPORT)
	(building-type-count-total BLDG-SPACEPORT == 0)
	(not (goal buildpause YES))
=>
	(build BLDG-SPACEPORT)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR == 0)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
=>
	(build BLDG-GOVTCTR)
)



;**************** TEAM SELECTION ****************
;Waffle Guide: These rules sort the AI into defenders and attackers.

(defrule
        (cc-players-building-type-count any-enemy BLDG-MONUMENT > 0)
		(game-time > 1)
=>
		(set-goal wonder-attempt ATTACK)
		(set-strategic-number sn-special-attack-type3 1)
		(set-strategic-number sn-attack-intelligence 1)
		(disable-self)
)

(defrule
		(cc-players-building-type-count any-ally BLDG-MONUMENT > 0)
		(game-time > 1)
=>
        (set-goal wonder-attempt DEFEND)
        (disable-self)
)

(defrule
		(building-type-count BLDG-MONUMENT == 1)
		(game-time > 1)
=>
        (set-goal wonder-attempt HOLDER) ; Will not attack or do anything
        (disable-self)
)

; Resource cheats

;---- Attacker ----
(defrule
		(true) ; all players
=>
        (cc-add-resource carbon 20000) ; Deathmatch res
        (cc-add-resource food 20000)
        (cc-add-resource nova 10000)
        (cc-add-resource metal 5000)
        (disable-self)
)

;---- Defender ----
(defrule
        (goal wonder-attempt HOLDER)
=>
        (cc-add-resource metal 5000)
        (disable-self)
)

(defrule
	(can-research aic-pop) ; note: is researched at power core
=>
	(research aic-pop)
	(disable-self)
)

; Special-mode construction support.  Defend Monument starts in an unusual
; state, so make sure attackers/defenders get the production buildings that
; the modern army packages expect before the direct UU/AC rules dominate.

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(can-build-with-escrow BLDG-TRAINTROOPER)
	(building-type-count-total BLDG-TRAINTROOPER < 4)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(can-build-with-escrow BLDG-TRAINMECH)
	(building-type-count-total BLDG-TRAINMECH < 4)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINMECH)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(building-type-count-total BLDG-TRAINHEAVY < 4)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINHEAVY)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(can-build-with-escrow BLDG-TRAINAIR)
	(building-type-count-total BLDG-TRAINAIR < 4)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINAIR)
)

; Special-mode army fallback.  The normal production files still provide the
; detailed package logic; these rules keep Defend Monument from going silent
; when scenario pacing prevents those packages from getting started.

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(unit-type-count-total UNIT-LASER-LINE < 12)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(unit-type-count-total UNIT-MISSILE-LINE < 6)
	(can-train UNIT-MISSILE-LINE)
	(not (goal support-aircraft YES))
=>
	(train UNIT-MISSILE-LINE)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(goal support-grenadiers YES)
	(unit-type-count-total UNIT-GRENADE-LINE < 6)
	(can-train UNIT-GRENADE-LINE)
=>
	(train UNIT-GRENADE-LINE)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
	(unit-type-count-total UNIT-MECH2-LINE < 8)
	(can-train UNIT-MECH2-LINE)
=>
	(train UNIT-MECH2-LINE)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-3)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(unit-type-count-total UNIT-MECH1-LINE < 6)
	(can-train UNIT-MECH1-LINE)
=>
	(train UNIT-MECH1-LINE)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-4)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm MECH/HW)
	)
	(unit-type-count-total SIEGE-RAM-LINE < 4)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

(defrule
	(or
		(goal wonder-attempt ATTACK)
		(goal wonder-attempt DEFEND)
	)
	(current-age >= tech-level-4)
	(or
		(goal support-aircraft YES)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-FIGHTER-LINE < 8)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)


; Little bit of scout logic
(defrule
	(game-time > 10)
=>
	(set-goal scouting 7) ; unique value
	(set-strategic-number sn-number-explore-groups 2) ; allow two scouts
    (set-strategic-number sn-minimum-explore-group-size 1)
	(set-strategic-number sn-maximum-explore-group-size 1)
	(disable-self)
)
(defrule
	(game-time > 360)
=>
	(set-goal scouting PULSEYES)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-blot-size 25)
	(disable-self)
)

;*********************************************************
;---- Attack Logic ----

(defrule
	(goal wonder-attempt ATTACK)
=>
	(enable-timer t-attackgroup-alt 300) ; Defenders get 4 minutes of peace ; too small, AI had no forces
	(disable-self)
)

(defrule
	(goal wonder-attempt DEFEND)
=>
	(enable-timer t-attackgroup-alt 540) ; Defenders will send a sortie to the Attackers at the 9min mark
	(disable-self)
)

(defrule
	(goal wonder-attempt HOLDER)
=>
	(disable-timer t-attackgroup-alt) ; never attack
	(disable-self)
)


(defrule
        (goal wonder-attempt ATTACK)
        (timer-triggered t-attackgroup-alt)
		(or
			(shared-goal treatytimer 0)
			(shared-goal treatytimer 1)
		)
=>
        (disable-timer t-attackgroup-alt)
        (enable-timer t-attackgroup-alt 180) ; Attack waves every 3 minutes.
        (set-goal aready YES)
		(chat-to-all "I hate that monument!")
        (set-strategic-number sn-special-attack-influence3 100) ; This may or may not actually do anything
		(set-strategic-number sn-attack-winning-player 1) ; This one works significantly more reliably
		(set-strategic-number sn-attack-winning-player-factor 80)
		
)

(defrule
        (goal wonder-attempt DEFEND)
        (timer-triggered t-attackgroup-alt)
		(or
			(shared-goal treatytimer 0)
			(shared-goal treatytimer 1)
		)
=>
        (disable-timer t-attackgroup-alt)
        (enable-timer t-attackgroup-alt 360) ; A 6min wait means again at the 15min mark
        (set-goal aready YES)
		(chat-to-all "You won't take us without a fight!")
)

; TSA or not
(defrule
	(true)
=>
	(set-goal attacktype TSA)
	(disable-self)
)


;--- Attacker Coordination ---

; Joinin Disable Shenanigans
; Alleviates issues whereby "I'm attacking" is followed by "I'm joining in!"

(defrule
	(taunt-detected any-ally 234)
	(or
		(goal amisummoned DISABLE-1)
		(or
			(goal amisummoned DISABLE-2)
			(goal amisummoned DISABLE-3)
		)
	)
=>
	(acknowledge-taunt every-ally 234)
)

(defrule
	(goal amisummoned DISABLE-3)
=>
	(set-goal amisummoned NO) ; system works nicely
)
(defrule
	(goal amisummoned DISABLE-2)
=>
	(set-goal amisummoned DISABLE-3)
)
(defrule
	(goal amisummoned DISABLE-1)
=>
	(set-goal amisummoned DISABLE-2)
)

; Joinin 
(defrule
	(taunt-detected any-ally 234)
	(military-population > 10) 
	(not (goal wonder-attempt HOLDER))
	(goal amisummoned NO)
=> 
	(acknowledge-taunt every-ally 234) ; can recieve multiple in the same tick so needs to call every
	(set-goal amisummoned YES)
	(set-goal aready YES)
	;(chat-to-player every-ally "I'm joining in!") ; message handled elsewhere now
	; (chat-local-to-self "WAFFLE: Joinin attack")
)

(defrule
	(taunt-detected any-ally 234)
	(military-population <= 10) 
=> 
	(acknowledge-taunt every-ally 234) 
	(do-nothing)
)





;-- Attacker Halt --
(defrule
	(goal wonder-attempt ATTACK)
	(taunt-detected any-ally 36)                    ;"attack on my mark"
	=>
	(acknowledge-taunt this-any-ally 36)
	(chat-to-all "108")
	(disable-timer t-attackgroup-alt) ; resetting of this should be done via taunt 31 
)

(defrule
	(goal wonder-attempt ATTACK)
	(taunt-detected any-ally 31)              ; "attack somebody"
	=>
	(acknowledge-taunt this-any-ally 31)
	(chat-to-player-using-id this-any-ally 22170) ; "43 Acknowledged! I will attack immediately, Commander."
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 5)
)

; TOWN SIZE ATTACK LOGIC
; Timers are overall higher than main attack logic due to defend the monument having so much res

(defrule
	(goal aready YES)
	(goal attacktype TSA)
	(not (goal amisummoned YES))
=>
	; (chat-local-to-self "WAFFLE: TSA. Attack. Set to HIGH")
	(set-goal attackTSAhold HOLDING-HIGH)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(chat-to-player every-computer "234")      ; sends taunt 234 to other Computer to summon them in
	(set-goal messagestatus msg-ATTACKING)		; sends message to player
	(set-goal aready NO)
	(set-goal amisummoned DISABLE-1)
	(disable-timer t-attackgroup-alt) ; we don't want it to interrupt our TSA
	(disable-timer t-attackgroup-hold) ; it may have been doing something but we got a join in 
)

(defrule
	(goal aready YES)
	(goal amisummoned YES) ; joinin
	(goal attacktype TSA)
=>
	; (chat-local-to-self "WAFFLE: TSA. Joinin. Set to HIGH")
	(set-goal attackTSAhold HOLDING-HIGH)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal messagestatus msg-JOININ)
	(set-goal aready NO)
	(set-goal amisummoned DISABLE-1)
	(disable-timer t-attackgroup-alt) ; we don't want it to interrupt our TSA
	(disable-timer t-attackgroup-hold) ; it may have been doing something but we got a join in 
)


(defrule
	(population < stop-junk-threshold) ; when population is smaller than the threshold
	(goal attackTSAhold HOLDING-HIGH)
=>
	(set-goal attackTSAhold HOLDING-LOW) ; start the timer to call off TSA 
	(disable-timer t-attackgroup-hold)
	(enable-timer t-attackgroup-hold 240)
	; (chat-local-to-self "WAFFLE: TSA hit low pop threshold. Holding for 240s more")
)
(defrule
	(population >= popcap) ; if population then reaches pop cap during this time
	(goal attackTSAhold HOLDING-LOW)
=>
	(set-goal attackTSAhold HOLDING-HIGH) ; reset and wait for pop to fall back down again
	(disable-timer t-attackgroup-hold)
	; (chat-local-to-self "WAFFLE: TSA re-reached popcap, holding indefinitely")
)
; force abort if army dead
(defrule
	(military-population <= 8)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
	(disable-timer t-attackgroup-hold)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 180)
	; (chat-local-to-self "WAFFLE: Army dead, force cancelling TSA. 180s cooldown")
)

; when the timer triggers...

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population >= stop-junk-threshold) ; high pop 
	(game-time < 900) ; After the 15min mark, do not turn off TSA
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 60)
	; (chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop high: 60s cooldown.")
)

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population < stop-junk-threshold) ; lower pop
	(game-time < 900) ; After the 15min mark, do not turn off TSA
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	; (chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop low: 150s cooldown.")
)


; -----------------------------------------------------
; --- CHAPTER 2B-II: INCREMENTING TOWN SIZE LOGIC --- 
; -----------------------------------------------------

(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 0)
	(not (strategic-number sn-maximum-town-size == 40))
=>
	(set-strategic-number sn-maximum-town-size 40)
	; (chat-local-to-self "WAFFLE: Level 0, TS 40")
)
