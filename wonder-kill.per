    (set-strategic-number sn-maximum-town-size TL4-townsize-smol)
	(set-strategic-number sn-percent-civilian-builders 90)
    (set-strategic-number sn-percent-civilian-gatherers 10)
	(set-strategic-number sn-max-unpowered-buildings 2)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(disable-self)
)

(defrule
        (true)
=>
        (set-strategic-number sn-zero-priority-distance 250) ; boring SNs
        (set-strategic-number sn-blot-exploration-map 0)
        (set-strategic-number sn-maximum-gaia-attack-response 2)
        (set-strategic-number sn-mill-max-distance 20) ; dropoff distances from home
		(set-strategic-number sn-camp-max-distance 20) ; nova carbon ore drops
		(set-strategic-number sn-allow-civilian-defense 0)
        (disable-self)
)

; resource distances that the AI will walk to a dropoff 
(defrule
        (true)
=>
        (set-strategic-number sn-maximum-carbon-drop-distance 25)
        (set-strategic-number sn-maximum-food-drop-distance 15)
        (set-strategic-number sn-maximum-hunt-drop-distance 15)

        (set-strategic-number sn-maximum-fish-boat-drop-distance -1) ; infinite apparently? 
        (set-strategic-number sn-maximum-nova-drop-distance 15)
        (set-strategic-number sn-maximum-metal-drop-distance 15)
        (disable-self)
)

(defrule
        (game-time > 900) ; 15min 
=>
        (set-strategic-number sn-percent-civilian-builders 50)
        (set-strategic-number sn-percent-civilian-gatherers 50)
		(set-strategic-number sn-camp-max-distance 40)
        (disable-self)
)

(defrule
        (game-time > 600)
		(not (strategic-number sn-maximum-town-size == TL4-townsize))
=>
        (set-strategic-number sn-sentry-distance TL4-sentry-distance)
		(set-strategic-number sn-maximum-town-size TL4-townsize)
		(disable-self)
)


(defrule
        (true)
=>
        (set-strategic-number sn-food-dropsite-distance 3)
        (set-strategic-number sn-carbon-dropsite-distance 3)
        (set-strategic-number sn-metal-dropsite-distance 3)
        (set-strategic-number sn-nova-dropsite-distance 3)
        (set-strategic-number sn-retask-gather-amount 5)

        (set-strategic-number sn-allow-civilian-defense 1)
        (set-strategic-number sn-garrison-rams 1)

        (disable-self)
)

(defrule
        (true)
=>
        (set-strategic-number sn-town-defend-priority 1)
        (set-strategic-number sn-nova-defend-priority 2)
        (set-strategic-number sn-metal-defend-priority 3)

        (set-strategic-number sn-forage-defend-priority 0)
        (set-strategic-number sn-holocron-defend-priority 0)
        (set-strategic-number sn-cap-civilian-builders 200) ; very high please!

        (disable-self)
)

