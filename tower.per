; =====================================================
; FILE: tower
; PURPOSE:
;   Controls walls and tower-side defensive building behavior.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: WALL STATE AND PLACEMENT
;	Chapter 2: STATIC DEFENSE BUILDINGS
;	Chapter 3: AA BATTERIES
;	Chapter 4: WALL CONSTRUCTION
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
        (goal wall-build YES)
        (wall-invisible-percentage 2 > 0)
=>
        (set-strategic-number sn-blot-exploration-map 1)
)

(defrule
	(or
		(not (goal allow-wall NO))
		(not (goal wall-build NO))
	)
 =>
	(set-goal allow-wall NO)
	(set-goal wall-build NO)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(or
		(not (goal allow-wall NO))
		(not (goal wall-build NO))
	)
=>
	(set-goal allow-wall NO)
	(set-goal wall-build NO)
)

(defrule
	(goal scn-detected YES)
	(not (goal allow-wall NO)) ; scenario catching
=>
	(set-goal allow-wall NO)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(current-age == tech-level-2)
	(building-type-count-total BLDG-TURRET-LINE >= 3)
=>
	(set-goal allow-wall NO)
)

(defrule
	(true)
=>
	(set-goal allow-wall NO)
	(set-goal wall-build NO)
	(disable-self)
)


(defrule
	(game-time < 10)
	(or
		(building-type-count BLDG-GATE > 0)
		(or
			(building-type-count BLDG-LTWALL > 0) ; light wall
			(building-type-count BLDG-BARRIER-LINE > 0) ; med+ wall
		
		)
	)
=>
	(set-goal allow-wall NO)
	(disable-self)
)


; =====================================================
; *** Chapter 1: WALL STATE AND PLACEMENT ***
; =====================================================

; Mostly original GB code follows, which is why it is hard to read.
; Start the pass.
(defrule
        (nor
				(map-type star-wars-world-kashyyyk)
				(nor
					(map-type fortress) 
					(map-type arena)
				)
        )
		(not (goal openingstyle STYLE-DEFENSIVE))
		(goal allow-wall YES)
=>
        (enable-wall-placement 2)
        (disable-self)
)


(defrule
        (nor
                (map-type fortress) 
                (map-type arena)
        )
		(not (goal openingstyle STYLE-DEFENSIVE))
		(goal allow-wall YES)
=>
        (enable-wall-placement 2)
        (disable-self)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
		(goal allow-wall YES)
=>
        (enable-wall-placement 1)
)


; compare SWGB CC rule
;(defrule
;        (difficulty <= easy)
;        (nor
;                (map-type fortress) 
;                (map-type arena)
;        )
;=>
;        (enable-wall-placement 2)
;        (disable-self)
;)


(defrule
        (current-age > tech-level-1)
		(not (goal openingstyle STYLE-DEFENSIVE))
		(goal allow-wall YES)
=>
        (set-goal wall-build NOTICE)
        (disable-self)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (current-age > tech-level-1)
		(goal allow-wall YES)
=>
        (set-goal wall-build YES)
)

(defrule
        (goal wall-build NOTICE)
        (or
                (difficulty >= easy)
                (map-type fortress)
        )
=>
        (set-goal wall-build NO)
        (disable-self)
)

(defrule
        (goal wall-build NOTICE)
=>
        (set-goal wall-build YES)
        (disable-self)
)

(defrule
        (goal wall-build NO)
        (current-age == tech-level-4)
        (nor 
                (map-type fortress)
                (false)
        )
=>
        (set-goal wall-build YES)
        (disable-self)
)

(defrule
        (goal wall-build NO)
        (building-type-count-total BLDG-MONUMENT > 0)
        (nor 
                (map-type fortress) 
                (or
                        (map-type tundra)
                        (map-type ice-lake)
                )
        )
=>
        (set-goal wall-build YES)
)

; =====================================================
; *** Chapter 2: STATIC DEFENSE BUILDINGS ***
; =====================================================

; Fortress owns static defenses so metal/ore spending is kept in one place.
; Escrow is used for research, not defensive construction.

; --- TL2 laser turret shell ---
(defrule
	(current-age == tech-level-2)
	(can-build-with-escrow BLDG-TURRET-LINE)
	(not (goal raid-turret-query 1))
=>
	(set-goal raid-turret-query 1)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-2)
	(not (can-build-with-escrow BLDG-TURRET-LINE))
	(not (goal raid-turret-query 2))
=>
	(set-goal raid-turret-query 2)
	(do-nothing) ; RAID diagnostics disabled
)


(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(goal raid-build-open NO)
=>
	(set-builders-type 79 8)
	(set-builders-type 234 8)
	(set-builders-type 235 8)
	(set-builders-type 3599 8)
	(set-builders-type 3600 8)
	(set-builders-type 3601 8)
	(set-builders-type 7088 8)
)

(defrule
	(current-age >= tech-level-2)
	(goal raid-build-open YES)
=>
	(set-builders-type 79 5)
	(set-builders-type 234 5)
	(set-builders-type 235 5)
	(set-builders-type 3599 5)
	(set-builders-type 3600 5)
	(set-builders-type 3601 5)
	(set-builders-type 7088 5)
)

(defrule
	(current-age == tech-level-2)
	(goal raid-build-open NO)
	(not (goal raid-builder-mode 8))
=>
	(set-goal raid-builder-mode 8)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-2)
	(goal raid-build-open YES)
	(not (goal raid-builder-mode 5))
=>
	(set-goal raid-builder-mode 5)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(goal raid-build-open NO)
	(not (goal buildpause YES))
	(building-type-count-total BLDG-TURRET-LINE < 3)
	(can-build-with-escrow BLDG-TURRET-LINE)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)



; Give Defensive extra builders on laser turrets before the first turret rule
; can even fire. If this sits below the build rule, the first turret starts
; with the old/default builder count and the whole shell comes in late.


(defrule
	(building-type-count-total BLDG-TURRET-LINE < 4)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(building-type-count-total BLDG-TURRET-LINE < 2)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

; Defensive should lean on laser turrets as its primary TL2 protection instead
; of waiting for the broader home-defense plan to come online later.
(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-TURRET-LINE < 6)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-TURRET-LINE < 4)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

; --- TL3 fortress and static AA shell ---

(defrule
	(building-type-count-total BLDG-GOVTCTR < 1)
	(or
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-TURRET-LINE >= 4)
		)
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 2)
	(or
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-TURRET-LINE >= 4)
		)
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)

#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

; Higher difficulties maintain a stronger starting AA shell.
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 6)
	(or
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-TURRET-LINE >= 4)
		)
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-MISSILE-LINE)
	(metal-amount >= 350)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)

; If metal is short, give a small nudge before starting the AA turret.
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 6)
	(or
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-TURRET-LINE >= 4)
		)
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-MISSILE-LINE)
	(metal-amount < 350)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(cc-add-resource metal 30)
	(build BLDG-MISSILE-LINE)
)
#end-if
#end-if
#end-if


; Once a fortress exists, allow the broader static defense package.
(defrule
	(building-type-count-total BLDG-GOVTCTR > 0)
	(building-type-count-total BLDG-MISSILE-LINE < 4) 
	(building-type-count-total BLDG-MAIN > 1)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)

; Shield generator.
(defrule
    (building-type-count-total BLDG-GOVTCTR > 0)
    (building-type-count-total BLDG-SHLDGEN == 0)
	(building-type-count-total BLDG-MAIN > 1)
    (can-build BLDG-SHLDGEN)
	(not (goal buildpause YES))
        	(goal raid-build-open YES)
=>
    (build BLDG-SHLDGEN)
)

; Once AA turrets are mostly done, allow second and third fortresses.

(defrule
	(building-type-count-total BLDG-MISSILE-LINE > 2)
	(building-type-count-total BLDG-GOVTCTR < 3)
	(building-type-count-total BLDG-MAIN > 1)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-GOVTCTR)
)

#load-if-not-defined DIFFICULTY-EASIEST

; When the second fortress is up, allow more static defenses.
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 5)
	(building-type-count-total BLDG-GOVTCTR > 1)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-TURRET-LINE < 4)
	(building-type-count-total BLDG-GOVTCTR > 1)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(building-type-count-total BLDG-TURRET-LINE < 2)
	(building-type-count-total BLDG-GOVTCTR > 1)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)


; Allow up to five fortresses once the defensive shell is established.
(defrule
	(building-type-count-total BLDG-MISSILE-LINE > 4)
	(building-type-count-total BLDG-TURRET-LINE > 2)
	(building-type-count-total BLDG-GOVTCTR < 3)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-GOVTCTR)
)

; Build more defenses as the fortress count rises.

; Shields.
(defrule
	(building-type-count-total BLDG-GOVTCTR > 2)
	(building-type-count-total BLDG-SHLDGEN < 2)
	(can-build BLDG-SHLDGEN)
	(not (goal buildpause YES))
		(goal raid-build-open YES)
=>
	(build BLDG-SHLDGEN)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 3)
	(building-type-count-total BLDG-SHLDGEN < 4)
	(can-build BLDG-SHLDGEN)
	(not (goal buildpause YES))
		(goal raid-build-open YES)
=>
	(build BLDG-SHLDGEN)
)

; Troop armies need earlier forward shield cover once they can hold a position.
(defrule
	(current-age == tech-level-4)
	(current-age-time > 420)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(building-type-count-total BLDG-SHLDGEN < 5)
	(military-population >= MIL_POP_A)
	(carbon-amount > 900)
	(nova-amount > 250)
	(can-build-with-escrow BLDG-SHLDGEN)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(build-forward BLDG-SHLDGEN)
)

; Rich TL4 forward Shield Generator starter. Do not wait for three home shields
; before protecting a successful forward base.
(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(goal forward-ground-core YES)
	(military-population >= MIL_POP_B)
	(carbon-amount > 1500)
	(nova-amount > 400)
	(can-build-with-escrow BLDG-SHLDGEN)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(build-forward BLDG-SHLDGEN)
)

; Rich TL4 forward Shield Generator support. The first shields still protect
; the home shell; surplus economies can push shield coverage toward the front.
(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(goal forward-ground-core YES)
	(military-population >= MIL_POP_B)
	(carbon-amount > 2500)
	(nova-amount > 600)
	(can-build-with-escrow BLDG-SHLDGEN)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(build-forward BLDG-SHLDGEN)
)

; Additional AA turrets.

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-MISSILE-LINE < 8)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

; Hard and Hardest expand the static shell further while TSA is active.

(defrule 
	(building-type-count-total BLDG-GOVTCTR < 3) 
	(can-build BLDG-GOVTCTR)
	(not (goal attackTSAhold EXHAUSTED))
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-MISSILE-LINE < 10) 
	(building-type-count-total BLDG-SHLDGEN > 1)
	(not (goal attackTSAhold EXHAUSTED))
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)
(defrule
	(building-type-count-total BLDG-GOVTCTR > 5)
	(building-type-count-total BLDG-MISSILE-LINE < 15) 
	(not (goal attackTSAhold EXHAUSTED))
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-TURRET-LINE < 8)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(not (goal attackTSAhold EXHAUSTED))
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-TURRET-LINE < 6)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(not (goal attackTSAhold EXHAUSTED))
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 5)
	(building-type-count-total BLDG-TURRET-LINE < 10)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(not (goal attackTSAhold EXHAUSTED))
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 5)
	(building-type-count-total BLDG-TURRET-LINE < 8)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(not (goal attackTSAhold EXHAUSTED))
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

; Outside TSA, keep a smaller home shell.
(defrule
	(building-type-count-total BLDG-GOVTCTR < 3)
	(goal attackTSAhold EXHAUSTED)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-MISSILE-LINE < 8)
	(building-type-count-total BLDG-SHLDGEN > 1)
	(goal attackTSAhold EXHAUSTED)
	(can-build BLDG-MISSILE-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-TURRET-LINE < 6)
	(building-type-count-total BLDG-SHLDGEN > 1)
	(goal attackTSAhold EXHAUSTED)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-TURRET-LINE < 4)
	(building-type-count-total BLDG-SHLDGEN > 1)
	(goal attackTSAhold EXHAUSTED)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

; Defensive fortification plan should top out at six laser turrets instead of
; drifting into the larger TSA/home-defense caps meant for the other openings.
(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-TURRET-LINE < 6)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-TURRET-LINE < 4)
	(can-build BLDG-TURRET-LINE)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-TURRET-LINE)
	(do-nothing) ; RAID diagnostics disabled
)

; Rich TL4 forward laser turret support for established forward bases.
(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(goal forward-ground-core YES)
	(building-type-count-total BLDG-POWERCORE >= 5)
	(building-type-count-total BLDG-TURRET-LINE < 14)
	(military-population >= MIL_POP_B)
	(carbon-amount > 1800)
	(can-build-with-escrow BLDG-TURRET-LINE)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build-forward BLDG-TURRET-LINE)
)

#end-if
#end-if
#end-if

; End non-Easiest static defense block.
#end-if

; =====================================================
; *** Chapter 3: AA BATTERIES ***
; =====================================================

; Unlike other defensive structures, AA Batteries are carbon intensive and
; locked behind research. All difficulties maintain a small battery shell.

(defrule
	(can-build BLDG-AABATTERY)
	(building-type-count-total BLDG-AABATTERY < 3)
	(or
		(not (town-under-attack))
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-AABATTERY)
)

#load-if-not-defined DIFFICULTY-EASIEST

; Higher difficulties maintain four in TL3 and six in TL4.
(defrule
	(can-build BLDG-AABATTERY)
	(or
		(and
			(current-age == tech-level-3)
			(building-type-count-total BLDG-AABATTERY < 4)
		)
		(and
			(current-age == tech-level-4)
			(building-type-count-total BLDG-AABATTERY < 6)
		)
	)
	(or
		(not (town-under-attack))
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-AABATTERY)
)

#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

; Hard and Hardest build more while TSA is active.
(defrule
	(can-build BLDG-AABATTERY)
	(not (goal attackTSAhold EXHAUSTED))
	(building-type-count-total BLDG-AABATTERY < 10)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-AABATTERY)
)

; Air alerts punch through escrow so the AI actually throws down the battery net.
(defrule
	(goal enemyairsighted AIR-ALERT-GUARD)
	(building-type-count-total BLDG-AABATTERY < 8)
	(can-build-with-escrow BLDG-AABATTERY)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-AABATTERY)
)

(defrule
	(goal enemyairsighted AIR-ALERT-DANGER)
	(building-type-count-total BLDG-AABATTERY < 12)
	(can-build-with-escrow BLDG-AABATTERY)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-AABATTERY)
)

; Rich TL4 forward AA Battery support. Use this only after the normal battery
; shell exists so it extends a forward base instead of replacing home defense.
(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(goal forward-ground-core YES)
	(building-type-count-total BLDG-POWERCORE >= 5)
	(building-type-count-total BLDG-AABATTERY >= 3)
	(building-type-count-total BLDG-AABATTERY < 12)
	(military-population >= MIL_POP_B)
	(carbon-amount > 2000)
	(can-build-with-escrow BLDG-AABATTERY)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build-forward BLDG-AABATTERY)
)

#end-if
#end-if
#end-if

; =====================================================
; *** Chapter 4: WALL CONSTRUCTION ***
; =====================================================

(defrule
        (current-age == tech-level-2)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (goal wall-build YES)
        (can-build-wall-with-escrow 2 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 2 BLDG-BARRIER-LINE)
                (metal-amount > 125)
        )
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-wall 2 BLDG-BARRIER-LINE)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (current-age == tech-level-2)
        (goal wall-build YES)
        (can-build-wall-with-escrow 1 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 1 BLDG-BARRIER-LINE)
                (metal-amount > 125)
        )
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-wall 1 BLDG-BARRIER-LINE)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (can-build-wall-with-escrow 2 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 2 BLDG-BARRIER-LINE)
                (metal-amount > 300)
        )
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-wall 2 BLDG-BARRIER-LINE)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (can-build-wall-with-escrow 1 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 1 BLDG-BARRIER-LINE)
                (metal-amount > 300)
        )
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-wall 1 BLDG-BARRIER-LINE)
)

(defrule
        (goal wall-build NO)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (building-type-count-total BLDG-GATE > 0)
        (wall-completed-percentage 2 >= 75)
        (wall-completed-percentage 2 < 100)
        (can-build-wall-with-escrow 2 BLDG-BARRIER-LINE)
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-wall 2 BLDG-BARRIER-LINE)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build NO)
        (building-type-count-total BLDG-GATE > 0)
        (wall-completed-percentage 1 >= 75)
        (wall-completed-percentage 1 < 100)
        (can-build-wall-with-escrow 1 BLDG-BARRIER-LINE)
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-wall 1 BLDG-BARRIER-LINE)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (building-type-count-total BLDG-GATE < 10)
        (can-build-gate-with-escrow 2)
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-gate 2)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (building-type-count-total BLDG-GATE < 10)
        (can-build-gate-with-escrow 1)
	(goal buildpause NO)
=>
        (release-escrow metal)
        (build-gate 1)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (wall-completed-percentage 2 == 100)
        (building-type-count-total BLDG-GATE == 0)
=>
        (delete-complete-building BLDG-BARRIER-LINE)
        (set-goal wall-build NO)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (wall-completed-percentage 1 == 100)
        (building-type-count-total BLDG-GATE == 0)
=>
        (delete-complete-building BLDG-BARRIER-LINE)
        (set-goal wall-build NO)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (wall-completed-percentage 2 == 100)
=>
        (set-goal wall-build NO)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (wall-completed-percentage 1 == 100)
=>
        (set-goal wall-build NO)
)

; wall-completed-percentage goes up to exactly 50% it seems, no higher
; it also counts foundations, so if all the foundations are laid, wall-completed-percentage reports 100

; TL2 mine defense; placement is engine controlled.
; Count spawned mines by explicit owner. Do not mix construction objects with
; live mines or depend on the native self unit-count path for spawned units.
(defrule
	(true)
=>
	(set-goal raid-mine-open NO)
)

(defrule
	(player-number 1)
	(cc-players-unit-type-count 1 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)

(defrule
	(player-number 2)
	(cc-players-unit-type-count 2 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)

(defrule
	(player-number 3)
	(cc-players-unit-type-count 3 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)

(defrule
	(player-number 4)
	(cc-players-unit-type-count 4 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)

(defrule
	(player-number 5)
	(cc-players-unit-type-count 5 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)

(defrule
	(player-number 6)
	(cc-players-unit-type-count 6 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)

(defrule
	(player-number 7)
	(cc-players-unit-type-count 7 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)

(defrule
	(player-number 8)
	(cc-players-unit-type-count 8 RAID-MINE-UNIT < 5)
=>
	(set-goal raid-mine-open YES)
)


(defrule
	(current-age == tech-level-2)
	(goal raid-build-open YES)
	(or
		(building-type-count BLDG-DROPCARBON >= 1)
		(or
			(building-type-count BLDG-DROPNOVA >= 1)
			(building-type-count BLDG-TURRET-LINE >= 1)
		)
	)
	(not (goal buildpause YES))
	(carbon-amount > 300)
	(goal raid-mine-open YES)
	(can-build RAID-MINE)
=>
	(set-builders-type RAID-MINE 1)
	(build RAID-MINE)
)

(defrule
	(current-age == tech-level-2)
	(building-type-count BLDG-TURRET-LINE >= 1)
	(goal raid-turret-progress 0)
=>
	(set-goal raid-turret-progress 1)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-2)
	(building-type-count BLDG-TURRET-LINE >= 2)
	(goal raid-turret-progress 1)
=>
	(set-goal raid-turret-progress 2)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-2)
	(building-type-count BLDG-TURRET-LINE >= 3)
	(goal raid-turret-progress 2)
=>
	(set-goal raid-turret-progress 3)
	(do-nothing) ; RAID diagnostics disabled
)

