; =====================================================
; *** Chapter 6: CHEATS ***
; =====================================================

(defrule
	(goal config-in-progress CONFIG-LISTED)
	(taunt-detected any-human 121)
=>
	(acknowledge-taunt this-any-human 121)
	(chat-to-player every-human "Cheating 500c for all AI. This cheat can be sent multiple times.")
	(chat-to-player every-computer "121") ; you need the quotes!
	(set-goal config-in-progress CONFIG-CLOSE)
)

(defrule
	(taunt-detected any-computer 121)
=>
	(acknowledge-taunt this-any-computer 121)
	(cc-add-resource carbon 500)
)

(defrule
	(goal config-in-progress CONFIG-LISTED)
	(taunt-detected any-human 122)
=>
	(acknowledge-taunt this-any-human 122)
	(chat-to-player every-human "Multi-resource cheat. This cheat can be sent multiple times.")
	(chat-to-player every-computer "106") ; Taunt 122 is being sent as part of attack chitchat, "I am going to end this once and for all!" Now is "Utinii!" - which is being used as part of CE diplo. Now 106 "Yub yub"
	(set-goal config-in-progress CONFIG-CLOSE)
)

(defrule
	(taunt-detected any-computer 106)
=>
	(acknowledge-taunt this-any-computer 106)
	(cc-add-resource carbon 1000)
	(cc-add-resource food 1000)
	(cc-add-resource nova 1000)
)

(defrule ; Tidy up
	(goal config-in-progress CONFIG-CLOSE)
=>
	(chat-to-player every-human "Closing config.")
	(set-goal config-in-progress NULL)
	(set-shared-goal pickingupthecall NULL)
)

; =====================================================
; *** Chapter 7: TREATY ***
; =====================================================
; TREATY SHENANIGANS HANDLED HERE (a little)

(defrule
	(shared-goal treatytimer 15)
	(game-time > 900)
=>
	(set-shared-goal treatytimer 1)
	(chat-to-all "The treaty timer is now over! Prepare for battle!")
)
(defrule
	(shared-goal treatytimer 30)
	(game-time > 1800)
=>
	(set-shared-goal treatytimer 1)
	(chat-to-all "The treaty timer is now over! Prepare for battle!")
)
(defrule
	(shared-goal treatytimer 45)
	(game-time > 2700)
=>
	(set-shared-goal treatytimer 1)
	(chat-to-all "The treaty timer is now over! Prepare for battle!")
)
(defrule
	(shared-goal treatytimer 60)
	(game-time > 3600)
=>
	(set-shared-goal treatytimer 1)
	(chat-to-all "The treaty timer is now over! Prepare for battle!")
)
