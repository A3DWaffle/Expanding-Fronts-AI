; tidy up if none picked
(defrule
	(goal messagestatus msg-ATTACKING)
	=>
	(set-goal messagestatus msg-NULL)
)


; -----------------------------------------------------
; *** Chapter 4: AI JOINS ATTACK*** 
; -----------------------------------------------------

(defrule
	(goal messagestatus msg-JOININ)
	=> 
	(chat-to-player every-ally "And I'm joining in!")
	(generate-random-number 5)
)

#load-if-not-defined FEDERATION
#load-if-not-defined CONFEDERACY

(defrule
	(goal messagestatus msg-JOININ)
	(random-number == 1)
	=>
	(chat-to-player every-ally "117 I'm going to regret this.")
	(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

(defrule
	(goal messagestatus msg-JOININ)
	(random-number == 2)
	=>
	(chat-to-player every-ally "139 Here's where the fun begins.")
	(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

(defrule
	(goal messagestatus msg-JOININ)
	(random-number == 3)
	=>
	(chat-to-player every-ally "284 Hit the target hard! Give it everything you got!")
	(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

(defrule
	(goal messagestatus msg-JOININ)
	(random-number == 4)
	=>
	(chat-to-player every-ally  "240 Watch that crossfire, boys!")
	(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

(defrule
	(goal messagestatus msg-JOININ)
	(random-number == 5)
	=>
	(chat-to-player every-ally  "296 I like those odds.")
	(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

#end-if
#end-if

(defrule
	(goal messagestatus msg-JOININ)
	(or
		(civ-selected CONFEDERACY)
		(civ-selected FEDERATION)
	)
	=>
	(chat-to-player any-ally "108 Roger roger.")
	(set-goal messagestatus msg-NULL)
)

; -----------------------------------------------------
; *** Chapter 5: AI ORDERS *** 
; -----------------------------------------------------

(defrule
	(goal messagestatus msg-COMMANDEDTOATTACK)
	=> 
	(chat-to-player every-ally "Acknowledged! I will attack immediately, Commander.")
	(generate-random-number 5)
)

(defrule
	(goal messagestatus msg-CENTER)
	=> 
	(chat-to-player every-ally "Sending spare forces to center. Cancel this behaviour with taunt 172.") 
