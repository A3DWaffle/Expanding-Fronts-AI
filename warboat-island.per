; CHANCE: 
; One unit: Force Message			; 1
; Three units: General Message		; 2,3,4
; Three units: Civ Specific Message	; 5,6,7


(defrule
	(goal messagestatus msg-RESIGN-RESIGN)
	(random-number == 1)
=> 
	(set-goal messagestatus msg-RESIGN-RESIGN-FORCE)
)

(defrule
	(goal messagestatus msg-RESIGN-RESIGN)
	(or
		(or
			(random-number == 2)
			(random-number == 3)
		)
			(random-number == 4)
	)
=> 
	(set-goal messagestatus msg-RESIGN-RESIGN-GENERAL)
)

(defrule
	(goal messagestatus msg-RESIGN-RESIGN)
	(random-number >= 5)
=> 
	(set-goal messagestatus msg-RESIGN-RESIGN-CIVSPECIFIC)
)



