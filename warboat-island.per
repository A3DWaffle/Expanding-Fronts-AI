	(goal messagestatus msg-ATTACKING)
	(random-number == 1)
	=>
	(chat-to-player every-ally "101 It will all be over soon.")
	;(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(random-number == 2)
	=>
	(chat-to-player every-ally "122 I am going to end this, once and for all!")
	;(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(random-number == 3)
	=>
	(chat-to-player every-ally "166 We need to mobilize, now!")
	;(set-goal messagestatus msg-NULL)
	;(generate-random-number 5)
)

