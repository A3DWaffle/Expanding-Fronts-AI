; CONFEDERACY AND FEDERATION BODGE
; Sorry about the mess, it's to help clear space in the string table

(defrule
	(or
		(or
			(goal messagestatus msg-CENTER)
			(goal messagestatus msg-COMMANDEDTOATTACK)
		)	
		(or
			(goal messagestatus msg-CANCELCENTER)
			(goal messagestatus msg-JOININ)
		)
	)
	=>
	(chat-to-player every-ally "108 Roger roger.")
	(set-goal messagestatus msg-NULL)
)









; -----------------------------------------------------
; *** Chapter 7: AI NICE GUY *** 
; -----------------------------------------------------

(defrule
	(players-current-age any-ally == tech-level-3)
	(not (current-age >= tech-level-3))
	(not (players-current-age any-enemy >= tech-level-3))
	(not (goal techthreetaunt DONE))
	(goal iamthechosenchatter ITSME)
	(goal scn-detected NO)
	=>
	(chat-to-player this-any-ally "Well done on reaching Tech Level 3 first, Commander!")
	(chat-to-player this-any-ally "88 Great kid, don't get cocky!")
	(set-goal techthreetaunt DONE)
)

(defrule
	(current-age == tech-level-3)
	(not (players-current-age any-enemy >= tech-level-3))
	(not (players-current-age any-ally >= tech-level-3))
	(goal iamthechosenchatter ITSME)
	(not (goal techthreetaunt DONE))
	(goal scn-detected NO)
	=>
	(chat-to-player every-ally "I have made it to Tech Level 3 first!")
	(chat-to-player every-ally "17 Now I am the master.")
	(set-goal techthreetaunt DONE)
)

(defrule
	(players-current-age any-enemy == tech-level-3)
	(not (players-current-age any-ally >= tech-level-3))
	(not (current-age >= tech-level-3))
	(goal iamthechosenchatter ITSME)
	(not (goal techthreetaunt DONE))
	(goal scn-detected NO)
	=>
	(chat-to-player this-any-enemy "You may have out-teched us, but this isn't over!")
	(chat-to-player this-any-enemy "244 It's not over yet.")
	(chat-to-player every-ally "Commander, the enemy is the first to Tech Level 3!")
	(chat-to-player every-ally "109 Disen berry berry baaad!")
	(set-goal techthreetaunt DONE)
)

; -----------------------------------------------------
; *** Chapter 8: AI CRIPPLED *** 
; -----------------------------------------------------

;Waffle Guide: The idea is to notify player that AI is close to resigning.
(defrule
	(game-time > 900) ; 15min 
	(unit-type-count-total UNIT-WORKER <= 15)
	(goal scn-detected NO)
	=>
	(set-goal messagestatus msg-CRIPPLEDAI)
	(generate-random-number 10)
	(disable-self)
)

(defrule
	(goal messagestatus msg-CRIPPLEDAI)
	(random-number == 1)
	=>
	(chat-to-all "184 How can you do this?")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-CRIPPLEDAI)
	(random-number == 2)
	=>
	(chat-to-all "86 I've just about had enough of you.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-CRIPPLEDAI)
	(random-number == 3)
	=>
	(chat-to-all "82 Maybe there's a lesson to be learned here.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-CRIPPLEDAI)
	(random-number == 4)
	(not (civ-selected GEONOSIANS))
	(not (civ-selected WOOKIEES))
	(not (civ-selected GUNGANS))
	=>
	(chat-to-all "286 Hey! Whose gonna pay for that droid, eh?")
	(set-goal messagestatus msg-NULL)
)

;Waffle Guide: Hope I did this one right, Idk why ORs confuse me.
(defrule
	(goal messagestatus msg-CRIPPLEDAI)
	(random-number == 4)
	(or
		(civ-selected GEONOSIANS)
		(or
			(civ-selected WOOKIEES)
			(civ-selected GUNGANS)
		)
	)
	=>
	(chat-to-all "45 Strike me down, I'll become more powerful than you can possibly imagine.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-CRIPPLEDAI)
	(random-number == 5)
	=>
	(chat-to-all "161 I can sense that you're angry.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-CRIPPLEDAI)
	(random-number > 5) ; high chance of calling this one
	=>
	(chat-to-all "45 Strike me down, I'll become more powerful than you can possibly imagine.") 
	(set-goal messagestatus msg-NULL)
)


