; =====================================================
; FILE: warboat-island
; PURPOSE:
;   Handles island-mode helpers, late-game utility, and chat behavior.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: ISLAND LOGIC
;	Chapter 2: CHAT
;	Chapter 3: LATEGAME UTILITY
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(goal iamthechosenchatter ITSME)
	(goal scn-detected NO)
	(cc-players-unit-type-count any-enemy 1587 > 0)
=>
	(chat-to-player every-enemy "69 That's no moon...")
	(disable-self)
)

; put this in chapter 5
(defrule
	(goal messagestatus msg-COMMANDEDNOTTOATTACK)
=>
	(chat-to-player every-ally "241 Standing by. We will attack when we hear Taunt 31, commander.")
	(set-goal messagestatus msg-NULL)
)

; put this at the start of chapter 10
(defrule
	(goal messagestatus msg-RESIGN-EXCUSE)
	(not (strategic-number snc-cheat-tier == 0))
=>
	(generate-random-number 3)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE)
	(not (strategic-number snc-cheat-tier == 0))
	(not (random-number == 1)) ; 2/3rds chance of complaining about it, otherwise continue as normal
=>
	(set-goal messagestatus msg-RESIGN-CHEAT)
)


(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-FISH)
=>
	(chat-to-all "You were the bigger fish.")
	(set-goal messagestatus msg-NULL)
)
(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-TANTIVE)
=>
	(chat-to-all "We couldn't find the droids we were looking for.")
	(set-goal messagestatus msg-NULL)
)
(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-BONGO)
=>
	(chat-to-all "Our neighbors were too scary.")
	(set-goal messagestatus msg-NULL)
)
(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-FLYINGCAR)
=>
	(chat-to-all "We thought a 4-seater sedan would be a useless relic from a bygone age!")
	(set-goal messagestatus msg-NULL)
)
(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-DECIMATOR)
=>
	(chat-to-all "Our forces were decimated.")
	(set-goal messagestatus msg-NULL)
)
(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-STARDEST)
=>
	(chat-to-all "Anti-Air Troopers simply couldn't match a Star Destroyer's firepower.")
	(set-goal messagestatus msg-NULL)
)
(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-SIMON)
=>
	(chat-to-all "Since when did Ewoks wield rapid laser blasters?!")
	(set-goal messagestatus msg-NULL)
)
(defrule
	(goal messagestatus msg-RESIGN-CHEAT)
	(strategic-number snc-cheat-tier == RESIGN-CHT-DEATHSTAR)
=>
	(chat-to-all "We thought it was a moon...")
	(set-goal messagestatus msg-NULL)
)


; config ad, put this anywhere in the resign section

(defrule
	(goal messagestatus msg-RESIGN-CONFIGAD)
=>
	(chat-to-all "I have been defeated!")
	(chat-to-all "To customize the AI's behaviour use Taunt 85 in your next game.")
	(chat-to-all "This has options like a treaty, tech level lock, resign logic, and more!")
	(set-goal messagestatus msg-NULL)
)



; -----------------------------------------------------
; *** Chapter 0: AI LOGIC AND MISC CHATS *** 
; -----------------------------------------------------


(defrule
	(goal iamthechosenchatter ITSME)
	(game-time > 40)
	(goal scn-detected NO)
	=>
	(set-goal messagestatus msg-GREETING)
	(disable-self)
)

(defrule
	(goal iamthechosenchatter ITSME)
	(game-time > 60)
	(goal scn-detected NO)
	=>
	(set-goal messagestatus msg-OPENING)
	(disable-self)
)
; there is a very slight (and I mean VERY SLIGHT) issue in that
; if iamthechosenchatter hasn't been picked yet 
; it's possible for msg-GREETING to get eaten up by msg-OPENING if game time hasn't gone far enough 
; but I would really call this not much of an issue, as a) it's only a message and b) greeting is sent to allies anyway

(defrule
	(true)
	=>
	(set-goal iamthechosenchatter UNDECIDED)
	(disable-self)
)

(defrule
		(player-number 1)
		(game-time > 1)
		(goal iamthechosenchatter UNDECIDED)
	=>
		(set-goal iamthechosenchatter ITSME)
)

(defrule
		(player-number 2)
		(game-time > 8)
		(goal iamthechosenchatter UNDECIDED)
	=>
		(set-goal iamthechosenchatter ITSME)
)

(defrule
		(player-number 3)
		(game-time > 15)
		(goal iamthechosenchatter UNDECIDED)
	=>
		(set-goal iamthechosenchatter ITSME)
)

(defrule
		(player-number 4)
		(game-time > 22)
		(goal iamthechosenchatter UNDECIDED)
	=>
		(set-goal iamthechosenchatter ITSME)
)

(defrule
		(player-number 5)
		(game-time > 29)
		(goal iamthechosenchatter UNDECIDED)
	=>
		(set-goal iamthechosenchatter ITSME)
)

(defrule
		(player-number 6)
		(game-time > 36)
		(goal iamthechosenchatter UNDECIDED)
	=>
		(set-goal iamthechosenchatter ITSME)
)

(defrule
		(player-number 7)
		(game-time > 43)
		(goal iamthechosenchatter UNDECIDED)
	=>
		(set-goal iamthechosenchatter ITSME)
)

(defrule
	(player-number 8)
	(game-time > 50)
	(goal iamthechosenchatter UNDECIDED)
=>
	(set-goal iamthechosenchatter ITSME)
)

(defrule
	(goal iamthechosenchatter ITSME)
=>
	(chat-to-player every-computer "I am the chatty one!")
	(chat-to-player every-computer "183")
	(disable-self)
)



(defrule
	(taunt-detected any-computer-ally 183)
	=>
	(acknowledge-taunt this-any-computer-ally 183)
	(set-goal iamthechosenchatter SOMEBODYELSE)
)



; eat up messages if in scenario mode
(defrule
	(not (goal messagestatus msg-NULL))
	(goal scn-detected YES)
=>
	(set-goal messagestatus msg-NULL)
)




(defrule
	(goal messagestatus msg-BUSYTECHING)
	=> 
	(chat-to-player every-ally "Commander, I am reserving my forces for the next Tech Level's upgrades.")
	(chat-to-player every-ally "If you really want me to attack, send Taunt 31 again.")
	(chat-to-player every-ally "224 I really would rather not.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-NOMILITARY)
	=> 
	(chat-to-player every-ally "Commander, I have no forces to attack with!") 
	(chat-to-player every-ally "168 I think we have a problem.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-MAXPOP)
	=> 
	(chat-to-player every-ally "Commander, I have an army ready: I await your signal with Taunt 31.")
	(chat-to-player every-ally "202 I was beginning to wonder if you'd got my message.")
	(set-goal messagestatus msg-NULL)
)



; -----------------------------------------------------
; *** Chapter 2: GENERIC SMACK TALKING *** 
; -----------------------------------------------------
;Waffle Guide: The rest are set to military pop milestones so they can taunt a few times and stop.
;Zel: Accent on the STOP. We do not want this to be a spam xD 

(defrule
	(military-population > 24)
	(goal iamthechosenchatter ITSME)
	(goal scn-detected NO)
	=>
	(set-goal messagestatus msg-MEAN)
	(generate-random-number 9)
	(disable-self)
)

(defrule
	(military-population > 50)
	(goal iamthechosenchatter ITSME)
	(goal scn-detected NO)
	=>
	(set-goal messagestatus msg-MEAN)
	(generate-random-number 9)
	(disable-self)
)

(defrule
	(military-population > 70)
	(goal iamthechosenchatter ITSME)
	(goal scn-detected NO)
	=>
	(set-goal messagestatus msg-MEAN)
	(generate-random-number 9)
	(disable-self)
)

(defrule
	(military-population > 80)
	(goal iamthechosenchatter ITSME)
	(goal scn-detected NO)
	=>
	(set-goal messagestatus msg-MEAN)
	(generate-random-number 9)
	(disable-self)
)

(defrule
	(random-number == 1)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "80 You must realize, you are doomed!")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 2)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "84 Now you will experience the full power of the Dark Side.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 3)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "118 Your situation is hopeless!")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 4)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "165 Don't make me destroy you.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 5)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "248 You and your friends are quite obnoxious.") 
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 6)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "233 Why don't you come out, General?") 
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 7)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "291 Run you cowards!") 
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 8)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "230 Pick up your visual scanning!") 
	(set-goal messagestatus msg-NULL)
)

(defrule
	(random-number == 9)
	(goal messagestatus msg-MEAN)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "271 This is not going to go the way you think.") 
	(set-goal messagestatus msg-NULL)
)



