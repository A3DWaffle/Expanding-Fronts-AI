; -----------------------------------------------------
; *** Chapter 2-1: CIV SMACK TALKING *** 
; -----------------------------------------------------

; was chapter 1, but got moved to 6-2 and is now chapter 2b I think? as to prevent doublefiring messagestatus is then eaten up and set to msg-NULL
; however this ofc needs to happen AFTER the other attacking messages ("I'm going on the assault!") are sent

; this HAS to be the one that sets to null or otherwise it's possible for two to fire at once

; rule to shut mountie attacks up
(defrule
	(goal messagestatus msg-ATTACKING)
	(current-age == tech-level-1)
	=>
	(set-goal messagestatus msg-NULL)
)


(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected GUNGANS)
	(current-age >= tech-level-3)
	=>
	(chat-to-player every-enemy "276 You gonna get pasted, outlander!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected GUNGANS)
	(current-age == tech-level-4)
	(cc-players-building-type-count any-enemy BLDG-BARRIER-LINE > 0)
	=>
	(chat-to-player every-enemy "217 Attack the walls!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected REBEL)
	(current-age == tech-level-3)
	=>
	(chat-to-player every-enemy "23 If it moves, blast it!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected REBEL)
	(current-age == tech-level-4)
	=>
	(chat-to-player every-enemy "210 Your overconfidence is your weakness.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected RESISTANCE)
	(current-age == tech-level-2)
	=>
	(chat-to-player every-enemy "272 Are we really doing this?")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(not (current-age == tech-level-4))
	(civ-selected EMPIRE)
	=>
	(chat-to-player every-enemy "21 Your base. Surrender it to me, or die!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(current-age == tech-level-4)
	(civ-selected EMPIRE)
	=>
	(chat-to-player every-enemy "8 I have you now!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected IMPERIALREMNANT)
	(research-completed rt-advparticlecannon)
	=>
	(chat-to-player every-enemy "84 Now you will experience the full power of the Dark Side!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(or
		(civ-selected IMPERIALREMNANT)
		(and
			(or
				(civ-selected EMPIRE)
				(civ-selected FIRSTORDER)
			)
			(unit-type-count UNIT-MECH3-LINE > 0) ; only if Assault is in play
		)
	)
	(goal scn-detected NO)
	=>
	(chat-to-player every-enemy "245 On my signal, unleash hell.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)


(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected CONFEDERACY)
	(research-completed rt-droidupg)
	=>
	(chat-to-player every-enemy "80 You must realise, you are doomed!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected FEDERATION)
	=>
	(chat-to-player every-enemy "181 This is going to hurt.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected REPUBLIC)
	(not (current-age == tech-level-4))
	=>
	(chat-to-player every-enemy "139 Here's where the fun begins!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected REPUBLIC)
	(current-age == tech-level-4)
	=>
	(chat-to-player every-enemy "192 Surrender, you should!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected REPUBLIC)
	(current-age == tech-level-4)
	(research-completed rt-gunship-lasers)
	=>
	(chat-to-player every-enemy "209 Things are about to get bloody.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected ZANN)
	=>
	(chat-to-player every-enemy "142 No bounties on you. A shame.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected WOOKIEES)
	=>
	(chat-to-player every-enemy "51 Let the Wookiee win!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)


(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(or
		(civ-selected REBEL)
		(or
			(civ-selected WOOKIEES)
			(or
				(civ-selected NEWREPUBLIC)
				(civ-selected RESISTANCE)
			)
		)
	)
	=>
	(chat-to-player every-enemy "78 I'm sure this trouble must be your fault.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected WOOKIEES)
	(research-completed rt-self-regeneration)
	=>
	(chat-to-player every-enemy "57 Wookiee Roar")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected FIRSTORDER)
	=>
	(chat-to-player every-enemy "287 I'll show you the Dark Side.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected FIRSTORDER)
	(research-completed rt-stimpacks)
	(research-completed rt-indoctrination)
	=>
	(chat-to-player every-enemy "257 You can't be so stupid as to think this would be easy.")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected NEWREPUBLIC)
	(current-age >= tech-level-3)
	=>
	(chat-to-player every-enemy "232 You think you can take me?")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected BLACKSUN)
	=>
	(chat-to-player every-enemy "103 I don't like you either!")
	(set-goal messagestatus msg-NULL)
	(disable-self)
)

(defrule
	(goal messagestatus msg-ATTACKING)
	(goal scn-detected NO)
	(civ-selected NABOO)
	=>
	(chat-to-player every-enemy "219 Meet the bigger fish.")
