; *** Chapter 10: RESIGN EXCUSE *** 
; -----------------------------------------------------



(defrule 
	(goal messagestatus msg-RESIGN-EXCUSE)
=>
	(generate-random-number 7)
)

(defrule 
	(goal messagestatus msg-RESIGN-EXCUSE)
	(random-number == 1)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE-GENERIC)
)

(defrule 
	(goal messagestatus msg-RESIGN-EXCUSE)
	(random-number == 2)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE-BADAI)
)

(defrule 
	(goal messagestatus msg-RESIGN-EXCUSE)
	(random-number == 3)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE-JOKE)
)

(defrule 
	(goal messagestatus msg-RESIGN-EXCUSE)
	(random-number == 4)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
)

(defrule 
	(goal messagestatus msg-RESIGN-EXCUSE)
	(random-number == 5)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE-CLASSIC)
)

(defrule 
	(goal messagestatus msg-RESIGN-EXCUSE)
	(or
		(random-number == 6) ; Double chance of this one firing
		(random-number == 7)
	)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE-CIVSPECIFIC) 
)


; -----------------------------------------------------
; Sub-Chapter: Technical
; Zel: I'll handle the technical section as it requires linking to misc bits of script and other oddballs. (It's in the resign file)
; Let me know if you have any other ideas!

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason HOLOFAIL)
=>
	(chat-to-all "I wasn't able to collect any Holocrons.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason TECHLEVELFAIL)
=>
	(chat-to-all "I couldn't get to the next Tech Level in time.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason AIRFAIL)
=>
	(chat-to-all "Your control of the air was absolute.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason WATERFAIL)
=>
	(chat-to-all "Your control of the water couldn't be stopped.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason TRAWLERFAIL)
=>
	(chat-to-all "I didn't defend my Utility Trawlers.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason TRADEFAIL)
=>
	(chat-to-all "I couldn't trade with my own Spaceports.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason STEALTHFAIL)
=>
	(chat-to-all "My stealth units were revealed immediately.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason WALLBUILDFAIL)
=>
	(chat-to-all "I lost all my Workers trying to build my walls.")
	(set-goal messagestatus msg-NULL)
)

(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
	(goal resignreason WALLCHOPFAIL)
=>
	(chat-to-all "My Carbon gatherers chopped a hole in my walls.")
	(set-goal messagestatus msg-NULL)
)

; failsafe for if no resignreason was picked and messagestatus is still not cleared
(defrule
	(goal messagestatus msg-RESIGN-EXCUSE-TECHNICAL)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE-CIVSPECIFIC) ; fallback
)



