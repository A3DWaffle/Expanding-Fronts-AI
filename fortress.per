; T4 train
; Black Sun only rolls TROOP or TROOP/HW. Pure TROOP leans on Gladiators as
; its heavy piece; TROOP/HW already has artillery, so Gladiators stay restrained.
(defrule
	(current-age == tech-level-4)
	(goal special-map LAND)
	(goal fortress-uu-core-ready YES)
	(military-population >= MIL_POP_A)
	(goal importantT4research DONE)
	(goal combat-arm TROOP)
	(unit-type-count-total UNIT-LASER-LINE >= TL4-trooper-arm-p4)
	(unit-type-count-total UNIT-GLADIATORDROID1-LINE < TL4-unique-supp)
	(can-train UNIT-GLADIATORDROID1-LINE)
	=>
	(train UNIT-GLADIATORDROID1-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map LAND)
	(goal fortress-uu-core-ready YES)
	(military-population >= MIL_POP_A)
	(goal importantT4research DONE)
	(goal combat-arm TROOP/HW)
	(unit-type-count-total UNIT-LASER-LINE >= TL4-trooper-arm-p4)
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p4)
	(unit-type-count-total UNIT-GLADIATORDROID1-LINE < TL4-unique-unit-arm-p1)
	(can-train UNIT-GLADIATORDROID1-LINE)
	=>
	(train UNIT-GLADIATORDROID1-LINE)
)

