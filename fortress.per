; UU upgrade
(defrule
    (current-age >= tech-level-4)
	(goal importantT4research DONE)
	(goal fortress-uu-core-ready YES)
	(military-population >= MIL_POP_A)
    (can-research-with-escrow ut-gladiatordroid)
=>
    (release-escrow carbon)
    (release-escrow nova)
	(release-escrow metal)
    (research ut-gladiatordroid)
)
#end-if
