	(goal importantT3research DONE)
	(current-age-time > 480)
	(goal openingstyle STYLE-RUSH)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(unit-type-count-total UNIT-GLADIATORDROID1-LINE < TL3-unique-unit-arm-water)
    (can-train UNIT-GLADIATORDROID1-LINE)
=>
    (train UNIT-GLADIATORDROID1-LINE)
)

