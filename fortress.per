; *** Chapter 2: FORTRESS TECHS ***
; =====================================================

(defrule
	; Galactic Senate Hub
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-research-with-escrow rt-galsenhb)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-galsenhb)
)

(defrule
	; Presidium
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-research-with-escrow rt-presidium)
	(goal importantT4research DONE)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-presidium)
)

(defrule
	; RP Air Cruiser Boost
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-cruboost)
	(goal importantT4research DONE)
	(unit-type-count-total UNIT-AIR-CRUISER > 0)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-cruboost)
)

(defrule
	; RS Resilience
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-resilience)
	(goal importantT4research DONE)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-resilience)
)

(defrule
	; BS Huntress Training
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-huntresstrain)
	(goal importantT4research DONE)
	(goal support-uu YES)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-huntresstrain)
)

(defrule
	; BS Huntress Mastery
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-huntressmastery)
	(goal importantT4research DONE)
	(goal support-uu YES)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-huntressmastery)
)

(defrule
	; NR Scramjets
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-scramjets)
	(goal importantT4research DONE)
	(or
		(goal support-aircraft YES)
		(or
			(goal support-aircraft YES)
			(goal support-uu YES)
		)
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-scramjets)
)

(defrule
	; RN Battle Armor
	(can-research-with-escrow rt-battle-armor)
	(goal importantT4research DONE)
	(or
		(goal support-uu YES)
		(unit-type-count-total UNIT-BOUNTY > 0)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-battle-armor)
)

(defrule
	; RN Taxation
	(can-research-with-escrow rt-taxation)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-taxation)
)

(defrule
	; WK Berserker Jet Packs
	(can-research-with-escrow rt-jetpacks)
	(goal importantT4research DONE)
	(goal support-uu YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-jetpacks)
)

