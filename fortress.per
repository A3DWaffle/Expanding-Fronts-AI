; *** Chapter 3: UNIQUE UNITS ***
; =====================================================

#load-if-defined REBEL

; T3 train
(defrule
	(current-age == tech-level-3)
	(current-age-time > 180)
	(goal special-map LAND)
	(not (goal openingstyle STYLE-DEFENSIVE))
    (unit-type-count-total UNIT-AIRSPEEDER-LINE < TL3-unique-unit-arm-p1)
    (can-train UNIT-AIRSPEEDER-LINE)
=>
    (train UNIT-AIRSPEEDER-LINE)
)

; T3 P2+ waits for important T3 research
(defrule
	(current-age == tech-level-3)
	(goal special-map LAND)
	(goal importantT3research DONE)
	(current-age-time > 300)
	(goal openingstyle STYLE-RUSH)
	(not (goal openingstyle STYLE-DEFENSIVE))
    (unit-type-count-total UNIT-AIRSPEEDER-LINE < TL3-unique-unit-arm)
    (can-train UNIT-AIRSPEEDER-LINE)
=>
    (train UNIT-AIRSPEEDER-LINE)
)

; T3 train with water
(defrule
	(current-age == tech-level-3)
	(current-age-time > 180)
	(goal special-map WATER)
	(not (goal openingstyle STYLE-DEFENSIVE))
    (unit-type-count-total UNIT-AIRSPEEDER-LINE < TL3-unique-unit-arm-p1-water)
    (can-train UNIT-AIRSPEEDER-LINE)
=>
    (train UNIT-AIRSPEEDER-LINE)
)

