; =====================================================
; *** Chapter 2: FORTRESS TECHS ***
; =====================================================

(defrule
	; Galactic Senate Hub
	(can-research-with-escrow rt-galsenhb)
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-galsenhb)
)

(defrule
	; Presidium
	(can-research-with-escrow rt-presidium)
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(military-population >= MIL_POP_B)
	(or
		(research-completed rt-galsenhb)
		(not (research-available rt-galsenhb))
	)
	(research-completed rt-automated-processes)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-presidium)
)

(defrule
	; RP Air Cruiser Boost
	(can-research-with-escrow rt-cruboost)
	(current-age >= tech-level-4)
	(unit-type-count-total UNIT-AIRCRUISER-LINE >= TL4-air-cruiser-arm-p1)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-cruboost)
)

(defrule
	; RS Resilience
	(can-research-with-escrow rt-resilience)
	(current-age >= tech-level-4)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-resilience)
)

(defrule
	; BS Huntress Training
	(can-research-with-escrow rt-huntresstrain)
	(current-age >= tech-level-4)
	(unit-type-count UU-JEDIALT-LINE >= unique-hunter-supp)
	(goal support-uu YES)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-huntresstrain)
)

(defrule
	; BS Huntress Mastery
	(can-research-with-escrow rt-huntressmastery)
	(current-age >= tech-level-4)
	(unit-type-count UU-JEDIALT-LINE >= unique-hunter-supp)
	(research-completed rt-automated-processes)
	(goal support-uu YES)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-huntressmastery)
)

(defrule
	; NR Scramjets
	(can-research-with-escrow ut-scramjets)
	(current-age >= tech-level-4)
	(unit-type-count-total UNIT-VWING-LINE >= TL4-unique-unit-arm-p1)
	(research-completed rt-automated-processes)
	(goal support-uu YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-scramjets)
)

(defrule
	; RN Battle Armor
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-battle-armor)
	(research-completed rt-taxation)
	(research-completed rt-automated-processes)
	(or
		(unit-type-count-total UNIT-BOUNTY >= TL4-bounty-detect-p1)
		(goal support-uu YES)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-battle-armor)
)

(defrule
	; RN Taxation
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-taxation)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-taxation)
)

