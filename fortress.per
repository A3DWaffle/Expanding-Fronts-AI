; Special escrow cannons. These are once-off catchup, but they still obey
; the same package cores as normal cannon production.

; --- Escrow cannon p1 ---
(defrule
	(current-age == tech-level-4)
	(goal special-map LAND)
	(goal combat-arm TROOP)
	(unit-type-count-total UNIT-LASER-LINE >= TL4-trooper-arm-p1)
	(unit-type-count-total UNIT-GRENADE-LINE >= TL4-grenade-arm-p1)
	(unit-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm-p1)
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
