; T3 P2+ waits for important T3 research
(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(goal importantT3research DONE)
	(current-age-time > 300)
	(goal openingstyle STYLE-RUSH)
	(not (goal openingstyle STYLE-DEFENSIVE))
    (unit-type-count-total UNIT-AIRSPEEDER-LINE < TL3-unique-unit-arm-hybrid)
    (can-train UNIT-AIRSPEEDER-LINE)
=>
    (train UNIT-AIRSPEEDER-LINE)
)

; T4 train
(defrule
	(current-age == tech-level-4)
	(goal special-map LAND)
	(goal fortress-uu-core-ready YES)
	(military-population >= MIL_POP_A)
	(or
		(and
			(goal support-uu YES)
			(or
				(and
					(military-population < MIL_POP_B)
					(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-supp-p1)
				)
				(and
					(military-population >= MIL_POP_B)
					(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-supp)
				)
			)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-unit-arm-p1)
		)
	)
	(can-train UNIT-AIRSPEEDER-LINE)
=>
	(train UNIT-AIRSPEEDER-LINE)
)

; T4 train with water
(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal fortress-uu-core-ready YES)
	(military-population >= MIL_POP_A)
	(or
		(and
			(goal support-uu YES)
			(or
				(and
					(military-population < MIL_POP_B)
					(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-supp-p1-water)
				)
				(and
					(military-population >= MIL_POP_B)
					(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-supp-water)
				)
			)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-unit-arm-p1-water)
		)
	)
	(can-train UNIT-AIRSPEEDER-LINE)
=>
	(train UNIT-AIRSPEEDER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map ASTEROID)
	(goal fortress-uu-core-ready YES)
	(military-population >= MIL_POP_A)
	(or
		(and
			(goal support-uu YES)
			(or
				(and
					(military-population < MIL_POP_B)
