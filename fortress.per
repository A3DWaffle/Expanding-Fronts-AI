#load-if-defined EMPIRE

(defrule
	(goal bounty-priority NO)
	(can-train UNIT-DARKTRP-LINE)
	(current-age == tech-level-3)
	(current-age-time > 180)
	(goal support-uu YES)
	(or
		(and
			(goal special-map LAND)
			(unit-type-count-total UNIT-DARKTRP-LINE < TL3-unique-unit-arm-p1)
		)
