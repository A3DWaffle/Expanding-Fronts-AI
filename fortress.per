; =====================================================
; FILE: fortress
; PURPOSE:
;   Builds fortresses, defenses, Fortress units, and Fortress-owned techs.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: FORTRESS UNITS
;	Chapter 2: FORTRESS TECHS
;	Chapter 3: UNIQUE UNITS
;	Chapter 4: DEFENSE BUILDINGS
;	Chapter 5: CIV TECH CATCHUP
;	Chapter 6: AA BATTERIES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(building-type-count-total BLDG-GOVTCTR < 1)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-MISSILE-LINE > 2)
	(building-type-count-total BLDG-GOVTCTR < 3)
	(building-type-count-total BLDG-MAIN >= 3)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(build BLDG-GOVTCTR)
)

; --- Bounty Hunter production priority ---
; A published nonzero estimate permits replenishment up to the existing target.
; Reserve Fortress production while below target; release it when satisfied.
; The next delayed NONE estimate ends the response; no extra intelligence polls.
(defrule
	(true)
=>
	(set-goal bounty-priority NO)
)

(defrule
	(goal bounty-window YES)
	(building-type-count BLDG-GOVTCTR > 0)
	(current-age == tech-level-3)
	(goal enemyjedisighted JEDI-ALERT-P1)
	(unit-type-count-total UNIT-BOUNTY < TL3-bounty-detect-p1)
=>
	(set-goal bounty-priority YES)
)

(defrule
	(goal bounty-window YES)
	(building-type-count BLDG-GOVTCTR > 0)
	(current-age == tech-level-3)
	(or
		(goal enemyjedisighted JEDI-ALERT-P2)
		(or
			(goal enemyjedisighted JEDI-ALERT-P3)
			(goal enemyjedisighted JEDI-ALERT-P4)
		)
	)
	(unit-type-count-total UNIT-BOUNTY < TL3-bounty-detect-p2)
=>
	(set-goal bounty-priority YES)
)

(defrule
	(goal bounty-window YES)
	(building-type-count BLDG-GOVTCTR > 0)
	(current-age == tech-level-4)
	(goal enemyjedisighted JEDI-ALERT-P1)
	(unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect-p1)
=>
	(set-goal bounty-priority YES)
)

(defrule
	(goal bounty-window YES)
	(building-type-count BLDG-GOVTCTR > 0)
	(current-age == tech-level-4)
	(goal enemyjedisighted JEDI-ALERT-P2)
	(unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect-p2)
=>
	(set-goal bounty-priority YES)
)

(defrule
	(goal bounty-window YES)
	(building-type-count BLDG-GOVTCTR > 0)
	(current-age == tech-level-4)
	(goal enemyjedisighted JEDI-ALERT-P3)
	(unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect-p3)
=>
	(set-goal bounty-priority YES)
)

(defrule
	(goal bounty-window YES)
	(building-type-count BLDG-GOVTCTR > 0)
	(current-age == tech-level-4)
	(goal enemyjedisighted JEDI-ALERT-P4)
	(unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect-p4)
=>
	(set-goal bounty-priority YES)
)

; --- Bounty hunters ---
(defrule
	(goal bounty-window YES)
	(current-age == tech-level-3)
	(goal enemyjedisighted JEDI-ALERT-P1)
	(unit-type-count-total UNIT-BOUNTY < TL3-bounty-detect-p1)
	(can-train-with-escrow UNIT-BOUNTY)
	=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-BOUNTY)
	(set-goal bounty-priority NO)
)

(defrule
	(goal bounty-window YES)
	(current-age == tech-level-3)
	(or
		(goal enemyjedisighted JEDI-ALERT-P2)
		(or
			(goal enemyjedisighted JEDI-ALERT-P3)
			(goal enemyjedisighted JEDI-ALERT-P4)
		)
	)
	(unit-type-count-total UNIT-BOUNTY < TL3-bounty-detect-p2)
	(can-train-with-escrow UNIT-BOUNTY)
	=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-BOUNTY)
	(set-goal bounty-priority NO)
)

(defrule
	(goal bounty-window YES)
	(current-age == tech-level-4)
	(goal enemyjedisighted JEDI-ALERT-P1)
	(unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect-p1)
