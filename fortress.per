	(current-age == tech-level-3)
	(current-age-time > 180)
	(goal special-map ASTEROID)
	(not (goal openingstyle STYLE-DEFENSIVE))
    (unit-type-count-total UNIT-AIRSPEEDER-LINE < TL3-unique-unit-arm-p1-asteroid)
