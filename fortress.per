	=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-BOUNTY)
	(set-goal bounty-priority NO)
)

(defrule
	(goal bounty-window YES)
	(current-age == tech-level-4)
	(goal enemyjedisighted JEDI-ALERT-P2)
