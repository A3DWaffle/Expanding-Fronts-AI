; =====================================================
; FILE: fortress
; PURPOSE:
;   Builds fortresses, defenses, Fortress units, and Fortress-owned techs.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: FORTRESS UNITS
;	Chapter 2: FORTRESS TECHS
;	Chapter 3: UNIQUE UNITS
;	Chapter 4: DEFENSE BUILDINGS
;	Chapter 5: CIV TECH CATCHUP
;	Chapter 6: AA BATTERIES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(building-type-count-total BLDG-GOVTCTR < 1)
	(or
		(not (goal openingstyle STYLE-DEFENSIVE))
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-MISSILE-LINE > 2)
	(building-type-count-total BLDG-GOVTCTR < 2)
	(building-type-count-total BLDG-MAIN > 1)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
=>
	(build BLDG-GOVTCTR)
)

; Keep the standard fortress shell capped at two.
(defrule
	(building-type-count-total BLDG-MISSILE-LINE > 4) ; not exact numbers, but should do it
	(building-type-count-total BLDG-TURRET-LINE > 2)
	(building-type-count-total BLDG-GOVTCTR < 2)
	(can-build BLDG-GOVTCTR)
	(not (goal buildpause YES))
=>
	(build BLDG-GOVTCTR)
)


; =====================================================
; *** Chapter 1: FORTRESS UNITS ***
; =====================================================

; --- Air cruiser ---

(defrule
	(current-age >= tech-level-4)
	(goal special-map LAND)
	(or
		(goal support-aircraft YES)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p4)
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p1)
	(unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm)
	(can-train UNIT-AIR-CRUISER)
	=>
	(train UNIT-AIR-CRUISER)
)

(defrule
	(current-age >= tech-level-4)
	(goal special-map WATER)
	(or
		(goal support-aircraft YES)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p4)
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p1)
	(unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm-water)
	(can-train UNIT-AIR-CRUISER)
	=>
	(train UNIT-AIR-CRUISER)
)

(defrule
	(current-age >= tech-level-4)
	(goal special-map ASTEROID)
	(or
		(goal support-aircraft YES)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p4)
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p1)
	(unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm-asteroid)
	(can-train UNIT-AIR-CRUISER)
	=>
	(train UNIT-AIR-CRUISER)
)

(defrule
	(current-age >= tech-level-4)
	(goal special-map HYBRID)
	(or
		(goal support-aircraft YES)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p4)
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p1)
	(unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm-hybrid)
	(can-train UNIT-AIR-CRUISER)
	=>
	(train UNIT-AIR-CRUISER)
)

