	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal combat-arm AIR)
	(unit-type-count-total UNIT-MOUNTED-LINE >= TL4-mounted-supp-p3-water)
	(or
		(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p3)
		(goal t4-air-core-p3-ready YES)
	)
	(unit-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm-p3-water)
	(can-train SIEGE-CANNON-LINE)
	(goal raid-cannon-cooldown 0)
=>
	(train SIEGE-CANNON-LINE)
	(set-goal raid-cannon-cooldown 13)
)

