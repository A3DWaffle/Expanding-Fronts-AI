	(timer-triggered t-raid-memory)
	(goal raid-attack-memory 4)
=>
	(set-goal raid-attack-memory 3)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-attack-memory 5)
=>
	(set-goal raid-attack-memory 4)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-attack-memory 6)
=>
	(set-goal raid-attack-memory 5)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-worker-memory 1)
=>
	(set-goal raid-worker-memory 0)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-worker-memory 2)
=>
	(set-goal raid-worker-memory 1)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-worker-memory 3)
=>
	(set-goal raid-worker-memory 2)
)







(defrule
	(timer-triggered t-raid-memory)
	(goal raid-cooldown 1)
