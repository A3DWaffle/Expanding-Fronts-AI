; =====================================================
; FILE: init-goals
; PURPOSE:
;   Initializes small shared goals expected by the current load chain.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: LOGIC
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal tryingtobuild NULL)
	(set-goal get-mad NO)

	(disable-self)
)


; initial sn's that probably shouldn't be touched later

(defrule
	(true)
=>
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1) ; disable difficulty adjusting sn automatically
	(set-strategic-number sn-scale-minimum-attack-group-size 0) ; attack group scaling issues
	(disable-self)
)


