; =====================================================
; FILE: init-goals
; PURPOSE:
;   Initializes small shared goals expected by the current load chain.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: STRATEGIC NUMBERS
;	Chapter 2: MIXED AIR CORE READINESS
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal tryingtobuild NULL)
	(set-goal get-mad NO)
	(set-goal buildpause NO)
	(set-goal t4-laser-ready NO)
	(set-goal t4-heavy-armor-ready NO)
	(set-goal t4-homing-ready NO)
	(set-goal t4-heavy-plating-ready NO)
	(set-goal t4-targeting-ready NO)
	(set-goal t4-artillery-ready NO)

	(disable-self)
)


; =====================================================
; *** Chapter 1: STRATEGIC NUMBERS ***
; =====================================================

(defrule
	(true)
=>
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1)
	(set-strategic-number sn-scale-minimum-attack-group-size 0)
	(disable-self)
)

; =====================================================
; *** Chapter 2: MIXED AIR CORE READINESS ***
; =====================================================
; This file loads after military-population and military-population-hard.
; Keep package-dependent rules here: constants.per loads before those targets.

; Recompute mixed-core support readiness before production modules run.
; Targets count existing plus queued units, matching the old Attacker prerequisites.
; Normal AIR: Fighters p2 / Attackers p4. P1: p3/p3. P2: p4/p2.
(defrule
	(true)
=>
	(set-goal t4-air-core-p3-ready NO)
	(set-goal t4-air-core-p4-ready NO)
)

(defrule
	(current-age == tech-level-4)
	(goal combat-arm AIR)
	(goal support-aircraft YES)
	(not (goal enemytroopersighted TROOPER-ALERT-NONE))
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p3)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p2)
=>
	(set-goal t4-air-core-p3-ready YES)
)

(defrule
	(current-age == tech-level-4)
	(goal combat-arm AIR)
	(goal support-aircraft YES)
	(goal enemytroopersighted TROOPER-ALERT-P1)
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p3)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p3)
=>
	(set-goal t4-air-core-p4-ready YES)
)

(defrule
	(current-age == tech-level-4)
	(goal combat-arm AIR)
	(goal support-aircraft YES)
	(goal enemytroopersighted TROOPER-ALERT-P2)
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p4)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p2)
=>
	(set-goal t4-air-core-p4-ready YES)
)


; RAID EXPERIMENT: early policies and independent memory heartbeat.
; RAID: initialize
(defrule
	(true)
=>
	(set-goal raid-attack-memory 0)
	(set-goal raid-worker-memory 0)
	(set-goal raid-phase 0)
	(set-goal raid-launch-open 0)
	(set-goal raid-build-open 0)
	(set-goal raid-defensive-roll 0)
	(disable-self)
)

; RAID: initialize
(defrule
	(true)
=>
	(set-goal raid-ever-attacked 0)
	(set-goal raid-signal-last 0)
	(set-goal raid-worker-last 0)
	(set-goal raid-builder-mode 0)
	(set-goal raid-diagnostic-pause 0)
	(set-goal raid-turret-progress 0)
	(set-goal raid-cooldown 0)
	(set-goal raid-turret-query 0)
	(set-goal raid-worker-query 0)
	(disable-self)
)

(defrule
	(true)
=>
	(enable-timer t-raid-memory 5)
	(do-nothing) ; RAID diagnostics disabled
	(disable-self)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-attack-memory 1)
=>
	(set-goal raid-attack-memory 0)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-attack-memory 2)
=>
	(set-goal raid-attack-memory 1)
)

