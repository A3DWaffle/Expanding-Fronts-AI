; Raid lifecycle counters share the heartbeat and never claim a new timer.
(defrule
	(true)
=>
	(set-goal raid-empty-ticks 0)
	(set-goal raid-recall-timeout 0)
	(disable-self)
)

(defrule
	(attack-soldier-count > 0)
=>
	(set-goal raid-empty-ticks 0)
)

; Descending increments prevent two empty ticks from cascading in one scan.
(defrule
	(timer-triggered t-raid-memory)
	(current-age == tech-level-1)
	(goal raid-phase 1)
	(attack-soldier-count == 0)
	(goal raid-empty-ticks 1)
=>
	(set-goal raid-empty-ticks 2)
)

(defrule
	(timer-triggered t-raid-memory)
	(current-age == tech-level-1)
	(goal raid-phase 1)
	(attack-soldier-count == 0)
	(goal raid-empty-ticks 0)
=>
	(set-goal raid-empty-ticks 1)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 1)
=>
	(set-goal raid-recall-timeout 0)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 2)
=>
	(set-goal raid-recall-timeout 1)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 3)
=>
	(set-goal raid-recall-timeout 2)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 4)
=>
	(set-goal raid-recall-timeout 3)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 5)
=>
	(set-goal raid-recall-timeout 4)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 6)
=>
	(set-goal raid-recall-timeout 5)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 7)
=>
	(set-goal raid-recall-timeout 6)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 8)
=>
	(set-goal raid-recall-timeout 7)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 9)
=>
	(set-goal raid-recall-timeout 8)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 10)
=>
	(set-goal raid-recall-timeout 9)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 11)
=>
	(set-goal raid-recall-timeout 10)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 12)
=>
	(set-goal raid-recall-timeout 11)
)

(defrule
	(timer-triggered t-raid-memory)
	(goal raid-recall-timeout 13)
=>
	(set-goal raid-recall-timeout 12)
)

(defrule
	(timer-triggered t-raid-memory)
=>
	(disable-timer t-raid-memory)
	(enable-timer t-raid-memory 5)
)

(defrule
	(town-under-attack)
=>
	(set-goal raid-attack-memory 6)
	(set-goal raid-ever-attacked YES)
)

(defrule
	(players-unit-type-count any-enemy UNIT-WORKER > 0)
=>
	(set-goal raid-worker-memory 3)
)

(defrule
	(town-under-attack)
	(not (goal raid-signal-last YES))
=>
	(set-goal raid-signal-last YES)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(not (town-under-attack))
	(not (goal raid-signal-last NO))
=>
	(set-goal raid-signal-last NO)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(players-unit-type-count any-enemy UNIT-WORKER > 0)
	(not (goal raid-worker-last YES))
=>
	(set-goal raid-worker-last YES)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(not (players-unit-type-count any-enemy UNIT-WORKER > 0))
	(not (goal raid-worker-last NO))
=>
	(set-goal raid-worker-last NO)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(players-unit-type-count any-enemy UNIT-WORKER < 0)
	(goal raid-worker-query NO)
=>
	(do-nothing) ; RAID diagnostics disabled
	(set-goal raid-worker-query YES)
)

; Release an ended raid after two empty heartbeat samples, before gate vetoes.
(defrule
	(current-age == tech-level-1)
	(goal raid-phase 1)
	(attack-soldier-count == 0)
	(goal raid-empty-ticks 2)
=>
	(set-goal raid-phase 0)
	(set-goal raid-empty-ticks 0)
	(set-strategic-number sn-number-attack-groups 1)
)

; Raid phases belong to TL1; neither may strand scouting after age-up.
(defrule
	(current-age >= tech-level-2)
	(or (goal raid-phase 1) (goal raid-phase 2))
=>
	(set-goal raid-phase 0)
	(set-goal raid-empty-ticks 0)
	(set-goal raid-recall-timeout 0)
	(set-strategic-number sn-number-attack-groups 1)
)

; Recall recovery exits before the gate reset so permission updates this scan.
(defrule
	(current-age == tech-level-1)
	(goal raid-phase 2)
	(goal raid-cooldown 0)
	(or
		(attack-soldier-count == 0)
		(goal raid-recall-timeout 0)
	)
=>
	(set-goal raid-phase 0)
	(set-strategic-number sn-number-attack-groups 1)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(true)
=>
	(set-goal raid-scout-open YES)
	(set-goal raid-build-open YES)
	(set-goal raid-launch-open YES)
)

(defrule
	(not (goal raid-attack-memory 0))
=>
	(set-goal raid-scout-open NO)
)

(defrule
	(attack-soldier-count > 0)
=>
	(set-goal raid-scout-open NO)
)

(defrule
	(attack-air-count > 0)
=>
	(set-goal raid-scout-open NO)
)

(defrule
	(attack-warboat-count > 0)
=>
	(set-goal raid-scout-open NO)
)

(defrule
	(goal raid-phase 1)
=>
	(set-goal raid-scout-open NO)
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
=>
	(set-goal raid-scout-open NO)
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count BLDG-TURRET-LINE < 3)
=>
	(set-goal raid-build-open NO)
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
=>
	(set-goal raid-launch-open NO)
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-AGGRESSIVE)
	(goal raid-ever-attacked NO)
=>
	(set-goal raid-launch-open NO)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(not (goal raid-defensive-roll 2))
=>
	(set-goal raid-launch-open NO)
)

(defrule
	(current-age == tech-level-1)
	(not (goal raid-cooldown 0))
=>
	(set-goal raid-launch-open NO)
)

(defrule
	(current-age == tech-level-1)
	(not (goal raid-attack-memory 0))
	(goal raid-worker-memory 0)
=>
	(set-goal raid-launch-open NO)
)

; Recall an active TL1 raid after damage memory when worker memory is empty.
(defrule
	(current-age == tech-level-1)
	(goal raid-phase 1)
	(not (goal raid-attack-memory 0))
	(goal raid-worker-memory 0)
=>
	(set-goal raid-phase 2)
	(set-goal raid-cooldown 6)
	(set-goal raid-recall-timeout 13)
	(set-goal aready NO)
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-strategic-number sn-gather-defense-units 1)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-1)
	(goal raid-phase 2)
=>
	(set-goal raid-launch-open NO)
)

; Recall recovery exit runs above the gate reset.

; Age-up phase cleanup runs above the gate reset.

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(goal raid-build-open NO)
=>
	(set-builders-type 79 8)
	(set-builders-type 234 8)
	(set-builders-type 235 8)
	(set-builders-type 3599 8)
	(set-builders-type 3600 8)
	(set-builders-type 3601 8)
	(set-builders-type 7088 8)
)

