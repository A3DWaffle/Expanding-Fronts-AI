; =====================================================
; FILE: randomgame
; PURPOSE:
;   Main random-map loader for the Computer Prototype AI.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: NORMAL OPERATION
;	Chapter 2: SPECIAL MODES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(chat-to-player every-computer "147") ; for CE cheat detection. You can stay in one more patch, as a treat
	(disable-self)
)

; ALWAYS LOAD:

(load "/Computer Prototype/constants")				; main file
(load "/Computer Prototype/population")     		; old eco numbers
(load "/Computer Prototype/military-population")	; easy/easiest package constants
(load "/Computer Prototype/military-population-hard") ; unit numbers
(load "/Computer Prototype/map-loads") 				; map detection, including asteroid and fish checks
(load "/Computer Prototype/building-count")   		; CC amount and some build logic

; NORMAL OPERATION
;     Deathmatch now part of random map
;     Monuments not built due to AI issues

#load-if-not-defined DEFEND-MONUMENT
#load-if-not-defined MONUMENT-RACE

; INITIAL SETUP

(load "/Computer Prototype/escrow")					; escrow & eco logic
(load "/Computer Prototype/init-goals")				; almost empty file

(load "/Computer Prototype/sn-homebase")			; townsize and a few other sn's
(load "/Computer Prototype/sn-gather")				; economy, includes herdable logic
(load "/Computer Prototype/sn-soldiers")			; scouting and difficulty logic
(load "/Computer Prototype/combat-arm")				; core/supp package roll used by modern unit production files

; MAIN STUFF

(load "/Computer Prototype/age-advancement")		; age up & config

(load "/Computer Prototype/attack")                 ; attack script
(load-random
	33 "/Computer Prototype/agressive"
	33 "/Computer Prototype/defensive"
	"/Computer Prototype/rush"
) ; personality overlay

(load "/Computer Prototype/cheats")					; needs to be loaded before worker production

(load "/Computer Prototype/diplomacy")              ; does very little now, basically just mirrors alliances

(load "/Computer Prototype/homebase")               ; workers, command center, prefab shelters, farms, power cores - load before research so CCs are built when reaching next TL

(load "/Computer Prototype/research")               ; research of everything that isn't a unit upgrade: so Hvy Trooper is in troop center, but MacroBinoculars is here 

; ECONOMY BUILDINGS

(load "/Computer Prototype/spaceport")				; all things trade

(load "/Computer Prototype/food")					; stuff to do with resource procs - economy is in sn gather
(load "/Computer Prototype/carbon")
(load "/Computer Prototype/nova")					; nova & ore in one file
(load "/Computer Prototype/ore")					; empty file

(load "/Computer Prototype/war-center")				; very small files controlling building (using them in research)
(load "/Computer Prototype/research-center")

; MILITARY CONTROLS

(load "/Computer Prototype/troop-center")
(load "/Computer Prototype/shipyard")
    
(load "/Computer Prototype/mech-factory")    
(load "/Computer Prototype/jedi-temple")  

(load "/Computer Prototype/airbase")
(load "/Computer Prototype/fortress")			; now contains all defensive building logic
(load "/Computer Prototype/heavy-weapons")

(load "/Computer Prototype/tower") 					; only contains walls now      
(load "/Computer Prototype/animal")					; garbage animals (predators, probots)
(load "/Computer Prototype/supplement")				; random map trainables

; EF ADDITIONS

(load "/Computer Prototype/fishboat") ;; Zel addition, has nothing to do with fishing, is adv inf cent 
(load "/Computer Prototype/warboat") ;; Zel addition, has nothing to do with warboats, is instead a lategame spam file
(load "/Computer Prototype/warboat-island") ; Zel and Waffle addition, chitchat

; #load-if-not-defined EMPEROR
; (load "/Computer Prototype/monument") ; monuments not built due to engine bug
; #end-if

; #load-if-not-defined DEATH-MATCH ; death match is now part of random map
; #end-if

(load "/Computer Prototype/resign")         

#end-if
#end-if



; SPECIAL MODE 1: MONUMENT RACE
#load-if-defined MONUMENT-RACE

(load "/Computer Prototype/wonder-rush") ; MAIN FILE

(load "/Computer Prototype/attack") ; hee hee hee ho

(load "/Computer Prototype/sn-gather")
(load "/Computer Prototype/sn-soldiers")

(load "/Computer Prototype/spaceport")


#end-if

; SPECIAL MODE 2: DEFEND THE MONUMENT
#load-if-defined DEFEND-MONUMENT

; instead of having all its logic in one file, which essentially caused double logic
; it now calls all logic from the relevant files

(load "/Computer Prototype/init-goals")

(load "/Computer Prototype/homebase")
; (load "/Computer Prototype/sn-homebase") ; alternate town size checks needed

(load "/Computer Prototype/sn-gather")
(load "/Computer Prototype/sn-soldiers")
(load "/Computer Prototype/escrow")

; the ordering of these files - and this rule - is important for build orders
(defrule
	(can-build BLDG-GOVTCTR)
	(building-type-count-total BLDG-GOVTCTR < 5)
=>
	(build BLDG-GOVTCTR)
)

(load "/Computer Prototype/troop-center")
(load "/Computer Prototype/shipyard")       
(load "/Computer Prototype/mech-factory")    
(load "/Computer Prototype/jedi-temple")  
(load "/Computer Prototype/airbase")
(load "/Computer Prototype/heavy-weapons")

(load "/Computer Prototype/carbon")	; carbon moved up due to ordering issues

(load "/Computer Prototype/wonder-kill") ; MAIN FILE FOR DEFEND THE MONUMENT

; (load "/Computer Prototype/war-center") ; not needed as all techs are already researched
; (load "/Computer Prototype/research-center")
(load "/Computer Prototype/spaceport") ; trade, tribute, and more

(load "/Computer Prototype/animal")
(load "/Computer Prototype/supplement")

(load "/Computer Prototype/food") ; carbon loaded earlier
(load "/Computer Prototype/nova")                   
(load "/Computer Prototype/ore")



(load "/Computer Prototype/fishboat") ;; Zel addition, has nothing to do with fishing, is adv inf cent 
(load "/Computer Prototype/warboat") ;; Zel addition, has nothing to do with warboats, is instead a lategame spam file
(load "/Computer Prototype/warboat-island") ; chitchat

(load "/Computer Prototype/cheats")

#end-if
