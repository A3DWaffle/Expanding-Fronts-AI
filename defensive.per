; =====================================================
; FILE: defensive
; PURPOSE:
;   Defensive personality overlay for safer pacing and high attack thresholds.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: LOGIC
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(goal openingstyle UNDEFINED)
=>
	(set-goal openingstyle STYLE-DEFENSIVE)
	(set-goal passiveage NO)
	(disable-self)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(current-age == tech-level-2)
	(current-age-time < 480)
	(not (goal passiveage YES))
=>
	(set-goal passiveage YES)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(goal passiveage YES)
	(current-age-time > 480)
=>
	(set-goal passiveage NO)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(not (current-age == tech-level-2))
	(not (goal passiveage NO))
=>
	(set-goal passiveage NO)
)

(defrule
	(current-age >= tech-level-3)
	(goal openingstyle STYLE-DEFENSIVE)
	(goal attacksonhold-auto YES)
	(military-population >= 18)
=>
	(set-goal attacksonhold-auto NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(current-age == tech-level-2)
	(or
		(goal attacksonhold-auto NO)
		(not (goal rushsize RUSHHALT))
	)
=>
	(set-goal attacksonhold-auto YES)
	(set-goal rushsize RUSHHALT)
)

