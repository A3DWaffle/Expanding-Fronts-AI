; =====================================================
; FILE: escrow
; PURPOSE:
;   Controls escrow settings and release support for the AI economy.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: AGE ESCROW SETTINGS
;	Chapter 2: ESCROW RELEASES
;	Chapter 3: TL4 METAL HANDLING
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; =====================================================
; *** Chapter 1: AGE ESCROW SETTINGS ***
; =====================================================

(defrule
	(current-age == tech-level-1)
	(current-age-time > 600)
=>
	(set-escrow-percentage food 60)
	(set-escrow-percentage carbon 0)
	(set-escrow-percentage nova 0)
	(set-escrow-percentage metal 0)
	(disable-self)
)


(defrule
	(current-age == tech-level-2)
=>
	(set-escrow-percentage food 20)
	(set-escrow-percentage carbon 40)
	(set-escrow-percentage nova 10)
	(set-escrow-percentage metal 0)
	(disable-self)
)

(defrule
	(goal importantT2research DONE)
	(current-age == tech-level-2)
=> 
	(set-escrow-percentage food 30)
	(set-escrow-percentage carbon 30)
	(set-escrow-percentage nova 20)
	(set-escrow-percentage metal 0)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(escrow-amount carbon > 300)
=>
	(release-escrow carbon)
)



(defrule
	(current-age == tech-level-3)
=>
	(set-escrow-percentage food 40)
	(set-escrow-percentage carbon 40)
	(set-escrow-percentage nova 25)
	(set-escrow-percentage metal 0)
	(disable-self)
)

(defrule
	(goal importantT3research DONE)
	(current-age == tech-level-3)
=> 
	(set-escrow-percentage food 40)
	(set-escrow-percentage carbon 30)
	(set-escrow-percentage nova 25)
	(set-escrow-percentage metal 10)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
=>
	(set-escrow-percentage food 40)
	(set-escrow-percentage carbon 70)
	(set-escrow-percentage nova 50)
	(set-escrow-percentage metal 50)
	(disable-self)
)

(defrule
	(goal importantT4research DONE)
=> 
	(set-escrow-percentage food 20) 
	(set-escrow-percentage carbon 33)
	(set-escrow-percentage nova 20)
	(set-escrow-percentage metal 50)
	(disable-self)
)

; =====================================================
; *** Chapter 2: ESCROW RELEASES ***
; =====================================================

; Release large stockpiles so escrow does not stall techs, monuments, or unit production.
; Metal has separate handling below because it is not gathered/trickled the same way.

(defrule
	(escrow-amount food > 1500)
=>
	(release-escrow food)
)
(defrule
	(escrow-amount carbon > 1000)
=>
	(release-escrow carbon)
)
(defrule
	(escrow-amount nova > 1500)
=>
	(release-escrow nova)
)

; If important T4 research is still outstanding, keep food/carbon/nova escrow high.

(defrule
	(current-age == tech-level-4)
	(not (goal importantT4research DONE))
=>
	(set-escrow-percentage food 40)
	(set-escrow-percentage carbon 60)
	(set-escrow-percentage nova 65)
)

; =====================================================
; *** Chapter 3: TL4 METAL HANDLING ***
; =====================================================

; Metal gets special handling because it does not trickle like the other resources.
; Keep enough for major TL4 techs and defensive structures, then release excess.

(defrule
	(escrow-amount metal > 510)
	(current-age == tech-level-4)
=>
	(set-escrow-percentage metal 0)
)

(defrule
	(escrow-amount metal > 1000) 
=>
	(release-escrow metal)
	(set-escrow-percentage metal 50)
)

(defrule
	(escrow-amount metal < 500)
	(current-age == tech-level-4)
=>
	(set-escrow-percentage metal 50)
)
