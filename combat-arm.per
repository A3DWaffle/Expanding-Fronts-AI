#load-if-defined EMPIRE

(defrule
	(goal combat-arm NOTICE)
	(random-number <= 25)
=>
	(set-goal combat-arm TROOP)
	(set-goal support-masters YES)
	(set-goal support-uu YES)
	(disable-self)
)

(defrule
	(goal combat-arm NOTICE)
	(random-number > 25)
	(random-number <= 50)
=>
	(set-goal combat-arm MECH)
	(set-goal support-artillery YES)
	(set-goal support-assault-mech YES)
	(set-goal support-masters YES)
	(disable-self)
)

(defrule
	(goal combat-arm NOTICE)
	(random-number > 50)
	(random-number <= 75)
=>
	(set-goal combat-arm MECH/HW)
	(set-goal support-masters YES)
	(set-goal support-assault-mech YES)
	(disable-self)
)

(defrule
	(goal combat-arm NOTICE)
	(random-number > 75)
=>
	(set-goal combat-arm TROOP/HW)
	(set-goal support-masters YES)
	(set-goal support-assault-mech YES)
	(disable-self)
)

#end-if

