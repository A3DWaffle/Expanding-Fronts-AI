; =====================================================
; FILE: combat-arm
; PURPOSE:
;   Selects core combat arm and support package for modern production logic.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: MAP SUPPORT FLAGS
;	Chapter 3: SUPPORT FALLBACKS
;	Chapter 4: CIV MATRICES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal combat-arm NOTICE)
	(generate-random-number 100)
	(disable-self)
)

(defrule
	(goal special-map ASTEROID)
=>
	(set-goal support-aircraft YES)
	(disable-self)
)

; =====================================================
; *** Chapter 1: MAP SUPPORT FLAGS ***
; =====================================================

(defrule
	(or
		(goal special-map WATER)
		(goal special-map HYBRID)
	)
=>
	(set-goal support-sea YES)
	(chat-local-to-self "WAFFLE: Combat support SEA enabled.")
	(disable-self)
)

(defrule
	(goal special-map WATER)
=>
	(set-goal support-aircraft YES)
	(set-goal support-sealift YES)
	(set-strategic-number sn-desired-number-transport-escorts 2)
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(set-strategic-number sn-number-boat-attack-groups 5)
	(set-strategic-number sn-minimum-boat-attack-group-size 5)
	(set-strategic-number sn-maximum-boat-attack-group-size 9)
	(chat-local-to-self "WAFFLE: Water map support: air and sealift enabled.")
	(disable-self)
)

(defrule
	(goal special-map WATER)
	(goal support-sealift YES)
	(not (strategic-number sn-task-ungrouped-soldiers == 1))
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
)

; =====================================================
; *** Chapter 3: SUPPORT FALLBACKS ***
; =====================================================
	
(defrule
	(false) ; This is an example rule to be copy/pasted.
=>
	; There are 6 lineups, select only one. Special thanks to LuckyLlama for helping me with these.
	(set-goal combat-arm TROOP) 		; This lineup priotizes Repeaters/Grenadiers.
	(set-goal combat-arm TROOP/HW) 		; This lineup priotizes Repeaters/Artillery.
	(set-goal combat-arm STRIKE/HW) 	; This lineup priotizes Strike Mechs/Artillery.
	(set-goal combat-arm MECHBALL) 		; This lineup priotizes Mech Destroyers/Artillery.
	(set-goal combat-arm DEATHBALL) 	; This lineup priotizes Mech Destroyers/Assault Mechs.
	(set-goal combat-arm AIR) 			; This lineup priotizes Attackers/Mounted Units.
	; A-mechs and Art can never be in same line-up. It's OP.

	; Mainline
	; (set-goal support-artillery YES/NO)
	; (set-goal support-assault-mech YES/NO)

	; Troop Center
	; (set-goal support-repeater YES/NO)
	; (set-goal support-grenadiers YES/NO)
	; (set-goal support-mounted YES/NO)

	; Mech Factory
	; (set-goal support-strike YES/NO)
	; (set-goal support-destroyer YES/NO)
	; (set-goal support-apc YES/NO)

	; Extras
	; (set-goal support-sam YES/NO)
	; (set-goal support-aircraft YES/NO)
	; (set-goal support-uu YES/NO)
	; (set-goal support-masters YES/NO)
	(disable-self)
)

; =====================================================
; *** Chapter 4: CIV MATRICES ***
; =====================================================

#load-if-defined EMPIRE

(defrule
	(goal combat-arm NOTICE)
	(random-number <= 25)
=>
	(set-goal combat-arm TROOP/HW)
	; Mainline
	(set-goal support-repeater YES)
	(set-goal support-artillery YES)
	(set-goal support-assault-mech NO)
	; Troop Center
	(set-goal support-grenadiers NO)
	(set-goal support-mounted NO)
	; Mech Factory
	(set-goal support-strike NO)
	(set-goal support-destroyer YES)
	(set-goal support-apc NO)
	; Extras
	(set-goal support-sam YES)
	(set-goal support-aircraft YES)
	(set-goal support-uu YES)
	(set-goal support-masters YES)
	(disable-self)
)

