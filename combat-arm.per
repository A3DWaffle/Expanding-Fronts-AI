; =====================================================
; FILE: combat-arm
; PURPOSE:
;   Selects core combat arm and support package for modern production logic.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: MAP SUPPORT FLAGS
;	Chapter 2: DEBUG MESSAGES
;	Chapter 3: SUPPORT FALLBACKS
;	Chapter 4: CIV MATRICES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal combat-arm NOTICE)
	(generate-random-number 100)
	(disable-self)
)

(defrule
	(goal special-map ASTEROID)
=>
	(set-goal support-aircraft YES)
	(disable-self)
)

; =====================================================
; *** Chapter 1: MAP SUPPORT FLAGS ***
; =====================================================

(defrule
	(or
		(goal special-map WATER)
		(goal special-map HYBRID)
	)
=>
	(set-goal support-sea YES)
	(chat-local-to-self "WAFFLE: Combat support SEA enabled.")
	(disable-self)
)

(defrule
	(goal special-map WATER)
=>
	(set-goal support-aircraft YES)
	(set-goal support-sealift YES)
	(set-strategic-number sn-desired-number-transport-escorts 2)
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(set-strategic-number sn-number-boat-attack-groups 5)
	(set-strategic-number sn-minimum-boat-attack-group-size 5)
	(set-strategic-number sn-maximum-boat-attack-group-size 9)
	(chat-local-to-self "WAFFLE: Water map support: air and sealift enabled.")
	(disable-self)
)

(defrule
	(goal special-map WATER)
	(goal support-sealift YES)
	(not (strategic-number sn-task-ungrouped-soldiers == 1))
=>
	(set-strategic-number sn-task-ungrouped-soldiers 1)
)

(defrule
	(goal special-map WATER)
	(goal support-artillery YES)
=>
	(set-goal support-artillery NO)
)

