; =====================================================
; FILE: combat-arm
; PURPOSE:
;   Selects core combat arm and support package for modern production logic.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: PACKAGE SELECTION
;	Chapter 2: SUPPORT FLAGS
;	Chapter 3: CIV MATRICES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal combat-arm NOTICE)
	(generate-random-number 100)
	(disable-self)
)

; Debug helpers so test games reveal which package actually rolled.

(defrule
	(not (goal combat-arm NOTICE))
	(goal combat-arm TROOP)
=>
	(chat-to-all "WAFFLE: Core arm TROOP")
	(disable-self)
)

(defrule
	(timer-triggered t-debug)
	(goal combat-arm TROOP)
=>
	(chat-to-all "WAFFLE: Core strategy reminder: arm TROOP")
)

(defrule
	(not (goal combat-arm NOTICE))
	(goal combat-arm TROOP/HW)
=>
	(chat-to-all "WAFFLE: Core arm TROOP/HW")
	(disable-self)
)

(defrule
	(timer-triggered t-debug)
	(goal combat-arm TROOP/HW)
=>
	(chat-to-all "WAFFLE: Core strategy reminder: arm TROOP/HW")
)

