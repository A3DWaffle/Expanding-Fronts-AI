; =====================================================
; FILE: homebase
; PURPOSE:
;   Builds core base infrastructure, workers, prefabs, farms, power cores, and CCs.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: COMMAND CENTER
;	Chapter 2: RESEARCH
;	Chapter 3: WORKERS
;	Chapter 4: PREFABS
;	Chapter 5: FARMS
;	Chapter 6: POWER CORE
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; =====================================================
; *** Chapter 1: COMMAND CENTER ***
; =====================================================

(defrule
	(game-time > raiders-timeout) ; raiders starts are very odd and this does not often work properly
	(building-type-count-total BLDG-MAIN == 0)
	(can-build-with-escrow BLDG-MAIN)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-MAIN) 
)

; TL3-CCs and TL4-CCs are set in building-count before this file loads.

; Defensive should spend its first clean TL3 on infrastructure, including its
; early CC shell before broad production scaling.
(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-MAIN < 3)
	(building-type-count-total BLDG-TRAINAIR >= 2)
	(can-build-with-escrow BLDG-MAIN)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-MAIN)
)

(defrule
	(current-age == tech-level-3)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-MAIN < TL3-CCs)
	(can-build-with-escrow BLDG-MAIN)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-MAIN)
)

(defrule
	(current-age == tech-level-4)
	(building-type-count-total BLDG-MAIN < TL4-CCs)
	(can-build-with-escrow BLDG-MAIN)
	(metal-amount > 110) ; try to not release escrow in T4
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
)



(defrule
	(current-age == tech-level-4)
	(can-build-with-escrow BLDG-MAIN)
	(or
		(goal attackTSAhold HOLDING-HIGH) ; use far-flung CCs to grab res during TSA
		(goal attackTSAhold HOLDING-LOW)
	)
	(metal-amount > 110) ; try to not release escrow in T4
	(or
		(goal attackTSAlevel 3)
		(goal attackTSAlevel 4)
	)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(can-build-with-escrow BLDG-MAIN)
	(or
		(goal attackTSAhold HOLDING-HIGH) 
		(goal attackTSAhold HOLDING-LOW)
	)
	(metal-amount > 110)
	(goal attackTSAlevel 5)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(can-build-with-escrow BLDG-MAIN)
	(or
		(goal attackTSAhold HOLDING-HIGH) 
		(goal attackTSAhold HOLDING-LOW)
	)
	(metal-amount > 110)
	(goal attackTSAlevel 6)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(can-build-with-escrow BLDG-MAIN)
	(or
		(goal attackTSAhold HOLDING-HIGH) 
		(goal attackTSAhold HOLDING-LOW)
	)
	(metal-amount > 110)
	(goal attackTSAlevel 7)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(can-build-with-escrow BLDG-MAIN)
	(or
		(goal attackTSAhold HOLDING-HIGH) 
		(goal attackTSAhold HOLDING-LOW)
	)
	(metal-amount > 110)
	(goal attackTSAlevel 8)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
	(disable-self)
)


(defrule
	(current-age == tech-level-4)
	(can-build-with-escrow BLDG-MAIN)
	(or
		(goal attackTSAhold HOLDING-HIGH) 
		(goal attackTSAhold HOLDING-LOW)
	)
	(metal-amount > 110)
	(goal attackTSAlevel 9)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
	(disable-self)
)


; =====================================================
; *** Chapter 2: RESEARCH ***
; =====================================================

; Motivator and Basic Training research need to load before worker training.
; CC construction stays above research so age-up momentum does not get stolen.

(defrule
	(current-age >= tech-level-2)
	(can-research-with-escrow rt-upgraded-motivator)
	(goal agingup NO)
	(or
		(current-age >= tech-level-3)
		(game-time > 540)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-upgraded-motivator)
)

(defrule
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-optimized-motivator)
	(game-time > 300)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-optimized-motivator)
)

(defrule
	; Basic Training
	(can-research rt-basic-training)
	(or
		(not (can-train UNIT-WORKER) )
		(or
			(civilian-population > 14)
			(unit-type-count 224 > 0) ; dead worker
		)
	)
=>
	(research rt-basic-training)
)



; =====================================================
; *** Chapter 3: WORKERS ***
; =====================================================

(defrule
	(current-age == tech-level-1)
	(civilian-population < civ-dark-hard) ; this value can be very high, like 50, so not an issue (it's per pop)
	(can-train UNIT-WORKER)
=>
	(train UNIT-WORKER)
)

; TL2 worker counts split by whether an ally trade route is available.
(defrule
	(current-age == tech-level-2)
	(or
		(and
			(unit-type-count-total UNIT-WORKER < TL4-max-workers-ally)
			(cc-players-building-type-count any-ally BLDG-SPACEPORT > 0) ; budget check for ally
		)
		(and
			(unit-type-count-total UNIT-WORKER < TL4-max-workers-noally)
			(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)) ; budget check for no ally
		)
	)
	(can-train UNIT-WORKER)
=>
	(train UNIT-WORKER)
)

; Late eco pop is split between workers, trawlers, and trade.

; case 1: no fish, yes ally
(defrule
		(or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(goal fish-present NO)
        (unit-type-count-total UNIT-WORKER < TL4-max-workers-ally)
		(cc-players-building-type-count any-ally BLDG-SPACEPORT > 0) ; budget check for ally
		(not (population > stop-junk-threshold)) ; stop training these once the 10% headroom threshold is reached
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)

; case 2: no fish, no ally
(defrule
        (or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(goal fish-present NO)
        (unit-type-count-total UNIT-WORKER < TL4-max-workers-noally)
		(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)) ; budget check for no ally
		(not (population > stop-junk-threshold)) ; stop training these once the 10% headroom threshold is reached
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)


; if the map DOES have fish (includes carbon gas vent)
; case 3: yes fish, yes ally
(defrule
        (or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(not (goal fish-present NO))
		(unit-type-count-total UNIT-WORKER < TL4-max-workers-ally-water)
		(cc-players-building-type-count any-ally BLDG-SPACEPORT > 0) ; budget check for ally
		(not (population > stop-junk-threshold))
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)
; case 4: yes fish, no ally
(defrule
        (or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(not (goal fish-present NO))
        (unit-type-count-total UNIT-WORKER < TL4-max-workers-noally-water)
		(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)) ; budget check for no ally
		(not (population > stop-junk-threshold))
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)

(defrule
	(true)
=>
	(set-goal lategameworker NO)
	(disable-self)
)

; Shared late-game worker cleanup for all difficulties. Difficulty should not be
; changing whether the AI understands how to trim workers at max-pop.

(defrule
	(game-time > 3600)
	(goal lategameworker NO)
	(goal ore-found NO)
	(goal nova-found NO) ; these call, among other things, number of miners
	(cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)
	(carbon-amount > 700) ; so got a bit banked, implying all buildings done
	=>
	(set-goal lategameworker YES)
)

(defrule
	(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0))
	(goal lategameworker YES)
=>
	(set-goal lategameworker NO)
)

(defrule
	(goal lategameworker YES)
	(unit-type-count-total UNIT-WORKER > late-max-workers)
	(population > stop-junk-threshold) ; only if pop is a rare resource
	=>
	(delete-unit UNIT-WORKER)
)

; Lategame train rule.
(defrule
	(goal lategameworker YES)
	(unit-type-count-total UNIT-WORKER < late-max-workers)
	(population < stop-junk-threshold) ; only if pop has plenty
	(can-train UNIT-WORKER)
	=>
	(train UNIT-WORKER)
)


; =====================================================
; *** Chapter 4: PREFABS ***
; =====================================================

; as-needed
(defrule
	(building-type-count BLDG-MAIN > 0)
	(housing-headroom < 5)			; "do we need a house" check
	(population-headroom > 0)		; normal timing: stop at the true pop cap
	(can-build-with-escrow BLDG-PREFAB)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
	(current-age == tech-level-2)
	(housing-headroom < 10)	
	(population-headroom > 0)
	(can-build-with-escrow BLDG-PREFAB)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
	(current-age == tech-level-2)
	(goal agingup YES)
	(housing-headroom < 15)	
	(population-headroom > 0)
	(can-build-with-escrow BLDG-PREFAB)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
	(current-age >= tech-level-3)
	(housing-headroom < 20) ; build lots of extra prefabs to prevent production from being capped
	(population-headroom > 0)
	(can-build-with-escrow BLDG-PREFAB)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

; Recovery path: if housing was destroyed and current pop exceeds housing,
; the normal population-headroom/buildpause gates can block rebuilding.
(defrule
	(building-type-count BLDG-MAIN > 0)
	(housing-headroom < 1)
	(can-build-with-escrow BLDG-PREFAB)
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

; Resilience increases prefab housing enough to trim old shelters.
(defrule
	(research-completed rt-resilience)
	(building-type-count BLDG-PREFAB > 1)
=>
	(delete-complete-building BLDG-PREFAB)
)

; =====================================================
; *** Chapter 5: FARMS ***
; =====================================================

(defrule
	(true)
=>
	(set-goal allowfarm YES)
	(disable-self)
)

; If no berries are present, build farms while spare assigned food gatherers hunt.

(defrule
	(current-age == tech-level-1)
	(current-age-time > 240)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(not (goal savetheanimals YES)) ; do not waste carbon on farms when nursery is needed
	(goal hunt-present NO)
	(unit-type-count GAIA-ANIMAL-HERD-LINE == 0)
	(idle-farm-count < 1)
	(can-build BLDG-FARM)
	(not (goal berries-present YES))
	(not (goal berries-present PLENTY))
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-1)
	(current-age-time > 240)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(not (goal savetheanimals YES))
	(goal hunt-present YES)
	(or
		(unit-type-count GAIA-ANIMAL-HERD-LINE == 0)
		(building-type-count-total BLDG-DROPANIM > 0)
	)
	(idle-farm-count < 1)
	(can-build BLDG-FARM)
	(not (goal berries-present YES))
	(not (goal berries-present PLENTY))
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

; TL1 food safety valve: once the opener is complete, spend surplus carbon
; on farms if food is still dangerously low.
(defrule
	(current-age == tech-level-1)
	(food-amount < 80)
	(carbon-amount > 225)
	(unit-type-count-total UNIT-WORKER > 10)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(idle-farm-count < 3)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

; TL1 carbon glut recovery: if the AI has piled up carbon but has almost no
; food income, create enough farm jobs for the food gather split to matter.
(defrule
	(current-age == tech-level-1)
	(food-amount < 150)
	(carbon-amount > 500)
	(unit-type-count-total UNIT-WORKER > 14)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-FARM < 10)
	(idle-farm-count < 6)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-1)
	(food-amount < 100)
	(carbon-amount > 250)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPANIM > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(not (goal savetheanimals YES))
	(idle-farm-count < 2)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-1)
	(food-amount < 100)
	(carbon-amount > 250)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPANIM > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-DROPNOVA > 0)
	(not (goal savetheanimals YES))
	(idle-farm-count < 2)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

; If berries are present, wait for them to become too far before farming.

(defrule
	(current-age == tech-level-1)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(not (goal savetheanimals YES)) ; do not waste carbon on farms when nursery is needed
	(or
		(unit-type-count GAIA-ANIMAL-HERD-LINE == 0)
		(building-type-count-total BLDG-DROPANIM > 0)
	)
	(idle-farm-count < 1)
	(can-build BLDG-FARM)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY)
	)
	(sheep-and-forage-too-far)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-2)
	(food-amount < 150)
	(carbon-amount > 450)
	(unit-type-count-total UNIT-WORKER > 10)
	(building-type-count-total BLDG-FARM < 18)
	(idle-farm-count < 6)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

; TL2 farm floor: do not depend on perfect hunt exhaustion detection once the
; worker count is large enough to need stable food income.
(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-WORKER > 18)
	(building-type-count-total BLDG-FARM < 8)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(carbon-amount > 250)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-2)
	(goal hunt-present NO)
	(building-type-count-total BLDG-FARM < 18)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-2)
	(goal hunt-present YES)
	(current-age-time > 180)
	(building-type-count-total BLDG-FARM < 12)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
