(defrule
	(current-age == tech-level-3)
	(goal hunt-present YES)
	(current-age-time > 180)
	(building-type-count-total BLDG-FARM < 24)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-3)
	(goal hunt-present YES)
	(current-age-time > 180)
	(building-type-count-total BLDG-FARM < 20)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-4)
	(goal hunt-present YES)
	(building-type-count-total BLDG-FARM < 45)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-4)
	(goal hunt-present YES)
	(building-type-count-total BLDG-FARM < 40)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-4)
	(goal hunt-present YES)
	(building-type-count-total BLDG-FARM < 35)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

; Maintain spare idle farms so exhausted farms can be refreshed without waiting
; for total farm count to fall behind the age target.
(defrule
	(current-age == tech-level-2)
	(idle-farm-count < 3)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-3)
	(idle-farm-count < 5)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-4)
	(idle-farm-count < 24)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-4)
	(game-time > 2400)
	(idle-farm-count < 48)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age >= tech-level-3)
	(carbon-amount > 500)
	(idle-farm-count < 16)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

; Late food-collapse recovery. If farm production got disabled or simply fell
; behind, spend the small carbon bank on farms before the food eco flatlines.
(defrule
	(current-age >= tech-level-3)
	(game-time > 2400)
	(unit-type-count-total UNIT-WORKER > 40)
	(food-amount < 300)
	(carbon-amount > 70)
	(building-type-count-total BLDG-FARM < 30)
	(idle-farm-count < 18)
	(can-build-with-escrow BLDG-FARM)
	(not (goal buildpause YES))
=>
	(set-goal allowfarm YES)
	(release-escrow carbon)
	(build BLDG-FARM)
)

; Stronger TL4 version: an hour in, 12 farmers is unrecoverable unless the AI
; aggressively refills the farm grid.
(defrule
	(current-age == tech-level-4)
	(game-time > 3000)
	(unit-type-count-total UNIT-WORKER > 60)
	(food-amount < 500)
	(carbon-amount > 70)
	(building-type-count-total BLDG-FARM < 45)
	(idle-farm-count < 30)
	(can-build-with-escrow BLDG-FARM)
	(not (goal buildpause YES))
=>
	(set-goal allowfarm YES)
	(release-escrow carbon)
	(build BLDG-FARM)
)

; Disable farms while the AI is rebuilding its CC or when food drop-off distance
; suggests the farm layout has gone bad.

(defrule
	(current-age >= tech-level-2)
	(game-time > 600)
	(building-type-count-total BLDG-FARM > 0)
	(building-type-count BLDG-MAIN == 0) ; if we do not have a CC
	(building-type-count-total BLDG-MAIN > 0) ; but one is building
=>
	(set-goal allowfarm NO)
)

(defrule
	(current-age >= tech-level-2)
	(not (current-age == tech-level-4))
	(game-time > 600)
	(food-amount > 300)
	(dropsite-min-distance food > 8)
	(building-type-count BLDG-FARM > 0)
=>
	(set-goal allowfarm NO)
)

(defrule
	(goal allowfarm NO)
	(building-type-count BLDG-FARM > 0)
=>
	(delete-complete-building BLDG-FARM)
)

(defrule
	(goal allowfarm NO)
	(building-type-count-total BLDG-FARM == 0)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal allowfarm YES)
)





; =====================================================
; *** Chapter 6: POWER CORE ***
; =====================================================

(defrule
	(building-type-count-total BLDG-TRAINBOAT <= 1)
	(not (strategic-number sn-max-unpowered-buildings == 1))
=>
	(set-strategic-number sn-max-unpowered-buildings 1)
)

; Shipyard-heavy builds need a little more unpowered-building tolerance.
(defrule
	(building-type-count-total BLDG-TRAINBOAT > 1) 
	(building-type-count-total BLDG-TRAINBOAT <= 3) ; 2 or 3 shipyards
	(not (strategic-number sn-max-unpowered-buildings == 2))
=>
	(set-strategic-number sn-max-unpowered-buildings 2)
)

(defrule
	(building-type-count-total BLDG-TRAINBOAT >= 4)
	(not (strategic-number sn-max-unpowered-buildings == 3))
=>
	(set-strategic-number sn-max-unpowered-buildings 3)
)



; Build the first Power Core before the Troop Center so early base placement anchors correctly.

(defrule
	(building-type-count BLDG-POWERCORE == 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count BLDG-MAIN > 0)
	(can-build BLDG-POWERCORE)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cpowercore)
	(build BLDG-POWERCORE)
)

; After the Troop Center is built, add a second Power Core if possible.

(defrule
	(current-age == tech-level-1) ; T2-3-4 have rules with current age time down below
	(building-type-count-total BLDG-POWERCORE < 2)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count BLDG-MAIN > 0)
	(building-type-count BLDG-TRAINTROOPER > 0)
	(unit-type-count UNIT-LASER-LINE <= 2) ; if troops are not being produced
	(can-build BLDG-POWERCORE)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cpowercore)
	(build BLDG-POWERCORE)
)


; (defrule
; 	(goal special-map WATER)
; 	(building-type-count BLDG-POWERCORE < 2) 
; 	(building-type-count BLDG-DROPCHOW > 0)
; 	(building-type-count BLDG-MAIN > 0)
; 	(building-type-count BLDG-TRAINTROOPER > 0)
; 	(building-type-count BLDG-TRAINBOAT > 0)
; 	(can-build BLDG-POWERCORE)
; 	=>
; 	(build BLDG-POWERCORE)
; )



; Emergency Power Core build. Tech-level caps keep the AI from overcorrecting.

(defrule
	(too-many-unpowered-buildings)
	(building-type-count BLDG-MAIN > 0)
	(can-build-with-escrow BLDG-POWERCORE)
	(or
		(and
			(current-age == tech-level-2)
			(building-type-count-total BLDG-POWERCORE < 4)
		)
		(or
			(and
				(current-age == tech-level-3)
				(building-type-count-total BLDG-POWERCORE < 9)
			)
			(and
				(current-age == tech-level-4)
				(building-type-count-total BLDG-POWERCORE < 10)
			)
		)
	)
	(not (goal buildpause YES))
	=>
	(release-escrow carbon)
	(set-goal resourcerefund cpowercore) 
	(build BLDG-POWERCORE)
)

; Banked-resource Power Core helper.

(defrule
	(or
		(and
			(current-age == tech-level-2)
			(building-type-count-total BLDG-POWERCORE < 2)
		)
		(or
		(and
			(current-age == tech-level-3)
			(building-type-count-total BLDG-POWERCORE < 3)
		)
		(and
			(current-age == tech-level-4)
			(building-type-count-total BLDG-POWERCORE < 5)
		)
		)
	)
	(can-build-with-escrow BLDG-POWERCORE)
	(or
		(carbon-amount > 300)
		(escrow-amount carbon > 250)
	)
	(current-age-time > 300) ; give some time for buildings to be dropped
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund cpowercore) 
	(build BLDG-POWERCORE)
	
)

; TL3 post-spine Power Core helper. Once Spaceport + War Center are online,
; allow extra power before production expansion stalls on unpowered buildings.
(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-WARCTR > 0)
	(building-type-count-total BLDG-MAIN >= 2)
	(building-type-count-total BLDG-POWERCORE < 5)
	(can-build-with-escrow BLDG-POWERCORE)
	(or
		(carbon-amount > 500)
		(escrow-amount carbon > 450)
	)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund cpowercore)
	(build BLDG-POWERCORE)
)

; Rich TL4 forward Power Core support. Once the core base has enough power,
; spend oversized banks on forward power for remote production and shields.
(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(building-type-count-total BLDG-POWERCORE >= 5)
	(building-type-count-total BLDG-POWERCORE < 8)
	(military-population >= MIL_POP_B)
	(carbon-amount > 2500)
	(food-amount > 1000)
	(nova-amount > 500)
	(can-build-with-escrow BLDG-POWERCORE)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund cpowercore)
	(build-forward BLDG-POWERCORE)
)

