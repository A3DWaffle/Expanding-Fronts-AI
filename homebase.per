	(goal hunt-present NO)
	(building-type-count-total BLDG-FARM < 35)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-3)
	(goal hunt-present YES)
	(current-age-time > 180)
	(building-type-count-total BLDG-FARM < 28)
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
