; =====================================================
; FILE: resign
; PURPOSE:
;   Handles resignation checks, failure reasons, and endgame resign behavior.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: RESIGN
;	Chapter 2: RESIGN GOALS
;	Chapter 3: BEHAVIOR
;	Chapter 4: RESIGN DIALOGUE
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal resignreason 0)
	(set-goal ResignCountdown NO)
	(set-goal Resign NO)
	(disable-self)
)

; disable the lot if it's a scenario

(defrule
	(goal scn-detected YES)
=>
	(set-goal resign-goal 999)
	(disable-self)
)

; bonus rule: if no workers at start of game, disable resigning
(defrule
	(game-time < 10)
	(unit-type-count UNIT-WORKER == 0)
=>
	(set-goal resign-goal 999) 
	(disable-self) 
)

; bonus rule 2: if Space Raiders, resign

(defrule
	(goal resign-goal 51)
=>
	(resign)
	(disable-self)
)

; =====================================================
; *** Chapter 1: RESIGN *** 
; =====================================================

(defrule
	(not (goal resign-goal 999))
	(building-type-count-total BLDG-MONUMENT == 0)
	(building-type-count-total BLDG-MAIN == 0)
	(or
		(unit-type-count-total UNIT-AIRTRANS-LINE > 0)
		(unit-type-count-total BOAT-TRANSPORT > 0)
	)
	(unit-type-count-total UNIT-WORKER <= 4)
	(soldier-count <= 3)
	(game-time > 120)
	(game-time < 180)
=>
	(set-goal messagestatus msg-RESIGN-SPACERAIDERS)
	(set-goal resign-goal 51)
	(disable-self)
)

; non-space, regular, raiders
(defrule
	(not (goal resign-goal 999))
	(nor 
		(hold-holocrons)
		(hold-koh-ruin)
	)
	(building-type-count-total BLDG-MONUMENT == 0)
	(building-type-count-total BLDG-MAIN == 0)
	(unit-type-count-total UNIT-WORKER <= 4)
	(soldier-count <= 3)
	(game-time > 590) ; activate before the rule below
	(game-time < 630)
	(shared-goal resignoverride NO)
=>
	(set-goal messagestatus msg-RESIGN-SPACERAIDERS)
	(set-goal resign-goal 51)
	(disable-self)
)

(defrule
	(game-time > 600)
	(unit-type-count-total UNIT-WORKER <= 9)
	(nor 
		(hold-holocrons)
		(hold-koh-ruin)
	)
	(military-population <= 4)
	(building-type-count-total BLDG-MONUMENT == 0)
	(goal ResignCountdown NO)
=>
	(enable-timer t-resign 240)
	(set-goal ResignCountdown YES)
	(set-goal Resign YES)
	;(chat-to-all "Waffle: Resign Countdown")
)

(defrule
	(military-population >= 5)
	(goal ResignCountdown YES)
=>
	(set-goal ResignCountdown NO)
	;(chat-to-all "Waffle: Aborting Countdown")
)

(defrule
	(game-time > 600)
	(unit-type-count-total UNIT-WORKER >= 10)
	(nor 
		(hold-holocrons)
		(hold-koh-ruin)
	)
	(military-population >= 5)
	(building-type-count-total BLDG-MONUMENT == 0)
	(goal Resign YES)
=>
	(set-goal Resign NO)
	;(chat-to-all "Waffle: Resign NO")
)

; resign start rule
(defrule
	(goal Resign YES)
	(or	
		(and
			(goal ResignCountdown YES)
			(timer-triggered t-resign)
		)
		(or
			(and ; case 1: current age time has elapsed a bit
				(current-age-time > 600) ; either a good way into current age
				(or
					(building-type-count-total BLDG-MAIN == 0) ; case 1a: no more CCs exist or are under construction
					(and
						(current-age == tech-level-4)			; case 1b: we are in TL4, as many CCs as we like, but no workers
						(unit-type-count-total UNIT-WORKER <= 1)
					)
				)
			)
			(and  ;case 2: no workers and no CC
				(unit-type-count UNIT-WORKER == 0)
				(building-type-count BLDG-MAIN == 0) 
			)
		)
	)
	(not (goal resign-goal 999))
	(shared-goal resignoverride NO) ; config override
=>
	(set-goal resign-goal 21) ; resign in progress
	(disable-self)
)

; =====================================================
; *** Chapter 2: RESIGN GOALS *** 
; --- 2a: EXCUSE MSG ---
; --- 2b: RESIGN MSG ---
; --- 2c: CONFIG CHECK ---
; =====================================================

; --- 2a: EXCUSE MSG ---

(defrule
	(goal resignreason 0)
	(goal resign-goal 21)
=>
	(set-goal resignreason 1) ; Allow picking a resign reason if one has not already been selected
	(disable-self)
)

(defrule
	(goal resign-goal 23) ; allow two ticks before resigning continues
=>
	(set-goal resign-goal 24) ; move to next stage
	(disable-self)
)
(defrule
	(goal resign-goal 22)
=>
	(set-goal resign-goal 23)
	(disable-self)
)
(defrule
	(goal resign-goal 21)
=>
	(set-goal messagestatus msg-RESIGN-EXCUSE)
	(set-goal resign-goal 22)
	(disable-self)
)

; --- 2b: RESIGN MSG ---

(defrule
	(goal resign-goal 25)
=>
	(set-goal resign-goal 27) ; move to next stage
	(disable-self)
)
(defrule
	(goal resign-goal 24)
=>
	(set-goal messagestatus msg-RESIGN-RESIGN)
	(set-goal resign-goal 25)
	(disable-self)
)

; --- 2c: CONFIG CHECK ---

(defrule
	(goal resign-goal 28)
=>
	(set-goal resign-goal 19) ; continue with resigning
)

(defrule
	(goal resign-goal 27)
	(not (player-in-game any-ally))
=>
	(generate-random-number 6)
	(disable-self)
)

(defrule
	(goal resign-goal 27)
	(not (player-in-game any-ally))
	(random-number == 1)
=>
	(set-goal messagestatus msg-RESIGN-CONFIGAD)
	(set-goal resign-goal 28)
)
(defrule
	(goal resign-goal 27) ; if the above hasn't happened
=>
	(set-goal resign-goal 19) ; speed it up
)

; =====================================================
; *** Chapter 3: BEHAVIOR *** 
; --- 3a: TRIBUTE ---
; --- 3b: DELETE BUILDINGS ---
; --- 3c: GOALS ---
; =====================================================
; actual resigning behaviour begins here

; -------------------
; --- 3a: TRIBUTE ---
; -------------------

(defrule
	(goal resign-goal 19)
	(stance-toward any-human ally)
=>
	(release-escrow carbon)
	(release-escrow food)
	(release-escrow nova)
	(release-escrow metal)
	(tribute-to-player this-any-human carbon 10000)
	(tribute-to-player this-any-human food 10000)
	(tribute-to-player this-any-human nova 10000)
	(tribute-to-player this-any-human metal 10000)
	(disable-self)
)

(defrule
	(goal resign-goal 19)
	(players-population any-ally > 10)
=>
	(release-escrow carbon)
	(release-escrow food)
	(release-escrow nova)
	(release-escrow metal)
	(tribute-to-player this-any-ally carbon 10000)
	(tribute-to-player this-any-ally food 10000)
	(tribute-to-player this-any-ally nova 10000)
	(tribute-to-player this-any-ally metal 10000)
	(disable-self)
)

; ------------------
; --- 3b: DELETE ---
; ------------------

(defrule
    (or
		(goal resign-goal 19)
		(goal resign-goal 9)
	)
=>
	(delete-building BLDG-TRAINBOAT)
	(delete-building BLDG-MAIN)
	(delete-building BLDG-TRAINJEDI)

	(delete-building BLDG-TRAINTROOPER)
	(delete-building BLDG-TRAINAIR)
	(delete-building BLDG-TRAINMECH)
	(delete-building BLDG-TRAINHEAVY)
	
	(delete-building BLDG-GOVTCTR)
)

; delete fun convertibles only if human enemies don't have any masters
(defrule
	(or
		(not (cc-players-unit-type-count any-human-enemy UNIT-MASTER-LINE > 0)) ; so if NOT any human has masters, delete them
		(research-completed rt-jedi-strength) ; or if we have purge
	)
	(or
		(goal resign-goal 19)
		(goal resign-goal 9)
	)
    (not (stance-toward any-human ally) )
=>
	(delete-building BLDG-TURRET1)
	(delete-building BLDG-TURRET2)
	(delete-building BLDG-TURRET3)

	(delete-building BLDG-MISSILE1)
	(delete-building BLDG-MISSILE2)
	(delete-building BLDG-AABATTERY)
)

; one of the following must be true: all defensive structures deleted OR human enemy has Masters EDIT ORRRR we have a human ally (rule below)
(defrule
	(goal resign-goal 19)
	(or
		(and
			(cc-players-unit-type-count any-human-enemy UNIT-MASTER-LINE > 0)
			(not (research-completed rt-jedi-strength)) ; purge
		)
		(and
			(building-type-count BLDG-TURRET-LINE == 0)
			(and
			(building-type-count BLDG-MISSILE-LINE == 0)
			(building-type-count BLDG-AABATTERY == 0) ; you get the picture
			)
		)
	)
=>
	(set-goal resign-goal 9) ; this clears defensive buildings
)

(defrule
	(stance-toward any-human ally)
	(goal resign-goal 19)
=>
	(set-goal resign-goal 9) ; defensive building bypass

)

(defrule
    (goal resign-goal 9)
    (building-type-count BLDG-TRAINTROOPER == 0)
    (building-type-count BLDG-TRAINAIR == 0)
    (building-type-count BLDG-TRAINMECH == 0)
    (building-type-count BLDG-TRAINHEAVY == 0)
	(building-type-count BLDG-TRAINJEDI == 0)
	(building-type-count BLDG-TRAINBOAT == 0)
	; (building-type-count BLDG-GOVTCTR == 0) ; possible issues with annex ? 
=>
    (set-goal resign-goal 8)
    (disable-self)
)

; -----------------
; --- 3c: GOALS ---
; -----------------

; NOTE: MAY CLOBBER THESE 
; Update: Keeping them as mementos currently. :)

(defrule
	(goal resign-goal 8)
=>
	(set-goal resign-goal 7)
	(generate-random-number 9)
	(disable-self)
)

(defrule
	(goal resign-goal 7)
	(random-number == 1)
=>
	;(chat-to-all "63: You must be very proud.")
	(set-goal resign-goal 6)
)

(defrule
	(goal resign-goal 7)
	(random-number == 2)
=>
	;(chat-to-all "76: You will be sorry.")
	(set-goal resign-goal 6)
)

(defrule
	(goal resign-goal 7)
	(random-number == 3)
=>
	;(chat-to-all "128: I hate you!")
	(set-goal resign-goal 6)
)

(defrule
	(goal resign-goal 7)
	(random-number == 4)
=>
	;(chat-to-all "211: It's not fair.")
	(set-goal resign-goal 6)
)

(defrule
	(goal resign-goal 7)
	(random-number >= 5)
=>
	;(chat-to-all "81: Ah well, it's my programming.")
	(set-goal resign-goal 6)
)

(defrule
    (goal resign-goal 6)
=>
        ;(chat-to-all-using-range 22300  22)
        ;(chat-to-all-using-id 22322) ; resign messages moved all over the place
    (resign)
    (disable-self)
)

; =====================================================
; *** Chapter 4: RESIGN DIALOGUE *** 
; --- 4a: HOLOCRONS ---
; --- 4b: WALLS FAILED ---
; --- 4c: STEALTH FAIL ---
; --- 4d: TECH LEVEL FAIL ---
; --- 4e: AIR FAIL ---
; --- 4f: WATER FAIL ---
; --- 4g: TRADE FAIL ---
; --- 4h: CHEAT RESIGNS ---
; =====================================================

; ---------------------
; --- 4a: HOLOCRONS ---
; ---------------------

(defrule
	(or
		(civ-selected REPUBLIC) ; the two +holo nova civs
		(civ-selected NABOO)
	)
	(or
		(unit-type-count UNIT-JEDI-LINE > 0) ; have jedi units
		(unit-type-count UNIT-MASTER-LINE > 0)
	)
	(goal resignreason 0)
=>
	(set-goal resignreason HOLOFAIL)
	(disable-self)
)

(defrule
	(or
		(civ-selected REPUBLIC)
		(civ-selected NABOO)
	)
	(unit-type-count UNIT-JEDIHOLO-LINE > 0)
	(goal resignreason HOLOFAIL)
=>
	(set-goal resignreason 0) ; allow this to pick something else
	(disable-self)
)

; ------------------------
; --- 4b: WALLS FAILED ---
; ------------------------
; WALL FAILS TO POKE 

(defrule 
	(wall-completed-percentage 2 >= 5)
	(goal wall-build YES)
	(goal resignreason 0)
=>
	(set-goal resignreason WALLBUILDFAIL)
	(disable-self)
)

(defrule
	(current-age >= tech-level-3)
	(goal resignreason WALLBUILDFAIL)
=>
	(set-goal resignreason 0)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(wall-completed-percentage 2 >= 5)
	(goal wall-build YES)
	(goal resignreason 0)
=>
	(set-goal resignreason WALLCHOPFAIL)
	(disable-self)
)

; ------------------------
; --- 4c: STEALTH FAIL ---
; ------------------------

(defrule ; STEALTH FAIL
	(goal resignreason 0)
	(or
		(research-completed rt-jedi-mind-trick)
		(or
			(and
				(civ-selected GUNGANS)
				(unit-type-count-total BOAT-LASER-LINE > 0) ; stealthed subs
			)
			(and
				(civ-selected IMPERIALREMNANT)
				(unit-type-count-total BOAT-MISSILE-LINE > 0) ; stealthed subs
			)
		)
	)
=>
	(set-goal resignreason STEALTHFAIL)
)

; ---------------------------
; --- 4d: TECH LEVEL FAIL ---
; ---------------------------

; ORDER IMPORTANT AS THE TOP ONE WILL FIRE FIRST
; TECH LEVEL FAIL
(defrule
	(or
		(or
			(and
				(current-age == tech-level-1)
				(players-current-age any-enemy >= tech-level-2)
			)
			(and
				(current-age == tech-level-2)
				(players-current-age any-enemy >= tech-level-3)
			)
		)
		(and
			(current-age == tech-level-3)
			(players-current-age any-enemy >= tech-level-4)
		)
	)
	(goal resignreason 1)
=>
	(set-goal resignreason TECHLEVELFAIL)
)

; --------------------
; --- 4e: AIR FAIL ---
; --------------------

; AIR FAIL
(defrule
	(goal resignreason 1)
	(or
		(cc-players-unit-type-count any-enemy UNIT-AIRCRUISER-LINE >= 3)
		(cc-players-unit-type-count any-enemy UNIT-BOMBER-LINE >= 20)
	)
=>
	(set-goal resignreason AIRFAIL)
)

; ----------------------
; --- 4f: WATER FAIL ---
; ----------------------

; WATER FAIL A 
(defrule
	(goal resignreason 1)
	(or
		(cc-players-unit-type-count any-enemy BOAT-ARTILLERY-LINE >= 6)
		(cc-players-unit-type-count any-enemy BOAT-MONITOR-LINE >= 10)
	)
=>
	(set-goal resignreason WATERFAIL)
)

; WATER FAIL B
(defrule
	(goal resignreason 1)
	(goal special-map WATER)
	(unit-type-count-total BOAT-WORKER <= 3)
=>
	(set-goal resignreason TRAWLERFAIL)
)

; ----------------------
; --- 4g: TRADE FAIL ---
; ----------------------

; TRADE FAIL
(defrule
	(goal resignreason 1)
	(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)) ; Can also fire if an ally just straight-up isn't in the game
	(current-age == tech-level-4)
=>
	(set-goal resignreason TRADEFAIL)
)

; -------------------------
; --- 4h: CHEAT RESIGNS ---
; -------------------------

; CHEAT RESIGN REASONS
; ordered by power so the highest powered one is at the last of the list

(defrule
	(true)
=>
	(set-strategic-number snc-cheat-tier 0)
	(disable-self)
)

(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-FISH)
	(cc-players-unit-type-count any-enemy 6324 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-FISH)
)
(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-TANTIVE)
	(cc-players-unit-type-count any-enemy 1580 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-TANTIVE)
)
(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-FLYINGCAR)
	(cc-players-unit-type-count any-enemy 4894 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-FLYINGCAR)
)
(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-STARDEST)
	(cc-players-unit-type-count any-enemy 1586 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-STARDEST)
)
(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-DECIMATOR)
	(cc-players-unit-type-count any-enemy 545 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-DECIMATOR)
)
(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-BONGO)
	(cc-players-unit-type-count any-enemy 1314 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-BONGO)
)
(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-SIMON)
	(cc-players-unit-type-count any-enemy 1204 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-SIMON)
)
(defrule
	(strategic-number snc-cheat-tier < RESIGN-CHT-DEATHSTAR)
	(cc-players-unit-type-count any-enemy 1587 > 0)
=>
	(set-strategic-number snc-cheat-tier RESIGN-CHT-DEATHSTAR)
)
