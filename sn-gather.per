(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-WORKER > 10)
	(food-amount < 150)
	(food-amount > 74)
	(carbon-amount > 1000)
	(not (strategic-number sn-food-gatherer-percentage == 70))
