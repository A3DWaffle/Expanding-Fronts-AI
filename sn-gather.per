; tech 4 is a mangled mess of like three separate systems that work well enough most of the time


; misc resource switching

; beginning of using ecoswitch
; is not needed on disable self rules


;(goal ecoswitch READYTOGO)
;=>
;(set-goal ecoswitch COOLDOWN)
; TECH 3 

; TOO MUCH FOOD

; NOT ENOUGH CARBON
(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(or
		(and
			(food-amount > 1000) ; LOTS too much food, low carbon (but some!)
			(carbon-amount < 250)
		)
		(and
			(food-amount > 500) ; some too much food, no carbon at all
			(carbon-amount < 50)
		)
	)
	(or
		(not (strategic-number sn-carbon-gatherer-percentage == 50)) 
		(not (strategic-number sn-food-gatherer-percentage == 25))
	)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 50)
	(set-strategic-number sn-food-gatherer-percentage 25)
	(set-goal ecoswitch COOLDOWN)
)

; NOT ENOUGH NOVA
(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(food-amount > 1000)
	(nova-amount < 200)
	(goal nova-found YES)
	(or
		(not (strategic-number sn-nova-gatherer-percentage == 30)) 
		(not (strategic-number sn-food-gatherer-percentage == 10))
	)
=>
	(set-strategic-number sn-nova-gatherer-percentage 30)
	(set-strategic-number sn-food-gatherer-percentage 10)
	(set-goal ecoswitch COOLDOWN)
)

; TOO MUCH CARBON

; NOT ENOUGH FOOD
(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(or
		(and
			(food-amount < 150) ; 150f for MD
			(carbon-amount > 700) ; lotsa carbon, not much food
		)
		(and
			(food-amount < 50)
			(carbon-amount > 300) ; fine carbon, NO food
		)
	)
	(or
		(not (strategic-number sn-carbon-gatherer-percentage == 25)) 
		(not (strategic-number sn-food-gatherer-percentage == 50))
	)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 25)
	(set-strategic-number sn-food-gatherer-percentage 50)
	(set-goal ecoswitch COOLDOWN)
)

; NOT ENOUGH NOVA
(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(nova-amount < 200)
	(carbon-amount > 700)
	(goal nova-found YES)
	(or
		(not (strategic-number sn-carbon-gatherer-percentage == 10)) 
		(not (strategic-number sn-nova-gatherer-percentage == 30))
	)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 10)
	(set-strategic-number sn-nova-gatherer-percentage 30)
	(set-goal ecoswitch COOLDOWN)
)

; NOVA RESET

(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(nova-amount > 300)
	(not (strategic-number sn-nova-gatherer-percentage == 10))
=>
	(set-strategic-number sn-nova-gatherer-percentage 10)
	(set-goal ecoswitch COOLDOWN)
)



; TECH 4 

; TOO MUCH FOOD

; NOT ENOUGH CARBON
(defrule
	(or
		(not (strategic-number sn-carbon-gatherer-percentage == 50)) ; hopefully lag reduction? not sure ; yes this seems to have helped a lot
		(not (strategic-number sn-food-gatherer-percentage == 10))
	)
	(current-age == tech-level-4)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(or
		(and
			(food-amount > 1000) ; LOTS too much food, low carbon (but some!)
			(carbon-amount < 250)
		)
		(and
			(food-amount > 500) ; some too much food, no carbon at all
			(carbon-amount < 50)
		)
	)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 50)
	(set-strategic-number sn-food-gatherer-percentage 10)
	(set-goal ecoswitch COOLDOWN)
)

