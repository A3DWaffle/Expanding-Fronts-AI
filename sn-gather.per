; Once TL3 is queued, stop treating TL2 like a carbon-spine phase. Keep food
; online, cut ore, and bank nova for TL3 unit and tech spending.
(defrule
	(current-age == tech-level-2)
	(goal agingup YES)
	(unit-type-count-total UNIT-WORKER > 18)
	(food-amount > 50)
	(not (strategic-number sn-nova-gatherer-percentage == 30))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 30)
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-nova-gatherer-percentage 30)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

;tech 3

; when we get to T3, several goals:
; build an extra CC
; build a fort
; get the tech
; build the billion extra buildings
; then go onto food for units & eventual T4 

    
(defrule
	(current-age == tech-level-3)
	(unit-type-count BOAT-WORKER < 5)
	(game-time > latestart-nerf-timeout)
	=>
	(set-strategic-number sn-carbon-gatherer-percentage 30)
	(set-strategic-number sn-food-gatherer-percentage 35)
	(set-strategic-number sn-nova-gatherer-percentage 15)
	(set-strategic-number sn-metal-gatherer-percentage 20)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(unit-type-count BOAT-WORKER >= 5)
	(game-time > latestart-nerf-timeout)
	=>
	(set-strategic-number sn-carbon-gatherer-percentage 50)
	(set-strategic-number sn-food-gatherer-percentage 15)
	(set-strategic-number sn-nova-gatherer-percentage 15)
	(set-strategic-number sn-metal-gatherer-percentage 20)
	(disable-self)
)

; keep in mind several ore-costing buildings will have been built before the fort itself due to price
(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(building-type-count BLDG-GOVTCTR > 0) ; wait for it to go up properly
	(building-type-count-total BLDG-MAIN >= 2)
=>
	(set-strategic-number sn-metal-gatherer-percentage 15)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(goal importantT3research DONE) ; mandates research center and a lotta res which in turn suggests a bunch of other buildings up
	=>
	(set-strategic-number sn-carbon-gatherer-percentage 30)
	(set-strategic-number sn-food-gatherer-percentage 35)
	(set-strategic-number sn-nova-gatherer-percentage 20)
	(set-strategic-number sn-metal-gatherer-percentage 15)
	(disable-self)
)

