; Late TL4 rare-resource vacuum: if carbon is bloated but nova is not banked,
; keep a large mining crew on nova instead of drifting back to carbon.
(defrule
	(current-age == tech-level-4)
	(game-time > 2400)
	(goal ecoswitch READYTOGO)
	(nova-amount < 1000)
	(carbon-amount > 1500)
	(goal nova-found YES)
	(or
		(not (strategic-number sn-carbon-gatherer-percentage == 10))
		(or
			(not (strategic-number sn-nova-gatherer-percentage == 40))
			(not (strategic-number sn-metal-gatherer-percentage == 5))
		)
	)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 10)
	(set-strategic-number sn-nova-gatherer-percentage 40)
	(set-strategic-number sn-metal-gatherer-percentage 5)
	(set-goal ecoswitch COOLDOWN)
)

; TL4 ore maintenance is allowed only after nova has a real bank.
(defrule
	(current-age == tech-level-4)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(nova-amount > 1200)
	(metal-amount < 500)
	(goal ore-found YES)
	(or
		(not (strategic-number sn-nova-gatherer-percentage == 20))
		(not (strategic-number sn-metal-gatherer-percentage == 8))
	)
=>
	(set-strategic-number sn-nova-gatherer-percentage 20)
	(set-strategic-number sn-metal-gatherer-percentage 8)
	(set-goal ecoswitch COOLDOWN)
)

; NOVA RESET
(defrule
	(current-age == tech-level-4)
	(game-time > latestart-nerf-timeout)
	(goal ecoswitch READYTOGO)
	(nova-amount > 1200)
	(not (strategic-number sn-nova-gatherer-percentage == 15))
=>
	(set-strategic-number sn-nova-gatherer-percentage 15)
	(set-strategic-number sn-metal-gatherer-percentage 8)
	(set-goal ecoswitch COOLDOWN)
)

; Farm-collapse recovery: when late game farms are exhausted in waves, the
; gather split can leave too few workers on replacement farms unless food crashes.
(defrule
	(current-age == tech-level-4)
	(game-time > latestart-nerf-timeout)
	(building-type-count-total BLDG-FARM > 0)
	(food-amount < 12000)
	(carbon-amount > 1000)
	(or
		(not (strategic-number sn-carbon-gatherer-percentage == 35))
		(not (strategic-number sn-food-gatherer-percentage == 35))
	)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 35)
	(set-strategic-number sn-food-gatherer-percentage 35)
)

; Late food-collapse recovery. This catches the ugly case where food is gone and
; carbon is also low, so the normal "too much carbon" food switches never fire.
(defrule
	(current-age >= tech-level-3)
	(game-time > 2400)
	(unit-type-count-total UNIT-WORKER > 40)
	(building-type-count-total BLDG-FARM > 0)
	(food-amount < 300)
	(not (strategic-number sn-food-gatherer-percentage == 70))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 20)
	(set-strategic-number sn-food-gatherer-percentage 70)
	(set-strategic-number sn-nova-gatherer-percentage 10)
	(set-strategic-number sn-metal-gatherer-percentage 5)
)

; GENERIC NON T1 START

(defrule
	(game-time > latestart-nerf-timeout)
	(game-time < 600)
	(not (current-age == tech-level-1))
	(goal savetheanimals NO)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 50)
	(set-strategic-number sn-food-gatherer-percentage 30)
	(set-strategic-number sn-nova-gatherer-percentage 10)
	(set-strategic-number sn-metal-gatherer-percentage 10)
	(disable-self)
)
