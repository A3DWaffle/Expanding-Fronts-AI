; =====================================================
; FILE: sn-gather
; PURPOSE:
;   Controls gather percentages, resource assignment, hunt behavior, and eco switching.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: TL1 GATHER
;	Chapter 2: TL2 GATHER
;	Chapter 3: TL3+ GATHER
;	Chapter 4: HUNT AND HERDABLES
;	Chapter 5: ECO SWITCHING
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(enable-timer t-economy 30)
	(set-goal ecoswitch READYTOGO)
	(disable-self)
)

(defrule
	(timer-triggered t-economy)
	(not (goal ecoswitch READYTOGO))
=>
	(set-goal ecoswitch READYTOGO)
	; (chat-local-to-self "ZELL: T-economy ticked, ready to go")
	(disable-timer t-economy) ; wait for it to be reset by setting to COOLDOWN
)

(defrule
	(goal ecoswitch COOLDOWN)
=>
	(disable-timer t-economy)
	(enable-timer t-economy 30)
	(set-goal ecoswitch COOLDOWNING)
	;(chat-local-to-self "ZELL: T-economy has been called, eco adjusted")
)



; start percentages: don't eat your nerfs, full carbon
(defrule
	(true)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 100)
	(set-strategic-number sn-food-gatherer-percentage 0)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
	(set-goal savetheanimals NO)
	(disable-self)
)


; save the animals code 

; Keep each nursery case separate; nested ORs can exceed the AI rule-size limit.
(defrule
	(building-type-count BLDG-MAIN > 0)
    (can-build-with-escrow BLDG-DROPANIM)
	(goal savetheanimals YES)
	(building-type-count-total BLDG-DROPANIM < 1)
	(goal savetheanimals-nursery ONE)
	(not (goal buildpause YES))
=>
	(release-escrow carbon) ; needed for later TL starts
    (build BLDG-DROPANIM)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
    (can-build-with-escrow BLDG-DROPANIM)
	(goal savetheanimals YES)
	(building-type-count-total BLDG-DROPANIM < 2)
	(goal savetheanimals-nursery TWO)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
    (build BLDG-DROPANIM)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
    (can-build-with-escrow BLDG-DROPANIM)
	(goal savetheanimals YES)
	(building-type-count-total BLDG-DROPANIM < 3)
	(goal savetheanimals-nursery THREE)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
    (build BLDG-DROPANIM)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
    (can-build-with-escrow BLDG-DROPANIM)
	(goal savetheanimals YES)
	(building-type-count-total BLDG-DROPANIM < 4)
	(goal savetheanimals-nursery FOUR)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
    (build BLDG-DROPANIM)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
    (can-build-with-escrow BLDG-DROPANIM)
	(goal savetheanimals YES)
	(building-type-count-total BLDG-DROPANIM < 5)
	(goal savetheanimals-nursery FIVE)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
    (build BLDG-DROPANIM)
)

(defrule
	(nursery-headroom < 1)
    (can-build-with-escrow BLDG-DROPANIM)
	(unit-type-count GAIA-ANIMAL-HERD-LINE > 0)
	(or
		(game-time > 800) 
		(unit-type-count GAIA-ANIMAL-HERD-LINE > 40) ; map with bananas nerf gen
	)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
    (build BLDG-DROPANIM) ; generic non-save-the-animals check for if they get some lategame and yes they have to be escrow'd
)						

; build one spare in T2 if you have none to get that mountie requirement
(defrule
	(building-type-count BLDG-MAIN > 0)
    (can-build BLDG-DROPANIM)
	(building-type-count-total BLDG-DROPANIM == 0)
	(not (current-age == tech-level-1))
	(not (goal buildpause YES))
=>
    (build BLDG-DROPANIM)
	(disable-self)
)

; Rush and Defensive can still need one late TL1 nursery to stop their opener from
; collapsing into farms when herdables are present but the early save-the-animals
; pass never locked in.
(defrule
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(building-type-count BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-DROPANIM == 0)
	(game-time > 120)
    (can-build-with-escrow BLDG-DROPANIM)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
    (build BLDG-DROPANIM)
)

; if we have any animals, but no space for them
; check is no longer for just T1, but for the first 5min of the game
; to avoid issues on later TL starts
(defrule
	(unit-type-count GAIA-ANIMAL-HERD-LINE > 0)
	(building-type-count BLDG-DROPANIM < 1)
	(or
		(game-time < 300)
		(current-age == tech-level-1)
	)
=>
	(set-goal savetheanimals YES)
	(set-goal savetheanimals-nursery ONE)
)

(defrule
	(unit-type-count GAIA-ANIMAL-HERD-LINE > 10)
	(building-type-count BLDG-DROPANIM < 2)
	(or
		(game-time < 300)
		(current-age == tech-level-1)
	)
=>
	(set-goal savetheanimals YES)
	(set-goal savetheanimals-nursery TWO)
)

(defrule
	(unit-type-count GAIA-ANIMAL-HERD-LINE > 20)
	(building-type-count BLDG-DROPANIM < 3)
	(or
		(game-time < 300)
		(current-age == tech-level-1)
	)
=>
	(set-goal savetheanimals YES)
	(set-goal savetheanimals-nursery THREE)
)

(defrule
	(unit-type-count GAIA-ANIMAL-HERD-LINE > 30) ; if somehow
	(building-type-count BLDG-DROPANIM < 4)
	(or
		(game-time < 300)
		(current-age == tech-level-1)
	)
=>
	(set-goal savetheanimals YES)
	(set-goal savetheanimals-nursery FOUR)
)

(defrule
	(unit-type-count GAIA-ANIMAL-HERD-LINE > 40) ; whaaa
	(building-type-count BLDG-DROPANIM < 5)
	(or
		(game-time < 300)
		(current-age == tech-level-1)
	)
=>
	(set-goal savetheanimals YES)
	(set-goal savetheanimals-nursery FIVE)
)

(defrule
	(goal savetheanimals YES)
	(or 								; one of the following must be true
		(game-time < 480) ; 8min
		(current-age == tech-level-1) 	; only destroy your food eco in T1, thanks
	)
=>
	
	(set-strategic-number sn-carbon-gatherer-percentage 100)
	(set-strategic-number sn-food-gatherer-percentage 0)
	(set-strategic-number sn-mill-max-distance 10) ; should hopefully keep animal nurseries close to home
)

; Verified lure-food starts still need workers on food even if herdable
; protection is active. Otherwise Kath-style maps can collapse into all carbon.
(defrule
	(current-age == tech-level-1)
	(goal allowgarbage LOWLUREFOOD)
	(game-time > 90)
	(not (strategic-number sn-food-gatherer-percentage == 55))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 35)
	(set-strategic-number sn-food-gatherer-percentage 55)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

; override in case things have completely broken

(defrule
	(goal savetheanimals YES)
	(game-time > 600) ; 10min
	(carbon-amount > 1000) ; been chopping carbon forever (OR deathmatch, so watch out for that)
	(or
		(current-age == tech-level-1)
		(current-age == tech-level-2) ; very unlikely this'll happen in T2
	)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 20)
	(set-strategic-number sn-food-gatherer-percentage 80) ; sorry ... 
	(set-goal savetheanimals NO)
)

; wait until we have a nursery for them - or nurseries, plural
; there was logic to try to split "nursery is under construction" vs "nursery is built"
; but that was mostly just A Mess

(defrule
	(goal savetheanimals YES)
	(goal savetheanimals-nursery ONE)
	(building-type-count BLDG-DROPANIM > 0)
	=> 
	(set-goal savetheanimals WAITING)
	(set-strategic-number sn-mill-max-distance 17)
	(enable-timer t-nerfs 40) ; timer for nerfs to get home safely
)


(defrule
	(goal savetheanimals YES)
	(goal savetheanimals-nursery TWO)
	(building-type-count BLDG-DROPANIM > 1)
	=> 
	(set-goal savetheanimals WAITING)
	(set-strategic-number sn-mill-max-distance 17)
	(enable-timer t-nerfs 60)
)

(defrule
	(goal savetheanimals YES)
	(goal savetheanimals-nursery THREE)
	(building-type-count BLDG-DROPANIM > 2)
	=> 
	(set-goal savetheanimals WAITING)
	(set-strategic-number sn-mill-max-distance 17)
	(enable-timer t-nerfs 60)
	
)

(defrule
	(goal savetheanimals YES)
	(goal savetheanimals-nursery FOUR)
	(building-type-count BLDG-DROPANIM > 3)
	=> 
	(set-goal savetheanimals WAITING)
	(set-strategic-number sn-mill-max-distance 17)
	(enable-timer t-nerfs 60)
)

(defrule
	(goal savetheanimals YES)
	(goal savetheanimals-nursery FIVE)
	(building-type-count BLDG-DROPANIM > 4)
	=> 
	(set-goal savetheanimals WAITING)
	(set-strategic-number sn-mill-max-distance 17)
	(enable-timer t-nerfs 60)
)



(defrule
	(timer-triggered t-nerfs)
	(goal savetheanimals WAITING)
=>
	(disable-timer t-nerfs)
	(set-goal savetheanimals NO)
	(set-strategic-number sn-carbon-gatherer-percentage 25)
	(set-strategic-number sn-food-gatherer-percentage 55) ; unleash the hounds!
	;(set-strategic-number sn-nova-gatherer-percentage 0)
	;(set-strategic-number sn-metal-gatherer-percentage 0) ; manual reset since the rules below may have fired
)


(defrule
	(timer-triggered t-nerfs)
	(goal savetheanimals YES)
=>
	(disable-timer t-nerfs)
)

; so the reason for the second rule
; consider this
; AI finds 8 nerfs, and builds a nursery. Tada, done, start the timer and let them get in safely
; AI finds more nerfs. Oh no, we need a second nursery. Savetheanimals goes back to YES.
; TIMER STILL GOES OFF
; and says EAT THE LOT


; 
; ACTUAL RESOURCE SWITCHING GOES HERE
;
;
;
;
;




; tech 1 

; does NOT use resource switching
; but rather a "what basis are we and what should we be doing" typa thing

; because the AI CANNOT LURE
; it goes onto farms
; which causes it to eat WAY more carbon than a player would


; so, after a minute, push harder to food/hunt instead of camping berries/carbon
(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(game-time > 90)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 35)
	(set-strategic-number sn-food-gatherer-percentage 55)
	;(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
	(disable-self)
)

; Fund the first Power Core and Troop Center through visible gatherer assignment
; instead of leaning on early carbon refunds.
(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(or
		(building-type-count-total BLDG-POWERCORE == 0)
		(building-type-count-total BLDG-TRAINTROOPER == 0)
	)
	(carbon-amount < 220)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-carbon-gatherer-percentage == 55))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 55)
	(set-strategic-number sn-food-gatherer-percentage 35)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

; if a shipyard is in play, go harder on the carbon

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-TRAINBOAT > 0)
	(game-time > 90)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 45)
	(set-strategic-number sn-food-gatherer-percentage 45)
	;(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
	(disable-self)
)


; this rule almost never fires because of the carbon check - the AI constantly spends carbon on
; prefabs, farms
; troopers, troop center, second power core
; possibly nova proc in T1
(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0) 
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)		; All relevant T1 buildings done
	(building-type-count-total BLDG-DROPCARBON > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(carbon-amount > 300) ; So all buildings done and some carbon to spare
=>
	(set-strategic-number sn-carbon-gatherer-percentage 25) ; need to afford farms and prefabs
	(set-strategic-number sn-food-gatherer-percentage 65)  ; it's actually quite a lot of carb
	(disable-self)
)

; the ONLY way this can fire is on a map with no other food except Food Stockpiles with 250f each
; that way the AI does not build too many farms because it is eating berries for days
(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0) 
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(carbon-amount > 500) ; lotsa carbon
=>
	(set-strategic-number sn-carbon-gatherer-percentage 5) 
	(set-strategic-number sn-food-gatherer-percentage 75)  
	(disable-self)
)


(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(goal agingup YES) ; if we're advancing to T2, allow some more carbon gatherers again
=>
	(set-strategic-number sn-carbon-gatherer-percentage 45)
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-nova-gatherer-percentage 15)
	(set-strategic-number sn-metal-gatherer-percentage 0)
	(disable-self)
)

; Rush frontloads nova in TL1 so it can keep pressure and pick up early techs.
(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-DROPNOVA == 0)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-nova-gatherer-percentage == 0))
=>
	(set-strategic-number sn-nova-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-carbon-gatherer-percentage == 35))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 35)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-food-gatherer-percentage == 50))
=>
	(set-strategic-number sn-food-gatherer-percentage 50)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPNOVA > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (unit-type-count-total UNIT-WORKER > 20))
	(not (strategic-number sn-nova-gatherer-percentage == 0))
=>
	(set-strategic-number sn-nova-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPNOVA > 0)
	(unit-type-count-total UNIT-WORKER > 20)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-nova-gatherer-percentage == 15))
=>
	(set-strategic-number sn-nova-gatherer-percentage 15)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-metal-gatherer-percentage == 0))
=>
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

; Defensive gives up TL1 nova/ore so it can hit TL2 with cleaner carbon/food flow.
; Mining ore before aging up pulls workers off the spine buildings too early.
(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-carbon-gatherer-percentage == 35))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 35)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-food-gatherer-percentage == 50))
=>
	(set-strategic-number sn-food-gatherer-percentage 50)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-MAIN > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-nova-gatherer-percentage == 0))
=>
	(set-strategic-number sn-nova-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPMETAL == 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-metal-gatherer-percentage == 0))
=>
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(goal agingup NO)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-metal-gatherer-percentage == 0))
=>
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(goal agingup YES)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (unit-type-count-total UNIT-WORKER > 20))
	(not (strategic-number sn-metal-gatherer-percentage == 10))
=>
	(set-strategic-number sn-metal-gatherer-percentage 10)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(goal agingup YES)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(unit-type-count-total UNIT-WORKER > 20)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-metal-gatherer-percentage == 15))
=>
	(set-strategic-number sn-metal-gatherer-percentage 15)
)

; nova for general purpose in T1
(defrule
	(current-age == tech-level-1)
	(not (goal openingstyle STYLE-RUSH))
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-DROPNOVA > 0)
	(not (unit-type-count-total UNIT-WORKER > 20))
	(not (strategic-number sn-nova-gatherer-percentage == 0))
	(or
		(and
			(goal agingup NO)
			(nova-amount < 50)
		)
		(and
			(goal agingup YES)
			(nova-amount < 200)
		)
	)
=>
	(set-strategic-number sn-nova-gatherer-percentage 0)
)

; Final TL1 correction after personality rules: if the opener is still missing
; its first Power Core or Troop Center, bias workers back to carbon briefly.
(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(or
		(building-type-count-total BLDG-POWERCORE == 0)
		(building-type-count-total BLDG-TRAINTROOPER == 0)
	)
	(carbon-amount < 220)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-carbon-gatherer-percentage == 55))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 55)
	(set-strategic-number sn-food-gatherer-percentage 35)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(not (goal openingstyle STYLE-RUSH))
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-DROPNOVA > 0)
	(unit-type-count-total UNIT-WORKER > 20)
	(not (strategic-number sn-nova-gatherer-percentage == 15))
	(or
		(and
			(goal agingup NO)
			(nova-amount < 50)
		)
		(and
			(goal agingup YES)
			(nova-amount < 200)
		)
	)
=>
	(set-strategic-number sn-nova-gatherer-percentage 15)
)

(defrule
	(current-age == tech-level-1)
	(not (goal openingstyle STYLE-RUSH))
	(not (goal openingstyle STYLE-DEFENSIVE))
	(goal agingup NO) ; allow continually mining nova if we're en route to TL2
	(nova-amount > 100)
	(not (strategic-number sn-nova-gatherer-percentage == 0))
=>
	(set-strategic-number sn-nova-gatherer-percentage 0)
)



; Late TL1 worker-count correction. Once the opener spine is online, stop
; parking double-digit worker counts on carbon and push the surplus to food.
(defrule
	(current-age == tech-level-1)
	(unit-type-count-total UNIT-WORKER > 10)
	(food-amount < 120)
	(carbon-amount > 300)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 15)
	(set-strategic-number sn-food-gatherer-percentage 85)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(unit-type-count-total UNIT-WORKER > 9)
	(not (unit-type-count-total UNIT-WORKER > 19))
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 25)
	(set-strategic-number sn-food-gatherer-percentage 75)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-DROPNOVA == 0)
	(unit-type-count-total UNIT-WORKER > 19)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 25)
	(set-strategic-number sn-food-gatherer-percentage 75)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-DROPNOVA > 0)
	(unit-type-count-total UNIT-WORKER > 19)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 20)
	(set-strategic-number sn-food-gatherer-percentage 65)
	(set-strategic-number sn-nova-gatherer-percentage 15)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

; Final TL1 starvation override. This must sit after the normal TL1 spine rules
; because those rules can otherwise restore a carbon-heavy split while food is low.
(defrule
	(current-age == tech-level-1)
	(unit-type-count-total UNIT-WORKER > 12)
	(food-amount < 150)
	(carbon-amount > 600)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-food-gatherer-percentage == 95))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 5)
	(set-strategic-number sn-food-gatherer-percentage 95)
	(set-strategic-number sn-nova-gatherer-percentage 0)
	(set-strategic-number sn-metal-gatherer-percentage 0)
)

; tech 2
; does not use (much) resource switching
; but rather a "get enough carb for our buildings"
; "and then go on food"

(defrule
	(current-age == tech-level-2)
	(unit-type-count BOAT-WORKER < 5) ; if our fishing fleet is nonexistent
	(game-time > latestart-nerf-timeout)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 40)
	(set-strategic-number sn-food-gatherer-percentage 35)
	(set-strategic-number sn-nova-gatherer-percentage 20)
	(set-strategic-number sn-metal-gatherer-percentage 5)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count BOAT-WORKER >= 5) ; if we have a functioning fishing fleet
	(game-time > latestart-nerf-timeout)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 45)
	(set-strategic-number sn-food-gatherer-percentage 25)
	(set-strategic-number sn-nova-gatherer-percentage 25)
	(set-strategic-number sn-metal-gatherer-percentage 5)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(game-time > latestart-nerf-timeout)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-TRAINJEDI > 0) 
	(building-type-count-total BLDG-TRAINMECH > 0)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-WARCTR > 0)
	(carbon-amount > 250) ; So all buildings done and some carbon to spare
=>
	(set-strategic-number sn-carbon-gatherer-percentage 30) 
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-nova-gatherer-percentage 25)
	(set-strategic-number sn-metal-gatherer-percentage 5)
	(disable-self)
)

; nova for general purpose
(defrule
	(current-age == tech-level-2)
	(nova-amount < 300)
	(carbon-amount > 100) ; only if we have enough-ish of other res
	(food-amount > 50)
	(not (strategic-number sn-nova-gatherer-percentage == 25))
=>
	(set-strategic-number sn-nova-gatherer-percentage 25)
)

(defrule
