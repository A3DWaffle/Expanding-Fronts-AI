=>
	(set-strategic-number sn-metal-gatherer-percentage 5)
)

; TL2 carbon/food parity override. This intentionally sits after the normal TL2
; personality mixes so a large carbon bank cannot strand the food economy.
(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-WORKER > 10)
	(food-amount < 200)
	(carbon-amount > 600)
	(not (strategic-number sn-food-gatherer-percentage == 60))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 15)
	(set-strategic-number sn-food-gatherer-percentage 60)
	(set-strategic-number sn-nova-gatherer-percentage 15)
	(set-strategic-number sn-metal-gatherer-percentage 5)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-WORKER > 10)
	(food-amount < 75)
	(carbon-amount > 300)
	(not (strategic-number sn-food-gatherer-percentage == 75))
=>
	(set-strategic-number sn-carbon-gatherer-percentage 10)
	(set-strategic-number sn-food-gatherer-percentage 75)
	(set-strategic-number sn-nova-gatherer-percentage 10)
	(set-strategic-number sn-metal-gatherer-percentage 0)
