; If treaty is active, set allies

(defrule
	(not
		(or
			(shared-goal treatytimer 0)
			(shared-goal treatytimer 1)
		)
	)
	(or
		(stance-toward any-human neutral)
		(stance-toward any-human enemy)
	)
	(game-time > 10)
=>
	(set-stance this-any-human ally)
	(chat-to-player this-any-human "This alliance will last... for as long as the treaty.")
)
(defrule
	(not
		(or
			(shared-goal treatytimer 0)
			(shared-goal treatytimer 1)
		)
	)
	(or
		(stance-toward any-computer neutral)
		(stance-toward any-computer enemy)
	)
	(game-time > 10)
=>
	(set-stance this-any-computer ally)
	(chat-to-player this-any-computer "BOT: This alliance will last... for as long as the treaty.")
)

; when treaty times out, reset diplo
; setting to ally not needed as is already the setting

(defrule
	(shared-goal treatytimer 1)
	(goal 51 neutral)
=>
	(set-stance 1 neutral)
	(disable-self) ; should avoid several issues
)
(defrule
	(shared-goal treatytimer 1)
	(goal 51 enemy)
=>
	(set-stance 1 enemy)
	(disable-self) 
)

(defrule
