; =====================================================
; FILE: diplomacy
; PURPOSE:
;   Mirrors diplomacy state and handles alliance, enemy, and tribute behavior.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: LOGIC
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

#load-if-not-defined TEAMS-LOCKED
(defrule
        (true)
=>
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 120)
        (disable-self)
)

(defrule
        (current-age >= tech-level-2)
        (players-stance any-computer-ally neutral)
		(goal scn-detected NO)
		(game-time > 20)
=>
        (set-stance this-any-computer-ally neutral)
)

(defrule
        (current-age >= tech-level-2)
        (players-stance any-computer-ally enemy)
		(goal scn-detected NO)
		(game-time > 20)
=>
        (set-stance this-any-computer-ally enemy)
)

(defrule
        (current-age >= tech-level-2)
        (players-stance any-computer-neutral ally)
		(goal scn-detected NO)
		(game-time > 20)
=>
        (set-stance this-any-computer-neutral ally)
)

(defrule
        (current-age >= tech-level-2)
        (players-stance any-computer-neutral enemy)
		(goal scn-detected NO)
		(game-time > 20)
=>
        (set-stance this-any-computer-neutral enemy)
)

(defrule
        (current-age >= tech-level-2)
        (players-stance any-computer-enemy ally)
		(goal scn-detected NO)
		(game-time > 20)
=>
        (set-stance this-any-computer-enemy ally)
)

(defrule
        (current-age >= tech-level-2)
        (players-stance any-computer-enemy neutral)
		(goal scn-detected NO)
		(game-time > 20)
=>
        (set-stance this-any-computer-enemy neutral)
)

;************

;*******************************************************
;BASIC DIPLOMACY VS. HUMANS

(defrule
	(goal scn-detected YES)
=>
	(set-goal get-mad UNDEFINED)
	(disable-timer t-chathelp) ; should stop all the below from firing
	(disable-self)
)


;if the human player doesn't go neutral at our request
(defrule
        (goal get-mad NO)
        (timer-triggered t-chathelp)
        (players-stance any-human-neutral enemy)
=>
        (chat-to-player-using-id this-any-human-neutral 22027)
                ;"41 We are Neutral to you.  Please set your diplomacy to Neutral to us."
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 120)
        (set-goal get-mad ANGRY)
)

(defrule
        (or
                (goal get-mad ANGRY) 
                (or
                        (goal get-mad ANGRIER)
                        (goal get-mad ANGRIEST)
                )
        )
        (or
                (players-stance any-human-neutral neutral)
                (players-stance any-human-neutral ally)
        )
=>
        (chat-to-player-using-id this-any-human-neutral 22028)
                ;"39 Welcome aboard."
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 120)
        (set-goal get-mad NO)
)

(defrule
        (goal get-mad ANGRY)
        (timer-triggered t-chathelp)
        (players-stance any-human-neutral enemy)
=>
        (set-goal get-mad ANGRIER)
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 120)
        (chat-to-player-using-id this-any-human-neutral 22030)
                ;"41 So you choose to ignore my good will?  I'll give you one more chance."
)

(defrule
        (goal get-mad ANGRIER)
        (timer-triggered t-chathelp)
        (players-stance any-human-neutral enemy)
=>
        (set-goal get-mad ANGRIEST)
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 120)
        (chat-to-player-using-id this-any-human-neutral 22032)
                ;"41 You do not have any other alternative - set your stance to Neutral towards me."
)

(defrule
        (goal get-mad ANGRIEST)
        (timer-triggered t-chathelp)
        (players-stance any-human-neutral enemy)
=>
        (set-goal get-mad YES)
        (chat-to-player-using-id this-any-human-neutral 22025)
                ;"40 We do not look kindly on your lack of good faith." 
        (set-stance this-any-human-neutral enemy)
        (set-stance every-computer ally)
        (disable-timer t-chathelp)
        (disable-self)
)

;when an ally turns on us
; to neutral
(defrule
        (goal get-mad NO)
        (players-stance any-human-ally neutral)
        ;(players-stance any-human-ally enemy)
=>
        ;(chat-to-player-using-id this-any-human-ally 22147) ;"39 I have professed my friendship.  Now set your stance to Ally as well."
		(chat-to-player this-any-human-ally "89 You are my Ally! Please set your stance to Ally as well.")
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 30)
        (set-goal get-mad ANGRY)
)

; to enemy (bypass first stage)
(defrule
        (goal get-mad NO)
        ; (players-stance any-human-ally neutral)
        (players-stance any-human-ally enemy)
=>
        (set-goal get-mad ANGRIER)
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 30)
        ;(chat-to-player-using-id this-any-human-ally 22149) ;"41 I sense a deception.  You're still not my Ally?"
		(chat-to-player this-any-human-ally "243 I sense a deception. Please set your stance towards me to Ally!")
)

(defrule
        (or
                (goal get-mad ANGRY) 
                (or
                        (goal get-mad ANGRIER)
                        (goal get-mad ANGRIEST)
                )
        )
        (players-stance any-human-ally ally)
=>
        ; (chat-to-player-using-id this-any-human-ally 22148) ;"39 Thanks for remaining my Ally."
		(chat-to-player this-any-human-ally "202 Thank you for remaining my Ally.")
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 120)
        (set-goal get-mad NO)
)

(defrule
        (goal get-mad ANGRY)
        (timer-triggered t-chathelp)
        (or
                (players-stance any-human-ally neutral)
                (players-stance any-human-ally enemy)
        )
=>
        (set-goal get-mad ANGRIER)
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 30)
        ;(chat-to-player-using-id this-any-human-ally 22149) ;"41 I sense a deception.  You're still not my Ally?"
		(chat-to-player this-any-human-ally "243 I sense a deception. Please set your stance towards me to Ally!")
)

(defrule
        (goal get-mad ANGRIER)
        (timer-triggered t-chathelp)
        (or
                (players-stance any-human-ally neutral)
                (players-stance any-human-ally enemy)
        )
=>
        (set-goal get-mad ANGRIEST)
        (disable-timer t-chathelp)
        (enable-timer t-chathelp 30)
        ;(chat-to-player-using-id this-any-human-ally 22151) ;"41 You're dark indeed.  I'm running out of patience."
		(chat-to-player this-any-human-ally "92 The Dark Side flows through you! Set your stance to Ally. Now.")
)

(defrule
        (goal get-mad ANGRIEST)
        (timer-triggered t-chathelp)
        (or
                (players-stance any-human-ally neutral)
                (players-stance any-human-ally enemy)
        )
=>
        (set-goal get-mad YES)
        ; (chat-to-player-using-id this-any-human-ally 22025) ;"40 We do not look kindly on your lack of good faith." 
		(chat-to-player this-any-human-ally "293 We do not look kindly on your lack of good faith.")
        (set-stance this-any-human-ally enemy)
        (set-stance every-computer ally)
        (disable-timer t-chathelp)
        (disable-self)
)

; if neutral to human, but no bots left in game, go enemy
(defrule
        (stance-toward any-human neutral)
        (nor
                (player-in-game any-computer-ally)
                (or
                        (player-in-game any-computer-enemy)
                        (player-in-game any-computer-neutral)
                )
        )
		(goal scn-detected NO)
=>
        (set-goal get-mad YES)
        (chat-to-player-using-id this-any-human 22034)
                ;"40 Your chances have just run out."
        (set-stance this-any-human enemy)
        (disable-timer t-chathelp)
        (disable-self)
)




; TREATY SHENANIGANS

; Check alliances at game start

(defrule
	(true)
=>
	(set-goal 51 99)
	(set-goal 52 99)
	(set-goal 53 99)
	(set-goal 54 99)
	(set-goal 55 99)
	(set-goal 56 99)
	(set-goal 57 99)
	(set-goal 58 99)
	(disable-self) ;aaaaaaaaaaaaaaaaaaaaa
)

(defrule
	(game-time < 10)
	(not (player-number 1))
	(stance-toward 1 ally)
=>
	(set-goal 51 ally)
	(disable-self)
)
