; if this is reached,
; the population limit checker broke and doesn't know what to set itself to
; use defaults of 75

(defrule
	(game-time > 2)
	=>
	(chat-to-all "WARNING: Population limit check broke, defaulting to 75. ")
	(chat-to-all "Check that the population limit is what it's supposed to be.")
	(chat-to-all "Do not use the Restart button, instead exit all the way to the main menu and re-enter.")
	(disable-self)
)


