; =====================================================
; FILE: research-center
; PURPOSE:
;   Builds Research Centers and researches Research Center-owned techs.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: CORE TECHS
;	Chapter 2: UNIQUE TECHS
;	Chapter 3: DEFENSIVE TECHS
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(current-age >= tech-level-3)
	(building-type-count BLDG-MAIN > 2)
	(building-type-count-total BLDG-RESCTR < 1)
	(can-build-with-escrow BLDG-RESCTR)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-RESCTR)
)

(defrule
	(current-age == tech-level-4)
	(building-type-count-total BLDG-RESCTR == 1)
	(can-build-with-escrow BLDG-RESCTR)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-RESCTR)
)

; -----------------------------------------------------
; *** Chapter 1: CORE TECHS ***
; -----------------------------------------------------

(defrule
    ; Homing Sensors
	(can-research-with-escrow rt-homing-sensors)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-homing-sensors)
)

(defrule
    ; Tracking and Targeting Computers
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-tracking-computer)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-tracking-computer)
)

(defrule
	; Durasteel Reinforced Support Beams
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-research-with-escrow rt-durasteel)
	(goal importantT4research DONE)
	(military-population >= MIL_POP_B)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-durasteel)
)

(defrule
    ; Permacite Plating
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-permacite-plating)
	(goal importantT4research DONE)
	(military-population >= MIL_POP_B)
=>
	(release-escrow metal)
	(release-escrow food)
	(research rt-permacite-plating)
)

(defrule
    ; Power Calibrator
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-power-calibrator)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-power-calibrator)
)

(defrule
	; Hvy Weapons Engineers
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-hvy-weapons-engineers)
	(building-type-count-total BLDG-TRAINHEAVY > 0)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-hvy-weapons-engineers)
)

; -----------------------------------------------------
; *** Chapter 2: UNIQUE TECHS ***
; -----------------------------------------------------

(defrule
    ; CF Droid Upgrades
    (current-age >= tech-level-4)
    (can-research-with-escrow rt-droidupg)
	(goal importantT4research DONE)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal combat-arm MECH)
				(or
					(goal combat-arm MECH/HW)
					(goal support-assault-mech YES)
				)
			)
		)
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
    (research rt-droidupg)
)

(defrule
    ; RA Evacuation Protocols
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-evac)
	(goal importantT4research DONE)
	(military-population >= MIL_POP_A)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-evac)
)

(defrule
    ; IR Fortress Worlds
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-fortressworlds)
	(goal importantT4research DONE)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-fortressworlds)
)

(defrule
    ; FO Advanced Torpedoes
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-adv-torpedoes)
	(goal importantT4research DONE)
	(not (goal enemyairsighted AIR-ALERT-NONE))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-adv-torpedoes)
)

; -----------------------------------------------------
; *** Chapter 3: DEFENSIVE TECHS ***
; -----------------------------------------------------

(defrule
	; Rotation Bearings
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-rotation-bearings)
	(military-population >= MIL_POP_A)
	(or
		(goal importantT4research DONE)
		(goal openingstyle STYLE-DEFENSIVE)
	)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-rotation-bearings)
)

(defrule
	; Ion Accu-Accelerator
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-ion-accelerator)
	(military-population >= MIL_POP_A)
	(or
		(goal importantT4research DONE)
		(goal openingstyle STYLE-DEFENSIVE)
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-ion-accelerator)
)
