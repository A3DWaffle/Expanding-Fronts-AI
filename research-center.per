; =====================================================
; FILE: research-center
; PURPOSE:
;   Builds Research Centers and researches Research Center-owned techs.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: CORE TECHS
;	Chapter 2: UNIQUE TECHS
;	Chapter 3: DEFENSIVE TECHS
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(current-age >= tech-level-3)
	(building-type-count BLDG-MAIN > 3)
	(building-type-count-total BLDG-RESCTR == 0)
	(can-build-with-escrow BLDG-RESCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-RESCTR)
)

(defrule
	(current-age == tech-level-4)
	(building-type-count-total BLDG-RESCTR == 1)
	(or
		(military-population >= MIL_POP_A)
		(current-age-time > 360)
	)
	(can-build-with-escrow BLDG-RESCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-RESCTR)
)

; -----------------------------------------------------
; *** Chapter 1: CORE TECHS ***
; -----------------------------------------------------

(defrule
    ; Homing Sensors
	(current-age >= tech-level-4)
	(not (goal enemyairsighted AIR-ALERT-LOW))
	(can-research-with-escrow rt-homing-sensors)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-homing-sensors)
)

(defrule
    ; Tracking and Targeting Computers
	(current-age >= tech-level-3)
	(military-population >= MIL_POP_A)
	(can-research-with-escrow rt-tracking-computer)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-tracking-computer)
)

(defrule
	; Durasteel Reinforced Support Beams
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-research-with-escrow rt-durasteel)
	(military-population >= MIL_POP_B)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-durasteel)
)

(defrule
    ; Permacite Plating
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-permacite-plating)
	(military-population >= MIL_POP_B)
=>
	(release-escrow metal)
	(release-escrow food)
	(research rt-permacite-plating)
)

(defrule
    ; Power Calibrator
	(current-age >= tech-level-4)
	(military-population >= MIL_POP_B)
	(can-research-with-escrow rt-power-calibrator)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-power-calibrator)
)

; Hvy Weapons Engineers: existing Artillery/AA packages OR the map's Cannon P1.
; Cannons come from Fortresses and do not require a Heavy Weapons Factory.
; Existing and queued units count, matching the original upgrade prerequisites.
(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-hvy-weapons-engineers)
	(goal special-map LAND)
	(or
		(and
			(or
				(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2)
				(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p2)
			)
			(building-type-count-total BLDG-TRAINHEAVY > 0)
		)
		(and
			(unit-type-count-total SIEGE-CANNON-LINE > 0)
			(unit-type-count-total SIEGE-CANNON-LINE >= TL4-cannon-arm-p1)
		)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-hvy-weapons-engineers)
)

(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-hvy-weapons-engineers)
	(goal special-map WATER)
	(or
		(and
			(or
				(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2)
				(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p2)
			)
			(building-type-count-total BLDG-TRAINHEAVY > 0)
		)
		(and
			(unit-type-count-total SIEGE-CANNON-LINE > 0)
			(unit-type-count-total SIEGE-CANNON-LINE >= TL4-cannon-arm-p1-water)
		)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-hvy-weapons-engineers)
)

(defrule
	(current-age >= tech-level-4)
