(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-hvy-weapons-engineers)
	(goal special-map HYBRID)
	(or
		(and
			(or
				(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2)
				(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p2)
