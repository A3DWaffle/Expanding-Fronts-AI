	(goal raid-rule-check YES)
	(not (can-build-with-escrow BLDG-TRAINTROOPER))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (not (goal buildpause YES)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal raid-build-open YES))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)



