; =====================================================
; FILE: troop-center
; PURPOSE:
;   Builds Troop Centers, researches troop upgrades, and trains troop packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL1/TL2 UNITS
;	Chapter 4: TL3 PACKAGES
;	Chapter 5: TL4 PACKAGES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-TRAINTROOPER == 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(or
		(building-type-count-total BLDG-DROPANIM > 0)
		(or
			(not (goal savetheanimals YES))
			(game-time > 120)
		)
	)
	(or
		(not (goal special-map WATER))
		(or
			(building-type-count-total BLDG-TRAINBOAT > 0)
			(game-time > 300)
		)
	)
	(can-build-with-escrow BLDG-TRAINTROOPER)
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(goal agingup YES)
	(building-type-count-total BLDG-TRAINTROOPER < 2)
	(can-build-with-escrow BLDG-TRAINTROOPER)
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-TRAINTROOPER < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-WARCTR > 0)
	(can-build-with-escrow BLDG-TRAINTROOPER)
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

(defrule
	(current-age == tech-level-2)
	(not (goal openingstyle STYLE-RUSH))
	(building-type-count-total BLDG-TRAINTROOPER < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINMECH > 0)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(can-build-with-escrow BLDG-TRAINTROOPER)
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

; --- TL3/4 Troop Center ---
(defrule
	(or
		(current-age == tech-level-3)
		(current-age == tech-level-4)
	)
	(or
		(building-type-count-total BLDG-TRAINAIR >= 2)
		(building-type-count-total BLDG-MAIN >= 2)
	)
	(building-type-count-total BLDG-TRAINTROOPER < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINTROOPER)
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

; --- Troop package ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(goal support-grenadiers YES)
		)
	)
	(building-type-count-total BLDG-TRAINTROOPER < 5)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINTROOPER)
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

;=====================================================
; CHAPTER 2: UPGRADES
;=====================================================

; --- Trooper upgrades ---
(defrule
	(can-research-with-escrow ut-laser-2)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-laser-2)
)

(defrule
	(can-research-with-escrow ut-laser-3)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-laser-3)
)

(defrule
	(can-research-with-escrow ut-laser-4)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-laser-4)
)

; --- Mounted Trooper upgrades ---
(defrule
	(can-research-with-escrow ut-mounted-2)
	(research-completed rt-macrobinoculars)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-mounted-2)
)

(defrule
	(can-research-with-escrow ut-mounted-3)
	(research-completed rt-portable-scanners)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-mounted-3)
)

; --- AA Trooper upgrade ---
(defrule
	(can-research-with-escrow ut-missile-troop-2)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-missile-troop-2)
)

(defrule
	; Lighter Armor
	(can-research-with-escrow rt-lighter-armor)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(research rt-lighter-armor)
)

(defrule
	; Dexterity
	(can-research-with-escrow rt-dexterity)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-dexterity)
)

(defrule
    ; MacroBinoculars, Trooper Range TL2
	(can-research-with-escrow rt-macrobinoculars)
=>
	(release-escrow food)
	(research rt-macrobinoculars)
)

(defrule 
    ; Portable Scanners, Trooper Range TL3
	(or
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(current-age >= tech-level-3)
		)
		(and
			(goal openingstyle STYLE-DEFENSIVE)
			(current-age >= tech-level-4)
		)
	)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
	(can-research-with-escrow rt-portable-scanners)
=>
	(release-escrow food)
	(research rt-portable-scanners)
)

(defrule
    ; Integrated Rangefinder, Trooper Range TL4
	(can-research-with-escrow rt-integrated-rgefinder)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(research rt-integrated-rgefinder)
)

(defrule
    ; Droid Assistants
	(can-research-with-escrow rt-assembly-droids)
	(or
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(current-age >= tech-level-3)
		)
		(and
			(goal openingstyle STYLE-DEFENSIVE)
			(current-age >= tech-level-4)
		)
	)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-assembly-droids)
)

(defrule
    ; GN Binoculars
	(can-research-with-escrow rt-farseein-binoculars)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(research rt-farseein-binoculars)
)

(defrule
	; RA Plasma Detonators
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-plasma-detonators)
	(unit-type-count-total UNIT-GRENADE-LINE > 0)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-plasma-detonators)
)

(defrule
	; NR Veterancy
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-veterancy)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-veterancy)
)

(defrule
	; BS Mag-Det Enforcers
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-magdetenforcers)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-magdetenforcers)
)

(defrule
	; BS Disruptors
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-disruptors)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-disruptors)
)

(defrule
	; FO Indoctrination
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-indoctrination)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-indoctrination)
)

(defrule
	; FO Conflagrine-14
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-conflagrine)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-conflagrine)
)

(defrule
	; GO Enhanced Dexterity
	(can-research-with-escrow rt-enh-dexterity)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-enh-dexterity)
)

(defrule
	; Explosive Yields Increased
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-explosive-yields-inc)
	(goal importantT3research DONE)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-explosive-yields-inc)
)

;=====================================================
; CHAPTER 3: TL1 / TL2 OPENING UNITS
;=====================================================

; --- TL1 Gremlin Trick ---
(defrule
	(current-age == tech-level-1)
	(not (goal openingstyle STYLE-AGRESSIVE))
	(goal gremlintrick NO)
=>
	(set-goal gremlintrick GREMLINTRICK-ACTIVE)
	(disable-self)
)

(defrule
	(current-age == tech-level-1)
	(not (goal openingstyle STYLE-AGRESSIVE))
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(unit-type-count-total UNIT-MOUNTED-LINE < TL1-mounted-core)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

(defrule
	(current-age == tech-level-1)
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(unit-type-count-total UNIT-MOUNTED-LINE >= TL1-mounted-core)
=>
	(set-goal gremlintrick GREMLINTRICK-DONE)
)

; --- TL1 Trooper  ---
(defrule
	(current-age == tech-level-1)
	(unit-type-count-total UNIT-LASER-LINE < TL1-trooper-core)
	(food-amount > 80)
	(food-amount < 250)
	(or
		(and
			(not (goal openingstyle STYLE-AGRESSIVE))
			(not (goal gremlintrick GREMLINTRICK-ACTIVE))
		)
		(and
			(goal openingstyle STYLE-AGRESSIVE)
			(game-time > 90)
		)
	)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

; --- TL2 Trooper ---
(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-LASER-LINE < TL2-trooper-core-p1)
	(research-completed ut-laser-2)
	(research-completed rt-macrobinoculars)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-MOUNTED-LINE >= TL2-mounted-core-p1)
	(unit-type-count-total UNIT-LASER-LINE < TL2-trooper-core-p3) ;No need for ratio to match closely here.
	(research-completed ut-laser-2)
	(research-completed rt-macrobinoculars)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-MOUNTED-LINE >= TL2-mounted-core-p3)
	(unit-type-count-total UNIT-LASER-LINE < TL2-trooper-core-p4) ;No need for ratio to match closely here.
	(research-completed ut-laser-2)
	(research-completed rt-macrobinoculars)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

; --- TL2 Mounted Trooper ---
(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-LASER-LINE >= TL2-trooper-core-p1)
	(unit-type-count-total UNIT-MOUNTED-LINE < TL2-mounted-core-p1)
	(research-completed ut-laser-2)
	(research-completed rt-macrobinoculars)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-LASER-LINE >= TL2-trooper-core-p2)
	(unit-type-count-total UNIT-MOUNTED-LINE < TL2-mounted-core-p2)
	(research-completed ut-laser-2)
	(research-completed rt-macrobinoculars)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count-total UNIT-LASER-LINE >= TL2-trooper-core-p3)
	(unit-type-count-total UNIT-MOUNTED-LINE < TL2-mounted-core-p3)
	(research-completed ut-laser-2)
	(research-completed rt-macrobinoculars)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

; --- TL2 AA Trooper ---
(defrule
	(current-age == tech-level-2)
	(or
		(and
			(goal enemyairsighted AIR-ALERT-LOW)
			(unit-type-count-total UNIT-MISSILE-LINE < TL2-aa-trooper-detect-air-alert-low-p1)
		)
		(and
			(goal enemyairsighted AIR-ALERT-GUARD)
			(unit-type-count-total UNIT-MISSILE-LINE < TL2-aa-trooper-detect-air-alert-guard-p2)
		)
	)
	(can-train UNIT-MISSILE-LINE)
=>
	(train UNIT-MISSILE-LINE)
)

;=====================================================
; CHAPTER 4: TL3 TROOP PACKAGES
;=====================================================

;-----------------------
; TROOPERS
;-----------------------

; --- TL3 Trooper p1 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(unit-type-count-total UNIT-MECH1-LINE > 0)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-LASER-LINE < TL3-trooper-core-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-LASER-LINE < TL3-trooper-core-p1-water)
		)
	)
	(research-completed ut-laser-3)
	(research-completed rt-portable-scanners)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

; --- TL3 Trooper p2 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal importantT3research DONE)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-LASER-LINE < TL3-trooper-core-p2)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-LASER-LINE < TL3-trooper-core-p2-water)
		)
	)
	
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

; -----------------------
; GRENADIERS
; -----------------------

; --- TL3 Grenadier p1 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p1)
				(unit-type-count-total UNIT-GRENADE-LINE < TL3-grenade-core-p1)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p1-water)
				(unit-type-count-total UNIT-GRENADE-LINE < TL3-grenade-core-p1-water)
			)
		)
	)
	(research-completed ut-laser-3)
	(research-completed rt-portable-scanners)
	(can-train UNIT-GRENADE-LINE)
=>
	(train UNIT-GRENADE-LINE)
)

; --- TL3 Grenadier p2 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
	(goal enemymechsighted MECH-ALERT-P2)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p2)
				(unit-type-count-total UNIT-GRENADE-LINE < TL3-grenade-core-p2)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p2-water)
				(unit-type-count-total UNIT-GRENADE-LINE < TL3-grenade-core-p2-water)
			
			)
		)
	)
	(can-train UNIT-GRENADE-LINE)
=>
	(train UNIT-GRENADE-LINE)
)

; -----------------------
; MOUNTED TROOPERS
; -----------------------

; --- TL3 Mounted p1 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p1)
				(unit-type-count-total UNIT-MOUNTED-LINE < TL3-mounted-core-p1)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p1-water)
				(unit-type-count-total UNIT-MOUNTED-LINE < TL3-mounted-core-p1-water)
			)
		)
	)
	(research-completed ut-laser-3)
	(research-completed rt-portable-scanners)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

; --- TL3 Mounted p2 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm TROOP)
	)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p2)
				(unit-type-count-total UNIT-MOUNTED-LINE < TL3-mounted-core-p2)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p2-water)
				(unit-type-count-total UNIT-MOUNTED-LINE < TL3-mounted-core-p2-water)
			)
		)
	)
	(research-completed ut-laser-3)
	(research-completed rt-portable-scanners)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

; -----------------------
; AA TROOPERS
; -----------------------

; --- TL3 AA Trooper air-alert low ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal enemyairsighted AIR-ALERT-LOW)
