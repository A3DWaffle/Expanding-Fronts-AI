; --- Trooper upgrades ---
(defrule
	(can-research-with-escrow ut-laser-2)
	(current-age >= tech-level-2)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-laser-2)
)

(defrule
	(can-research-with-escrow ut-laser-3)
	(current-age >= tech-level-3)
	(or (goal support-repeater YES) (goal support-mounted YES))
	(or
		(research-completed ut-laser-2)
		(not (research-available ut-laser-2))
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-laser-3)
)

(defrule
	(can-research-with-escrow ut-laser-4)
	(current-age >= tech-level-4)
	(goal support-repeater YES)
	(or
		(research-completed ut-laser-3)
		(not (research-available ut-laser-3))
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-laser-4)
)

; --- Mounted Trooper upgrades ---
(defrule
	(can-research-with-escrow ut-mounted-2)
	(current-age >= tech-level-2)
	(research-completed rt-macrobinoculars)
	(unit-type-count-total UNIT-MOUNTED-LINE >= TL2-mounted-core-p1)
	(goal mounted-upgrade-ready YES)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-mounted-2)
)

(defrule
	(can-research-with-escrow ut-mounted-3)
	(current-age >= tech-level-3)
	(goal support-mounted YES)
	(unit-type-count-total UNIT-MOUNTED-LINE >= TL4-mounted-supp-p1)
	(or
		(research-completed ut-mounted-2)
		(not (research-available ut-mounted-2))
	)
	(goal mounted-upgrade-ready YES)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-mounted-3)
)

; --- AA Trooper upgrade ---
(defrule
	(current-age >= tech-level-3)
	(can-research-with-escrow ut-missile-troop-2)
	(research-completed rt-portable-scanners)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-missile-troop-2)
)

(defrule
	; Lighter Armor
	(can-research-with-escrow rt-lighter-armor)
	(current-age >= tech-level-3)
	(or
		(unit-type-count-total UNIT-LASER-LINE >= TL3-trooper-core-p1)
		(or
			(unit-type-count-total UNIT-MOUNTED-LINE >= TL3-mounted-core-p1)
			(or
				(unit-type-count-total UNIT-GRENADE-LINE >= TL3-grenade-core-p1)
				(goal uu-kind TROOP)
			)
		)
	)
	(or
		(goal support-repeater YES)
		(or
			(goal support-mounted YES)
			(or
				(goal support-grenadiers YES)
				(goal uu-kind TROOP)
			)
		)
	)
	(or
		(research-completed ut-mounted-3)
		(research-completed ut-laser-3)
	)
	(research-completed rt-portable-scanners)
=>
	(release-escrow food)
	(research rt-lighter-armor)
)

(defrule
	; Dexterity
	(can-research-with-escrow rt-dexterity)
	(current-age >= tech-level-4)
	(or
		(unit-type-count-total UNIT-LASER-LINE >= TL4-trooper-arm-p2)
		(or
			(unit-type-count-total UNIT-MOUNTED-LINE >= TL4-mounted-supp-p2)
			(unit-type-count-total UNIT-GRENADE-LINE >= TL4-grenade-arm-p2)
		)
	)
	(or
		(goal support-repeater YES)
		(or
			(goal support-mounted YES)
			(or
				(goal support-grenadiers YES)
				(goal uu-kind TROOP)
			)
		)
	)
	(or
		(research-completed ut-mounted-3)
		(research-completed ut-laser-4)
	)
	(not (research-available rt-integrated-rgefinder))
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-dexterity)
)

