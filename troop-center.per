)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-POWERCORE > 0))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (building-type-count-total BLDG-DROPANIM > 0) (or (not (goal savetheanimals YES)) (game-time > 120))))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (not (goal special-map WATER)) (or (building-type-count-total BLDG-TRAINBOAT > 0) (game-time > 300))))
=>
	(set-goal raid-rule-check NO)
)

