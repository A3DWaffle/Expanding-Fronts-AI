;=====================================================
; CHAPTER 3: TL1 / TL2 OPENING UNITS
;=====================================================

(defrule
	(current-age == tech-level-1)
	(goal agingup YES)
	(unit-type-count-total UNIT-LASER-LINE < TL2-trooper-core-p1)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

(defrule
	(current-age == tech-level-2)
	(not (goal openingstyle STYLE-RUSH))
	(unit-type-count-total UNIT-LASER-LINE < TL2-trooper-core-p4)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

; --- TL1 Gremlin Trick ---
(defrule
	(current-age == tech-level-1)
	(not (goal openingstyle STYLE-AGGRESSIVE))
	(goal gremlintrick NO)
	(or (goal openingstyle STYLE-RUSH) (goal raid-defensive-roll 2))
=>
	(set-goal gremlintrick GREMLINTRICK-ACTIVE)
	(disable-self)
)


; A small TL3 core floor makes the normal wave composition checks attainable.
; Retain larger existing packages and keep small-cap games on their old targets.
#load-if-not-defined POPULATION-CAP-25
#load-if-not-defined POPULATION-CAP-50
(defrule
	(current-age == tech-level-3)
	(or (goal combat-arm TROOP) (goal combat-arm TROOP/HW))
	(unit-type-count-total UNIT-LASER-LINE < 8)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)
#end-if
#end-if

(defrule
	(current-age == tech-level-1)
	(not (goal openingstyle STYLE-AGGRESSIVE))
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(unit-type-count-total UNIT-MOUNTED-LINE < TL1-mounted-core)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

