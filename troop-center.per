; --- TROOP core p1 ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-LASER-LINE < TL4-trooper-arm-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-LASER-LINE < TL4-trooper-arm-p1-water)
		)
	)
	(not (research-available ut-laser-4))
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

