	(unit-type-count-total UNIT-MOUNTED-LINE < 39)
=>
	(set-goal mounted-ratio-open YES)
)

(defrule
	(or (current-age == tech-level-2) (current-age == tech-level-3))
	(unit-type-count UNIT-LASER-LINE >= 78)
	(unit-type-count UNIT-MOUNTED-LINE > 0)
	(unit-type-count-total UNIT-MOUNTED-LINE <= 39)
=>
	(set-goal mounted-upgrade-ready YES)
)

(defrule
	(or (current-age == tech-level-2) (current-age == tech-level-3))
	(unit-type-count UNIT-LASER-LINE >= 80)
	(unit-type-count-total UNIT-MOUNTED-LINE < 40)
=>
	(set-goal mounted-ratio-open YES)
)

(defrule
	(or (current-age == tech-level-2) (current-age == tech-level-3))
	(unit-type-count UNIT-LASER-LINE >= 80)
	(unit-type-count UNIT-MOUNTED-LINE > 0)
	(unit-type-count-total UNIT-MOUNTED-LINE <= 40)
=>
	(set-goal mounted-upgrade-ready YES)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count UNIT-LASER-LINE < TL2-trooper-core-p2)
=>
	(set-goal mounted-upgrade-ready NO)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map LAND)
	(unit-type-count UNIT-LASER-LINE < TL3-trooper-core-p2)
=>
	(set-goal mounted-upgrade-ready NO)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(unit-type-count UNIT-LASER-LINE < TL3-trooper-core-p2-water)
=>
	(set-goal mounted-upgrade-ready NO)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(unit-type-count UNIT-LASER-LINE < TL3-trooper-core-p2-hybrid)
=>
	(set-goal mounted-upgrade-ready NO)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(unit-type-count UNIT-LASER-LINE < TL3-trooper-core-p2-asteroid)
=>
	(set-goal mounted-upgrade-ready NO)
)

; RAID: split oversized prerequisite list
(defrule
	(true)
=>
	(set-goal raid-rule-check YES)
)

(defrule
	(goal raid-rule-check YES)
	(not (current-age == tech-level-1))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-TRAINTROOPER == 0))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-DROPCHOW > 0))
=>
	(set-goal raid-rule-check NO)
)

