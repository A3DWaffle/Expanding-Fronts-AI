; =====================================================
; FILE: troop-center
; PURPOSE:
;   Builds Troop Centers, researches troop upgrades, and trains troop packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL1/TL2 UNITS
;	Chapter 4: TL3 PACKAGES
;	Chapter 5: TL4 PACKAGES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; TL2/TL3: two completed Lasers per Mountie, counting queued Mounties.
; Recompute once before upgrades/production; one new mounted order per scan.
(defrule
	(true)
=>
	(set-goal mounted-ratio-open NO)
	(set-goal mounted-upgrade-ready NO)
)

(defrule
	(current-age >= tech-level-4)
=>
	(set-goal mounted-ratio-open YES)
	(set-goal mounted-upgrade-ready YES)
)

(defrule
	(or (current-age == tech-level-2) (current-age == tech-level-3))
	(unit-type-count UNIT-LASER-LINE >= 2)
	(unit-type-count-total UNIT-MOUNTED-LINE < 1)
=>
	(set-goal mounted-ratio-open YES)
)

(defrule
	(or (current-age == tech-level-2) (current-age == tech-level-3))
	(unit-type-count UNIT-LASER-LINE >= 2)
	(unit-type-count UNIT-MOUNTED-LINE > 0)
	(unit-type-count-total UNIT-MOUNTED-LINE <= 1)
=>
	(set-goal mounted-upgrade-ready YES)
)

