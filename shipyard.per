; =====================================================
; FILE: shipyard
; PURPOSE:
;   Builds Shipyards, researches naval upgrades, and trains naval packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: FISHING
;	Chapter 4: NAVAL PACKAGES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(or
		(goal special-map WATER)
		(goal special-map HYBRID)
	)
	(game-time > 5)
=>
	(chat-local-to-self "WAFFLE: Water on, boats enabled.")
	(disable-self)
)

(defrule
	(not (map-type precipice))
=>
	(set-strategic-number sn-minimum-water-body-size-for-dock 500)
	; Do not let distant fish pull first dock placement away from home.
	(set-strategic-number sn-maximum-fish-boat-drop-distance 30)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-number-boat-explore-groups 1)
	(set-strategic-number sn-dock-defend-priority 1)
	(disable-self)
)

(defrule
	(game-time > 2400)
=>
	(set-strategic-number sn-number-boat-explore-groups 0)
	(set-strategic-number sn-maximum-boat-explore-group-size 0)
	(set-strategic-number sn-minimum-boat-explore-group-size 0)
	(disable-self)
)

(defrule
	(true)
=>
	(set-goal boattobuild FISHBOAT)
	(set-goal lategamefish NO)
	(disable-self)
)

(defrule
	(goal special-map WATER)
=>
	(set-goal support-sea YES)
	(set-goal support-sealift YES)
	(set-strategic-number sn-desired-number-transport-escorts 2)
	(disable-self)
)

(defrule
	(goal special-map WATER)
	(not (strategic-number sn-desired-number-transport-escorts == 2))
=>
	(set-strategic-number sn-desired-number-transport-escorts 2)
)

; =====================================================
; CHAPTER 1: BUILDINGS
; =====================================================

(defrule
	(goal special-map WATER)
	(goal support-sealift YES)
	(building-type-count-total BLDG-TRAINBOAT == 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (too-many-unpowered-buildings))
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(current-age >= tech-level-2)
	(goal special-map WATER)
	(goal support-sealift YES)
	(building-type-count-total BLDG-TRAINBOAT < 3)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (too-many-unpowered-buildings))
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(not (goal fish-present NO))
	(or
		(goal special-map WATER)
		(goal special-map HYBRID)
	)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-TRAINBOAT == 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (too-many-unpowered-buildings))
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(current-age == tech-level-1)
	(goal special-map WATER)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINBOAT < 2)
	(can-build BLDG-TRAINBOAT)
	(not (too-many-unpowered-buildings))
	(not (goal buildpause YES))
=>
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(current-age == tech-level-2)
	(goal special-map WATER)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-TRAINMECH > 0)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-TRAINBOAT < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(goal importantT2research DONE)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (too-many-unpowered-buildings))
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(or
		(current-age == tech-level-3)
		(current-age == tech-level-4)
	)
	(goal special-map WATER)
	(building-type-count-total BLDG-TRAINBOAT < 4)
	(building-type-count-total BLDG-POWERCORE > 0)
	(or
		(building-type-count-total BLDG-MAIN > 2)
		(building-type-count-total BLDG-TRAINAIR >= 2)
	)
	(goal importantT3research DONE)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (too-many-unpowered-buildings))
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-sea YES)
	(building-type-count-total BLDG-TRAINBOAT < 5)
	(building-type-count-total BLDG-POWERCORE > 0)
	(goal importantT4research DONE)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (too-many-unpowered-buildings))
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

; ============================================================================
; TRANSPORTS
; ============================================================================

(defrule
	(current-age >= tech-level-2)
	(goal special-map WATER)
	(building-type-count-total BLDG-TRAINBOAT > 0)
	(unit-type-count-total BOAT-TRANSPORT < 2)
	(not (can-train BOAT-TRANSPORT))
=>
	(release-escrow carbon)
	(release-escrow food)
)

(defrule
	(current-age >= tech-level-2)
	(goal special-map WATER)
	(unit-type-count-total BOAT-TRANSPORT < 2)
	(can-train BOAT-TRANSPORT)
=>
	(chat-local-to-self "WAFFLE: Training sea transport.")
	(train BOAT-TRANSPORT)
)

; ============================================================================
; UPGRADES
; ============================================================================

(defrule
	(or
		(goal support-sea YES)
		(or
			(goal special-map WATER)
			(goal special-map HYBRID)
		)
	)
	(can-research-with-escrow ut-boat-laser-2)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-boat-laser-2)
)

(defrule
	(or
		(goal support-sea YES)
		(or
			(goal special-map WATER)
			(goal special-map HYBRID)
		)
	)
	(can-research-with-escrow ut-boat-laser-3)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-boat-laser-3)
)

(defrule
	(or
		(goal support-sea YES)
		(or
			(goal special-map WATER)
			(goal special-map HYBRID)
		)
	)
	(can-research-with-escrow ut-boat-cutlaser-2)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-boat-cutlaser-2)
)

(defrule
	(or
		(goal support-sea YES)
		(or
			(goal special-map WATER)
			(goal special-map HYBRID)
		)
	)
	(can-research-with-escrow ut-boat-missile-2)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-boat-missile-2)
)

(defrule
	(or
		(goal support-sea YES)
		(or
			(goal special-map WATER)
			(goal special-map HYBRID)
		)
	)
	(can-research-with-escrow ut-boat-artillery-2)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-boat-artillery-2)
)

(defrule
	(or
		(goal support-sea YES)
		(or
			(goal special-map WATER)
			(goal special-map HYBRID)
		)
	)
	(can-research-with-escrow ut-boat-grenade-2)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-boat-grenade-2)
)

; ============================================================================
; FISHING BOATS
; ============================================================================

(defrule
	(current-age == tech-level-1)
	(goal special-map WATER)
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
)

(defrule
	(current-age == tech-level-1)
	(goal special-map HYBRID)
	(unit-type-count-total BOAT-WORKER < TL1-trawler-hybrid)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
)

(defrule
	(current-age == tech-level-2)
	(goal special-map WATER)
	(warboat-count >= 2)
	(goal boattobuild FISHBOAT)
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
	(set-goal boattobuild ATTACKBOAT)
)

(defrule
	(current-age == tech-level-2)
	(goal special-map HYBRID)
	(warboat-count >= 2)
	(goal boattobuild FISHBOAT)
	(unit-type-count-total BOAT-WORKER < TL1-trawler-hybrid)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
	(set-goal boattobuild ATTACKBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(warboat-count >= 3)
	(goal boattobuild FISHBOAT)
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(or
		(goal lategamefish NO)
		(goal fish-present VENTSIGHTED)
	)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
	(set-goal boattobuild ATTACKBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(warboat-count >= 3)
	(goal boattobuild FISHBOAT)
	(unit-type-count-total BOAT-WORKER < TL1-trawler-hybrid)
	(or
		(goal lategamefish NO)
		(goal fish-present VENTSIGHTED)
	)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
	(set-goal boattobuild ATTACKBOAT)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(warboat-count >= 4)
	(goal boattobuild FISHBOAT)
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(or
		(goal lategamefish NO)
		(goal fish-present VENTSIGHTED)
	)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
	(set-goal boattobuild ATTACKBOAT)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map HYBRID)
	(warboat-count >= 4)
	(goal boattobuild FISHBOAT)
	(unit-type-count-total BOAT-WORKER < TL1-trawler-hybrid)
	(or
		(goal lategamefish NO)
		(goal fish-present VENTSIGHTED)
	)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
	(set-goal boattobuild ATTACKBOAT)
)

(defrule
	(goal lategamefish YES)
	(not (goal fish-present VENTSIGHTED))
	(unit-type-count-total BOAT-WORKER > 2)
=>
	(delete-unit BOAT-WORKER)
)

(defrule
	(population >= popcap)
	(not (goal fish-present VENTSIGHTED))
=>
	(set-goal lategamefish YES)
	(disable-self)
)

(defrule
	(goal lategameworker YES)
	(not (goal fish-present VENTSIGHTED))
=>
	(set-goal lategamefish YES)
	(disable-self)
)

; ============================================================================
; WARBOATS
; ============================================================================

; WATER deathball priority:
; 5 Frigate backbone, 1 AA screen, 1 Cruiser siege, 1 Monitor only into mechs.

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-sea YES)
	(unit-type-count-total BOAT-MISSILE-LINE < 1)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE < 5)
	(can-train BOAT-LASER-LINE)
=>
	(train BOAT-LASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE >= 3)
	(unit-type-count-total BOAT-ARTILLERY-LINE < 1)
	(can-train BOAT-ARTILLERY-LINE)
=>
	(train BOAT-ARTILLERY-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE >= 5)
	(unit-type-count-total BOAT-ARTILLERY-LINE < 2)
	(can-train BOAT-ARTILLERY-LINE)
=>
	(train BOAT-ARTILLERY-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-sea YES)
	(not (goal enemyboatsighted BOAT-ALERT-NONE))
	(unit-type-count-total BOAT-CUTLASER-LINE < 1)
	(can-train BOAT-CUTLASER-LINE)
=>
	(train BOAT-CUTLASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-sea YES)
	(not (goal enemymechsighted MECH-ALERT-NONE))
	(unit-type-count-total BOAT-MONITOR-LINE < 1)
	(can-train BOAT-MONITOR-LINE)
=>
	(train BOAT-MONITOR-LINE)
	(set-goal boattobuild FISHBOAT)
)

; TL2 opening: frigates are the main body, AA destroyers only answer real air.

(defrule
	(current-age >= tech-level-2)
	(goal support-sealift YES)
	(unit-type-count-total BOAT-TRANSPORT < 2)
	(can-train-with-escrow BOAT-TRANSPORT)
=>
	(release-escrow carbon)
	(release-escrow food)
	(train BOAT-TRANSPORT)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map WATER)
	(unit-type-count-total BOAT-MISSILE-LINE < TL2-aa-destroyer-detect-air-alert-low-p1-water)
	(goal enemyairsighted AIR-ALERT-LOW)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map HYBRID)
	(unit-type-count-total BOAT-MISSILE-LINE < TL2-aa-destroyer-detect-air-alert-low-p1-hybrid)
	(goal enemyairsighted AIR-ALERT-LOW)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map WATER)
	(not (goal passiveage YES))
	(unit-type-count-total BOAT-MISSILE-LINE < TL2-aa-destroyer-detect-air-alert-guard-p2-water)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map HYBRID)
	(not (goal passiveage YES))
	(unit-type-count-total BOAT-MISSILE-LINE < TL2-aa-destroyer-detect-air-alert-guard-p2-hybrid)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map WATER)
	(not (goal passiveage YES))
	(unit-type-count-total BOAT-MISSILE-LINE < TL2-aa-destroyer-detect-air-alert-danger-p3-water)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map HYBRID)
	(not (goal passiveage YES))
	(unit-type-count-total BOAT-MISSILE-LINE < TL2-aa-destroyer-detect-air-alert-danger-p3-hybrid)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map WATER)
	(unit-type-count-total BOAT-LASER-LINE < TL2-frigate-core-water)
	(can-train BOAT-LASER-LINE)
=>
	(train BOAT-LASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-2)
	(not (goal fish-present NO))
	(goal special-map HYBRID)
	(unit-type-count-total BOAT-LASER-LINE < TL2-frigate-core-hybrid)
	(can-train BOAT-LASER-LINE)
=>
	(train BOAT-LASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

; TL3 SEA package.

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE < TL3-frigate-arm-p1-water)
	(can-train BOAT-LASER-LINE)
=>
	(train BOAT-LASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE < TL3-frigate-arm-p1-hybrid)
	(can-train BOAT-LASER-LINE)
=>
	(train BOAT-LASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE >= TL3-frigate-arm-p1-water)
	(unit-type-count-total BOAT-MISSILE-LINE < TL3-aa-destroyer-arm-p1-water)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE >= TL3-frigate-arm-p1-hybrid)
	(unit-type-count-total BOAT-MISSILE-LINE < TL3-aa-destroyer-arm-p1-hybrid)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE >= TL3-frigate-arm-p1-water)
	(unit-type-count-total BOAT-MISSILE-LINE >= TL3-aa-destroyer-arm-p1-water)
	(unit-type-count-total BOAT-CUTLASER-LINE < TL3-destroyer-arm-p1-water)
	(can-train BOAT-CUTLASER-LINE)
=>
	(train BOAT-CUTLASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(goal support-sea YES)
	(unit-type-count-total BOAT-LASER-LINE >= TL3-frigate-arm-p1-hybrid)
	(unit-type-count-total BOAT-MISSILE-LINE >= TL3-aa-destroyer-arm-p1-hybrid)
	(unit-type-count-total BOAT-CUTLASER-LINE < TL3-destroyer-arm-p1-hybrid)
	(can-train BOAT-CUTLASER-LINE)
=>
	(train BOAT-CUTLASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(goal support-sea YES)
	(not (goal passiveage YES))
	(unit-type-count-total BOAT-LASER-LINE < TL3-frigate-arm-p2-water)
	(unit-type-count-total BOAT-CUTLASER-LINE >= TL3-destroyer-arm-p1-water)
	(can-train BOAT-LASER-LINE)
=>
	(train BOAT-LASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(goal support-sea YES)
	(not (goal passiveage YES))
	(unit-type-count-total BOAT-LASER-LINE < TL3-frigate-arm-p2-hybrid)
	(unit-type-count-total BOAT-CUTLASER-LINE >= TL3-destroyer-arm-p1-hybrid)
	(can-train BOAT-LASER-LINE)
=>
	(train BOAT-LASER-LINE)
	(set-goal boattobuild FISHBOAT)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(goal support-sea YES)
	(not (goal passiveage YES))
	(unit-type-count-total BOAT-LASER-LINE >= TL3-frigate-arm-p2-water)
	(unit-type-count-total BOAT-MISSILE-LINE < TL3-aa-destroyer-arm-p2-water)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
