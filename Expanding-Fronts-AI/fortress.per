; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

#load-if-not-defined DIFFICULTY-EASIEST ; do not get good units on Easiest
;*********** AIR CRUISER ***********

(defrule
	(current-age >= tech-level-4)
	(not (goal special-map WATER))
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm)
	(can-train UNIT-AIR-CRUISER)
	=>
	(train UNIT-AIR-CRUISER)
)

(defrule
	(current-age >= tech-level-4)
	(goal special-map WATER)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm-water)
	(can-train UNIT-AIR-CRUISER)
	=>
	(train UNIT-AIR-CRUISER)
)

;*********** CANNON ***********

; Standard rule: normal map and water map.
; 1v1-specific cannon caps have been retired so this file now follows the
; same package-era siege plan in every match type.
; Pure TROOP can also lean on cannons here as its late siege outlet.
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal combat-arm MECH/HW)
				(goal support-artillery YES)
			)
		)
	)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm-water)
		)
	)
	(can-train SIEGE-CANNON-LINE)
=>
	(train SIEGE-CANNON-LINE)
)



; Special escrow cannons. These MUST be once-off, or the escrow system's getting nowhere

; two at start
(defrule
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
	(disable-self)
)
(defrule
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
	(disable-self)
)

; two lategame
(defrule
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
	(disable-self)
)
(defrule
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
	(disable-self)
)


; So this should give the AI four once-off cannons near the start of T4 to get its siege rolling 

#end-if ; of not Easiest

;********** BOUNTY HUNTERS **********

(defrule
	(not (goal special-map WATER))
	(unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect)
	(goal enemyjedisighted YES)
	(can-train UNIT-BOUNTY)
	=>
	(train UNIT-BOUNTY)
)

(defrule
	(goal special-map WATER)
	(unit-type-count-total UNIT-BOUNTY < TL4-bounty-detect)
	(goal enemyjedisighted YES)
	(can-train UNIT-BOUNTY)
	=>
	(train UNIT-BOUNTY)
)


;********** FORTRESS TECHS **********

(defrule
	; Galactic Senate Hub
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-research-with-escrow rt-galsenhb)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-galsenhb)
)

(defrule
	; Presidium
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-GOVTCTR > 0)
	(can-research-with-escrow rt-presidium)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research rt-presidium)
)

