	(current-age == tech-level-4)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(goal support-uu YES)
			(unit-type-count-total UNIT-MAGNAGUARD-LINE < TL4-unique-supp)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-MAGNAGUARD-LINE < TL4-unique-unit-arm-p1)
		)
	)
	(can-train UNIT-MAGNAGUARD-LINE)
=>
	(train UNIT-MAGNAGUARD-LINE)
)
; T4 train with water
(defrule
	(goal special-map WATER)
	(current-age == tech-level-4)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(goal support-uu YES)
			(unit-type-count-total UNIT-MAGNAGUARD-LINE < TL4-unique-supp-water)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-MAGNAGUARD-LINE < TL4-unique-unit-arm-p1-water)
		)
	)
	(can-train UNIT-MAGNAGUARD-LINE)
=>
	(train UNIT-MAGNAGUARD-LINE)
)

; UU upgrade
(defrule
        (current-age >= tech-level-4)
        (can-research-with-escrow ut-magnaguard)
        =>
        (release-escrow food)
        (release-escrow nova)
		(release-escrow metal)
        (research ut-magnaguard)
)

;#end-if

