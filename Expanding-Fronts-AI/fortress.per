;*********************************

; SO

; FORT FILE NOW ALSO CONTAINS ALL RELEVANT TURRETING
; so I can keep track of the ore 'n' stuff
; note that ESCROW IS ONLY FOR RESEARCH
; forts CANNOT USE ESCROW for construction

; T2 rules

; Give Defensive extra builders on laser turrets before the first turret rule
; can even fire. If this sits below the build rule, the first turret starts
; with the old/default builder count and the whole shell comes in late.
(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
=>
	(set-builders-type BLDG-TURRET-LINE 5)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-TURRET-LINE < 2)
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)

; Defensive should lean on laser turrets as its primary TL2 protection instead
; of waiting for the broader home-defense plan to come online later.
(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-TURRET-LINE < 6)
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)

#load-if-defined DIFFICULTY-HARD
(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-TURRET-LINE < 3)
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)
#end-if

#load-if-defined DIFFICULTY-HARDEST
(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-TURRET-LINE < 4)
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)
#end-if
; AI gets ore for these in cheats file


; T3
; forts exist now!

(defrule
	(building-type-count-total BLDG-GOVTCTR < 1)
	(or
		(not (goal openingstyle STYLE-DEFENSIVE))
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-GOVTCTR)
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 2) ; always have some AA turrets
	(or
		(not (goal openingstyle STYLE-DEFENSIVE))
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-MISSILE-LINE)
=>
	(build BLDG-MISSILE-LINE)
)

#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

; no free ore edition
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 6) ; anti-cheese starting AA turrets
	(or
		(not (goal openingstyle STYLE-DEFENSIVE))
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-MISSILE-LINE)
	(metal-amount >= 350)
=>
	(build BLDG-MISSILE-LINE)
)

; free ore edition
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 6) ; anti-cheese starting AA turrets
	(or
		(not (goal openingstyle STYLE-DEFENSIVE))
		(or
			(building-type-count-total BLDG-TURRET-LINE >= 6)
			(current-age-time > 420)
		)
	)
	(can-build BLDG-MISSILE-LINE)
	(metal-amount < 350)
=>
	(cc-add-resource metal 80) ; NOTE TO SELF CHEAT
	(build BLDG-MISSILE-LINE)
)
#end-if
#end-if
#end-if


; when one fort is built, allow misc more ore buildings
; also you want 2 CCs

; aa turrets
(defrule
	(building-type-count-total BLDG-GOVTCTR > 0)
	(building-type-count-total BLDG-MISSILE-LINE < 4) 
	(building-type-count-total BLDG-MAIN > 1)
	(can-build BLDG-MISSILE-LINE)
=>
	(build BLDG-MISSILE-LINE)
)

; shield generator
(defrule
        (building-type-count-total BLDG-GOVTCTR > 0)
        (building-type-count-total BLDG-SHLDGEN == 0)
		(building-type-count-total BLDG-MAIN > 1)
        (can-build BLDG-SHLDGEN)
        =>
        (build BLDG-SHLDGEN)
)

; once the AA turrets are mostly done, allow a second fort (and third)

(defrule
	(building-type-count-total BLDG-MISSILE-LINE > 2)
	(building-type-count-total BLDG-GOVTCTR < 3)
	(building-type-count-total BLDG-MAIN > 1)
	(can-build BLDG-GOVTCTR)
=>
	(build BLDG-GOVTCTR)
)

; on easiest, be dumb, and do not do this
#load-if-not-defined DIFFICULTY-EASIEST

; when second fort is up, allow even more buildings
(defrule
	(building-type-count-total BLDG-MISSILE-LINE < 5)
	(building-type-count-total BLDG-GOVTCTR > 1)
	(can-build BLDG-MISSILE-LINE)
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-TURRET-LINE < 4)
	(building-type-count-total BLDG-GOVTCTR > 1)
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)


; now allow up to five forts
(defrule
	(building-type-count-total BLDG-MISSILE-LINE > 4) ; not exact numbers, but should do it
	(building-type-count-total BLDG-TURRET-LINE > 2)
	(building-type-count-total BLDG-GOVTCTR < 5)
	(can-build BLDG-GOVTCTR)
=>
	(build BLDG-GOVTCTR)
)

; build more things as the five forts come online

; shields
(defrule
	(building-type-count-total BLDG-GOVTCTR > 2)
	(building-type-count-total BLDG-SHLDGEN < 2)
	(can-build BLDG-SHLDGEN)
	=>
	(build BLDG-SHLDGEN)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 3)
	(building-type-count-total BLDG-SHLDGEN < 3)
	(can-build BLDG-SHLDGEN)
	=>
	(build BLDG-SHLDGEN)
)

; and the AA turrets

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-MISSILE-LINE < 8)
	(can-build BLDG-MISSILE-LINE)
=>
	(build BLDG-MISSILE-LINE)
)


; at this point what the AI should do depends on a lot of things

; we want it to throw down more turrets on hard/hardest
; we want it to build a billion extra forts

; we ALSO want some of these to only be active during TSA

; rules could probably do with a little more tuning but that's the idea
#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

; When TSA is on...
; build MOAAAR
; with some tiering of forts 'n' stuff

(defrule 
	(building-type-count-total BLDG-GOVTCTR < 10) 
	(can-build BLDG-GOVTCTR)
	(not (goal attackTSAhold EXHAUSTED)) ; TSA is on
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-MISSILE-LINE < 10) 
	(building-type-count-total BLDG-SHLDGEN > 1)
	(not (goal attackTSAhold EXHAUSTED)) ; TSA is on
	(can-build BLDG-MISSILE-LINE)
=>
	(build BLDG-MISSILE-LINE)
)
(defrule
	(building-type-count-total BLDG-GOVTCTR > 6)
	(building-type-count-total BLDG-MISSILE-LINE < 15) 
	(not (goal attackTSAhold EXHAUSTED)) ; TSA is on
	(can-build BLDG-MISSILE-LINE)
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-TURRET-LINE < 8)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(not (goal attackTSAhold EXHAUSTED)) ; TSA is on
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 6)
	(building-type-count-total BLDG-TURRET-LINE < 10)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(not (goal attackTSAhold EXHAUSTED)) ; TSA is on
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)

; And if it isn't on, build fewer at home happily
(defrule
	(building-type-count-total BLDG-GOVTCTR < 6) ; Allow 6 forts at home
	(can-build BLDG-GOVTCTR)
=>
	(build BLDG-GOVTCTR)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-MISSILE-LINE < 8) ; Allow 8 AA Turrets at home
	(building-type-count-total BLDG-SHLDGEN > 1)
	(can-build BLDG-MISSILE-LINE)
=>
	(build BLDG-MISSILE-LINE)
)

(defrule
	(building-type-count-total BLDG-GOVTCTR > 4)
	(building-type-count-total BLDG-TURRET-LINE < 6) ; Allow 6 laser turrets at home
	(building-type-count-total BLDG-SHLDGEN > 1)
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)

; Defensive fortification plan should top out at six laser turrets instead of
; drifting into the larger TSA/home-defense caps meant for the other openings.
(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-TURRET-LINE < 6)
	(can-build BLDG-TURRET-LINE)
=>
	(build BLDG-TURRET-LINE)
)

#end-if
#end-if
#end-if

; =====================================================
; CHAPTER X: CIV FORTRESS TECH CATCHUP
; =====================================================

(defrule
	; RN Battle Armor
	(can-research-with-escrow rt-battle-armor)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-battle-armor)
)

(defrule
	; RN Taxation
	(can-research-with-escrow rt-taxation)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-taxation)
)

(defrule
	; WK Berserker Jet Packs
	(can-research-with-escrow rt-jetpacks)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-jetpacks)
)

#end-if ; of disabling stuff on Easiest

; aa battery logic
; unlike other defensive structures, VERY carbon intensive
; and locked behind a research

; all difficulties: maintain 2

(defrule
	(can-build BLDG-AABATTERY)
	(building-type-count-total BLDG-AABATTERY < 2)
	(or
		(not (town-under-attack)) ; v carbon intensive, spend that on something important instead
		(goal openingstyle STYLE-DEFENSIVE)
	)
=>
	(build BLDG-AABATTERY)
)

#load-if-not-defined DIFFICULTY-EASIEST

; higher difficulties: 3 and 4 in T4
(defrule
	(can-build BLDG-AABATTERY)
	(or
		(and
			(current-age == tech-level-3)
			(building-type-count-total BLDG-AABATTERY < 3)
		)
		(and
			(current-age == tech-level-4)
			(building-type-count-total BLDG-AABATTERY < 4)
		)
	)
	(or
		(not (town-under-attack))
		(goal openingstyle STYLE-DEFENSIVE)
	)
=>
	(build BLDG-AABATTERY)
)

#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE

; when TSA is on build more 
(defrule
	(can-build BLDG-AABATTERY)
	(not (goal attackTSAhold EXHAUSTED)) ; TSA is on
	(building-type-count-total BLDG-AABATTERY < 6)
=>
	(build BLDG-AABATTERY)
)

#end-if
#end-if
#end-if




