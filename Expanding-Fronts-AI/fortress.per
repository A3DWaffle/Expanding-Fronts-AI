(defrule
	; NR Scramjets
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-scramjets)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-scramjets)
