;******* UNIQUE UNITS & UPGRADE *********

;#load-if-defined REBEL

; T3 train
(defrule
		(not (goal special-map WATER))
        (current-age == tech-level-3)
        (not (goal fightertrick FIGHTERTRICK-ACTIVE))
        (unit-type-count-total UNIT-AIRSPEEDER-LINE < TL3-unique-unit-arm)
        (can-train UNIT-AIRSPEEDER-LINE)
        =>
        (train UNIT-AIRSPEEDER-LINE)
)
; T3 train with water
(defrule
		(goal special-map WATER)
        (current-age == tech-level-3)
        (not (goal fightertrick FIGHTERTRICK-ACTIVE))
        (unit-type-count-total UNIT-AIRSPEEDER-LINE < TL3-unique-unit-arm-water)
        (can-train UNIT-AIRSPEEDER-LINE)
        =>
        (train UNIT-AIRSPEEDER-LINE)
)
; T4 train
(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-4)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(goal support-uu YES)
			(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-supp)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-unit-arm-p1)
		)
	)
	(can-train UNIT-AIRSPEEDER-LINE)
=>
	(train UNIT-AIRSPEEDER-LINE)
)
; T4 train with water
(defrule
	(goal special-map WATER)
	(current-age == tech-level-4)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(goal support-uu YES)
			(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-supp-water)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-AIRSPEEDER-LINE < TL4-unique-unit-arm-p1-water)
		)
	)
	(can-train UNIT-AIRSPEEDER-LINE)
=>
	(train UNIT-AIRSPEEDER-LINE)
)
; UU upgrade
(defrule
        (current-age >= tech-level-4)
        (can-research-with-escrow ut-airspeeder)
        =>
        (release-escrow carbon)
        (release-escrow nova)
        (research ut-airspeeder)
)

;#end-if

