;#load-if-defined GUNGANS

; with help from A3DWaffle
(defrule
		(not (goal fightertrick FIGHTERTRICK-ACTIVE))
		(military-population > 5) ; only build Faambas if we have something to shield!
        (unit-type-count-total UNIT-SHIELD-LINE < 1)
		(can-train UNIT-SHIELD-LINE)
        =>
        (train UNIT-SHIELD-LINE)
)

(defrule
		(not (goal fightertrick FIGHTERTRICK-ACTIVE))
		(military-population > 15)
        (unit-type-count-total UNIT-SHIELD-LINE < 3)
		(can-train UNIT-SHIELD-LINE)
        =>
        (train UNIT-SHIELD-LINE)
)
; T4 train
(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-4)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(military-population > 25)
	(or
		(and
			(goal support-uu YES)
			(unit-type-count-total UNIT-SHIELD-LINE < TL4-unique-supp)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-SHIELD-LINE < TL4-unique-unit-arm-p1)
		)
	)
	(can-train UNIT-SHIELD-LINE)
=>
	(train UNIT-SHIELD-LINE)
)
; T4 train with water
(defrule
	(goal special-map WATER)
	(current-age == tech-level-4)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(military-population > 25)
	(or
		(and
			(goal support-uu YES)
			(unit-type-count-total UNIT-SHIELD-LINE < TL4-unique-supp-water)
		)
		(and
			(not (goal support-uu YES))
			(unit-type-count-total UNIT-SHIELD-LINE < TL4-unique-unit-arm-p1-water)
		)
	)
	(can-train UNIT-SHIELD-LINE)
=>
	(train UNIT-SHIELD-LINE)
)

; UU upgrade
(defrule
        (current-age >= tech-level-4)
        (can-research-with-escrow ut-faamba-shield-gen)
        =>
		(release-escrow food)
        (release-escrow carbon)
        (release-escrow nova)
        (research ut-faamba-shield-gen)
)

;#end-if

