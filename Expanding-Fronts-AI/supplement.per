; =====================================================
; FILE: supplement
; PURPOSE:
;   Handles supplemental trainables and miscellaneous support units.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: SUPPLEMENTAL TRAINABLES
;	Chapter 2: CLEANUP
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
		(building-type-count-total 3111 > 0)
        =>
        (set-strategic-number sn-total-number-explorers 4)
		(set-strategic-number sn-percentage-explore-exterminators 100)
		(set-strategic-number sn-minimum-town-size 250)
		
		(enable-timer t-nerfs 1) ; budget attack timer to save a slot
		
		(disable-self)
)

(defrule
		(building-type-count-total 3111 > 0)
		=>
		(set-strategic-number sn-initial-attack-delay 30)
		(set-strategic-number sn-initial-attack-delay-type 2)
)

(defrule
		(player-in-game any-neutral)
		(building-type-count-total 3111 > 0)
		=>
		(set-stance this-any-neutral enemy)
)

(defrule
		(timer-triggered t-nerfs)
		(building-type-count-total 3111 > 0)
        (military-population > 0)
		=>
		(attack-now)
		(disable-timer t-nerfs)
		(enable-timer t-nerfs 30)
)

(defrule
		(building-type-count-total 3111 > 0)
		(nova-amount < 30)
        (unit-type-count UNIT-LASER-LINE < 25)
        (can-train UNIT-LASER-LINE)
        =>
        (train UNIT-LASER-LINE)
)

#load-if-defined REPUBLIC

(defrule
		(building-type-count-total 3111 > 0)
        (cc-players-building-type-count any-enemy 3111 > 0)
        (can-train 1955)
        =>
        (train 1955)
)

(defrule
		(building-type-count-total 3111 > 0)
        (cc-players-unit-type-count any-enemy UNIT-LASER-LINE > 0)
        (can-train 1995)
        =>
        (train 1995)
)

(defrule
		(building-type-count-total 3111 > 0)
        (cc-players-unit-type-count any-enemy UNIT-BXCMD-2 > 0)
        (can-train 2382TROOPER)
        =>
        (train 2382TROOPER)
)

(defrule
		(building-type-count-total 3111 > 0)
        (cc-players-unit-type-count any-enemy UNIT-DESTDROID2 > 0)
        (can-train 1856)
        =>
        (train 1856)
)


#end-if

#load-if-defined CONFEDERACY

(defrule
		(building-type-count-total 3111 > 0)
        (cc-players-building-type-count any-enemy 3111 > 0)
        (can-train 4097)
        =>
        (train 4097)
)

(defrule
		(building-type-count-total 3111 > 0)
        (cc-players-unit-type-count any-enemy UNIT-LASER-LINE > 0)
        (can-train UNIT-BXCMD-2)
        =>
        (train UNIT-BXCMD-2)
)

(defrule
		(building-type-count-total 3111 > 0)
        (cc-players-unit-type-count any-enemy 1995 > 0)
        (can-train UNIT-DESTDROID2)
        =>
        (train UNIT-DESTDROID2)
)

#end-if

; random scenario junk-unit training removed
(defrule
	(can-train SCN-MISC-LINE)
	(unit-type-count-total SCN-MISC-LINE == 0)
=>
	(train SCN-MISC-LINE)
)

; RANDOM RESEARCHES
; Trapping (Ewok Hut)
(defrule
	(can-research nt-trapping)
=>
	(research nt-trapping)
)
; Carbon Freezing (Bespin Govt Ctr)
(defrule
	(can-research-with-escrow nt-carbon-freezing) ; (actually decent tech)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research nt-carbon-freezing)
)
; Power Convertors (Tatooine Market)
(defrule
	(can-research nt-power-convert) ; (completely useless tech)
=>
	(research nt-power-convert)
)



