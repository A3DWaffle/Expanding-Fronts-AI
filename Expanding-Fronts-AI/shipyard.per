	(current-age == tech-level-4)
	(goal combat-arm SEA)
	(unit-type-count-total BOAT-LASER-LINE >= TL4-frigate-arm-p3)
	(unit-type-count-total BOAT-CUTLASER-LINE >= TL4-destroyer-arm-p3)
	(unit-type-count-total BOAT-ARTILLERY-LINE >= TL4-cruiser-arm-p2)
	(unit-type-count-total BOAT-MONITOR-LINE < TL4-monitor-detect-p1)
	(can-train BOAT-MONITOR-LINE)
=>
	(train BOAT-MONITOR-LINE)
	(set-goal boattobuild FISHBOAT)
)

; TL4 extra AA response.

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(unit-type-count-total BOAT-MISSILE-LINE < TL4-aa-destroyer-detect-air-alert-low)
	(goal enemyairsighted AIR-ALERT-LOW)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(unit-type-count-total BOAT-MISSILE-LINE < TL4-aa-destroyer-detect-air-alert-guard)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(unit-type-count-total BOAT-MISSILE-LINE < TL4-aa-destroyer-detect-air-alert-danger)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(can-train BOAT-MISSILE-LINE)
=>
	(train BOAT-MISSILE-LINE)
)

(defrule
	(current-age == tech-level-4)
	(unit-type-count-total UU-ATATSWIMMER-LINE < TL4-unique-unit-arm-water)
	(can-train UU-ATATSWIMMER-LINE)
=>
	(train UU-ATATSWIMMER-LINE)
)