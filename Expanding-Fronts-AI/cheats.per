	(not (can-research-with-escrow tech-level-3))
	(goal agingup NO)
	(unit-type-count UNIT-WORKER > 20)
	(building-type-count-total BLDG-TRAINMECH >= 1)
	(building-type-count-total BLDG-SPACEPORT >= 1)
