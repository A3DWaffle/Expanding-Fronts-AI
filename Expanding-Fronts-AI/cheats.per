; =====================================================
; FILE: cheats
; PURPOSE:
;   Provides difficulty resource support, build-order recovery, and AI-only compensation.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: DIFFICULTY SUPPORT
;	Chapter 2: RESOURCE GRANTS
;	Chapter 3: REFUNDS
;	Chapter 4: RECOVERY
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(enable-timer t-aicheat 150) ; Faster cadence so the new opener/package logic is not underfunded
	(disable-self)
)

; free worker cheat
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-EASIEST

; For Moderate, Hard, and Hardest
; the AI gets free workers in T1
; This is because quite frankly the AI is bad
; players can take advantage of all the food available;
; huntables, lurables, and even shore fish
; meanwhile the AI can only really berry and nerfs
; then when it's out of berries it goes onto farms
; when there's like 15 rontos right on its doorstep
; don't worry tho, the T1 trooper rules check for food amounts so this will not
; allow the AI to have infinite troopers in T1 

(defrule
	(game-time < 10)
	(food-amount > 100)
=>
	(cc-add-resource food 2) ; large enough to tip over the food at start so it's not zero when they train all their workers
	(disable-self)
)

#load-if-defined DIFFICULTY-MODERATE
(defrule
	(current-age == tech-level-1)
	(food-amount < 50)
	(not (food-amount < 2)) ; handles cases in scenarios where starting with 0 res
	(game-time > 150) ; worker train time is 25s, so this means 4 workers (starting 200f) are trained with downtime for 2
=>
	(cc-add-resource food 5)
)
#end-if
#load-if-not-defined DIFFICULTY-MODERATE
(defrule
	(current-age == tech-level-1)
	(food-amount < 50)
	(not (food-amount < 2)) ; handles cases in scenarios where starting with 0 res
=>
	(cc-add-resource food 5)
)
#end-if



#end-if
#end-if




#load-if-defined DIFFICULTY-EASY
; EASY CHEATS
; Small worker-scaled economy. Enough to keep the AI functioning, but still very punishable.

(defrule
	(current-age == tech-level-2)
	(current-age-time > cheat-timeout)
	(unit-type-count UNIT-WORKER > 10)
=>
	(cc-add-resource carbon 75)
	(cc-add-resource food 75)
	(cc-add-resource nova 25)
	(cc-add-resource metal 25)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(current-age-time > cheat-timeout)
	(unit-type-count UNIT-WORKER > 15)
=>
	(cc-add-resource carbon 150)
	(cc-add-resource food 100)
	(cc-add-resource nova 50)
	(cc-add-resource metal 25)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(current-age-time > cheat-timeout)
	(unit-type-count UNIT-WORKER > 20)
=>
	(cc-add-resource carbon 150)
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
	(cc-add-resource metal 50)
	(disable-self)
)

; TL1 worker-band income
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-1)
	(goal agingup NO)
	(unit-type-count UNIT-WORKER >= 5)
	(strategic-number snc-lure-amount > 0)
	(or
		(carbon-amount < 400)
		(food-amount < 250)
	)
=>
	(cc-add-resource carbon 4)
	(cc-add-resource food 8)
)
