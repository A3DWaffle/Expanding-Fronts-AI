; Keep the lure-food shim, but let it ride on top of the smaller worker-based economy.
(defrule
	(current-age == tech-level-1)
	(game-time > 300)
=>
	(set-goal cheatlure YES)
	(disable-self)
)
(defrule
	(current-age == tech-level-1)
	(game-time > 420)
=>
	(set-goal cheatlure YES)
	(disable-self)
)
(defrule
	(current-age == tech-level-1)
	(game-time > 540)
=>
