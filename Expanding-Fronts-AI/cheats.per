	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(current-age-time > 1800)
	(unit-type-count UNIT-WORKER >= 40)
	(or
		(carbon-amount < 3200)
		(or
			(food-amount < 2200)
			(or
				(nova-amount < 1100)
				(metal-amount < 450)
			)
		)
	)
=>
	(cc-add-resource carbon 140)
	(cc-add-resource food 130)
	(cc-add-resource nova 80)
	(cc-add-resource metal 20)
)
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(current-age-time > 1800)
	(unit-type-count UNIT-WORKER >= 45)
	(or
		(carbon-amount < 3200)
		(or
			(food-amount < 2200)
			(or
				(nova-amount < 1100)
				(metal-amount < 450)
			)
		)
	)
=>
	(cc-add-resource carbon 140)
	(cc-add-resource food 130)
	(cc-add-resource nova 80)
	(cc-add-resource metal 20)
)

; targeted T4 research support
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(unit-type-count UNIT-WORKER > 25)
	(or
		(carbon-amount < 2500)
		(or
			(food-amount < 1800)
			(nova-amount < 900)
		)
	)
	(not (goal importantT4research DONE))
=>
	(cc-add-resource carbon 350)
	(cc-add-resource food 500)
	(cc-add-resource nova 500)
	(cc-add-resource metal 100)
)

#end-if

;********************************
; Random map Extreme cheats:

; Wait, but there isn't an Extreme difficulty in the settings? What gives?
; This is enabled in the config by Taunt 85
; (shared-goal customdifficulty EXTREME)
; Note that these WILL STACK with whatever the cheats for current difficulty were set to 

; Resources on age up


(defrule
	(shared-goal customdifficulty EXTREME)
	(current-age == tech-level-1)
	(game-time > cheat-timeout)
=>
	(cc-add-resource carbon 50)
	(cc-add-resource food 100)
	(disable-self)
)       

(defrule
	(current-age == tech-level-2)
	(shared-goal customdifficulty EXTREME)
	(current-age-time > cheat-timeout)
=>
	(cc-add-resource carbon 100)
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
	(cc-add-resource metal 50)
	(disable-self)
) 

(defrule
	(current-age == tech-level-3)
	(shared-goal customdifficulty EXTREME)
	(current-age-time > cheat-timeout)
=>
	(cc-add-resource carbon 200)
	(cc-add-resource food 100)
	(cc-add-resource nova 50)
	(cc-add-resource metal 50)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(shared-goal customdifficulty EXTREME)
	(current-age-time > cheat-timeout)
=>
	(cc-add-resource carbon 200)
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
	(cc-add-resource metal 100)
	(disable-self)
)       


; Resources on timer
; keep in mind THESE STACK

; tech level 1
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-1)
	(shared-goal customdifficulty EXTREME)
=>
	(cc-add-resource carbon 50) 
	(cc-add-resource food 50)
) 

; tech level 2
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
	(shared-goal customdifficulty EXTREME)
=>
	(cc-add-resource carbon 100) 
	(cc-add-resource food 100)
	(cc-add-resource nova 50)
) 

; tech level 3
(defrule
	(timer-triggered t-aicheat)
