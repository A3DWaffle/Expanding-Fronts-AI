#load-if-defined DIFFICULTY-HARD
; HARD CHEATS
; Stronger than Moderate in TL2/TL3, but still driven by actual worker count and stockpile need.

(defrule
	(current-age == tech-level-1)
=>
	(disable-self)
)       

(defrule
	(current-age == tech-level-1)
	(game-time > cheat-timeout)
	(strategic-number snc-lure-amount > 0)
=>
	(cc-add-resource carbon 60)
	(cc-add-resource food 75)
	(disable-self)
)       

