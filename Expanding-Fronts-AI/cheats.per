; Retired the old stacked TL4 max-pop faucet. The worker-band economy above now
; handles scaling, so if the workers die the cheat income dies with them.
; timer that propels the whole system including the above
(defrule
	(timer-triggered t-aicheat)
=>
	(disable-timer t-aicheat)
	(enable-timer t-aicheat 150) ; faster cadence to support the prototype's heavier early/midgame plans
	(chat-local-to-self "WAFFLE: Timer cheat rollover. Expect free money.")
)


; SPECIAL FUN TECHS

#load-if-not-defined DIFFICULTY-EASIEST

#load-if-not-defined DIFFICULTY-EASY

; Moderate, Hard, Hardest:

(defrule
	(can-research aic-pop)
	(population >= 200)
=>
	(research aic-pop)
	(disable-self)
)


#load-if-not-defined DIFFICULTY-MODERATE
; Hard and Hardest

(defrule
	(can-research aic-trade1)
	(unit-type-count UNIT-CARGO-GROUND-LINE > 0)
=>
	(research aic-trade1)
	(disable-self)
)

#load-if-not-defined DIFFICULTY-HARD 
; Hardest

; GUNSHIP ARNAMENTS: AI EDITION
(defrule
	(research-completed rt-gunship-lasers)
	(research-completed ut-laser-4) ; repeater
	(can-research aic-gunship-garrison)
	(civ-selected REPUBLIC)
	(or
		(research-completed rt-jedi-strength)
		(shared-goal purgebypass YES)
	)
=>
	(research aic-gunship-garrison)
)

; "Garrisoned" turrets
(defrule
	(research-completed ut-adv-turret)
	(research-completed ut-laser-4) ; repeater
	(can-research aic-turret-garrison)
	(or
		(research-completed rt-jedi-strength)
		(shared-goal purgebypass YES)
	)
=>
	(research aic-turret-garrison)
)

(defrule
	(can-research aic-trade2)
	(unit-type-count UNIT-CARGO-GROUND-LINE > 0)
=>
	(research aic-trade2)
	(disable-self)
)
#end-if

#end-if
#end-if
#end-if

; config bypass 
(defrule
	(research-completed rt-gunship-lasers)
	(research-completed ut-laser-4) ; repeater
	(can-research aic-gunship-garrison)
	(civ-selected REPUBLIC)
	(shared-goal purgebypass TURBO)
=>
	(research aic-gunship-garrison)
)

; "Garrisoned" turrets
(defrule
	(research-completed ut-adv-turret)
	(research-completed ut-laser-4) ; repeater
	(can-research aic-turret-garrison)
	(shared-goal purgebypass TURBO)
=>
	(research aic-turret-garrison)
)



