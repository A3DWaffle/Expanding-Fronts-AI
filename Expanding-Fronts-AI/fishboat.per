; TROOPER LINE REPLACEMENTS


(defrule
	(goal advinfcen YES)
	(can-research-with-escrow aic-adv-laser-1-2)
=>
	(release-escrow food)
	(release-escrow nova)
	(research aic-adv-laser-1-2)
	(disable-self)
)

