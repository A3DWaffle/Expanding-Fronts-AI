(defrule
	(true)
=>
	(set-goal uu-kind UU-MECH)
	(disable-self)
)
#end-if

; AIR DETECTION: REGULAR AIR

(defrule
		(strategic-number snc-enemy-regular-air == 0)
        (or
			(cc-players-unit-type-count any-enemy UNIT-FIGHTER-LINE > 0)
			(or
				(cc-players-unit-type-count any-enemy UNIT-BOMBER-LINE > 0)
				(or
					(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE > 0)
					(or
						(cc-players-unit-type-count any-enemy UNIT-INTERCEPTOR-LINE > 9) ; Interceptors are kinda moot when it comes to needing AA
						(or
							(cc-players-unit-type-count any-enemy UNIT-GEOFLYR-LINE > 0)
							(or
								(cc-players-unit-type-count any-enemy UNIT-JEDIFGT-LINE > 0)
								(or
									(cc-players-unit-type-count any-enemy UNIT-VWING-LINE > 0)
									(or
										(cc-players-unit-type-count any-enemy UNIT-AIRCRUISER-LINE > 0)
										(cc-players-unit-type-count any-enemy UNIT-AIRSPEEDER-LINE > 0)
									)
								)
							)
						)
					)
				)
			)
        )
        =>
        (set-strategic-number snc-enemy-regular-air 1)
		;(chat-local-to-self "WAFFLE: Some Regular Enemy Air Sighted!")
)

(defrule
		(strategic-number snc-enemy-regular-air < 2)
		(cc-players-unit-type-count any-enemy UNIT-AIRCRUISER-LINE > 0)
        =>
        (set-strategic-number snc-enemy-regular-air 2)
		;(chat-local-to-self "WAFFLE: Air Cruiser sighted. Escalate to GUARD")
)

(defrule
		(strategic-number snc-enemy-regular-air < 3)
		(cc-players-unit-type-count any-enemy UNIT-AIRCRUISER-LINE > 1)
        =>
        (set-strategic-number snc-enemy-regular-air 3)
		;(chat-local-to-self "WAFFLE: Multiple Air Cruisers sighted. Escalate to DANGER")
)

(defrule
		(strategic-number snc-enemy-regular-air < 2)
        (or
			(cc-players-unit-type-count any-enemy UNIT-FIGHTER-LINE > 5)
			(or
				(cc-players-unit-type-count any-enemy UNIT-BOMBER-LINE > 4)
				(or
					(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE > 4)
					(or
						(cc-players-unit-type-count any-enemy UNIT-INTERCEPTOR-LINE > 12) 
						(or
							(cc-players-unit-type-count any-enemy UNIT-GEOFLYR-LINE > 3)
							(or
								(cc-players-unit-type-count any-enemy UNIT-JEDIFGT-LINE > 5)
								(or
									(cc-players-unit-type-count any-enemy UNIT-VWING-LINE > 4)
									(or
										(cc-players-unit-type-count any-enemy UNIT-AIRCRUISER-LINE > 0)
										(cc-players-unit-type-count any-enemy UNIT-AIRSPEEDER-LINE > 3)
									)
								)
							)
						)
					)
				)
			)
        )
        =>
        (set-strategic-number snc-enemy-regular-air 2)
		;(chat-local-to-self "WAFFLE: Many Regular Enemy Air Sighted!")
)

; lots 1: any specific > 10
(defrule
		(strategic-number snc-enemy-regular-air < 3)
        (or
			(cc-players-unit-type-count any-enemy UNIT-FIGHTER-LINE > 10)
			(or
				(cc-players-unit-type-count any-enemy UNIT-BOMBER-LINE > 10)
				(or
					(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE > 10)
					(or
						(cc-players-unit-type-count any-enemy UNIT-INTERCEPTOR-LINE > 20) 
						(or
							(cc-players-unit-type-count any-enemy UNIT-GEOFLYR-LINE > 8)
							(or
								(cc-players-unit-type-count any-enemy UNIT-JEDIFGT-LINE > 10)
								(or
									(cc-players-unit-type-count any-enemy UNIT-VWING-LINE > 10)
									(or
										(cc-players-unit-type-count any-enemy UNIT-AIRCRUISER-LINE > 2)
										(cc-players-unit-type-count any-enemy UNIT-AIRSPEEDER-LINE > 8)
									)
								)
							)
						)
					)
				)
			)
        )
        =>
        (set-strategic-number snc-enemy-regular-air 3)
		;(chat-local-to-self "WAFFLE: Lots Regular Enemy Air Sighted, type 1")
)

; lots 2: multiple types > 5
(defrule
	(strategic-number snc-enemy-regular-air < 3)
	(or
		(and
			(cc-players-unit-type-count any-enemy UNIT-FIGHTER-LINE >= 6)
			(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE >= 6)
		)
		(and
			(cc-players-unit-type-count any-enemy UNIT-BOMBER-LINE >= 5)
			(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE >= 7)
		)
	)
=>
	(set-strategic-number snc-enemy-regular-air 3)
	;(chat-local-to-self "WAFFLE: Lots Regular Enemy Air Sighted, type 2")
)

; wind down from LOTS to SOME (MANY is skipped, as you will likely want to maintain high AA to completely get rid of it)
(defrule
	(strategic-number snc-enemy-regular-air == 3)
	(and
			(cc-players-unit-type-count every-enemy UNIT-FIGHTER-LINE <= 5)
			(and
				(cc-players-unit-type-count every-enemy UNIT-BOMBER-LINE <= 4)
				(and
					(cc-players-unit-type-count every-enemy UNIT-ATTACKER-LINE <= 4)
					(and
						(cc-players-unit-type-count every-enemy UNIT-INTERCEPTOR-LINE <= 12) 
						(and
							(cc-players-unit-type-count every-enemy UNIT-GEOFLYR-LINE <= 3)
							(and
								(cc-players-unit-type-count every-enemy UNIT-JEDIFGT-LINE <= 5)
								(and
									(cc-players-unit-type-count every-enemy UNIT-VWING-LINE <= 4)
									(and
										(cc-players-unit-type-count every-enemy UNIT-AIRCRUISER-LINE == 0)
										(cc-players-unit-type-count every-enemy UNIT-AIRSPEEDER-LINE < 3)
									)
								)
							)
						)
					)
				)
			)
        )
=>
	(set-strategic-number snc-enemy-regular-air 1)
	;(chat-local-to-self "WAFFLE: Winding down LOTS to SOME of enemy regular air")
)





(defrule
	(not (strategic-number snc-enemy-regular-air == 0))
	(and
		(cc-players-unit-type-count every-enemy UNIT-FIGHTER-LINE == 0)
		(and
			(cc-players-unit-type-count every-enemy UNIT-BOMBER-LINE == 0)
			(and
				(cc-players-unit-type-count every-enemy UNIT-ATTACKER-LINE == 0)
				(and
					(cc-players-unit-type-count every-enemy UNIT-INTERCEPTOR-LINE <= 9) 
					(and
						(cc-players-unit-type-count every-enemy UNIT-GEOFLYR-LINE == 0)
						(and
							(cc-players-unit-type-count every-enemy UNIT-JEDIFGT-LINE == 0)
							(and
								(cc-players-unit-type-count every-enemy UNIT-VWING-LINE == 0)
								(and
									(cc-players-unit-type-count every-enemy UNIT-AIRCRUISER-LINE == 0)
									(cc-players-unit-type-count every-enemy UNIT-AIRSPEEDER-LINE == 0)
								)
							)
						)
					)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-regular-air 0)
	;(chat-local-to-self "WAFFLE: No Enemy Regular Air Sighted")
)

; AIR DETECTION: SCENARIO AIR
(defrule
	(strategic-number snc-enemy-scn-air == 0)
	(or
		(cc-players-unit-type-count any-enemy SCN-AIR-FIGHTER-LINE > 0)
		(or
			(cc-players-unit-type-count any-enemy SCN-AIR-BOMBER-LINE > 0)
			(or
				(cc-players-unit-type-count any-enemy SCN-AIR-ATTACKER-LINE > 0)
				(or
					(cc-players-unit-type-count any-enemy SCN-AIR-INTERCEPTOR-LINE > 6) 
					(or
						(cc-players-unit-type-count any-enemy SCN-SPACE-LINE > 0)
						(cc-players-unit-type-count any-enemy SCN-AIR-FORTRESS-LINE > 0)
					)		
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-scn-air 1)
	;(chat-local-to-self "WAFFLE: Some Enemy Scenario Air Sighted")
)

(defrule
	(strategic-number snc-enemy-scn-air < 2)
	(or
		(cc-players-unit-type-count any-enemy SCN-AIR-FIGHTER-LINE > 5)
		(or
			(cc-players-unit-type-count any-enemy SCN-AIR-BOMBER-LINE > 4)
			(or
				(cc-players-unit-type-count any-enemy SCN-AIR-ATTACKER-LINE > 4)
				(or
					(cc-players-unit-type-count any-enemy SCN-AIR-INTERCEPTOR-LINE > 12) 
					(or
						(cc-players-unit-type-count any-enemy SCN-SPACE-LINE > 0)
						(cc-players-unit-type-count any-enemy SCN-AIR-FORTRESS-LINE > 3)
					)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-scn-air 2)
	;(chat-local-to-self "WAFFLE: Many Scenario Enemy Air Sighted!")
)

(defrule
	(strategic-number snc-enemy-scn-air < 3)
	(or
		(cc-players-unit-type-count any-enemy SCN-AIR-FIGHTER-LINE > 10)
		(or
			(cc-players-unit-type-count any-enemy SCN-AIR-BOMBER-LINE > 10)
			(or
				(cc-players-unit-type-count any-enemy SCN-AIR-ATTACKER-LINE  > 10)
				(or
					(cc-players-unit-type-count any-enemy SCN-AIR-INTERCEPTOR-LINE  > 20) 
					(or
						(cc-players-unit-type-count any-enemy SCN-SPACE-LINE > 1)
						(cc-players-unit-type-count any-enemy SCN-AIR-FORTRESS-LINE > 8)
					)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-scn-air 3)
	;(chat-local-to-self "WAFFLE: Lots Scenario Enemy Air Sighted") ; no lots type 1 or 2 as that just isn't needed for regular C
)

; wind down from LOTS to SOME (MANY is skipped, as you will likely want to maintain high AA to completely get rid of it)
(defrule
	(strategic-number snc-enemy-scn-air == 3)
	(and
		(cc-players-unit-type-count every-enemy SCN-AIR-FIGHTER-LINE <= 5)
		(and
			(cc-players-unit-type-count every-enemy SCN-AIR-BOMBER-LINE <= 4)
			(and
				(cc-players-unit-type-count every-enemy SCN-AIR-ATTACKER-LINE <= 4)
				(and
					(cc-players-unit-type-count every-enemy SCN-AIR-INTERCEPTOR-LINE <= 12) 
					(and
						(cc-players-unit-type-count every-enemy SCN-SPACE-LINE == 0)
						(cc-players-unit-type-count every-enemy SCN-AIR-FORTRESS-LINE <= 3)
					)
					
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-scn-air 1)
	;(chat-local-to-self "WAFFLE: Winding down LOTS to SOME of enemy scn air")
)


(defrule
	(not (strategic-number snc-enemy-scn-air == 0))
	(and
		(cc-players-unit-type-count every-enemy SCN-AIR-FIGHTER-LINE == 0)
		(and
			(cc-players-unit-type-count every-enemy SCN-AIR-BOMBER-LINE == 0)
			(and
				(cc-players-unit-type-count every-enemy SCN-AIR-ATTACKER-LINE == 0)
				(and
					(cc-players-unit-type-count every-enemy SCN-AIR-INTERCEPTOR-LINE <= 6) 
					(and
						(cc-players-unit-type-count every-enemy SCN-SPACE-LINE == 0)
						(cc-players-unit-type-count every-enemy SCN-AIR-FORTRESS-LINE == 0)
					)
				)
			)
		)
	)
	=>
	(set-strategic-number snc-enemy-scn-air 0)
	;(chat-local-to-self "WAFFLE: No enemy scn air sighted")
)

; AIR DETECTION: COMBINED ALERT STATE
(defrule
	(strategic-number snc-enemy-regular-air == 0)
	(strategic-number snc-enemy-scn-air == 0)

	(not (goal enemyairsighted AIR-ALERT-NONE))
=>
	(set-goal enemyairsighted AIR-ALERT-NONE)
	(chat-local-to-self "WAFFLE: Combining air, it's AIR-ALERT-NONE")
)

(defrule
	(or
		(strategic-number snc-enemy-regular-air == 1)
		(strategic-number snc-enemy-scn-air == 1)
	)
	(not
		(and
			(strategic-number snc-enemy-regular-air >= 1)
			(strategic-number snc-enemy-scn-air >= 1)
		)
	)

	(not (goal enemyairsighted AIR-ALERT-LOW))
=>
	(set-goal enemyairsighted AIR-ALERT-LOW)
	(chat-local-to-self "WAFFLE: Combining air, it's AIR-ALERT-LOW I")
)

(defrule
	(and
		(strategic-number snc-enemy-regular-air == 1)
		(strategic-number snc-enemy-scn-air == 1)
	)
	(not (goal enemyairsighted AIR-ALERT-LOW))
=>
	(set-goal enemyairsighted AIR-ALERT-LOW)
	(chat-local-to-self "WAFFLE: Combining air, it's AIR-ALERT-LOW II")
)

(defrule
	(or
		(and
			(strategic-number snc-enemy-regular-air == 2)
			(strategic-number snc-enemy-scn-air <= 1)
		)
		(and
			(strategic-number snc-enemy-regular-air <= 1)
			(strategic-number snc-enemy-scn-air == 2)
		)
	)
	(not (goal enemyairsighted AIR-ALERT-GUARD))
=>
	(set-goal enemyairsighted AIR-ALERT-GUARD)
	(chat-local-to-self "WAFFLE: Combining air, it's AIR-ALERT-GUARD")
)

(defrule
	(or
		(strategic-number snc-enemy-regular-air >= 3)
		(strategic-number snc-enemy-scn-air >= 3)
	)
	(not (goal enemyairsighted AIR-ALERT-DANGER))
=>
	(set-goal enemyairsighted AIR-ALERT-DANGER)
	(chat-local-to-self "WAFFLE: Combining air, it's AIR-ALERT-DANGER I")
)
(defrule
	(and
		(strategic-number snc-enemy-regular-air == 2)
		(strategic-number snc-enemy-scn-air == 2)
	)
	(not (goal enemyairsighted AIR-ALERT-DANGER))
=>
	(set-goal enemyairsighted AIR-ALERT-DANGER)
	(chat-local-to-self "WAFFLE: Combining air, it's AIR-ALERT-DANGER II")
)

; MECH DETECTION: REGULAR MECH

(defrule
	(strategic-number snc-enemy-mech-detection == 0)
	(or
		(cc-players-unit-type-count any-enemy UNIT-MECH1-LINE > 0)
		(or
			(cc-players-unit-type-count any-enemy UNIT-MECH2-LINE > 0)
			(or
				(cc-players-unit-type-count any-enemy UNIT-MECH3-LINE > 0)
				(cc-players-unit-type-count any-enemy UNIT-MECH4-LINE > 0)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 1)
)

(defrule
	(strategic-number snc-enemy-mech-detection == 0)
	(or
		(cc-players-unit-type-count any-enemy UNIT-DESTDROID-LINE > 0)
		(or
			(cc-players-unit-type-count any-enemy UNIT-SKISPEEDER-LINE > 0)
			(cc-players-unit-type-count any-enemy UNIT-GLADIATORDROID1-LINE > 0)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 1)
)

(defrule
	(strategic-number snc-enemy-mech-detection < 2)
	(or
		(cc-players-unit-type-count any-enemy UNIT-MECH1-LINE > 5)
		(or
			(cc-players-unit-type-count any-enemy UNIT-MECH2-LINE > 5)
			(or
				(cc-players-unit-type-count any-enemy UNIT-MECH3-LINE > 5)
				(cc-players-unit-type-count any-enemy UNIT-MECH4-LINE > 5)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 2)
)

(defrule
	(strategic-number snc-enemy-mech-detection < 2)
	(or
		(cc-players-unit-type-count any-enemy UNIT-DESTDROID-LINE > 5)
		(or
			(cc-players-unit-type-count any-enemy UNIT-SKISPEEDER-LINE > 5)
			(cc-players-unit-type-count any-enemy UNIT-GLADIATORDROID1-LINE > 5)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 2)
)

; lots 1: any specific > 10
(defrule
	(strategic-number snc-enemy-mech-detection < 3)
	(or
		(cc-players-unit-type-count any-enemy UNIT-MECH1-LINE > 10)
		(or
			(cc-players-unit-type-count any-enemy UNIT-MECH2-LINE > 10)
			(or
				(cc-players-unit-type-count any-enemy UNIT-MECH3-LINE > 10)
				(cc-players-unit-type-count any-enemy UNIT-MECH4-LINE > 10)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 3)
)

(defrule
	(strategic-number snc-enemy-mech-detection < 3)
	(or
		(cc-players-unit-type-count any-enemy UNIT-DESTDROID-LINE > 10)
		(or
			(cc-players-unit-type-count any-enemy UNIT-SKISPEEDER-LINE > 10)
			(cc-players-unit-type-count any-enemy UNIT-GLADIATORDROID1-LINE > 10)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 3)
)

; lots 2: multiple types > 5
(defrule
	(strategic-number snc-enemy-mech-detection < 3)
	(or
		(and
			(cc-players-unit-type-count any-enemy UNIT-MECH1-LINE >= 6)
			(cc-players-unit-type-count any-enemy UNIT-MECH2-LINE >= 6)
		)
		(or
			(and
				(cc-players-unit-type-count any-enemy UNIT-MECH1-LINE >= 6)
				(cc-players-unit-type-count any-enemy UNIT-MECH3-LINE >= 6)
			)
			(and
				(cc-players-unit-type-count any-enemy UNIT-MECH2-LINE >= 6)
				(cc-players-unit-type-count any-enemy UNIT-MECH3-LINE >= 6)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 3)
)

(defrule
	(strategic-number snc-enemy-mech-detection < 3)
	(or
		(and
			(cc-players-unit-type-count any-enemy UNIT-MECH4-LINE >= 6)
			(cc-players-unit-type-count any-enemy UNIT-DESTDROID-LINE >= 6)
		)
		(or
			(and
				(cc-players-unit-type-count any-enemy UNIT-SKISPEEDER-LINE >= 6)
				(cc-players-unit-type-count any-enemy UNIT-GLADIATORDROID1-LINE >= 6)
			)
			(and
				(cc-players-unit-type-count any-enemy UNIT-MECH2-LINE >= 6)
				(cc-players-unit-type-count any-enemy UNIT-SKISPEEDER-LINE >= 6)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 3)
)

(defrule
	(strategic-number snc-enemy-mech-detection < 4)
	(or
		(cc-players-unit-type-count any-enemy UNIT-MECH1-LINE > 20)
		(or
			(cc-players-unit-type-count any-enemy UNIT-MECH2-LINE > 20)
			(or
				(cc-players-unit-type-count any-enemy UNIT-MECH3-LINE > 20)
				(cc-players-unit-type-count any-enemy UNIT-MECH4-LINE > 20)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 4)
)

(defrule
	(strategic-number snc-enemy-mech-detection < 4)
	(or
		(cc-players-unit-type-count any-enemy UNIT-DESTDROID-LINE > 20)
		(or
			(cc-players-unit-type-count any-enemy UNIT-SKISPEEDER-LINE > 20)
			(cc-players-unit-type-count any-enemy UNIT-GLADIATORDROID1-LINE > 20)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 4)
)

(defrule
	(strategic-number snc-enemy-mech-detection == 4)
	(and
		(cc-players-unit-type-count every-enemy UNIT-MECH1-LINE <= 10)
		(and
			(cc-players-unit-type-count every-enemy UNIT-MECH2-LINE <= 10)
			(and
				(cc-players-unit-type-count every-enemy UNIT-MECH3-LINE <= 10)
				(and
					(cc-players-unit-type-count every-enemy UNIT-MECH4-LINE <= 10)
					(and
						(cc-players-unit-type-count every-enemy UNIT-DESTDROID-LINE <= 10)
						(and
							(cc-players-unit-type-count every-enemy UNIT-SKISPEEDER-LINE <= 10)
							(cc-players-unit-type-count every-enemy UNIT-GLADIATORDROID1-LINE <= 10)
						)
					)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 2)
)

(defrule
	(strategic-number snc-enemy-mech-detection == 3)
	(and
		(cc-players-unit-type-count every-enemy UNIT-MECH1-LINE <= 5)
		(and
			(cc-players-unit-type-count every-enemy UNIT-MECH2-LINE <= 5)
			(and
				(cc-players-unit-type-count every-enemy UNIT-MECH3-LINE <= 5)
				(and
					(cc-players-unit-type-count every-enemy UNIT-MECH4-LINE <= 5)
					(and
						(cc-players-unit-type-count every-enemy UNIT-DESTDROID-LINE <= 5)
						(and
							(cc-players-unit-type-count every-enemy UNIT-SKISPEEDER-LINE <= 5)
							(cc-players-unit-type-count every-enemy UNIT-GLADIATORDROID1-LINE <= 5)
						)
					)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 1)
)

(defrule
	(not (strategic-number snc-enemy-mech-detection == 0))
	(and
		(cc-players-unit-type-count every-enemy UNIT-MECH1-LINE == 0)
		(and
			(cc-players-unit-type-count every-enemy UNIT-MECH2-LINE == 0)
			(and
				(cc-players-unit-type-count every-enemy UNIT-MECH3-LINE == 0)
				(cc-players-unit-type-count every-enemy UNIT-MECH4-LINE == 0)
			)
		)
	)
	(and
		(cc-players-unit-type-count every-enemy UNIT-DESTDROID-LINE == 0)
		(and
			(cc-players-unit-type-count every-enemy UNIT-SKISPEEDER-LINE == 0)
			(cc-players-unit-type-count every-enemy UNIT-GLADIATORDROID1-LINE == 0)
		)
	)
=>
	(set-strategic-number snc-enemy-mech-detection 0)
)

; MECH DETECTION: COMBINED ALERT STATE

(defrule
	(strategic-number snc-enemy-mech-detection == 0)
	(not (goal enemymechsighted MECH-ALERT-NONE))
=>
	(set-goal enemymechsighted MECH-ALERT-NONE)
)

(defrule
	(strategic-number snc-enemy-mech-detection == 1)
	(not (goal enemymechsighted MECH-ALERT-P1))
=>
	(set-goal enemymechsighted MECH-ALERT-P1)
)

(defrule
	(strategic-number snc-enemy-mech-detection == 2)
	(not (goal enemymechsighted MECH-ALERT-P2))
=>
	(set-goal enemymechsighted MECH-ALERT-P2)
)

(defrule
	(strategic-number snc-enemy-mech-detection == 3)
	(not (goal enemymechsighted MECH-ALERT-P3))
=>
	(set-goal enemymechsighted MECH-ALERT-P3)
)

(defrule
	(strategic-number snc-enemy-mech-detection == 4)
	(not (goal enemymechsighted MECH-ALERT-P4))
=>
	(set-goal enemymechsighted MECH-ALERT-P4)
)

; JEDI DETECTION
; USED FOR Bounty Hunters and Vornskr-s

(defrule
	(goal enemyjedisighted NO)
	(or
	(cc-players-unit-type-count any-enemy UNIT-JEDI-LINE > 2) ; more than two for holocron collection duty indicates something's up
		(or
			(cc-players-unit-type-count any-enemy UNIT-MASTER-LINE > 0)
			(or
				(cc-players-unit-type-count any-enemy UNIT-SHADOWTROOPER-LINE > 0)
				(cc-players-unit-type-count any-enemy UU-JEDIALT-LINE > 2) ; 1-2 of these ain't a biggie
			)
		)
	)
=>
	(set-goal enemyjedisighted YES)
)

(defrule
	(goal enemyjedisighted YES)
	(and
	(cc-players-unit-type-count every-enemy UNIT-JEDI-LINE <= 2)
		(and
			(cc-players-unit-type-count every-enemy UNIT-MASTER-LINE <= 0)
			(and
				(cc-players-unit-type-count every-enemy UNIT-SHADOWTROOPER-LINE <= 0)
				(cc-players-unit-type-count every-enemy UU-JEDIALT-LINE <= 2)
			)
		)
	)
=>
	(set-goal enemyjedisighted NO)
)

; PURGE BYPASS

#load-if-not-defined ALL-TECH

(defrule
	(not (players-civ any-human EMPIRE)) ; sith master 
	(not (players-civ any-human IMPERIALREMNANT))
	(not (players-civ any-human REBEL)) ; jedi master
	(not (players-civ any-human NABOO))
	(not (players-civ any-human REPUBLIC))
	(not (players-civ any-human NEWREPUBLIC))
	(not (players-civ any-human BLACKSUN)) ; nightmother
	(game-time > 1)
=>
	(set-shared-goal purgebypass YES) ; this does not neccessarily need to be a shared goal, but it works as one I guess
	(disable-self)
)

#end-if

; BUILD QUEUE RECOVERY RULES
; Used as a fix to try and stop build queue from breaking due to really not wanting to release escrow of ore for constructions
; No idea if this was actually neccessary or if it was a weird shipyard shore ice fix but this works I guess?

; Another way to break the AI's build queue is to destroy an in-progress construction, which causes the AI to be unable to build any of that building ever
; Particularly devastating if you take out a farm since those can still be sighted at 1 HP unlike other foundations

(defrule
	(goal tryingtobuild MECH)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 26)
=>
	(release-escrow carbon)
	(build BLDG-TRAINMECH)
	(set-goal tryingtobuild NULL)
)

(defrule
	(goal tryingtobuild HVYWEAP)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 26)
=>
	(release-escrow carbon)
	(build BLDG-TRAINHEAVY)
	(set-goal tryingtobuild NULL)
)

(defrule
	(goal tryingtobuild AIRBASE)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 26)
=>
	(release-escrow carbon)
	(build BLDG-TRAINAIR)
	(set-goal tryingtobuild NULL)
)

; SCENARIO DETECTION

(defrule
	(true)
=>
	(set-goal scn-detected UNDEFINED)
	(disable-self)
)

(defrule
	(building-type-count 1202 > 0) ; undefeatable object
=>
	(set-goal scn-detected YES)
	(disable-self)
)

(defrule
	(building-count == 0)
	(unit-type-count-total UNIT-WORKER == 0)
	(game-time < scn-timeout)
=>
	(set-goal scn-detected YES)
	(disable-self)
)

(defrule
	(building-type-count BLDG-MAIN != 1) ; does technically fire on raiders starts but those are broken anyway
	(not
		(and
			(unit-type-count-total UNIT-WORKER == 3)
			(population < 5)
		)
	)
	(game-time < scn-timeout)
=>
	(set-goal scn-detected YES)
	(disable-self)
)

(defrule
	(carbon-amount == 0)
	(food-amount == 0)
	(nova-amount == 0)
	(metal-amount == 0)
	(game-time < scn-timeout) ; only in opening seconds of game
=>
	(set-goal scn-detected YES)
	(disable-self)
)


(defrule
	(event-detected trigger 1)
	(not (goal scn-detected NO))
=>
	(set-goal scn-detected YES)
)

(defrule
	(game-time >= 4)
	(goal scn-detected UNDEFINED)
=>
	(set-goal scn-detected NO)
	(disable-self)
)


; SHARED TIMER LOGIC

(defrule
	(true)
=>
	(enable-timer t-tenmin 1)
	(disable-self)
)

(defrule
	(timer-triggered t-tenmin)
=>
	(set-goal resource-search SEARCH) ; see nova for more information
)

; allow training a holocron collector every < 30min (YMMV depending on how far tenmin is through when holocron collector trained)
(defrule
	(timer-triggered t-tenmin)
	(goal holocroncollectionservices 3)
=>
	(set-goal holocroncollectionservices 4)
)

(defrule
	(timer-triggered t-tenmin)
	(goal holocroncollectionservices 2)
=>
	(set-goal holocroncollectionservices 3)
)

(defrule
	(timer-triggered t-tenmin)
	(goal holocroncollectionservices 1)
=>
	(set-goal holocroncollectionservices 2)
)


#load-if-not-defined DIFFICULTY-EASIEST
(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
	(timer-triggered t-tenmin)
=>
	(set-goal lategamecannon TWO) ; see warboat for more information
	(set-goal lategameore ALLOW)
	(set-goal scouting ALLOW) 
	(set-goal lategamemaster ALLOW)
)

#load-if-not-defined DIFFICULTY-EASY

(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
	(timer-triggered t-tenmin)
	(goal lategameac 1)
=>
	(set-goal lategameac 2)
)

(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
	(timer-triggered t-tenmin)
	(goal lategameac 0)
=>
	(set-goal lategameac 1)
)

#end-if

#end-if

(defrule
	(timer-triggered t-tenmin)
=>
	(disable-timer t-tenmin)
	(enable-timer t-tenmin 600) ; reset
)

