; AIR UNIT DETECTION RESET


(defrule
	(true)
=>
	(set-goal enemyairsighted NO)
	(set-goal enemyjedisighted NO)
	(set-goal openingstyle UNDEFINED)
	(set-goal fightertrick NO)
	(set-goal gremlintrick NO)
	(set-goal support-masters NO)
	(set-goal support-assault-mech NO)
	(set-goal support-aircraft NO)
	(set-goal support-uu NO)
	(set-goal support-artillery NO)
	(set-goal support-grenadiers NO)
	(set-goal support-bombers NO)
	(set-goal support-acklay NO)
	(set-goal hunt-food-phase NO)
	(set-goal holocroncollectionservices 0)
	(set-goal uu-kind UU-NONE)
	(set-goal opening-announced NO)
	(set-goal gremlinstate GREMLIN-ZERO)
	(set-goal enemymechsighted MECH-ALERT-NONE)
	(set-strategic-number snc-enemy-regular-air 0)
	(set-strategic-number snc-enemy-scn-air 0)
	(set-strategic-number snc-enemy-mech-detection 0)
	(disable-self) ; oops
)

; CIV UU KIND
; Broad labels for shared tech/production rules. These intentionally describe
; how the AI should think about the UU, not every exact armor class.

#load-if-defined EMPIRE
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

#load-if-defined REBEL
(defrule
	(true)
=>
	(set-goal uu-kind UU-AIR)
	(disable-self)
)
#end-if

#load-if-defined NABOO
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

#load-if-defined WOOKIEES
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

#load-if-defined GUNGANS
(defrule
	(true)
=>
	(set-goal uu-kind UU-SUPPORT)
	(disable-self)
)
#end-if

#load-if-defined FEDERATION
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

#load-if-defined REPUBLIC
(defrule
	(true)
=>
	(set-goal uu-kind UU-AIR)
	(disable-self)
)
#end-if

#load-if-defined CONFEDERACY
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

#load-if-defined GEONOSIANS
(defrule
	(true)
=>
	(set-goal uu-kind UU-AIR)
	(disable-self)
)
#end-if

#load-if-defined ZANN
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

#load-if-defined RESISTANCE
(defrule
	(true)
=>
	(set-goal uu-kind UU-MECH)
	(disable-self)
)
#end-if

#load-if-defined FIRSTORDER
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

#load-if-defined IMPERIALREMNANT
(defrule
	(true)
=>
	(set-goal uu-kind UU-TROOPER)
	(disable-self)
)
#end-if

