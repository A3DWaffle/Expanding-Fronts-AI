(defconst cheat-timeout 20) ; is used to not send cheat res at start of game for scn detection to work
(defconst raiders-timeout 90) ; is used to control at what point the AI should stop wandering & build stuff on Raiders
(defconst scn-timeout 4)
; Townsize defaults are framework values, not population-generator output.
; Canonical names use T2/T3/T4 because these are age-stage behavioural settings.
(defconst T2-townsize-smol 18)
(defconst T2-townsize 24)
(defconst T2-townsize-big 32)
(defconst T2-townsize-bigger 40)

(defconst T3-townsize-smol 24)
(defconst T3-townsize 32)
(defconst T3-townsize-big 40)
(defconst T3-townsize-bigger 48)

(defconst T4-townsize-smol 32)
(defconst T4-townsize 40)
(defconst T4-townsize-big 50)
(defconst T4-townsize-bigger 60)

; Compatibility aliases for older files. Keep until all callers are migrated.
(defconst TL2-townsize-smol T2-townsize-smol)
(defconst TL2-townsize T2-townsize)
(defconst TL2-townsize-big T2-townsize-big)
(defconst TL2-townsize-bigger T2-townsize-bigger)

(defconst TL3-townsize-smol T3-townsize-smol)
(defconst TL3-townsize T3-townsize)
(defconst TL3-townsize-big T3-townsize-big)
(defconst TL3-townsize-bigger T3-townsize-bigger)

(defconst TL4-townsize-smol T4-townsize-smol)
(defconst TL4-townsize T4-townsize)
(defconst TL4-townsize-big T4-townsize-big)
(defconst TL4-townsize-bigger T4-townsize-bigger)
; so I don't have to keep typing the same number everywhere & can change it easily


