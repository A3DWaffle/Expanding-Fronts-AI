; =====================================================
; FILE: tower
; PURPOSE:
;   Controls walls and tower-side defensive building behavior.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: WALLS
;	Chapter 2: TOWERS
;	Chapter 3: CLEANUP
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
        (goal wall-build YES)
        (wall-invisible-percentage 2 > 0)
=>
        (set-strategic-number sn-blot-exploration-map 1)
)

(defrule
	(or
		(not (goal allow-wall NO))
		(not (goal wall-build NO))
	)
 =>
	(set-goal allow-wall NO)
	(set-goal wall-build NO)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(or
		(not (goal allow-wall NO))
		(not (goal wall-build NO))
	)
=>
	(set-goal allow-wall NO)
	(set-goal wall-build NO)
)

(defrule
	(goal scn-detected YES)
	(not (goal allow-wall NO)) ; scenario catching
=>
	(set-goal allow-wall NO)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(current-age == tech-level-2)
	(building-type-count-total BLDG-TURRET-LINE >= 3)
=>
	(set-goal allow-wall NO)
)

(defrule
	(true)
=>
	(set-goal allow-wall NO)
	(set-goal wall-build NO)
	(disable-self)
)


(defrule
	(game-time < 10)
	(or
		(building-type-count BLDG-GATE > 0)
		(or
			(building-type-count BLDG-LTWALL > 0) ; light wall
			(building-type-count BLDG-BARRIER-LINE > 0) ; med+ wall
		
		)
	)
=>
	(set-goal allow-wall NO)
	(disable-self)
)


; mostly original GB code follows, which is why it's incomprehensible


;start the pass
(defrule
        (nor
				(map-type star-wars-world-kashyyyk)
				(nor
					(map-type fortress) 
					(map-type arena)
				)
        )
		(not (goal openingstyle STYLE-DEFENSIVE))
		(goal allow-wall YES)
=>
        (enable-wall-placement 2)
        (disable-self)
)


(defrule
        (nor
                (map-type fortress) 
                (map-type arena)
        )
		(not (goal openingstyle STYLE-DEFENSIVE))
		(goal allow-wall YES)
=>
        (enable-wall-placement 2)
        (disable-self)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
		(goal allow-wall YES)
=>
        (enable-wall-placement 1)
)


; compare SWGB CC rule
;(defrule
;        (difficulty <= easy)
;        (nor
;                (map-type fortress) 
;                (map-type arena)
;        )
;=>
;        (enable-wall-placement 2)
;        (disable-self)
;)


(defrule
        (current-age > tech-level-1)
		(not (goal openingstyle STYLE-DEFENSIVE))
		(goal allow-wall YES)
=>
        (set-goal wall-build NOTICE)
        (disable-self)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (current-age > tech-level-1)
		(goal allow-wall YES)
=>
        (set-goal wall-build YES)
)

(defrule
        (goal wall-build NOTICE)
        (or
                (difficulty >= easy)
                (map-type fortress)
        )
=>
        (set-goal wall-build NO)
        (disable-self)
)

(defrule
        (goal wall-build NOTICE)
=>
        (set-goal wall-build YES)
        (disable-self)
)

(defrule
        (goal wall-build NO)
        (current-age == tech-level-4)
        (nor 
                (map-type fortress)
                (false)
        )
=>
        (set-goal wall-build YES)
        (disable-self)
)

(defrule
        (goal wall-build NO)
        (building-type-count-total BLDG-MONUMENT > 0)
        (nor 
                (map-type fortress) 
                (or
                        (map-type tundra)
                        (map-type ice-lake)
                )
        )
=>
        (set-goal wall-build YES)
)

;build walls

(defrule
        (current-age == tech-level-2)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (goal wall-build YES)
        (can-build-wall-with-escrow 2 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 2 BLDG-BARRIER-LINE)
                (metal-amount > 125)
        )
=>
        (release-escrow metal)
        (build-wall 2 BLDG-BARRIER-LINE)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (current-age == tech-level-2)
        (goal wall-build YES)
        (can-build-wall-with-escrow 1 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 1 BLDG-BARRIER-LINE)
                (metal-amount > 125)
        )
=>
        (release-escrow metal)
        (build-wall 1 BLDG-BARRIER-LINE)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (can-build-wall-with-escrow 2 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 2 BLDG-BARRIER-LINE)
                (metal-amount > 300)
        )
=>
        (release-escrow metal)
        (build-wall 2 BLDG-BARRIER-LINE)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (can-build-wall-with-escrow 1 BLDG-BARRIER-LINE)
        (or
                (can-afford-complete-wall 1 BLDG-BARRIER-LINE)
                (metal-amount > 300)
        )
=>
        (release-escrow metal)
        (build-wall 1 BLDG-BARRIER-LINE)
)

(defrule
        (goal wall-build NO)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (building-type-count-total BLDG-GATE > 0)
        (wall-completed-percentage 2 >= 75)
        (wall-completed-percentage 2 < 100)
        (can-build-wall-with-escrow 2 BLDG-BARRIER-LINE)
=>
        (release-escrow metal)
        (build-wall 2 BLDG-BARRIER-LINE)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build NO)
        (building-type-count-total BLDG-GATE > 0)
        (wall-completed-percentage 1 >= 75)
        (wall-completed-percentage 1 < 100)
        (can-build-wall-with-escrow 1 BLDG-BARRIER-LINE)
=>
        (release-escrow metal)
        (build-wall 1 BLDG-BARRIER-LINE)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (building-type-count-total BLDG-GATE < 10)
        (can-build-gate-with-escrow 2)
=>
        (release-escrow metal)
        (build-gate 2)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (building-type-count-total BLDG-GATE < 10)
        (can-build-gate-with-escrow 1)
=>
        (release-escrow metal)
        (build-gate 1)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (wall-completed-percentage 2 == 100)
        (building-type-count-total BLDG-GATE == 0)
=>
        (delete-complete-building BLDG-BARRIER-LINE)
        (set-goal wall-build NO)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (wall-completed-percentage 1 == 100)
        (building-type-count-total BLDG-GATE == 0)
=>
        (delete-complete-building BLDG-BARRIER-LINE)
        (set-goal wall-build NO)
)

(defrule
        (goal wall-build YES)
        (not (goal openingstyle STYLE-DEFENSIVE))
        (wall-completed-percentage 2 == 100)
=>
        (set-goal wall-build NO)
)

(defrule
        (goal openingstyle STYLE-DEFENSIVE)
        (goal wall-build YES)
        (wall-completed-percentage 1 == 100)
=>
        (set-goal wall-build NO)
)

; wall-completed-percentage goes up to exactly 50% it seems, no higher
; it also counts foundations, so if all the foundations are laid, wall-completed-percentage reports 100



