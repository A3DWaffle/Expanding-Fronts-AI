; =====================================================
; FILE: mech-factory
; PURPOSE:
;   Builds Mech Factories, researches mech upgrades, and trains mech packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL3 PACKAGES
;	Chapter 4: TL4 PACKAGES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-TRAINMECH == 0)
	(building-type-count BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
=>
	(set-goal tryingtobuild MECH)
)

; --- T3 Mech Factories ---
(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-TRAINMECH < 2)
	(or
		(building-type-count-total BLDG-TRAINAIR == 2); Defensive
		(building-type-count BLDG-MAIN > 2) ; Aggressive
	)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Standard TL4 Mech Factory ---
(defrule
	(current-age == tech-level-4)
	(building-type-count-total BLDG-TRAINMECH < 2)
	(building-type-count-total BLDG-MAIN >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Mech package: third factory ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
	(building-type-count-total BLDG-TRAINMECH < 3)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Mech package: fourth factory ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
	(building-type-count-total BLDG-TRAINMECH < 4)
	(building-type-count-total BLDG-TRAINMECH >= 3)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(current-age-time > 420)
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Mech package: fifth factory ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(building-type-count-total BLDG-TRAINMECH < 5)
	(building-type-count-total BLDG-TRAINMECH >= 4)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(current-age-time > 840)
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; =====================================================
; CHAPTER 2: UPGRADES
; =====================================================

; --- Heavy Strike Mech ---
(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-single-mech-2)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-single-mech-2)
)

; --- Heavy Mech Destroyer ---
(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-dual-mech-2)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-dual-mech-2)
)

; --- Heavy Assault Mech ---
(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-multi-mech-2)
	(not (research-available ut-dual-mech-2))
	(not (research-available ut-single-mech-2))
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-multi-mech-2)
)

(defrule
    ; Technicians
	(can-research-with-escrow rt-wookiee-mechanics)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(unit-type-count-total UNIT-MECH3-LINE > 0)
		)
	)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-wookiee-mechanics)
)

(defrule
    ; Advanced Redesign / Adv Redesign
	(can-research-with-escrow rt-adv-redesign)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(unit-type-count-total UNIT-MECH3-LINE > 0)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-adv-redesign)
)

(defrule
	; Auxiliary Power Cells
	(current-age >= tech-level-4)
	(goal importantT4research DONE)
	(can-research-with-escrow rt-aux-power-cells)
	(unit-type-count-total UNIT-MECH3-LINE > 0)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-aux-power-cells)
)

(defrule
	; Upgraded Generator
	(can-research-with-escrow rt-upgraded-generators)
	(goal importantT3research DONE)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(unit-type-count-total UNIT-MECH3-LINE > 0)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-upgraded-generators)
)

(defrule
	; Advanced Generator
	(can-research-with-escrow rt-adv-generator)
	(goal importantT4research DONE)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(unit-type-count-total UNIT-MECH3-LINE > 0)
		)
	)
=>
	(release-escrow metal)
	(release-escrow nova)
	(research rt-adv-generator)
)

(defrule
	; GE Walker Research
	(can-research-with-escrow rt-transport-capability)
=>
	(release-escrow metal)
	(release-escrow nova)
	(research rt-transport-capability)
)

(defrule
	; GN Creature Armor
	(can-research-with-escrow rt-goonga-armor)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-goonga-armor)
)

;(defrule
;	; TF Deployment Racks, has no effect on the AI but for sake of completion here it is commented out.
;	(can-research-with-escrow rt-deployment-racks)
;=>
;	(release-escrow food)
;	(release-escrow carbon)
;	(research rt-deployment-racks)
;)

(defrule
	; ZC Phased Pulse Cannons
	(can-research-with-escrow rt-phased-pulse)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-phased-pulse)
)

(defrule
	; IR Advanced Particle Cannons
	(can-research-with-escrow rt-advparticlecannon)
=>
	(release-escrow food)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-advparticlecannon)
)

(defrule
	; RS Salvaged Components
	(can-research-with-escrow rt-salvcomponents)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-salvcomponents)
)

; =====================================================
; CHAPTER 3: TECH 3 MECH PACKAGES
; =====================================================

; -----------------------
; STRIKE MECH
; -----------------------

(defrule
	(current-age == tech-level-3)
	(not (goal combat-arm MECH))
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1-water)
		)
	)
	(can-train-with-escrow UNIT-MECH1-LINE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

(defrule
	(current-age == tech-level-3)
	(not (goal combat-arm MECH))
	(goal importantT3research DONE)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p3)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p3-water)
		)
	)
	(can-train-with-escrow UNIT-MECH1-LINE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

; --- TL3 Strike core p1 ---
(defrule
	(current-age == tech-level-3)
	(goal combat-arm MECH)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p1)
				(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p1-water)
				(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1-water)
			)
		)
	)
	(can-train-with-escrow UNIT-MECH1-LINE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

; --- TL3 Strike core p2 ---
(defrule
	(current-age == tech-level-3)
	(goal combat-arm MECH)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p2)
				(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p2)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p2-water)
				(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p2-water)
			)
		)
	)
	(can-train-with-escrow UNIT-MECH1-LINE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

; -----------------------
; MECH DESTROYER
; -----------------------

; --- TL3 MD core p1 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal combat-arm MECH)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-arm-p2)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-arm-p2-water)
		)
	)
	(can-train UNIT-MECH2-LINE)
=>
	(train UNIT-MECH2-LINE)
)

; --- TL3 MD core p2 ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal combat-arm MECH)
	(goal importantT3research DONE)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-MECH1-LINE >= TL3-mech1-arm-p1)
				(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-arm-p4)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-MECH1-LINE >= TL3-mech1-arm-p1-water)
				(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-arm-p4-water)
			)
		)
	)
	(can-train UNIT-MECH2-LINE)
=>
	(train UNIT-MECH2-LINE)
)

; --- TL3 MD detect response ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal enemymechsighted MECH-ALERT-P1)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-detect-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-detect-p1-water)
		)
	)
	(can-train UNIT-MECH2-LINE)
=>
	(train UNIT-MECH2-LINE)
)

(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal enemymechsighted MECH-ALERT-P2)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-detect-p2)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-detect-p2-water)
		)
	)
	(can-train UNIT-MECH2-LINE)
=>
	(train UNIT-MECH2-LINE)
)

(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal enemymechsighted MECH-ALERT-P3)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-detect-p3)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-MECH2-LINE < TL3-mech2-detect-p3-water)
		)
	)
	(can-train UNIT-MECH2-LINE)
=>
	(train UNIT-MECH2-LINE)
)

