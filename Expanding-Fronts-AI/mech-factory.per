; -----------------------
; MECH/HW STRIKE CORE
; -----------------------

; --- MECH/HW Strike p1 ---
(defrule
	(current-age == tech-level-4)
	(goal combat-arm MECH/HW)
	(unit-type-count-total UNIT-MECH1-LINE < TL4-mech1-arm-p1)
	(can-train UNIT-MECH1-LINE)
=>
	(train UNIT-MECH1-LINE)
)

; --- MECH/HW Strike p2 ---
(defrule
	(current-age == tech-level-4)
	(goal combat-arm MECH/HW)
	(goal importantT4research DONE)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1-water)
		)
	)
	(unit-type-count-total UNIT-MECH1-LINE < TL4-mech1-arm-p2)
	(can-train UNIT-MECH1-LINE)
=>
	(train UNIT-MECH1-LINE)
)

; --- MECH/HW Strike p3 ---
(defrule
	(current-age == tech-level-4)
	(goal combat-arm MECH/HW)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2-water)
		)
	)
	(unit-type-count-total UNIT-MECH1-LINE < TL4-mech1-arm-p3)
	(can-train UNIT-MECH1-LINE)
=>
	(train UNIT-MECH1-LINE)
)

; --- MECH/HW Strike p4 ---
(defrule
	(current-age == tech-level-4)
	(goal combat-arm MECH/HW)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p3)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p3-water)
		)
	)
	(unit-type-count-total UNIT-MECH1-LINE < TL4-mech1-arm-p4)
	(can-train UNIT-MECH1-LINE)
=>
	(train UNIT-MECH1-LINE)
)

