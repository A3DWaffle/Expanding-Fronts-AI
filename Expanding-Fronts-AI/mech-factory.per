(defrule
	(current-age == tech-level-4)
	(goal support-assault-mech YES)
	(goal importantT4research DONE)
	(unit-type-count-total UNIT-MECH3-LINE < TL4-mech3-supp-p1)
	(can-train UNIT-MECH3-LINE)
=>
	(train UNIT-MECH3-LINE)
)

