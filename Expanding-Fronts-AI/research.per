; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(goal openingstyle STYLE-AGRESSIVE)
	(research-completed rt-macrobinoculars)
	(research-completed rt-fusion-cutter)
	(research-completed rt-irrigation)
=>
	(set-goal importantT2research DONE)
	(disable-self)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(research-completed rt-macrobinoculars)
	(research-completed rt-primary-focus-coils)
	(research-completed rt-basic-armor)
=>
	(set-goal importantT2research DONE)
	(disable-self)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
=>
	(set-goal importantT2research DONE)
	(disable-self)
)

; T3
(defrule
	(goal openingstyle STYLE-AGRESSIVE)
	(research-completed rt-portable-scanners)
	(research-completed rt-elevation-tracking)
	(research-completed rt-external-sensor-pod)
	(research-completed rt-upgraded-motivator)
	(research-completed rt-enh-fusion-cutter)
	(research-completed rt-harvesting)
	(research-completed rt-tracking-computer) ; does slow down the works, but that's probably fine
=>
	(set-goal importantT3research DONE)
	(disable-self)
)

(defrule
	(goal openingstyle STYLE-DEFENSIVE)
	(research-completed rt-upgraded-motivator)
	(research-completed rt-elevation-tracking)
	(research-completed rt-external-sensor-pod)
	(research-completed rt-fusion-cutter)
	(research-completed rt-irrigation)
	(research-completed rt-enh-fusion-cutter)
	(research-completed rt-harvesting)
=>
	(set-goal importantT3research DONE)
	(disable-self)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(not (research-available rt-primary-focus-coils))
	(not (research-available rt-basic-armor))
=>
	(set-goal importantT3research DONE)
	(disable-self)
)

; T4
(defrule
	(research-completed rt-homing-sensors)
	(research-completed rt-heavy-fusion-cutter)
	(research-completed rt-adv-harvesting)
	(research-completed rt-targetting-sensors)
	(research-completed rt-optimized-motivator)
=>
	(set-goal importantT4research DONE)
	(disable-self)
)

; -----------------------------------------------------
; *** Chapter 1: GLOBAL PRIORITY ***
; -----------------------------------------------------

;  Normally, file load order does not matter. However, in the case of the advancement to a tech level, a whole bunch of techs
;  suddenly become available. The prioritization system already handles some of them, but in these specific cases, some techs should
;  be researched over others. By putting them first in the file, it ensures that if the AI has the resources on hand, it will get these
;  as opposed to the other techs

(defrule
	; Shield Modifications - prioritize for real air comps and air UUs
	(can-research-with-escrow rt-shield-mods)
	(or
		(goal combat-arm AIR)
		(or
			(goal support-aircraft YES)
			(or
				(goal support-aircraft YES)
				(or
					(unit-type-count-total UNIT-AIRSPEEDER-LINE > 0)
					(or
						(unit-type-count-total UNIT-GEOFLYR-LINE > 0)
						(or
							(unit-type-count-total UNIT-VWING-LINE > 0)
							(unit-type-count-total UNIT-JEDIFGT-LINE > 0)
						)
					)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-shield-mods)
)

(defrule
	; Efficient Buildings
	(can-research-with-escrow rt-effbldgs)
=>
	(release-escrow nova)
	(research rt-effbldgs)
)

(defrule
	; Automated Processes
	(can-research-with-escrow rt-automated-processes)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-automated-processes)
)

(defrule
    ; Adv Missile Turret
    (can-research-with-escrow ut-adv-missile-turret) ; important tech
=>
	(release-escrow carbon)
	(release-escrow metal)
    (research ut-adv-missile-turret)
)

