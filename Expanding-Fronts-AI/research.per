; -----------------------------------------------------
; *** Chapter 4: COMMAND CENTER
; -----------------------------------------------------

; Motivators & basic training moved to homebase due to file load issues

(defrule
	; Sensor Beacon
	(current-age >= tech-level-3)
	(building-type-count BLDG-MAIN > 2)
	(or
		(and
			(current-age == tech-level-3)
			(goal importantT3research DONE)
		)
		(and
			(current-age >= tech-level-4)
			(goal importantT4research DONE)
		)
	)
	(can-research rt-sensor-beacon)
=>
	(research rt-sensor-beacon)
)

(defrule
	; Sensor Array
	(current-age >= tech-level-3)
	(building-type-count BLDG-MAIN > 2)
	(or
		(and
			(current-age == tech-level-3)
			(goal importantT3research DONE)
		)
		(and
			(current-age >= tech-level-4)
			(goal importantT4research DONE)
		)
	)
	(can-research rt-sensor-array)
=>
	(research rt-sensor-array)
)

