; =====================================================
; FILE: carbon
; PURPOSE:
;   Builds Carbon Processing Centers and researches carbon-side economy techs.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 1: CARBON PROCESSING CENTERS
;	Chapter 2: CARBON ECONOMY TECHS
;
; =====================================================
; *** Chapter 1: CARBON PROCESSING CENTERS ***
; =====================================================

; Hunt openers need early carbon infrastructure before the first Food Proc Ctr.
; Otherwise hunt-delayed food rules can leave the opener with neither eco anchor.
(defrule
	(game-time > 45)
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(building-type-count BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPCARBON == 0)
	(not (dropsite-min-distance carbon == -1))
	(not (dropsite-min-distance carbon == 255))
	(dropsite-min-distance carbon > 1)
	(can-build-with-escrow BLDG-DROPCARBON)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund ccarbonproc)
	(build BLDG-DROPCARBON)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON == 0)
	(not (dropsite-min-distance carbon == -1))
	(not (dropsite-min-distance carbon == 255))
	(dropsite-min-distance carbon > 1)
	(can-build BLDG-DROPCARBON)
	(not (goal savetheanimals YES)) ; wanna get those nerfs housed ASAP
	(game-time > 60) ; do not do immediately
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund ccarbonproc)
	(build BLDG-DROPCARBON)
)

; timeout
(defrule
	(game-time > 180)
	(building-type-count-total BLDG-DROPCARBON == 0)
	(can-build BLDG-DROPCARBON)
	(not (goal buildpause YES))
	=>
	(set-goal resourcerefund ccarbonproc)
	(build BLDG-DROPCARBON)
)

; build as needed
; Zel: we have to escrow carbon procs
; as the AI is Just That Incompetent
(defrule
	(current-age >= tech-level-2)
	(dropsite-min-distance carbon > 3)
	(not (dropsite-min-distance carbon == 255)) ; not on island
	(not (dropsite-min-distance carbon == -1)) ; none found
	(building-type-count BLDG-DROPCARBON < 12) ; cap of 12, but these can and should be deleted
	(game-time > 180) ; 3min
	(can-build-with-escrow BLDG-DROPCARBON)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund ccarbonproc)
	(build BLDG-DROPCARBON)
)

; interesting note: AI seems to be unable to build carbon proc centers on trees that it itself chopped



(defrule
	(building-type-count-total BLDG-DROPCARBON > 10)
=>
	(delete-complete-building BLDG-DROPCARBON)
)

; =====================================================
; *** Chapter 2: CARBON ECONOMY TECHS ***
; =====================================================

(defrule
	; Handheld CarbonExtractor
	(or
		(current-age >= tech-level-3)
		(and
			(current-age == tech-level-2)
			(goal agingup YES)
		)
	)
	(can-research-with-escrow rt-fusion-cutter)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-fusion-cutter)
)

(defrule
	; Enhanced CarbonExtractor
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-enh-fusion-cutter)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-enh-fusion-cutter)
)

(defrule
	; Hvy Duty CarbonExtractor
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-heavy-fusion-cutter)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-heavy-fusion-cutter)
)

(defrule
	; WK People of the Trees
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-peopleoftrees)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research ut-peopleoftrees)
)
