	(escrow-amount nova > 250)
	(building-type-count BLDG-SPACEPORT > 0)
=>
	(release-escrow nova)
	(buy-commodity metal)
	(set-goal lategameore ONE)
	(chat-local-to-self "WAFFLE: Escrow Low Ore Purchase up to 3")
)

