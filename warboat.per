; =====================================================
; FILE: warboat
; PURPOSE:
;   Legacy late-game utility hooks retained under the warboat name.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: LATEGAME UTILITY
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal lategameac 0)
	(disable-self)
)

; many values now set as part of t-tenmin as part of constants

; =====================================================
; *** Chapter 1: LATEGAME UTILITY ***
; =====================================================

(defrule
	(goal lategamemaster ALLOW)
	(unit-type-count-total UNIT-MASTER-LINE > 0) ; one master
=>
	(set-goal lategamemaster DONE)
)

(defrule
	(goal lategamecannon TWO)						; option a: as part of 10min timer lategame
	(unit-type-count-total SIEGE-CANNON-LINE < 2) 
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
	; (chat-local-to-self "WAFFLE: Escrow cannon: up to two")
)

(defrule
	(unit-type-count-total SIEGE-CANNON-LINE >= 2)
	(goal lategamecannon TWO)
=>
	(set-goal lategamecannon NO)
)

(defrule
	(goal lategamemaster ALLOW)
	(unit-type-count-total UNIT-MASTER-LINE < 1)
	(can-train-with-escrow UNIT-MASTER-LINE)
	(research-completed rt-jedi-concentration)
=>
	(release-escrow food)
	(release-escrow nova)
	(train UNIT-MASTER-LINE)
	; (chat-local-to-self "WAFFLE: Escrow master")
)

; ore

(defrule
	(metal-amount > 3000) ; skip
	(not (goal lategameore THREE))
=>
	(set-goal lategameore THREE)
)

(defrule
	(goal lategameore ALLOW)
	(can-buy-commodity metal)
=>
	(buy-commodity metal)
	(set-goal lategameore ONE)
	; (chat-local-to-self "WAFFLE: Ore Purchase up to 3")
)

(defrule
	(goal lategameore ONE)
	(can-buy-commodity metal)
=>
	(buy-commodity metal)
	(set-goal lategameore TWO)
	;(chat-local-to-self "WAFFLE: Ore Purchase 2")
)

(defrule
	(goal lategameore TWO)
	(can-buy-commodity metal)
=>
	(buy-commodity metal)
	(set-goal lategameore THREE)
	;(chat-local-to-self "WAFFLE: Ore Purchase 3")
)

; try with escrow

; lower amount
(defrule
	(goal lategameore ALLOW)
	(not (can-buy-commodity metal))
	(commodity-buying-price metal < 250)
	(escrow-amount nova > 250)
	(building-type-count BLDG-SPACEPORT > 0)
=>
	(release-escrow nova)
	(buy-commodity metal)
	(set-goal lategameore ONE)
	; (chat-local-to-self "WAFFLE: Escrow Low Ore Purchase up to 3")
)

(defrule
	(goal lategameore ONE)
	(not (can-buy-commodity metal))
	(commodity-buying-price metal < 250)
	(escrow-amount nova > 250)
	(building-type-count BLDG-SPACEPORT > 0)
=>
	(release-escrow nova)
	(buy-commodity metal)
	(set-goal lategameore TWO)
	;(chat-local-to-self "WAFFLE: Escrow Low Ore Purchase 2")
)

(defrule
	(goal lategameore TWO)
	(not (can-buy-commodity metal))
	(commodity-buying-price metal < 250)
	(escrow-amount nova > 250)
	(building-type-count BLDG-SPACEPORT > 0)
=>
	(release-escrow nova)
	(buy-commodity metal)
	(set-goal lategameore THREE)
	;(chat-local-to-self "WAFFLE: Escrow Low Ore Purchase 3")
)

;upper amount: give up at 350
(defrule
	(goal lategameore ALLOW)
	(not (can-buy-commodity metal))
	(commodity-buying-price metal >= 250)
	(commodity-buying-price metal < 350)
	(escrow-amount nova > 350)
	(building-type-count BLDG-SPACEPORT > 0)
=>
	(release-escrow nova)
	(buy-commodity metal)
	(set-goal lategameore ONE)
	; (chat-local-to-self "WAFFLE: Escrow High Ore Purchase up to 3")
)

(defrule
	(goal lategameore ONE)
	(not (can-buy-commodity metal))
	(commodity-buying-price metal >= 250)
	(commodity-buying-price metal < 350)
	(escrow-amount nova > 350)
	(building-type-count BLDG-SPACEPORT > 0)
=>
	(release-escrow nova)
	(buy-commodity metal)
	(set-goal lategameore TWO)
	;(chat-local-to-self "WAFFLE: Escrow High Ore Purchase 2")
)

(defrule
	(goal lategameore TWO)
	(not (can-buy-commodity metal))
	(commodity-buying-price metal >= 250)
	(commodity-buying-price metal < 350)
	(escrow-amount nova > 350)
	(building-type-count BLDG-SPACEPORT > 0)
=>
	(release-escrow nova)
	(buy-commodity metal)
	(set-goal lategameore THREE)
	;(chat-local-to-self "WAFFLE: Escrow High Ore Purchase 3")
)

