(defrule
	(goal lategamecannon TWO)						; option a: as part of 10min timer lategame
	(unit-type-count-total SIEGE-CANNON-LINE < 2) 
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
	(chat-local-to-self "WAFFLE: Escrow cannon: up to two")
)

(defrule
	(goal lategamecannon ALLOW)						; option b: as part of requirement for lategamecomp
	(can-train-with-escrow SIEGE-CANNON-LINE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
	(chat-local-to-self "WAFFLE: Escrow cannon: required for lategamecomp")
)




(defrule
	(unit-type-count-total SIEGE-CANNON-LINE >= 2)
	(goal lategamecannon TWO)
=>
	(set-goal lategamecannon NO)
)



(defrule
	(goal lategamemaster ALLOW)
	(unit-type-count-total UNIT-MASTER-LINE < 1)
	(can-train-with-escrow UNIT-MASTER-LINE)
	(research-completed rt-jedi-concentration)
=>
	(release-escrow food)
	(release-escrow nova)
	(train UNIT-MASTER-LINE)
	(chat-local-to-self "WAFFLE: Escrow master")
)

; ore

(defrule
	(metal-amount > 3000) ; skip
	(not (goal lategameore THREE))
=>
	(set-goal lategameore THREE)
)

(defrule
	(goal lategameore ALLOW)
	(can-buy-commodity metal)
=>
	(buy-commodity metal)
	(set-goal lategameore ONE)
	(chat-local-to-self "WAFFLE: Ore Purchase up to 3")
)

(defrule
	(goal lategameore ONE)
	(can-buy-commodity metal)
=>
	(buy-commodity metal)
	(set-goal lategameore TWO)
	;(chat-local-to-self "WAFFLE: Ore Purchase 2")
)

(defrule
	(goal lategameore TWO)
	(can-buy-commodity metal)
=>
	(buy-commodity metal)
	(set-goal lategameore THREE)
	;(chat-local-to-self "WAFFLE: Ore Purchase 3")
)

; try with escrow

