; rebels, naboo, resistance, new republic
; empire, wookiees

(defrule
	(goal lategameac 2) ; 20min see constants
	(can-train-with-escrow UNIT-AIRCRUISER-LINE)
=>
	(release-escrow food)
	(release-escrow nova)
	(train UNIT-AIRCRUISER-LINE)
	(set-goal lategameac 0)
	; (chat-local-to-self "WAFFLE: Escrow AC")
)

