(defrule
	(true)
=>
	(set-goal allowlategamecomp NO) ; initialize
	(set-goal lategameac 0)
	(disable-self)
)



; ok so the BULK of this file is the below but there's some important stuff that should happen in lategame too

; many values now set as part of t-tenmin as part of constants


(defrule
	(goal lategamemaster ALLOW)
	(unit-type-count-total UNIT-MASTER-LINE > 0) ; one master
=>
	(set-goal lategamemaster DONE)
)

;combined rule (less helpful for debug spectating)
; (defrule
; 	(or
; 		(and
; 			(goal lategamecannon TWO)						; option a: as part of 10min timer lategame
; 			(unit-type-count-total SIEGE-CANNON-LINE < 2) 
; 		)
; 			(goal lategamecannon ALLOW)						; option b: as part of requirement for lategamecomp
; 	)
; 	(can-train-with-escrow SIEGE-CANNON-LINE)
; =>
