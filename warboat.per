; ONLY WORKS ON HARD OR HARDEST

; THE CORE OF THIS FILE IS 
; (population >= stop-junk-threshold)) ; update: it became a lot more complicated than that 
; stop-junk-threshold is defined per population (thanks C++ script) as 10% of pop cap
; Stuff like Troopers, workers, trade units (edit: not trade units), halts at this point
; And civs should go REALLY REALLY HAM with the remaining 10% pop with THE BEST OF THE BEST units, not caring about number, simply caring that they can be massed

; was a rule for ACs but that was mostly just being silly


; rules for overall enable/disable
(defrule
	(true)
=>
	(set-goal allowlategamecomp 999) ; disable on game start
	(disable-self)
)

(defrule
	(current-age == tech-level-3) ; allow in late T3
=>
	(set-goal allowlategamecomp NO)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
=>
	(set-goal allowlategamecomp 999) ; disable while research is coming in
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
=>
	(set-goal allowlategamecomp NO) ; allow enabling
	(disable-self)
)


; the way this works now is to reset it to NO each time, and then every time it has to run the checks, which SHOULD be okay ? 
; possible lag issue but it really should not be a problem, just like resign rules really
; I think any lag was from having a Computer Classic in the match tbh
(defrule
	(not (goal allowlategamecomp 999)) ; disabled
	(not (goal allowlategamecomp NO))
=>
	(set-goal allowlategamecomp NO)
)

; cannon reset
(defrule
	(goal allowlategamecomp NO)
	(not (goal lategamecannon TWO)) ; do not delete this information
	(not (goal lategamecannon NO))
=>
	(set-goal lategamecannon NO)
)



; population check:
; in essence, one of the following must be true:
(defrule
	(goal allowlategamecomp NO)
	(or
		(population >= stop-junk-threshold); 0.9x pop cap: 225(250)
	(or
		(and
			(goal lategameworker YES)
			(population >= stop-junk-threshold-lower); 0.8x pop cap: 200(250)
		)
	(or
		(and
			(cc-players-building-type-count any-ally BLDG-MONUMENT > 0)
			(population >= stop-junk-threshold-lower)
		)
	(or
		(and
			(cc-players-building-type-count any-enemy BLDG-MONUMENT > 0)
			(population >= stop-junk-threshold-lower)
		)
		(and
			(building-type-count-total BLDG-MONUMENT > 0)
			(population >= stop-junk-threshold-lower)
		)
	)
	)
	)
	)

=>
	(set-goal allowlategamecomp 10) ; 10 is temp value
)

; aa check
(defrule
	(goal allowlategamecomp 10)
	(or
		(and
			(goal enemyairsighted AIR-ALERT-NONE)
			(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p1)	; require a light AA screen
		)
	(or
		(and
			(goal enemyairsighted AIR-ALERT-LOW)
			(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p1)
		)
	(or
		(and
			(goal enemyairsighted AIR-ALERT-GUARD)
			(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-guard-p2) ; require full amount
		)
		(and
			(or
				(goal enemyairsighted AIR-ALERT-DANGER)
				(goal enemyairsighted AIR-ALERT-CRISIS)
			)
			(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-danger-p3) 
		)
	)
	)
	)
=>
	(set-goal allowlategamecomp 11)
)

; siege check - use live package p1 caps as the minimum late-comp unlock gate
(defrule
	(goal allowlategamecomp 11)
	(not (goal special-map WATER))
	(or
		(unit-type-count-total SIEGE-CANNON-LINE >= TL4-cannon-arm-p1)
		(current-age == tech-level-3) ; cannons do not exist in T3
	)
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
=>
	(set-goal allowlategamecomp YES)
)

(defrule
	(goal allowlategamecomp 11)
	(goal special-map WATER)
	(or
		(unit-type-count-total SIEGE-CANNON-LINE >= TL4-cannon-arm-p1-water)
		(current-age == tech-level-3) ; cannons do not exist in T3
	)
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1-water)
=>
	(set-goal allowlategamecomp YES)
)

; siege fail due to cannon
(defrule
	(current-age == tech-level-4)
	(goal allowlategamecomp 11)
	(not (goal special-map WATER))
	(not (unit-type-count-total SIEGE-CANNON-LINE >= TL4-cannon-arm-p1))
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
	(not (goal lategamecannon ALLOW))
=>
	(set-goal lategamecannon ALLOW)
)

(defrule
	(current-age == tech-level-4)
	(goal allowlategamecomp 11)
	(goal special-map WATER)
	(not (unit-type-count-total SIEGE-CANNON-LINE >= TL4-cannon-arm-p1-water))
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1-water)
	(not (goal lategamecannon ALLOW))
=>
	(set-goal lategamecannon ALLOW)
)



