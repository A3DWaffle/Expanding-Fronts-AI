; =====================================================
; CHAPTER 3: TECH 3 AIR PACKAGES
; =====================================================

; -----------------------
; FIGHTERS
; -----------------------

; --- TL3 fighter trick reset ---
(defrule
	(current-age >= tech-level-4)
	(goal fightertrick FIGHTERTRICK-ACTIVE)
=>
	(set-goal fightertrick FIGHTERTRICK-DONE)
)

; --- TL3 fighter trick p1 ---
; Defensive/agressive openings may use the two-Airbase fighter trick even if air is not their long-term arm.
(defrule
	(current-age == tech-level-3)
	(goal fightertrick FIGHTERTRICK-ACTIVE)
	(building-type-count-total BLDG-TRAINAIR >= 2)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-FIGHTER-LINE < fightertrick-fighters)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-FIGHTER-LINE < fightertrick-fighters-water)
		)
	)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; --- TL3 fighter core p1 ---
(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm AIR)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(or
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1-water)
		)
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1)
		)
	)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; --- TL3 fighter core p2 ---
(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm AIR)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-BOMBER-LINE >= TL3-bomber-arm-p1)
				(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-BOMBER-LINE >= TL3-bomber-arm-p1-water)
				(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2-water)
			)
		)
	)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; -----------------------
; BOMBERS
; -----------------------

(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm AIR)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p1-water)
		)
	)
	(can-train UNIT-BOMBER-LINE)
=>
	(train UNIT-BOMBER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm AIR)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-FIGHTER-LINE >= TL3-fighter-arm-p2)
				(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p2)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-FIGHTER-LINE >= TL3-fighter-arm-p2-water)
				(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p2-water)
			)
		)
	
	)
	(can-train UNIT-BOMBER-LINE)
=>
	(train UNIT-BOMBER-LINE)
)

; =====================================================
; CHAPTER 4: 
; =====================================================

; -----------------------
; INTERCEPTORS
; -----------------------

; --- Interceptor air-alert low ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(goal enemyairsighted AIR-ALERT-LOW)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-detect-air-alert-low-p1)
	(can-train UNIT-INTERCEPTOR-LINE)
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; --- Interceptor air-alert guard ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-detect-air-alert-guard-p2)
	(can-train UNIT-INTERCEPTOR-LINE)
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; --- Interceptor air-alert danger ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-detect-air-alert-danger-p3)
	(can-train UNIT-INTERCEPTOR-LINE)
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; -----------------------
; ATTACKERS
; -----------------------

; --- Aircraft support attackers p1 ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p1)
	(can-train UNIT-ATTACKER-LINE)
=>
	(train UNIT-ATTACKER-LINE)
)

; --- Aircraft support attackers p2 ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(goal importantT4research DONE)
	(or
		(goal enemyairsighted AIR-ALERT-NONE)
		(or
			(and
				(goal enemyairsighted AIR-ALERT-LOW)
				(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-low-p1)
			)
			(or
				(and
					(goal enemyairsighted AIR-ALERT-GUARD)
					(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-guard-p2)
				)
				(and
					(goal enemyairsighted AIR-ALERT-DANGER)
					(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-danger-p3)
				)
			)
		)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p2)
	(can-train UNIT-ATTACKER-LINE)
=>
	(train UNIT-ATTACKER-LINE)
)

; --- Aircraft support attackers p3 ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(goal importantT4research DONE)
		(or
		(goal enemyairsighted AIR-ALERT-NONE)
		(or
			(and
				(goal enemyairsighted AIR-ALERT-LOW)
				(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-low-p1)
			)
			(or
				(and
					(goal enemyairsighted AIR-ALERT-GUARD)
					(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-guard-p2)
				)
				(and
					(goal enemyairsighted AIR-ALERT-DANGER)
					(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-danger-p3)
				)
			)
		)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p3)
	(can-train UNIT-ATTACKER-LINE)
=>
	(train UNIT-ATTACKER-LINE)
)

; --- Aircraft support attackers p4 ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(goal importantT4research DONE)
		(or
		(goal enemyairsighted AIR-ALERT-NONE)
		(or
			(and
				(goal enemyairsighted AIR-ALERT-LOW)
				(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-low-p1)
			)
			(or
				(and
					(goal enemyairsighted AIR-ALERT-GUARD)
					(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-guard-p2)
				)
				(and
					(goal enemyairsighted AIR-ALERT-DANGER)
					(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-detect-air-alert-danger-p3)
				)
			)
		)
	)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p4)
	(can-train UNIT-ATTACKER-LINE)
=>
	(train UNIT-ATTACKER-LINE)
)

