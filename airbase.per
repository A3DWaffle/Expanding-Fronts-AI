; =====================================================
; FILE: airbase
; PURPOSE:
;   Builds Airbases, researches aircraft upgrades, and trains aircraft packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL3 PACKAGES
;	Chapter 4: TL4 PACKAGES
;	Chapter 5: AIR TRANSPORT
;
; =====================================================
; *** Chapter 1: BUILDINGS ***
; =====================================================

(defrule
	(can-build BLDG-TRAINAIR)
	(current-age == tech-level-3)
	(goal support-aircraft YES)
	(building-type-count-total BLDG-TRAINAIR < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINAIR)
)

(defrule
	(can-build BLDG-TRAINAIR)
	(current-age == tech-level-3)
	(building-type-count-total BLDG-MAIN > 2)
	(building-type-count-total BLDG-TRAINAIR == 0)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(goal support-aircraft NO)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINAIR)
)

(defrule
	(can-build BLDG-TRAINAIR)
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(building-type-count-total BLDG-TRAINAIR < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINAIR)
)

(defrule
	(can-build BLDG-TRAINAIR)
	(current-age == tech-level-4)
	(goal combat-arm AIR)
	(goal support-aircraft YES)
	(building-type-count-total BLDG-TRAINAIR < 6)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINAIR)
)

; Heavy troop pressure can justify an Airbase response from any lineup.
(defrule
	(current-age == tech-level-4)
	(not (goal combat-arm AIR))
	(goal enemytroopersighted TROOPER-ALERT-P2)
	(building-type-count-total BLDG-TRAINAIR < 3)
	(can-build BLDG-TRAINAIR)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINAIR)
)

; Naval air support can establish Airbases even without the aircraft package.
(defrule
	(current-age >= tech-level-3)
	(goal special-map WATER)
	(not (goal enemyboatsighted BOAT-ALERT-NONE))
	(not (goal enemyboatsighted BOAT-ALERT-P1))
	(building-type-count-total BLDG-TRAINAIR < 2)
	(can-build BLDG-TRAINAIR)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINAIR)
)

(defrule
	(current-age >= tech-level-3)
	(goal special-map HYBRID)
	(not (goal enemyboatsighted BOAT-ALERT-NONE))
	(not (goal enemyboatsighted BOAT-ALERT-P1))
	(building-type-count-total BLDG-TRAINAIR < 2)
	(can-build BLDG-TRAINAIR)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINAIR)
)

; =====================================================
; CHAPTER 2: UPGRADES
; =====================================================

; --- Basic fighter upgrade ---
(defrule
	(can-research-with-escrow ut-fighter-2)
	(current-age >= tech-level-4)
	(or (goal support-aircraft YES) (goal enemytroopersighted TROOPER-ALERT-P2))
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p1)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-fighter-2)
)

; --- Advanced fighter upgrade ---
(defrule
	(can-research-with-escrow ut-fighter-3)
	(current-age >= tech-level-4)
	(or (goal support-aircraft YES) (goal enemytroopersighted TROOPER-ALERT-P2))
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p1)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-fighter-3)
)

; --- Enhanced bomber upgrade ---
(defrule
	(can-research-with-escrow ut-bomber-2)
	(current-age >= tech-level-4)
	(goal support-aircraft YES)	
	(unit-type-count-total UNIT-BOMBER-LINE >= TL4-bomber-arm-p1)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-bomber-2)
)

(defrule
	; Efficient Manufacturing
	(can-research-with-escrow rt-drafted-labor)
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-drafted-labor)
)

(defrule
	; Shield Modifications
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-shield-mods)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-shield-mods)
)

(defrule
	; Armored Platework
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-armor-plating)
	(or
		(research-completed rt-shield-mods)
		(not (research-available rt-shield-mods))
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-armor-plating)
)

(defrule
	; Enlarged Bomb Hold
	(can-research-with-escrow rt-enlarged-bomb-hold)
	(current-age >= tech-level-3)
	(unit-type-count-total UNIT-BOMBER-LINE >= TL3-bomber-arm-p1)
	(or
		(research-completed rt-drafted-labor)
		(not (research-available rt-drafted-labor))
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-enlarged-bomb-hold)
)

(defrule
	; RP Gunship Armaments
	(can-research-with-escrow rt-gunship-lasers)
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(research-completed rt-shield-mods)
	(research-completed rt-drafted-labor)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-gunship-lasers)
)

(defrule
	; RA A-wing Upgrades
	(can-research-with-escrow rt-avail-awing)
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE >= TL4-interceptor-arm-p1)
	(research-completed rt-shield-mods)
	(research-completed rt-drafted-labor)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-avail-awing)
)

(defrule
	; RA Astromech Repairs
	(can-research-with-escrow rt-astromechs)
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(research-completed rt-shield-mods)
	(research-completed rt-drafted-labor)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-astromechs)
)

(defrule
	; RN Advanced Engines
	(can-research-with-escrow rt-lighter-material)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(research-completed rt-shield-mods)
	(research-completed rt-drafted-labor)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-lighter-material)
)

(defrule
	; RS Bunkerbusters
	(can-research-with-escrow rt-bunkerbusters)
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-BOMBER-LINE >= TL4-bomber-arm-p1)
	(research-completed rt-enlarged-bomb-hold)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-bunkerbusters)
)

(defrule
	; NR New Class Modernization
	(can-research-with-escrow ut-newclassmod)
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(research-completed rt-shield-mods)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-newclassmod)
)

; =====================================================
; CHAPTER 3: TECH 3 AIR PACKAGES
; =====================================================

; TL3 mech counters get the next Airbase slot until their bounded target is met.
(defrule
	(true)
=>
	(set-goal t3-bomber-priority NO)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map LAND)
	(goal enemymechsighted MECH-ALERT-P1)
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p1)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map LAND)
	(or (goal enemymechsighted MECH-ALERT-P2) (or (goal enemymechsighted MECH-ALERT-P3) (goal enemymechsighted MECH-ALERT-P4)))
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p2)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(goal enemymechsighted MECH-ALERT-P1)
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p1-water)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(or (goal enemymechsighted MECH-ALERT-P2) (or (goal enemymechsighted MECH-ALERT-P3) (goal enemymechsighted MECH-ALERT-P4)))
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p2-water)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(goal enemymechsighted MECH-ALERT-P1)
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p1-hybrid)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(or (goal enemymechsighted MECH-ALERT-P2) (or (goal enemymechsighted MECH-ALERT-P3) (goal enemymechsighted MECH-ALERT-P4)))
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p2-hybrid)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(goal enemymechsighted MECH-ALERT-P1)
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p1-asteroid)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(or (goal enemymechsighted MECH-ALERT-P2) (or (goal enemymechsighted MECH-ALERT-P3) (goal enemymechsighted MECH-ALERT-P4)))
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p2-asteroid)
	(can-train UNIT-BOMBER-LINE)
=>
	(set-goal t3-bomber-priority YES)
)

