; =====================================================
; FILE: airbase
; PURPOSE:
;   Builds Airbases, researches aircraft upgrades, and trains aircraft packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL3 PACKAGES
;	Chapter 4: TL4 PACKAGES
;	Chapter 5: DETECT PACKAGES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-TRAINAIR < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 25)
	(not (goal tryingtobuild AIRBASE))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-MAIN > 2)
	(building-type-count-total BLDG-TRAINAIR < 4)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 25)
	(not (goal tryingtobuild AIRBASE))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-MAIN > 2)
	(building-type-count-total BLDG-TRAINAIR < 1)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 25)
	(not (goal tryingtobuild AIRBASE))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(or
			(goal support-aircraft YES)
			(or
				(goal support-aircraft YES)
				(goal support-bombers YES)
			)
		)
	)
	(building-type-count-total BLDG-TRAINAIR < 4)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 25)
	(not (goal tryingtobuild AIRBASE))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

; =====================================================
; CHAPTER 2: UPGRADES
; =====================================================

; --- Basic fighter upgrade ---
(defrule
	(current-age >= tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(can-research-with-escrow ut-fighter-2)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-fighter-2)
)

; --- Advanced fighter upgrade: standard timing ---
(defrule
	(current-age >= tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(research-completed rt-shield-mods)
	(can-research-with-escrow ut-fighter-3)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-fighter-3)
)

; --- Enhanced bomber upgrade: standard timing ---
(defrule
	(current-age >= tech-level-4)
	(or
		(goal combat-arm AIR)
		(or
			(goal support-aircraft YES)
			(or
				(goal support-aircraft YES)
				(goal support-bombers YES)
			)
		)
	)
	(research-completed rt-shield-mods)
	(can-research-with-escrow ut-bomber-2)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-bomber-2)
)

; --- Advanced bomber upgrade ---
(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-bomber-3)
	(or
		(goal combat-arm AIR)
		(or
			(goal support-aircraft YES)
			(or
				(goal support-aircraft YES)
				(goal support-bombers YES)
			)
		)
	)
	(research-completed rt-shield-mods)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-bomber-3)
)

(defrule
	; Efficient Manufacturing
	(can-research-with-escrow rt-drafted-labor)
	(or
		(goal combat-arm AIR)
		(or
			(goal support-aircraft YES)
			(or
				(goal support-aircraft YES)
				(goal support-bombers YES)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-drafted-labor)
)

(defrule
	; Armored Platework
	(can-research-with-escrow rt-armor-plating)
	(or
		(goal combat-arm AIR)
		(or
			(goal support-aircraft YES)
			(or
				(goal support-aircraft YES)
				(goal support-bombers YES)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-armor-plating)
)

(defrule
	; Gunship Armaments
	(can-research-with-escrow rt-gunship-lasers)
	(or
		(goal combat-arm AIR)
		(or
			(goal support-aircraft YES)
			(or
				(goal support-aircraft YES)
				(goal support-bombers YES)
			)
		)
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-gunship-lasers)
)

(defrule
	; Enlarged Bomb Hold
	(current-age == tech-level-3)
	(can-research-with-escrow rt-enlarged-bomb-hold)
	(or
		(goal openingstyle STYLE-DEFENSIVE)
		(or
			(goal combat-arm AIR)
			(or
				(goal support-aircraft YES)
				(or
					(goal support-aircraft YES)
					(goal support-bombers YES)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-enlarged-bomb-hold)
)

(defrule
	; Enlarged Bomb Hold
	(current-age == tech-level-4)
	(can-research-with-escrow rt-enlarged-bomb-hold)
	(or
		(goal combat-arm AIR)
