; -----------------------
; FIGHTERS
; -----------------------

; --- TL3 fighter core p1 ---

; A small TL3 core floor makes the normal wave composition checks attainable.
; Retain larger existing packages and keep small-cap games on their old targets.
#load-if-not-defined POPULATION-CAP-25
#load-if-not-defined POPULATION-CAP-50
(defrule
	(current-age == tech-level-3)
	(goal combat-arm AIR)
	(unit-type-count-total UNIT-FIGHTER-LINE < 8)
	(can-train UNIT-FIGHTER-LINE)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)
#end-if
#end-if

(defrule
	(current-age == tech-level-3)
	(goal special-map LAND)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1)
	(can-train UNIT-FIGHTER-LINE)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1-water)
	(can-train UNIT-FIGHTER-LINE)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1-asteroid)
	(can-train UNIT-FIGHTER-LINE)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1-hybrid)
	(can-train UNIT-FIGHTER-LINE)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

; --- TL3 fighter core p2 ---
(defrule
	(can-train UNIT-FIGHTER-LINE)
	(current-age == tech-level-3)
	(goal special-map LAND)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(can-train UNIT-FIGHTER-LINE)
	(current-age == tech-level-3)
	(goal special-map WATER)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2-water)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(can-train UNIT-FIGHTER-LINE)
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2-asteroid)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(can-train UNIT-FIGHTER-LINE)
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2-hybrid)
	(goal t3-bomber-priority NO)
=>
	(train UNIT-FIGHTER-LINE)
)

; =====================================================
; CHAPTER 4: TL4 AIR PACKAGES
; =====================================================

; Heavy Repeater/Mountie sightings prioritize the AIR Fighter counter package.
; Recompute every pass. Queued Fighters satisfy the target; if training them is
; unavailable, allow the other aircraft rules to use available production.
(defrule
	(true)
=>
	(set-goal t4-fighter-priority NO)
)

(defrule
	(current-age == tech-level-4)
	(goal combat-arm AIR)
	(goal support-aircraft YES)
	(goal enemytroopersighted TROOPER-ALERT-P2)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p4)
	(can-train UNIT-FIGHTER-LINE)
=>
	(set-goal t4-fighter-priority YES)
)

; Heavy mounted armies can draw a larger Fighter response.
(defrule
	(current-age == tech-level-4)
	(not (goal combat-arm AIR))
	(goal enemytroopersighted TROOPER-ALERT-P2)
	(players-unit-type-count any-enemy UNIT-MOUNTED-LINE >= 20)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p4)
	(can-train UNIT-FIGHTER-LINE)
=>
	(set-goal t4-fighter-priority YES)
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(not (goal combat-arm AIR))
	(goal enemytroopersighted TROOPER-ALERT-P2)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p3)
	(can-train UNIT-FIGHTER-LINE)
=>
	(set-goal t4-fighter-priority YES)
	(train UNIT-FIGHTER-LINE)
)

; -----------------------
; INTERCEPTORS
; -----------------------

; --- Interceptor air-alert danger ---
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-detect-air-alert-danger-p3)
	(can-train UNIT-INTERCEPTOR-LINE)
	(goal t4-fighter-priority NO)
	(not (goal combat-arm AIR))
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; Reduced Interceptor cover for the AIR core lineup.
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-air-danger)
	(can-train UNIT-INTERCEPTOR-LINE)
	(goal t4-fighter-priority NO)
	(goal combat-arm AIR)
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; -----------------------
; FIGHTERS: TL4 AIR TROOPER RESPONSE
; -----------------------
; Raise the Fighter target before producing the replacement Attacker tiers.
; Queued Fighters count toward the target; existing aircraft are never discarded.
(defrule
	(current-age == tech-level-4)
	(goal combat-arm AIR)
	(goal support-aircraft YES)
	(not (goal enemytroopersighted TROOPER-ALERT-NONE))
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p3)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal combat-arm AIR)
	(goal support-aircraft YES)
	(goal enemytroopersighted TROOPER-ALERT-P2)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p4)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; -----------------------
; ATTACKERS
; -----------------------

(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p1)
	(can-train UNIT-ATTACKER-LINE)
	(goal t4-fighter-priority NO)
=>
	(train UNIT-ATTACKER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p2)
	(can-train UNIT-ATTACKER-LINE)
	(goal t4-fighter-priority NO)
=>
	(train UNIT-ATTACKER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p3)
	(can-train UNIT-ATTACKER-LINE)
	(goal t4-fighter-priority NO)
=>
	(train UNIT-ATTACKER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-ATTACKER-LINE < TL4-attacker-arm-p4)
	(can-train UNIT-ATTACKER-LINE)
	(goal t4-fighter-priority NO)
=>
	(train UNIT-ATTACKER-LINE)
)

; -----------------------
; INTERCEPTOR SUPPORT
; -----------------------
; Low/guard Interceptors supplement the Attacker core rather than taking its
; production slots first. If Attackers cannot train, allow available AA cover.
; --- Interceptor air-alert low ---
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(goal enemyairsighted AIR-ALERT-LOW)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-detect-air-alert-low-p1)
	(can-train UNIT-INTERCEPTOR-LINE)
	(goal t4-fighter-priority NO)
	(or (unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p2)
		(not (can-train UNIT-ATTACKER-LINE)))
	(not (goal combat-arm AIR))
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; Reduced Interceptor cover for the AIR core lineup.
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(goal enemyairsighted AIR-ALERT-LOW)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-air-low)
	(can-train UNIT-INTERCEPTOR-LINE)
	(goal t4-fighter-priority NO)
	(or (unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p2)
		(not (can-train UNIT-ATTACKER-LINE)))
	(goal combat-arm AIR)
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; --- Interceptor air-alert guard ---
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-detect-air-alert-guard-p2)
	(can-train UNIT-INTERCEPTOR-LINE)
	(goal t4-fighter-priority NO)
	(or (unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p2)
		(not (can-train UNIT-ATTACKER-LINE)))
	(not (goal combat-arm AIR))
=>
	(train UNIT-INTERCEPTOR-LINE)
)

; Reduced Interceptor cover for the AIR core lineup.
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(unit-type-count-total UNIT-INTERCEPTOR-LINE < TL4-interceptor-air-guard)
	(can-train UNIT-INTERCEPTOR-LINE)
	(goal t4-fighter-priority NO)
	(or (unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p2)
		(not (can-train UNIT-ATTACKER-LINE)))
	(goal combat-arm AIR)
=>
	(train UNIT-INTERCEPTOR-LINE)
)


; -----------------------
;  BOMBERS
; -----------------------

; Bombers supplement the fleet when multiple enemy combat boats are seen.
(defrule
	(current-age >= tech-level-3)
	(or (goal special-map WATER) (goal special-map HYBRID))
	(not (goal enemyboatsighted BOAT-ALERT-NONE))
	(not (goal enemyboatsighted BOAT-ALERT-P1))
	(unit-type-count-total UNIT-BOMBER-LINE < TL3-bomber-arm-p2-water)
	(goal t4-fighter-priority NO)
	(can-train UNIT-BOMBER-LINE)
=>
	(train UNIT-BOMBER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(or (goal special-map WATER) (goal special-map HYBRID))
	(or (goal enemyboatsighted BOAT-ALERT-P3) (goal enemyboatsighted BOAT-ALERT-P4))
	(unit-type-count-total UNIT-BOMBER-LINE < TL4-bomber-supp-p2)
	(goal t4-fighter-priority NO)
	(can-train UNIT-BOMBER-LINE)
=>
	(train UNIT-BOMBER-LINE)
)

; --- Anti-mech bomber p1 ---
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(or
		(goal combat-arm AIR)
		(goal enemymechsighted MECH-ALERT-P2)
	)
	(or
		(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p2)
		(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p2)
	)
	(unit-type-count-total UNIT-BOMBER-LINE < TL4-bomber-supp-p1)
	(can-train UNIT-BOMBER-LINE)
	(goal t4-fighter-priority NO)
=>
	(train UNIT-BOMBER-LINE)
)

; --- Anti-mech bomber p2 ---
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(or
		(goal combat-arm AIR)
		(goal enemymechsighted MECH-ALERT-P3)
	)
	(or
		(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p3)
		(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p3)
	)
	(unit-type-count-total UNIT-BOMBER-LINE < TL4-bomber-supp-p2)
	(can-train UNIT-BOMBER-LINE)
	(goal t4-fighter-priority NO)
=>
	(train UNIT-BOMBER-LINE)
)

; --- Anti-mech bomber p3 ---
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(or
		(goal combat-arm AIR)
		(goal enemymechsighted MECH-ALERT-P4)
	)
	(or
		(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p4)
		(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p4)
	)
	(unit-type-count-total UNIT-BOMBER-LINE < TL4-bomber-supp-p3)
	(can-train UNIT-BOMBER-LINE)
	(goal t4-fighter-priority NO)
=>
	(train UNIT-BOMBER-LINE)
)

; -----------------------
; FIGHTER SUPPORT
; -----------------------

; --- AIR core fighter cover ---
(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(military-population >= MIL_POP_A)
	(goal combat-arm AIR)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p1)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(military-population >= MIL_POP_A)
	(goal combat-arm AIR)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p2)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; =====================================================
; CHAPTER 5: AIR TRANSPORT
; =====================================================

; --- Maintain map-start Air Transport ---
(defrule
	(game-time < 10)
	(unit-type-count-total UNIT-AIRLIFT-LINE > 0)
=>
	(set-goal support-airlift YES)
	(disable-self)
)

; --- Enable airlift on Asteroid and Water maps ---
(defrule
	(or
		(goal special-map ASTEROID)
		(goal special-map WATER)
	)
=>
	(set-goal support-airlift YES)
	(disable-self)
)

; --- Water transport reserve for the existing group logic ---
(defrule
	(current-age >= tech-level-3)
	(goal special-map WATER)
	(goal support-airlift YES)
	(unit-type-count-total UNIT-AIRLIFT-LINE < 2)
	(can-train UNIT-AIRLIFT-LINE)
	(military-population >= MIL_POP_A)
	(soldier-count > 0)
=>
	(train UNIT-AIRLIFT-LINE)
)

#load-if-not-defined POPULATION-CAP-25
#load-if-not-defined POPULATION-CAP-50
(defrule
	(current-age == tech-level-4)
	(goal special-map WATER)
	(goal support-airlift YES)
	(unit-type-count-total UNIT-AIRLIFT-LINE < 3)
	(can-train UNIT-AIRLIFT-LINE)
	(military-population >= MIL_POP_A)
	(soldier-count > 0)
=>
	(train UNIT-AIRLIFT-LINE)
)
#end-if
#end-if
