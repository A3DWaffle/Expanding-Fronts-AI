; =====================================================
; FILE: airbase
; PURPOSE:
;   Builds Airbases, researches aircraft upgrades, and trains aircraft packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL3 PACKAGES
;	Chapter 4: TL4 PACKAGES
;	Chapter 5: AIR TRANSPORT
;
; =====================================================
; *** Chapter 1: BUILDINGS ***
; =====================================================

(defrule
	(current-age == tech-level-3)
	(or
		(goal openingstyle STYLE-DEFENSIVE)
		(goal openingstyle STYLE-AGGRESSIVE)
	)
	(building-type-count-total BLDG-TRAINAIR < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 25)
	(not (goal tryingtobuild AIRBASE))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-MAIN > 2)
	(building-type-count-total BLDG-TRAINAIR < 1)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 25)
	(not (goal tryingtobuild AIRBASE))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

; TL3 post-spine Airbase scaling.
(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-TRAINAIR < 3)
	(building-type-count-total BLDG-TRAINAIR >= 2)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-WARCTR > 0)
	(building-type-count-total BLDG-MAIN >= 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(carbon-amount > 600)
	(metal-amount > 50)
	(not (goal tryingtobuild AIRBASE))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(military-population >= MIL_POP_A)
	(building-type-count-total BLDG-TRAINAIR < 4)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 25)
	(not (goal tryingtobuild AIRBASE))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild AIRBASE)
)

(defrule
	(current-age == tech-level-4)
	(goal support-aircraft YES)
	(building-type-count-total BLDG-TRAINAIR >= 4)
	(building-type-count-total BLDG-TRAINAIR < 6)
	(building-type-count-total BLDG-POWERCORE > 0)
	(carbon-amount > 2000)
	(food-amount > 1000)
	(nova-amount > 500)
	(metal-amount > 200)
	(military-population >= MIL_POP_B)
	(can-build-with-escrow BLDG-TRAINAIR)
	(not (goal tryingtobuild AIRBASE))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(release-escrow carbon)
	(build-forward BLDG-TRAINAIR)
)

; =====================================================
; CHAPTER 2: UPGRADES
; =====================================================

; --- Basic fighter upgrade ---
(defrule
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-FIGHTER-LINE > 0)
	(military-population >= MIL_POP_A)
	(can-research-with-escrow ut-fighter-2)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-fighter-2)
)

; --- Advanced fighter upgrade ---
(defrule
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(unit-type-count-total UNIT-FIGHTER-LINE > 0)
	(military-population >= MIL_POP_B)
	(can-research-with-escrow ut-fighter-3)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-fighter-3)
)

; --- Enhanced bomber upgrade ---
(defrule
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(research-completed rt-shield-mods)
	(unit-type-count-total UNIT-BOMBER-LINE > 0)
	(or
		(goal enemymechsighted MECH-ALERT-P2)
		(or
			(goal enemymechsighted MECH-ALERT-P3)
			(goal enemymechsighted MECH-ALERT-P4)
		)
	)
	(can-research-with-escrow ut-bomber-2)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-bomber-2)
)

(defrule
	; Efficient Manufacturing
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-drafted-labor)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-drafted-labor)
)

(defrule
	; Armored Platework
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-armor-plating)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-armor-plating)
)

(defrule
	; Gunship Armaments
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-gunship-lasers)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-gunship-lasers)
)

(defrule
	; Enlarged Bomb Hold
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-enlarged-bomb-hold)
	(military-population >= MIL_POP_A)
	(unit-type-count-total UNIT-BOMBER-LINE > 0)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-enlarged-bomb-hold)
)

(defrule
	; RA A-wing Upgrades
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-avail-awing)
	(goal importantT4research DONE)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-avail-awing)
)

(defrule
	; RA Astromech Repairs
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-astromechs)
	(research-completed rt-shield-mods)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-astromechs)
)

(defrule
	; RN Advanced Engines
	(can-research-with-escrow rt-lighter-material)
	(research-completed rt-shield-mods)
	(military-population >= MIL_POP_A)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-lighter-material)
)

(defrule
	; RS Bunkerbusters
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow rt-bunkerbusters)
	(military-population >= MIL_POP_A)
	(research-completed rt-shield-mods)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-bunkerbusters)
)

(defrule
	; NR New Class Modernization
	(current-age >= tech-level-4)
	(goal support-aircraft YES)
	(can-research-with-escrow ut-newclassmod)
	(research-completed rt-shield-mods)
	(military-population >= MIL_POP_A)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-newclassmod)
)

; =====================================================
; CHAPTER 3: TECH 3 AIR PACKAGES
; =====================================================

; -----------------------
; FIGHTERS
; -----------------------

; --- TL3 fighter core p1 ---
(defrule
	(current-age == tech-level-3)
	(goal special-map LAND)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1-water)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1-asteroid)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p1-hybrid)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; --- TL3 fighter cover floor ---
(defrule
	(current-age == tech-level-3)
	(current-age-time > 240)
	(building-type-count-total BLDG-TRAINAIR > 0)
	(unit-type-count-total UNIT-FIGHTER-LINE < 4)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; --- TL3 fighter core p2 ---
(defrule
	(current-age == tech-level-3)
	(goal special-map LAND)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL3-fighter-arm-p1)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map WATER)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL3-fighter-arm-p1-water)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2-water)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL3-fighter-arm-p1-asteroid)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2-asteroid)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

(defrule
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(not (goal passiveage YES))
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL3-fighter-arm-p1-hybrid)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL3-fighter-arm-p2-hybrid)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

