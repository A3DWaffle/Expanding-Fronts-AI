; --- Aircraft support fighters p2 ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm AIR)
		(goal support-aircraft YES)
	)
	(goal importantT4research DONE)
	(unit-type-count-total UNIT-ATTACKER-LINE >= TL4-attacker-arm-p1)
	(unit-type-count-total UNIT-FIGHTER-LINE < TL4-fighter-arm-p2)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
)

; =====================================================
; CHAPTER 6: AIR TRANSPORT
; =====================================================

; --- Maintain map-start Air Transport ---
(defrule
	(game-time < 10)
	(unit-type-count-total UNIT-AIRTRANS-LINE > 0)
=>
	(set-goal allow-air-trans YES)
	(disable-self)
)

; --- Asteroid maps allow Air Transport ---
(defrule
	(goal special-map ASTEROID)
=>
	(set-goal allow-air-trans YES)
	(disable-self)
)

; --- Build Air Transport once basic fighter cover exists ---
(defrule
	(goal allow-air-trans YES)
	(or
		(and
			(current-age == tech-level-3)
			(unit-type-count-total UNIT-FIGHTER-LINE >= TL3-fighter-arm-p1)
		)
		(and
			(current-age == tech-level-4)
			(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm-p1)
		)
	)
	(unit-type-count-total UNIT-AIRTRANS-LINE == 0)
	(can-train UNIT-AIRTRANS-LINE)
=>
	(train UNIT-AIRTRANS-LINE)
)

; =====================================================
; CHAPTER X: CIV AIRBASE TECH CATCHUP
; =====================================================

(defrule
	; RN Advanced Engines
	(can-research-with-escrow rt-lighter-material)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-lighter-material)
)

