; =====================================================
; *** Chapter 4: TL3 SIEGE AND TL4 RAMS ***
; =====================================================

; -----------------------
; ARTILLERY
; -----------------------

(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-AGGRESSIVE)
	(goal special-map LAND)
	(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core)
	(or
		(goal enemyairsighted AIR-ALERT-NONE)
		(or
			(goal enemyairsighted AIR-ALERT-LOW)
			(or
				(and
					(goal enemyairsighted AIR-ALERT-GUARD)
					(unit-type-count-total SIEGE-MISSILE-LINE >= TL3-aa-mobile-detect-air-alert-low-p1)
				)
				(and
					(goal enemyairsighted AIR-ALERT-DANGER)
					(unit-type-count-total SIEGE-MISSILE-LINE >= TL3-aa-mobile-detect-air-alert-low-p1)
				)
			)
		)
	)
	(can-train SIEGE-ARTILLERY-LINE)
=>
	(train SIEGE-ARTILLERY-LINE)
)

