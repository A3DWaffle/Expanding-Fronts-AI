; =====================================================
; CHAPTER 4: TECH 3 SIEGE PACKAGES
; =====================================================

; -----------------------
; ARTILLERY
; -----------------------

(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(goal openingstyle STYLE-AGRESSIVE)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core-water)
		)
	)
	(can-train SIEGE-ARTILLERY-LINE)
=>
	(train SIEGE-ARTILLERY-LINE)
)

; -----------------------
; RAMS
; -----------------------

; --- TL3 Ram p1 ---
(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-RUSH)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-RAM-LINE < TL3-ram-core-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-RAM-LINE < TL3-ram-core-p1-water)
		)
	)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

; --- TL3 Ram p2 ---
(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-RUSH)
	(goal importantT3research DONE)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-RAM-LINE < TL3-ram-core-p2)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-RAM-LINE < TL3-ram-core-p2-water)
		)
	)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

; --- TL4 MECH Ram p1 ---
(defrule
	(current-age == tech-level-4)
	(goal combat-arm MECH)
	(goal importantT4research DONE)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
				(unit-type-count-total SIEGE-RAM-LINE < TL4-ram-arm-p1)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2-water)
				(unit-type-count-total SIEGE-RAM-LINE < TL4-ram-arm-p1-water)
			)
		)
	)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

(defrule
	(current-age == tech-level-4)
	(goal combat-arm TROOP)
	(goal importantT4research DONE)
	(or
		(and
			(not (goal special-map WATER))
			(and
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
				(unit-type-count-total SIEGE-RAM-LINE < TL4-ram-arm-p1)
			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1-water)
				(unit-type-count-total SIEGE-RAM-LINE < TL4-ram-arm-p1-water)
			)
		)
	)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

; =====================================================
; CHAPTER 5: TECH 4 ARTILLERY PACKAGES
; =====================================================

; --- Core Artillery p1 ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH/HW)
		(goal combat-arm TROOP/HW)
	)
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL4-artillery-arm-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL4-artillery-arm-p1-water)
		)
	)
	(can-train SIEGE-ARTILLERY-LINE)
=>
	(train SIEGE-ARTILLERY-LINE)
)

