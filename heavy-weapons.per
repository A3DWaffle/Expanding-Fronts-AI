			)
		)
		(and
			(goal special-map WATER)
			(and
				(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p1-water)
				(unit-type-count-total SIEGE-ARTILLERY-LINE < TL4-artillery-arm-p2-water)
