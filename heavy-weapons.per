	(current-age == tech-level-4)
	(goal support-artillery YES)
	(goal special-map WATER)
	(unit-type-count-total SIEGE-ARTILLERY-LINE < TL4-artillery-supp-p3-water)
	(goal importantT4research DONE)
	(or
		(goal enemyairsighted AIR-ALERT-NONE)
		(or
			(goal enemyairsighted AIR-ALERT-LOW)
			(or
				(and
					(goal enemyairsighted AIR-ALERT-GUARD)
					(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-guard-p2)
				)
				(and
					(goal enemyairsighted AIR-ALERT-DANGER)
					(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-danger-p3)
				)
			)
		)
	)
	(can-train SIEGE-ARTILLERY-LINE)
=>
	(train SIEGE-ARTILLERY-LINE)
)

