	(goal artillery-allowed YES)
	(current-age == tech-level-4)
	(goal special-map HYBRID)
	(unit-type-count-total SIEGE-ARTILLERY-LINE < TL4-artillery-arm-p2-hybrid)
	(can-train SIEGE-ARTILLERY-LINE)
=>
	(train SIEGE-ARTILLERY-LINE)
)

(defrule
	(can-train SIEGE-ARTILLERY-LINE)
	(current-age == tech-level-3)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm STRIKE/HW)
	)
	(or
		(and
			(goal special-map LAND)
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core-water)
		)
	)
=>
	(train SIEGE-ARTILLERY-LINE)
)

(defrule
	(can-train SIEGE-ARTILLERY-LINE)
	(current-age == tech-level-3)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm STRIKE/HW)
	)
	(or
		(and
			(goal special-map ASTEROID)
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core-asteroid)
		)
		(and
			(goal special-map HYBRID)
			(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core-hybrid)
		)
	)
=>
	(train SIEGE-ARTILLERY-LINE)
)

