	(release-escrow nova)
	(release-escrow metal)
	(train SIEGE-MISSILE-LINE)
)

; --- TL4 AA Mobile air-alert danger ---
(defrule
	(current-age == tech-level-4)
	(goal special-map LAND)
	(unit-type-count-total SIEGE-MISSILE-LINE < TL4-aa-mobile-detect-air-alert-danger-p3)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(military-population >= MIL_POP_A)
	(can-train SIEGE-MISSILE-LINE)
	(goal support-sam YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(release-escrow metal)
	(train SIEGE-MISSILE-LINE)
)

