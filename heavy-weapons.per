; =====================================================
; FILE: heavy-weapons
; PURPOSE:
;   Builds Heavy Weapons Factories, researches siege upgrades, and trains siege packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: AIR-ALERT AA MOBILE
;	Chapter 4: TL3 SIEGE AND TL4 RAMS
;	Chapter 5: TL4 ARTILLERY
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; =====================================================
; *** Chapter 1: BUILDINGS ***
; =====================================================

; Town-clearing Pummels can request one factory outside the ordinary lineup.
(defrule
	(current-age >= tech-level-3)
	(enemy-buildings-in-town)
	(building-type-count-total BLDG-TRAINHEAVY < 1)
	(building-type-count BLDG-POWERCORE > 0)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
	(can-build BLDG-TRAINHEAVY)
=>
	(build BLDG-TRAINHEAVY)
)

; Build a siege factory if the normal lineup has none to meet the fortress hold.
(defrule
	(goal fortress-siege-hold YES)
	(goal artillery-allowed YES)
	(can-build BLDG-TRAINHEAVY)
	(building-type-count-total BLDG-TRAINHEAVY < 1)
	(building-type-count BLDG-POWERCORE > 0)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINHEAVY)
)

(defrule
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(current-age >= tech-level-3)
	(goal combat-arm TROOP/HW)
	(building-type-count-total BLDG-SPACEPORT >= 1)
	(building-type-count-total BLDG-TRAINHEAVY < 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINHEAVY)
	;(set-goal tryingtobuild HVYWEAP)
)

; RAID: split oversized prerequisite list
(defrule
	(true)
=>
	(set-goal raid-rule-check YES)
)

(defrule
	(goal raid-rule-check YES)
	(not (can-build-with-escrow BLDG-TRAINHEAVY))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (current-age >= tech-level-3))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (goal support-artillery YES) (goal support-sam YES)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-MAIN > 2))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-SPACEPORT >= 1))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-TRAINHEAVY < 1))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-POWERCORE > 0))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (metal-amount > 25))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (not (goal tryingtobuild HVYWEAP)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (not (goal buildpause YES)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (not (too-many-unpowered-buildings)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal raid-build-open YES))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
=>
	(build BLDG-TRAINHEAVY)
)



(defrule
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(current-age >= tech-level-4)
	(goal support-artillery YES)
	(building-type-count-total BLDG-MAIN > 2)
	(building-type-count-total BLDG-TRAINHEAVY < 4)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

(defrule
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-MAIN > 2)
	(not (goal enemyairsighted AIR-ALERT-LOW))
	(goal support-sam YES)
	(building-type-count-total BLDG-TRAINHEAVY < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)
; =====================================================
; *** Chapter 2: UPGRADES ***
; =====================================================

; --- Heavy Artillery ---
(defrule
	(can-research-with-escrow ut-artillery-2)
	(current-age >= tech-level-4)
	(goal support-artillery YES)
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-artillery-2)
)

; --- Heavy Pummel: upgrade only a town-clearing package already in use. ---
(defrule
	(current-age >= tech-level-4)
	(enemy-buildings-in-town)
	(unit-type-count SIEGE-RAM-LINE >= 1)
	(can-research ut-ram-2)
=>
	(research ut-ram-2)
)

; --- Heavy AA Mobile ---
(defrule
	(can-research-with-escrow ut-missile-launcher-2)
	(current-age >= tech-level-4)
	(goal support-sam YES)
	(not (goal enemyairsighted AIR-ALERT-NONE))
	(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p1)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-missile-launcher-2)
)

(defrule
    ; Anti-Air Retrofit
	(can-research-with-escrow rt-aaretrofit)
	(current-age >= tech-level-4)
	(goal support-sam YES)
	(not (goal enemyairsighted AIR-ALERT-NONE))
	(research-completed ut-missile-launcher-2)
=>
	(release-escrow metal)
	(release-escrow carbon)
	(research rt-aaretrofit)
)

(defrule
	; Strengthened Frame
	(can-research-with-escrow rt-strengthened-frames)
	(current-age >= tech-level-4)
	(or 
		(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
		(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p1)
	)
	(or
		(research-completed ut-missile-launcher-2)
		(research-completed ut-artillery-2)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-strengthened-frames)
)

(defrule
	; Reinforced Frame
	(can-research-with-escrow rt-reinforced-frames)
	(current-age >= tech-level-4)
	(or 
		(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
		(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p1)
	)
	(or
		(research-completed rt-strengthened-frames)
		(not (research-available rt-strengthened-frames))
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-reinforced-frames)
)

(defrule
	; Mechanics
	(can-research-with-escrow rt-rebel-mechanics)
	(current-age >= tech-level-4)
	(or 
		(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
		(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p1)
	)
	(or
		(research-completed rt-reinforced-frames)
		(not (research-available rt-reinforced-frames))
	)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-rebel-mechanics)
)

(defrule
	; GN Creature Training
	(can-research-with-escrow rt-creature-training)
	(current-age >= tech-level-4)
	(or
		(goal support-sam YES)
		(goal support-artillery YES)
	)
	(or
		(research-completed rt-reinforced-frames)
		(not (research-available rt-reinforced-frames))
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-creature-training)
)

(defrule
	; WK Forest Vision
	(can-research-with-escrow rt-forest-vision)
	(current-age >= tech-level-4)
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
	(research-completed ut-artillery-2)
	(or
		(research-completed rt-strengthened-frames)
		(not (research-available rt-strengthened-frames))
	)
	(or
		(goal combat-arm TROOP/HW)
		(goal combat-arm STRIKE/HW)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-forest-vision)
)

(defrule
	; GO Geonosian Engineers
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-geoengnr)
	(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p1)
	(or
		(goal support-sam YES)
		(goal support-artillery YES)
	)
	(or
		(research-completed rt-rebel-mechanics)
		(not (research-available rt-rebel-mechanics))
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-geoengnr)
)

(defrule
	; GO Hailfire Rocket Pods
	(can-research-with-escrow rt-hailfire-missiles)
	(current-age >= tech-level-4)
	(goal support-sam YES)
	(unit-type-count-total SIEGE-MISSILE-LINE >= TL4-aa-mobile-detect-air-alert-low-p1)
	(or
		(research-completed rt-aaretrofit)
		(not (research-available rt-aaretrofit))
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-hailfire-missiles)
)

