; =====================================================
; *** Chapter 4: TL3 SIEGE AND TL4 RAMS ***
; =====================================================

; Town-clearing only: stop requesting Pummels as soon as buildings leave town.
; No attack-now or global targeting/radius changes; native combat selects targets.
#load-if-defined POPULATION-CAP-25
(defrule
	(current-age >= tech-level-3)
	(enemy-buildings-in-town)
	(unit-type-count-total SIEGE-RAM-LINE < 1)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

#end-if
#load-if-not-defined POPULATION-CAP-25
(defrule
	(current-age >= tech-level-3)
	(enemy-buildings-in-town)
	(unit-type-count-total SIEGE-RAM-LINE < 2)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

#end-if

; -----------------------
; ARTILLERY
; -----------------------

; A fortress sighting can require artillery outside the regular lineup.
(defrule
	(goal fortress-siege-hold YES)
	(goal artillery-allowed YES)
	(current-age == tech-level-3)
	(goal special-map LAND)
	(unit-type-count-total SIEGE-ARTILLERY-LINE < TL3-artillery-core-p2)
	(can-train SIEGE-ARTILLERY-LINE)
=>
	(train SIEGE-ARTILLERY-LINE)
)

