; =====================================================
; FILE: heavy-weapons
; PURPOSE:
;   Builds Heavy Weapons Factories, researches siege upgrades, and trains siege packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL3 SIEGE
;	Chapter 4: TL4 SIEGE
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-RUSH)
	(building-type-count-total BLDG-TRAINMECH >= 1)
	(building-type-count-total BLDG-SPACEPORT >= 1)
	(building-type-count-total BLDG-WARCTR >= 1)
	(building-type-count-total BLDG-TRAINHEAVY < 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-AGRESSIVE)
	(building-type-count-total BLDG-MAIN > 2)
	(building-type-count-total BLDG-TRAINMECH >= 1)
	(building-type-count-total BLDG-SPACEPORT >= 1)
	(building-type-count-total BLDG-TRAINHEAVY < 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-MAIN > 2)
	(building-type-count-total BLDG-TRAINAIR >= 2)
	(building-type-count-total BLDG-TRAINMECH >= 1)
	(building-type-count-total BLDG-SPACEPORT >= 1)
	(building-type-count-total BLDG-TRAINHEAVY < 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

(defrule
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-TRAINHEAVY < 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

(defrule
	(current-age >= tech-level-4)
	(or
		(goal combat-arm TROOP/HW)
		(or 
			(goal support-artillery YES)
			(or
		 		(goal support-artillery YES)
				(goal combat-arm MECH/HW)
			)
		)
	)
	(building-type-count-total BLDG-TRAINHEAVY < 3)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

(defrule
	(current-age >= tech-level-4)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(building-type-count-total BLDG-TRAINHEAVY < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

(defrule
	(current-age >= tech-level-4)
	(goal enemyairsighted AIR-ALERT-DANGER)
	(building-type-count-total BLDG-TRAINHEAVY < 3)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 25)
	(not (goal tryingtobuild HVYWEAP))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild HVYWEAP)
)

; =====================================================
; CHAPTER 2: UPGRADES
; =====================================================

; --- Heavy Artillery ---
(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-artillery-2)
	(or
		(goal combat-arm TROOP/HW)
		(or
			(goal combat-arm MECH/HW)
			(goal support-artillery YES)
		)
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-artillery-2)
)

; --- Heavy Ram ---
(defrule
	(can-research-with-escrow ut-ram-2)
	(goal openingstyle STYLE-RUSH)
	(goal importantT4research DONE)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-ram-2)
)

; --- Heavy AA Mobile ---
(defrule
	(can-research-with-escrow ut-missile-launcher-2)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-missile-launcher-2)
)

(defrule
    ; Anti-Air Retrofit
	(can-research-with-escrow rt-aaretrofit)
=>
	(release-escrow metal)
	(release-escrow carbon)
	(research rt-aaretrofit)
)

(defrule
	; Strengthened Frame
	(can-research-with-escrow rt-strengthened-frames)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-strengthened-frames)
)

(defrule
	; Reinforced Frame
	(can-research-with-escrow rt-reinforced-frames)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-reinforced-frames)
)

(defrule
	; Mechanics
	(can-research-with-escrow rt-rebel-mechanics)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-rebel-mechanics)
)

(defrule
	; GN Creature Training
	(can-research-with-escrow rt-creature-training)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-creature-training)
)

(defrule
	; WK Forest Vision
	(can-research-with-escrow rt-forest-vision)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-forest-vision)
)

(defrule
	; GO Geonosian Engineers
	(can-research-with-escrow rt-geoengnr)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-geoengnr)
)

(defrule
	; GO Hailfire Rocket Pods
	(can-research-with-escrow rt-hailfire-missiles)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-hailfire-missiles)
)

; =====================================================
; CHAPTER 3: AIR-ALERT AA MOBILE
; =====================================================

; --- TL3 AA Mobile air-alert low ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-MISSILE-LINE < TL3-aa-mobile-detect-air-alert-low-p1)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-MISSILE-LINE < TL3-aa-mobile-detect-air-alert-low-p1-water)
		)
	)
	(goal enemyairsighted AIR-ALERT-LOW)
	(can-train SIEGE-MISSILE-LINE)
=>
	(train SIEGE-MISSILE-LINE)
)

; --- TL3 AA Mobile air-alert guard ---
(defrule
	(current-age == tech-level-3)
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
	(or
		(and
			(not (goal special-map WATER))
			(unit-type-count-total SIEGE-MISSILE-LINE < TL3-aa-mobile-detect-air-alert-guard-p2)
		)
		(and
			(goal special-map WATER)
			(unit-type-count-total SIEGE-MISSILE-LINE < TL3-aa-mobile-detect-air-alert-guard-p2-water)
		)
	)
	(goal enemyairsighted AIR-ALERT-GUARD)
	(can-train SIEGE-MISSILE-LINE)
=>
	(train SIEGE-MISSILE-LINE)
)

