; =====================================================
; FILE: animal
; PURPOSE:
;   Handles animal techs and Geonosian animal-side unique unit production.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 1: TECHS
;	Chapter 2: GEONOSIAN ANIMAL NURSERY
;	Chapter 3: GEONOSIAN ANIMAL UNIQUE UNITS
;
; =====================================================
; *** Chapter 1: TECHS ***
; =====================================================

(defrule
	; Stimulants
	(can-research-with-escrow rt-stimulants)
	(current-age >= tech-level-3)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-stimulants)
)

(defrule
	; Genetics
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-genetics)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-genetics)
)

(defrule
	; Cloning
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-cloning)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-cloning)
)

(defrule
	; GO Beast Training
	(current-age >= tech-level-4)
	(goal importantT4research DONE)
	(goal support-acklay YES)
	(can-research-with-escrow rt-beast-training) ; this does not need to be so high priority but it's okay
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-beast-training)
)

(defrule
	; RP Kaminoan Refit
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-kamino-refit)
	(goal importantT4research DONE)
	(building-type-count BLDG-DROPANIM > 0)
	(or
		(unit-type-count-total SCN-PREDATOR-LINE > 0)
		(or
			(unit-type-count-total SCN-TROOP-GUNNER-LINE > 0)
			(unit-type-count-total SCN-TROOP-DEMOLITION-LINE > 0)
		)
	)
=>
	(release-escrow carbon)
	(research rt-kamino-refit)
)

#load-if-defined GEONOSIANS

; =====================================================
; *** Chapter 2: GEONOSIAN ANIMAL NURSERY ***
; =====================================================

(defrule
    (current-age >= tech-level-3)
	(building-type-count BLDG-MAIN > 1) ; wait a bit
	(building-type-count BLDG-DROPANIM < 3)
    (can-build BLDG-DROPANIM)
	(not (goal buildpause YES))
=>
    (build BLDG-DROPANIM)
)

; =====================================================
; *** Chapter 3: GEONOSIAN ANIMAL UNIQUE UNITS ***
; =====================================================

; Nexu

(defrule
	(current-age == tech-level-3)
	(goal openingstyle STYLE-RUSH)
	(unit-type-count-total SCN-TROOP-GUNNER-LINE < unique-nexu-supp)
	(can-train SCN-TROOP-GUNNER-LINE)
	=>
	(train SCN-TROOP-GUNNER-LINE)
)

; Reek

(defrule
	(current-age >= tech-level-3)
	(goal openingstyle STYLE-RUSH)
	(unit-type-count-total SCN-PREDATOR-LINE >= unique-acklay-arm)
	(unit-type-count-total SCN-TROOP-DEMOLITION-LINE < unique-reek-supp)
	(can-train SCN-TROOP-DEMOLITION-LINE)
	=>
	(train SCN-TROOP-DEMOLITION-LINE)
)

; Acklay

(defrule
	(current-age >= tech-level-4)
	(goal support-acklay YES)
	(unit-type-count-total SCN-PREDATOR-LINE < unique-acklay-arm) ;note: now part of unitline
	(can-train SCN-PREDATOR-LINE)
	=>
	(train SCN-PREDATOR-LINE)
)
#end-if
