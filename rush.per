; =====================================================
; FILE: rush
; PURPOSE:
;   Rush personality overlay for early pressure and low attack thresholds.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: LOGIC
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(goal openingstyle UNDEFINED)
=>
	(set-goal openingstyle STYLE-RUSH)
	(set-goal passiveage NO)
	(disable-self)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(current-age == tech-level-3)
	(current-age-time < 480)
	(not (goal passiveage YES))
=>
	(set-goal passiveage YES)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(goal passiveage YES)
	(current-age-time > 480)
=>
	(set-goal passiveage NO)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(not (current-age == tech-level-3))
	(not (goal passiveage NO))
=>
	(set-goal passiveage NO)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(goal rushwavecap 0)
=>
	(generate-random-number 2)
	(set-goal rushwavecap NOTICE)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(goal rushwavecap NOTICE)
	(random-number == 1)
=>
	(set-goal rushwavecap 1)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(goal rushwavecap NOTICE)
	(random-number == 2)
=>
	(set-goal rushwavecap 2)
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(goal attacksonhold-auto YES)
	(not (goal rushsize RUSHHALT))
	(military-population >= 10)
=>
	(set-goal attacksonhold-auto NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 15)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(current-age == tech-level-3)
	(or
		(goal attacksonhold-auto NO)
		(not (goal rushsize RUSHHALT))
	)
=>
	(set-goal attacksonhold-auto YES)
	(set-goal rushsize RUSHHALT)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(current-age >= tech-level-4)
	(or
		(goal attacksonhold-auto YES)
		(goal rushsize RUSHHALT)
	)
=>
	(set-goal attacksonhold-auto NO)
	(set-goal rushsize RUSHCONTINUE)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 60)
)
