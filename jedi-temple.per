; =====================================================
; FILE: jedi-temple
; PURPOSE:
;   Builds Jedi Temple, trains Jedi units, and paces fair holocron collectors.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: CORE UNITS
;	Chapter 3: MASTER UNITS
;	Chapter 4: TEMPLE UNIQUE UNITS
;	Chapter 5: UPGRADES
;	Chapter 6: CIV TECH CATCHUP
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-strategic-number sn-maximum-jedi-support-group-size 0) ; Freezes units, do not use.
	(disable-self)
)

; Debug: announce when a temple unit successfully claims a holocron.
(defrule
	(unit-type-count-total UNIT-JEDIHOLO-LINE > 0)
=>
	(chat-to-all "252: My holocron!")
	(disable-self)
)

; =====================================================
; *** Chapter 1: BUILDINGS ***
; =====================================================

(defrule
	(current-age == tech-level-2)
;	(or
;		(goal openingstyle STYLE-RUSH)
;		(goal openingstyle STYLE-DEFENSIVE)
;	)
	(goal support-aircraft YES)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-TRAINJEDI == 0)
	(can-build-with-escrow BLDG-TRAINJEDI)
	(nova-amount >= 25)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(build BLDG-TRAINJEDI)
)

(defrule
	(current-age >= tech-level-3)
	(building-type-count-total BLDG-MAIN > 3)
	(building-type-count-total BLDG-TRAINJEDI == 0)
	(can-build-with-escrow BLDG-TRAINJEDI)
	(nova-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-TRAINJEDI)
)

(defrule
	(current-age >= tech-level-3)
	(building-type-count-total BLDG-MAIN > 3)
	(building-type-count-total BLDG-TRAINJEDI == 0)
	(can-build-with-escrow BLDG-TRAINJEDI)
	(nova-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-TRAINJEDI)
)

(defrule
	(current-age == tech-level-4)
	(can-build-with-escrow BLDG-TRAINJEDI)
	(building-type-count-total BLDG-TRAINJEDI < 4)
	(goal support-masters YES)
	(nova-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-TRAINJEDI)
)

; =====================================================
; *** Chapter 2: CORE UNITS ***
; =====================================================

#load-if-not-defined BLACKSUN

; Disabled: early Rush/Defensive Jedi training can collect holocrons too soon.
; (defrule
; 	(current-age <= tech-level-3)
; 	(or
; 		(goal openingstyle STYLE-RUSH)
; 		(goal openingstyle STYLE-DEFENSIVE)
; 	)
; 	(goal support-masters YES)
; 	(building-type-count-total BLDG-TRAINJEDI > 0)
; 	(unit-type-count-total UNIT-JEDI-LINE < TL2-knight-supp-p1)
; 	(or
; 		(nova-amount > 200)
; 		(goal agingup YES)
; 	)
; 	(can-train-with-escrow UNIT-JEDI-LINE)
; =>
; 	(release-escrow food)
; 	(release-escrow nova)
; 	(train UNIT-JEDI-LINE)
; )

(defrule
	(current-age >= tech-level-3)
	(game-time > 1500)
	(game-time < 3600)
	(goal holocroncollectionservices 0)
	(building-type-count-total BLDG-TRAINJEDI > 0)
	(unit-type-count-total UNIT-JEDI-LINE == 0)
	(unit-type-count-total UNIT-JEDIHOLO-LINE == 0)
	(can-train-with-escrow UNIT-JEDI-LINE)
=>
	(release-escrow food)
	(release-escrow nova)
	(train UNIT-JEDI-LINE)
	(set-goal holocroncollectionservices 1)
)

; The shared ten-minute timer walks holocroncollectionservices upward after a failed collector.
(defrule
	(current-age >= tech-level-3)
	(game-time > 1500)
	(game-time < 3600)
	(or
		(goal holocroncollectionservices 2)
		(or
			(goal holocroncollectionservices 3)
			(goal holocroncollectionservices 4)
		)
	)
	(building-type-count-total BLDG-TRAINJEDI > 0)
	(unit-type-count-total UNIT-JEDI-LINE == 0)
	(unit-type-count-total UNIT-JEDIHOLO-LINE == 0)
	(can-train-with-escrow UNIT-JEDI-LINE)
=>
	(release-escrow food)
	(release-escrow nova)
	(train UNIT-JEDI-LINE)
	(set-goal holocroncollectionservices 1)
)
#end-if

; =====================================================
; *** Chapter 3: MASTER UNITS ***
; =====================================================
; Match each Master tier to completed Cannons on the current map.
; Queued Cannons do not unlock Masters. Require a real Cannon even if a
; small population package rounds its Cannon target to zero.
; Keep the existing army/tech prerequisites and p3 military-population check.

; --- Master p1: Cannon p1 prerequisite ---
(defrule
	(can-train UNIT-MASTER-LINE)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(or
		(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p3)
		(or
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p3)
			(not
				(research-available rt-jedi-mind-trick)
			)
		)
	)
	(goal special-map LAND)
	(unit-type-count-total UNIT-MASTER-LINE < TL4-master-supp-p1)
	(unit-type-count SIEGE-CANNON-LINE > 0)
	(unit-type-count SIEGE-CANNON-LINE >= TL4-cannon-arm-p1)
=>
	(train UNIT-MASTER-LINE)
)

(defrule
	(can-train UNIT-MASTER-LINE)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(or
		(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p3)
		(or
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p3)
			(not
				(research-available rt-jedi-mind-trick)
			)
		)
	)
	(goal special-map WATER)
	(unit-type-count-total UNIT-MASTER-LINE < TL4-master-supp-p1-water)
	(unit-type-count SIEGE-CANNON-LINE > 0)
	(unit-type-count SIEGE-CANNON-LINE >= TL4-cannon-arm-p1-water)
=>
	(train UNIT-MASTER-LINE)
)

(defrule
	(can-train UNIT-MASTER-LINE)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(or
		(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p3)
		(or
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p3)
			(not
				(research-available rt-jedi-mind-trick)
			)
		)
	)
	(goal special-map ASTEROID)
	(unit-type-count-total UNIT-MASTER-LINE < TL4-master-supp-p1-asteroid)
	(unit-type-count SIEGE-CANNON-LINE > 0)
	(unit-type-count SIEGE-CANNON-LINE >= TL4-cannon-arm-p1-asteroid)
=>
	(train UNIT-MASTER-LINE)
)

(defrule
	(can-train UNIT-MASTER-LINE)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(or
		(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p3)
		(or
			(unit-type-count-total SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p3)
			(not
				(research-available rt-jedi-mind-trick)
			)
		)
	)
	(goal special-map HYBRID)
	(unit-type-count-total UNIT-MASTER-LINE < TL4-master-supp-p1-hybrid)
	(unit-type-count SIEGE-CANNON-LINE > 0)
	(unit-type-count SIEGE-CANNON-LINE >= TL4-cannon-arm-p1-hybrid)
=>
	(train UNIT-MASTER-LINE)
)

