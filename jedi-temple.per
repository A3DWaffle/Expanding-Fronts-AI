; =====================================================
; *** Chapter 4: TEMPLE UNIQUE UNITS ***
; =====================================================

; --- Black Sun Temple UU ---
#load-if-defined BLACKSUN

; --- First Nightsister Hunter ---
; Black Sun uses Hunters for holocron collection instead of basic Jedi.
(defrule
	(current-age >= tech-level-3)
	(game-time > 1500)
	(game-time < 3600)
	(goal holocroncollectionservices 0)
	(unit-type-count-total UU-JEDIALT-LINE == 0)
	(unit-type-count-total UNIT-JEDIHOLO-LINE == 0)
	(can-train-with-escrow UU-JEDIALT-LINE)
=>
	(release-escrow food)
	(release-escrow nova)
	(train UU-JEDIALT-LINE)
	(set-goal holocroncollectionservices 1)
)

; --- Replacement Nightsister Hunter ---
(defrule
	(current-age >= tech-level-2)
	(game-time > 1500)
	(game-time < 3600)
	(or
		(goal holocroncollectionservices 2)
		(or
			(goal holocroncollectionservices 3)
			(goal holocroncollectionservices 4)
		)
	)
	(unit-type-count-total UU-JEDIALT-LINE == 0)
	(unit-type-count-total UNIT-JEDIHOLO-LINE == 0)
	(can-train-with-escrow UU-JEDIALT-LINE)
=>
	(release-escrow food)
	(release-escrow nova)
	(train UU-JEDIALT-LINE)
	(set-goal holocroncollectionservices 1)
)

; --- T3 Nightsister Hunter ---
(defrule
	(current-age == tech-level-3)
	(goal support-uu YES)
	(not (goal passiveage YES))
	(unit-type-count UU-JEDIALT-LINE < unique-hunter-supp)
	(can-train UU-JEDIALT-LINE)
=>
	(train UU-JEDIALT-LINE)
)

; --- T4 Nightsister Hunter ---
(defrule
	(current-age == tech-level-4)
	(goal support-uu YES)
	(unit-type-count UU-JEDIALT-LINE < unique-hunter-supp-p2)
	(can-train UU-JEDIALT-LINE)
=>
	(train UU-JEDIALT-LINE)
)

#end-if

; =====================================================
; *** Chapter 5: UPGRADES ***
; =====================================================

(defrule
	(current-age >= tech-level-3)
	(goal support-masters YES)
	(unit-type-count-total UNIT-JEDI-LINE >= TL3-knight-supp-p1)
	(can-research-with-escrow ut-jedi-2)
=>
	(release-escrow nova)
	(release-escrow food)
	(research ut-jedi-2)
)

(defrule
	; Force Agility, Jedi go fast.
	(can-research-with-escrow rt-jedi-agility)
	(current-age >= tech-level-2)
	(or
		(unit-type-count-total UNIT-JEDI-LINE > 0)
		(unit-type-count-total UNIT-MASTER-LINE > 0)
	)
	(nova-amount >= 300)
=>
	(release-escrow nova)
	(research rt-jedi-agility)
)

(defrule
	; Force Meditation
	(can-research-with-escrow rt-jedi-meditation)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(unit-type-count-total UNIT-MASTER-LINE >= 1)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-jedi-meditation)
)

(defrule
	; Force Concentration
	(can-research-with-escrow rt-jedi-concentration)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(or
		(research-completed rt-jedi-meditation)
		(not (research-available rt-jedi-meditation))
	)
=>
	(release-escrow nova)
	(research rt-jedi-concentration)
)

(defrule
	; Stronger Force,
	(current-age == tech-level-4)
	(goal support-masters YES)
	(can-research-with-escrow rt-force-strong)
	(or
		(research-completed rt-jedi-concentration)
		(not (research-available rt-jedi-concentration))
	)
=>
	(release-escrow nova)
	(research rt-force-strong)
)

(defrule
	; Jedi Mind Trick
	(can-research-with-escrow rt-jedi-mind-trick)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(military-population >= MIL_POP_A)
=>
	(release-escrow nova)
	(research rt-jedi-mind-trick)
)

(defrule
	; Force Influence,
	(can-research-with-escrow rt-force-influence)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(not (goal enemyjedisighted JEDI-ALERT-NONE))
	(or
		(research-completed rt-jedi-concentration)
		(not (research-available rt-jedi-concentration))
	)
=>
	(release-escrow nova)
	(research rt-force-influence)
)

(defrule
	; Force Stamina,
	(can-research-with-escrow rt-jedi-stamina)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(or
		(research-completed rt-jedi-concentration)
		(not (research-available rt-jedi-concentration))
	)
=>
	(release-escrow nova)
	(research rt-jedi-stamina)
)

(defrule
	; Force Purge,
	(current-age >= tech-level-3)
	(military-population >= MIL_POP_A)
	(nova-amount >= 2000)
	(not (goal enemyjedisighted JEDI-ALERT-NONE))
	(can-research-with-escrow rt-jedi-strength)
=>
	(release-escrow nova)
	(research rt-jedi-strength)
)

(defrule
	; Faith in the Force,
	(can-research-with-escrow rt-faith-in-the-force)
	(current-age == tech-level-4)
	(not (goal enemyjedisighted JEDI-ALERT-NONE))
	(military-population >= MIL_POP_A)
	(nova-amount >= 2000)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-faith-in-the-force)
)

(defrule
	; Force Perception
	(can-research-with-escrow rt-jedi-perception)
	(current-age == tech-level-4)
	(goal support-masters YES)
	(unit-type-count-total UNIT-MASTER-LINE >= 1)
	(not (goal enemyjedisighted JEDI-ALERT-NONE))
=>
	(release-escrow nova)
	(research rt-jedi-perception)
)

; =====================================================
; *** Chapter 6: CIV TECH CATCHUP ***
; =====================================================

(defrule
	; RP Sight Beyond Sight
	(military-population >= MIL_POP_B)
	(can-research-with-escrow rt-sgtbysgt)
	(goal importantT4research DONE)
=>
	(release-escrow nova)
	(research rt-sgtbysgt)
)

(defrule
	; GE Chain Lightning
	(unit-type-count-total UNIT-MASTER-LINE >= TL4-master-supp-p1)
	(can-research-with-escrow rt-chain-lightning)
	(goal importantT4research DONE)
	(goal support-masters YES)
	(or
		(research-completed rt-force-influence)
		(not (research-available rt-force-influence))
	)
=>
	(release-escrow nova)
	(research rt-chain-lightning)
)

(defrule
	; IR Artusian Crystals
	(military-population >= MIL_POP_A)
	(can-research-with-escrow rt-artusiancrystals)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-artusiancrystals)
)

(defrule
	; NR New Jedi Order
	(current-age >= tech-level-4)
	(unit-type-count-total UNIT-MASTER-LINE >= TL4-master-supp-p1)
	(can-research-with-escrow rt-newjediorder)
	(goal importantT4research DONE)
	(goal support-masters YES)
	(or
		(research-completed rt-jedi-meditation)
		(not (research-available rt-jedi-meditation))
	)
=>
	(release-escrow nova)
	(research rt-newjediorder)
)

(defrule
	; BS Spirit Ichor
	(current-age >= tech-level-4)
	(unit-type-count-total UNIT-MASTER-LINE >= TL4-master-supp-p1)
	(can-research-with-escrow ut-spiritichor)
	(goal importantT4research DONE)
	(goal support-masters YES)
	(or
		(research-completed rt-force-strong)
		(not (research-available rt-force-strong))
	)
=>
	(release-escrow nova)
	(research ut-spiritichor)
)
