; =====================================================
; FILE: attack
; PURPOSE:
;   Controls attack readiness, attack waves, TSA, AIRWAVE, and personality attack pacing.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: PERSONALITY THRESHOLDS
;	Chapter 2: MAIN ATTACK LOGIC
;	Chapter 3: TSA
;	Chapter 4: AIRWAVE
;	Chapter 5: SPECIAL CASES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal attacksonhold-auto NO)								; locks attacks when researching techs
	(set-goal attacksonhold-manual NO)								; locks attacks and prevents new attacks, from taunt 36, only cleared with taunt 31
	(set-goal attacksonhold-scn NO)									; idem but scenario
	(set-goal maxpopattack TOOLOWPOP)								; overrides regular attack system with max pop attack system
	(set-strategic-number sn-gather-idle-soldiers-at-center 0)		; used for center gather taunt 185
	(set-goal center-override NO)									; idem
	(set-goal attacktype NORM)										; used for switching between attack now and town size attack
	(set-goal attackTSAlevel 0)										; needed to initialize
	(set-goal attackTSAhold EXHAUSTED)								; what TSA is up to
	(set-goal attackTSAvar NULL)									; starting value so the logic doesn't break
	(set-goal reasonforattack attack-is-me)							; helps organize chatting
	(disable-self)
)

; openingstyle is now selected by load-random in randomgame.per.
; The selected personality file then sets openingstyle itself.

(defrule
	(goal opening-announced NO)
	(goal openingstyle STYLE-AGRESSIVE)
=>
	(chat-to-all "WAFFLE: Personality AGRESSIVE")
	(set-goal rushsize NORM)
	(set-strategic-number sn-special-attack-type2 UNIT-WORKER)
	(set-strategic-number sn-special-attack-influence2 2147483647)
	(set-goal opening-announced YES)
)

(defrule
	(goal opening-announced NO)
	(goal openingstyle STYLE-DEFENSIVE)
=>
	(chat-to-all "WAFFLE: Personality DEFENSIVE")
	(set-goal rushsize SMOL)
	(set-strategic-number sn-special-attack-type2 BLDG-DROPANIM)
	(set-strategic-number sn-special-attack-influence2 2147483647)
	(set-goal opening-announced YES)
)

(defrule
	(goal opening-announced NO)
	(goal openingstyle STYLE-RUSH)
=>
	(chat-to-all "WAFFLE: Personality RUSH")
	(set-goal rushsize BIG)
	(set-strategic-number sn-special-attack-type2 BLDG-DROPANIM)
	(set-strategic-number sn-special-attack-influence2 2147483647)
	(set-goal opening-announced YES)
)

(defrule
	(current-age == tech-level-3)
=>
	(set-strategic-number sn-special-attack-type2 UNIT-WORKER)
	(set-strategic-number sn-special-attack-influence2 2147483647)
	(disable-self)
)

; -----------------------------------------------------
; --- CHAPTER 1: DIFFICULTY LOADS FOR ATTACK TIMERS --- 
; -----------------------------------------------------

; ACTUALLY CHAPTER 1A IS DOWN A BIT, HOLD ON

; Sorry about the deorganization, the rule for disabling attacks needs to run before the rule that attacks !


; -----------------------------------------------------
; --- CHAPTER 1b: RE-ENABLING LOCKED ATTACKS --- 
; -----------------------------------------------------

; Basically, if the AI is teching up, or hasn't got its super important techs yet, do not attack
; attacksonhold-auto is set to YES whenever the AI techs up in age-advancement EXCEPT for T2-3. So all we need to do is reset it

(defrule
	(current-age == tech-level-2)
	(goal importantT2research DONE)
	(not (goal openingstyle STYLE-RUSH))
=>
	(set-goal attacksonhold-auto NO)
	(disable-self)
)

; Rush should not get stranded in a tech-up hold if it already has a real T2 army
(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(not (goal rushsize RUSHHALT))
	(military-population >= 10)
	(goal attacksonhold-auto YES)
=>
	(set-goal attacksonhold-auto NO)
)

(defrule
	(current-age == tech-level-3)
=>
	(set-goal attacksonhold-auto YES) ; wait for the research to come in
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(goal importantT3research DONE)
=>
	(set-goal attacksonhold-auto NO)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(game-time < 600) ; this rule needed for late starts as attacksonhold is normally set when teching up to T4
=>
	(set-goal attacksonhold-auto YES)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
=>
	(set-goal attacksonhold-auto NO)
	(disable-self)
)


; -----------------------------------------------------
; --- CHAPTER 1A: MAIN ATTACK LOGIC
; -----------------------------------------------------


;********************************
; DIFFICULTY LOADS: EASIEST & EASY SPECIFIC LOGIC

#load-if-defined DIFFICULTY-EASIEST
;attack timer - almost never attack 

(defrule
	(players-current-age every-human >= tech-level-3)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 3600)
=>
	(enable-timer t-attackgroup-alt 1)
	(disable-self)
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 3600)
	(set-goal aready YES)
)

(defrule
	(not (goal rushsize RUSHHALT))
=>
	(set-goal rushsize RUSHHALT)
)
#end-if

#load-if-defined DIFFICULTY-EASY

(defrule
	(players-current-age every-human >= tech-level-3)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 2400) ; 40min mark
=>
	(enable-timer t-attackgroup-alt 1)
	(set-goal attack-timer YES)
	(disable-self)
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-scn NO)
	(goal attacksonhold-manual NO)
=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 1500) ; 25min 
	(set-goal aready YES)
)

(defrule
	(not (goal rushsize RUSHHALT))
=>
	(set-goal rushsize RUSHHALT)
)
#end-if

; EVERYTHING ELSE

#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY

;attack timer - once in tech-2, or if rushing, launch attacks every 10 minutes (<-- og dev comment)
;once in tech-4, launch attack every 5 minutes ; 5min is too small, AI has no forces
; try 12min? ; nope that's WAY too long ; 8 min? 

; these rules, which reset several variables when timer retriggers, need to be first
; otherwise by the time they're called, the timer will have been reset and no longer triggering
(defrule
	(timer-triggered t-attackgroup-alt)
	(goal maxpopattack SENTOFF)
=>
	(set-goal maxpopattack ALLOW) 
)
(defrule
	(timer-triggered t-attackgroup-hold)
	(goal maxpopattack SENTOFF)
=>
	(set-goal maxpopattack ALLOW) 
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(goal rushsize RUSHHALT)
=>
	(set-goal rushsize NULL) ; can happen in very long T2
)

; This rule catches situations where the timer will not start, such as starting in T4, or if the T1/2 check never went off

(defrule
	(not (goal attack-timer YES))
	(current-age >= tech-level-3)
	(game-time > 900) ; 15min mark
	(goal attacksonhold-manual NO)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 5) ; Attack immediately
	(chat-local-to-self "WAFFLE: No attack timer. Commencing attack")
	(set-goal attack-timer YES)
	(disable-self)
)

; T1 attack rules. Only ever called in
(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(goal attack-timer NO)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 25)
	(set-goal attack-timer YES)
)

(defrule
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(goal gremlinstate GREMLIN-ZERO)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal gremlinstate GREMLIN-ONE)
)

(defrule
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(goal gremlinstate GREMLIN-ONE)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 2)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal gremlinstate GREMLIN-TWO)
)

(defrule
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(goal gremlinstate GREMLIN-TWO)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 3)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal gremlinstate GREMLIN-DONE)
	(set-goal gremlintrick GREMLINTRICK-DONE)
)

(defrule
	(goal aready YES)
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(or
		(goal gremlinstate GREMLIN-ONE)
		(or
			(goal gremlinstate GREMLIN-TWO)
			(goal gremlinstate GREMLIN-DONE)
		)
	)
=>
	(set-goal reasonforattack attack-is-me)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
)

(defrule
	(current-age == tech-level-1)
	(timer-triggered t-attackgroup-alt)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(set-goal aready YES)
	(disable-timer t-attackgroup-alt) ; do not start the timer for another attack in T1
	(chat-local-to-self "WAFFLE: T1 attack. Does not start timer")
	(set-goal attack-timer NO) ; and let it be restarted as needed
)
(defrule
	(current-age == tech-level-1) ; only way attacks fire in T1 like this is with taunt 31
	(timer-triggered t-attackgroup-alt)
	(unit-type-count-total UNIT-MOUNTED-LINE < 1)
	=>
	(set-goal messagestatus msg-NOMILITARY)
	(disable-timer t-attackgroup-alt)
	(set-goal attack-timer NO)
)

; one direct T1 shove for Rush so it does not sit on the first real little army
(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
	(disable-self)
)

;
; T2 RUSH LOGIC

; some T2 logic that probably needs to be loaded before other logic

; if rush is paused and reach T3
(defrule
	(current-age == tech-level-3)
	(goal rushsize RUSHHALT)
=>
	(set-goal rushsize NULL)
	(chat-local-to-self "WAFFLE: T3 reached with HALT rushes. AT 120s, keep in mind onhold-auto")
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 120)
	(disable-self)
)

; Aggressive uses lighter TL2 pressure than Rush. Keep this separate from the
; generic pop kickoff so it cannot stockpile forever waiting for a larger wave.
(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-AGRESSIVE)
	(military-population >= 4)
	(goal attack-timer NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
=>
	(set-goal attacksonhold-auto NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
)

; direct pop kickoffs so the AI attacks because it has units, not just because a timer happened to line up
(defrule
	(current-age == tech-level-2)
	(not (goal openingstyle STYLE-RUSH))
	(military-population >= 6)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
	(disable-self)
)

; Rush pileup relief: if the home army is sitting there and no attack group is really out, shove it
(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(not (goal rushsize RUSHHALT))
	(defend-soldier-count >= 10)
	(attack-soldier-count <= 1)
	(not (goal aready YES))
	(goal attack-timer NO)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
)

; Generic pileup relief for any T2 army that has clearly stalled at home
(defrule
	(current-age == tech-level-2)
	(not (goal openingstyle STYLE-RUSH))
	(defend-soldier-count >= 8)
	(attack-soldier-count <= 1)
	(not (goal aready YES))
	(goal attack-timer NO)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
)

(defrule
	(current-age == tech-level-3)
	(military-population >= 8)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 180)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
	(disable-self)
)

; Same idea in T3: if a real army is camped at home, send it
(defrule
	(current-age == tech-level-3)
	(defend-soldier-count >= 10)
	(attack-soldier-count <= 1)
	(not (goal aready YES))
	(goal attack-timer NO)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 180)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
)

; stop rushing if walled (eg: arena)
(defrule
	(current-age == tech-level-2)
	(or
		(goal rushsize RUSHDONE)
		(goal rushsize RUSHCONTINUE)
	)
	(cc-players-building-type-count every-enemy BLDG-BARRIER-LINE >= 10)
=>
	(set-goal rushsize RUSHHALT)
	(chat-local-to-self "WAFFLE: Everyone has walls. No more T2 rushes. AT 480s")
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 480)
	(disable-self)
)

; human override to continue rushing
(defrule
	(goal rushsize RUSHHALT)
	(goal reasonforattack attack-is-human)
=>
	(set-goal rushsize RUSHCONTINUE)
)

; HARD AND HARDEST RUSH RULES
; T2 attacks
; begin a rush. setting of rushsize is above
; we tried defend-soldier-count which worked better but mostly worked worse because this would never fire as the AI was continually being called by its ally to attack
(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize SMOL)
		(military-population >= 10) 
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20) ; give time for scenario to set in 
=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 RUSH SMOL. AT 150s")
	(set-goal rushsize RUSHDONE)
	(set-goal attack-timer YES)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me) ; ensures no silliness on message
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize NORM)
		(military-population >= 10)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 RUSH NORM. AT 150s")
	(set-goal rushsize RUSHDONE)
	(set-goal aready YES)
	(set-goal attack-timer YES)
	(set-goal reasonforattack attack-is-me) ; ensures no silliness on message
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize BIG)
		(military-population >= 10)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 RUSH BIG. AT 150s")
	(set-goal rushsize RUSHDONE)
	(set-goal aready YES)
	(set-goal attack-timer YES)
	(set-goal reasonforattack attack-is-me) ; ensures no silliness on message
	(disable-self)
)

; what happens after a rush
; hard now continues rushing like moderate/hardest so the midgame feel is more universal
#load-if-defined DIFFICULTY-HARD
(defrule
	(current-age == tech-level-2)
	(goal rushsize RUSHDONE)
=>
	(set-goal rushsize RUSHCONTINUE)
	(disable-self)
)
#end-if

; hardest: always continue rushing
#load-if-defined DIFFICULTY-HARDEST
(defrule
	(current-age == tech-level-2)
	(goal rushsize RUSHDONE)
=>
	(set-goal rushsize RUSHCONTINUE)
	(disable-self)
)
#end-if

#load-if-defined DIFFICULTY-MODERATE
(defrule
	(current-age == tech-level-2)
	(goal rushsize RUSHDONE)
=>
	(set-goal rushsize RUSHCONTINUE)
	(disable-self)
)
#end-if

; so when the attack timer runs out, it will try to reinforce:

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(defend-soldier-count > 5) ; if we have reinforcements
	(attack-soldier-count > 3) ; and the attack group is still alive
	(not (goal rushsize RUSHHALT))
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 attack reinforce. AT 150s")
	(set-goal aready YES) ; whichever message is used here can and should depend
)

; if the attack group is dead; 

; then two cases happen
; a) we do not have enough defending soldiers, go on cooldown
; b) we do have enough defending soldiers, go on the attack

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(military-population >= 10)
	(or
		(defend-soldier-count >= 9)         ; if we have plenty of spare soldiers at home
		(and
			(goal reasonforattack attack-is-AI)
			(defend-soldier-count >= 7) ; allow if fewer soldiers but an ally AI joinin
		)
	)
	(not (goal rushsize RUSHHALT))
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 rush dead soldiers home . AT 150s")
	(set-goal aready YES)
)

; anything else
; major case when this fires: if an attack has already been sent off
; defend soldier count is like 0-1 despite military population being high because it's all in the attack force
; there are no reinforcements to send
; so going on cooldown still makes sense

; if a human called them in and none of the above have triggered so far, bypass nearly all the time

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(military-population >= 3)
	(goal reasonforattack attack-is-human)
	=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 90)
	(set-goal aready YES)
)

(defrule
	(current-age == tech-level-2) 
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(military-population <= 3)
	(goal reasonforattack attack-is-human)
	=>
	(set-goal messagestatus msg-NOMILITARY)
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 210) ; go on cooldown
	(set-goal aready NO)
	(set-goal reasonforattack attack-is-me) ; clear
)

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(goal openingstyle STYLE-AGRESSIVE)
	(military-population >= 4)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 aggressive attack. AT 150s")
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
)

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(building-type-count-total BLDG-TRAINBOAT > 0)
	(not (goal openingstyle STYLE-RUSH))
	(or
		(unit-type-count-total BOAT-LASER-LINE >= 2)
		(or
			(unit-type-count-total BOAT-CUTLASER-LINE >= 2)
			(or
				(unit-type-count-total BOAT-MISSILE-LINE >= 2)
				(and
					(unit-type-count-total BOAT-LASER-LINE >= 1)
					(unit-type-count-total BOAT-MISSILE-LINE >= 1)
				)
			)
		)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 fleet ready. AT 150s")
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
)

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(military-population >= 6)
	(not (goal openingstyle STYLE-RUSH))
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150)
	(chat-local-to-self "WAFFLE: T2 army ready. AT 150s")
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me) ; clear
)

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
	(military-population < 6)
	(not (goal openingstyle STYLE-RUSH))
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 120) ; recheck soon instead of sleeping
	(chat-local-to-self "WAFFLE: T2 army light. Recheck in 120s.")
	(set-goal aready NO)
	(set-goal reasonforattack attack-is-me) ; clear
)



; higher tech levels are much simpler to get your head around
; moderate uses this logic too 

(defrule
	(current-age == tech-level-3)
	(timer-triggered t-attackgroup-alt)
	(building-type-count-total BLDG-TRAINBOAT > 0)
	(or
		(unit-type-count-total BOAT-LASER-LINE >= 3)
		(or
			(unit-type-count-total BOAT-CUTLASER-LINE >= 2)
			(or
				(unit-type-count-total BOAT-ARTILLERY-LINE >= 1)
				(and
					(unit-type-count-total BOAT-LASER-LINE >= 2)
					(unit-type-count-total BOAT-MISSILE-LINE >= 1)
				)
			)
		)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 120)
	(chat-local-to-self "WAFFLE: T3 fleet ready. AT 180s")
	(set-goal aready YES)
)

(defrule
	(current-age == tech-level-3)
	(timer-triggered t-attackgroup-alt)
	(military-population >= 8)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 180) ; stronger cadence once a real army exists
	(chat-local-to-self "WAFFLE: T3 army ready. AT 240s")
	(set-goal aready YES)
)

(defrule
	(current-age == tech-level-4)
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 480) ; still leave room for TSA, but do not sleep forever
	(chat-local-to-self "WAFFLE: T4 Attack. AT 480s")
	(set-goal aready YES)
)

(defrule
	(current-age == tech-level-3)
	(timer-triggered t-attackgroup-alt)
	(military-population < 8)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 90) ; army not ready yet, check again soon
	(chat-local-to-self "WAFFLE: T3 army light. Recheck in 120s")
	(set-goal aready NO)
)


; so now that we have Town Size Attack
; what we want is the following
; a) population reaches maximum. begin TSA. hold until further notice 
; a-i) if timer triggered - which could be regular attack timer or a joinin - begin TSA just the same
; b) if population drops below 225 or whatever the constant is, put TSA on a 5-ish min timer and continue to hold
; c) after 10min of TSA-ing, stop and wait for maximum population again

; HOWEVER
; keep in mind maximium population does not neccessarily occur on Moderate as lategame comp is disabled 
; on Moderate, therefore we should stick to the 10min timer attack but for TSA - essentially, its own logic

; SO
; therefore

#load-if-not-defined DIFFICULTY-MODERATE ; give players a break

(defrule
	(population >= popcap)
	(goal attackTSAhold EXHAUSTED)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal attacktype TSA)
=>
	(set-goal aready YES) ; is what sends an attack off
	(set-goal attackTSAhold HOLDING-HIGH)
	(chat-local-to-self "WAFFLE: Pop cap reached. TSA ON")
)
; for max pop attacks that are NOT under TSA

(defrule
	(population >= popcap)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal attacktype NORM)
	(goal maxpopattack ALLOW)
=>
	(set-goal aready YES) ; is what sends an attack off
	(set-goal maxpopattack SENTOFF) ; stop this from firing again
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 120)
	(chat-local-to-self "WAFFLE: Maxpop. AT 120s")
)
#end-if

; chat to humans to say we should attack if on hold
(defrule
	(population >= popcap)
	(not (goal maxpopattack PLEASECONFIRM))
	(goal attacksonhold-manual YES)
	(goal attacksonhold-scn NO)
=>
	(set-goal maxpopattack PLEASECONFIRM)
	(set-goal messagestatus msg-MAXPOP)
)



; -----------------------------------------------------
; --- CHAPTER 1C: SWITCHING BETWEEN NORMAL ATTACK AND TSA
; -----------------------------------------------------

(defrule
	(population >= 120)
	(not (goal openingstyle STYLE-RUSH))
	(military-population >= 30)
	(not (goal attacktype TSA))
=>
	(set-goal attacktype TSA)
)

(defrule
	(population >= 100)
	(goal openingstyle STYLE-RUSH)
	(military-population >= 16)
	(not (goal attacktype TSA))
=>
	(set-goal attacktype TSA)
)

(defrule
	(not (and
	(population >= 120)
	(military-population >= 40)
	)	) ; aka not the above
	(not (goal attacktype NORM	))
=>
	(set-goal attacktype NORM)
)


; -----------------------------------------------------
; --- CHAPTER 2A: REGULAR ATTACK LOGIC --- 
; -----------------------------------------------------

; THE CORE OF IT ALL
; when Aready, then, ATTAAAAAACK

; with different rules for each TL because of different town size setting

; 22410 was 
; 	(chat-to-player-using-id any-computer-ally 22410)      ;sends taunt 200 to summon them in
; but we can just do this without ID and also pick a better taunt; 234 "Get in there you big furry oaf! I don't care what you smell!"

; DISABLE IF NOT UNDER TREATY TIME YET

(defrule
	(not 
		(or
			(shared-goal treatytimer 0) ; treaty timer was never turned on
			(shared-goal treatytimer 1) ; treaty timer expired
		) 
	)
	(goal aready YES)
=>
	(set-goal aready NO)
)

; If TL2 Rush has already spent its allowed wave(s), kill any stale ready state
; before the chitchat rule can keep broadcasting attack taunts.
(defrule
	(goal aready YES)
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(goal rushsize RUSHHALT)
=>
	(set-goal aready NO)
	(set-goal attack-timer YES)
	(disable-timer t-attackgroup-alt)
)

; TL2 Rush only has attack consumers at 10+ military pop. If another branch arms
; an attack below that, clear it here so the attack taunt cannot loop forever.
(defrule
	(goal aready YES)
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(military-population < 10)
=>
	(set-goal aready NO)
	(set-goal reasonforattack attack-is-me)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 120)
)

; Stop spent TL2 Rush waves before the global attack chitchat can announce them.
(defrule
	(goal aready YES)
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(goal rushwavecap 1)
	(goal rushwaves 1)
=>
	(set-goal aready NO)
	(set-goal attacksonhold-auto YES)
	(set-goal rushsize RUSHHALT)
	(set-goal attack-timer YES)
	(disable-timer t-attackgroup-alt)
)

(defrule
	(goal aready YES)
	(current-age == tech-level-2)
	(goal openingstyle STYLE-RUSH)
	(goal rushwavecap 2)
	(goal rushwaves 2)
=>
	(set-goal aready NO)
	(set-goal attacksonhold-auto YES)
	(set-goal rushsize RUSHHALT)
	(set-goal attack-timer YES)
	(disable-timer t-attackgroup-alt)
)

; CHITCHAT
; LOADED BEFOREHAND BECAUSE IT'S EASIER THIS WAY (as aready is set to NO as part of attack script)

(defrule
	(goal aready YES)
	(goal reasonforattack attack-is-me)
=>
	(chat-to-player every-computer "234")      	; sends taunt 234 to other Computer to summon them in
	(set-goal messagestatus msg-ATTACKING)		; there is no every computer ally so this has to call every computer to avoid spamming humans - corresponding taunt incoming logic can check if it was actually an ally, tho
)

(defrule
	(goal aready YES)
	(goal reasonforattack attack-is-AI)
=>
	(set-goal messagestatus msg-JOININ) ; do NOT call in other AI with this
)

(defrule
	(goal aready YES)
	(goal reasonforattack attack-is-human)
=>
	;(chat-to-player every-computer "234")      	; summon other Computer is not needed since the taunt will (likely) be sent to all AI
	(do-nothing) ; message to player not needed as it was already sent in the "I saw a taunt 31" response
)

; RESET TO NORMAL

(defrule
	(goal aready YES)
=>
	(set-goal reasonforattack attack-is-me) ; this means that the next pass, unless something else happened, it will default to it going on the attack
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
=>
	(set-goal reasonforattack attack-is-me) ; this one's a bit of a bugger to get your head around, but basically if the AI gets a joinin while it is holding its attacks (eg: getting techs), the joinin is never cleared
)

(defrule
	(goal aready YES)
	(goal openingstyle STYLE-AGRESSIVE)
	(not (current-age == tech-level-2))
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
	(set-goal attacksonhold-auto NO)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
)

(defrule
	(goal aready YES)
	(goal openingstyle STYLE-RUSH)
	(current-age == tech-level-2)
	(military-population >= 10)
	(goal rushwaves 0)
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
	(set-goal attacksonhold-auto NO)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal attack-timer YES)
	(set-goal rushwaves 1)
)

(defrule
	(goal aready YES)
	(goal openingstyle STYLE-RUSH)
	(current-age == tech-level-2)
	(military-population >= 10)
	(goal rushwaves 1)
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
	(set-goal attacksonhold-auto NO)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal attack-timer YES)
	(set-goal rushwaves 2)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(current-age == tech-level-2)
	(goal rushwavecap 1)
	(goal rushwaves 1)
=>
	(set-goal aready NO)
	(set-goal attacksonhold-auto YES)
	(set-goal rushsize RUSHHALT)
	(set-goal attack-timer YES)
	(disable-timer t-attackgroup-alt)
)

(defrule
	(goal openingstyle STYLE-RUSH)
	(current-age == tech-level-2)
	(goal rushwavecap 2)
	(goal rushwaves 2)
=>
	(set-goal aready NO)
	(set-goal attacksonhold-auto YES)
	(set-goal rushsize RUSHHALT)
	(set-goal attack-timer YES)
	(disable-timer t-attackgroup-alt)
)

(defrule
	(goal aready YES)
	(goal openingstyle STYLE-RUSH)
	(not (current-age == tech-level-2))
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
	(set-goal attacksonhold-auto NO)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
)

(defrule
	(goal aready YES)
	(goal openingstyle STYLE-DEFENSIVE)
	(not (current-age == tech-level-2))
	(not (goal fightertrick FIGHTERTRICK-ACTIVE))
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
	(set-goal attacksonhold-auto NO)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
)


(defrule
	(goal aready YES)
	(goal attacktype NORM)
	(current-age == tech-level-1)
=>
	;(set-strategic-number sn-maximum-town-size 30)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
)

(defrule
	(goal aready YES)
	(current-age == tech-level-2)
	(not (goal openingstyle STYLE-RUSH))
	(goal attacktype NORM)
=>
	;(set-strategic-number sn-maximum-town-size 43) ; gets reset by homebase ; seems to be causing weird worker dogpile issues
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal attack-timer YES)
)

(defrule
	(goal aready YES)
	(current-age == tech-level-3)
	(goal attacktype NORM)
=>
	;(set-strategic-number sn-maximum-town-size 70)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
)

(defrule
	(goal aready YES)
	(current-age == tech-level-4)
	(goal attacktype NORM)
=>
	;(set-strategic-number sn-maximum-town-size 150)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now) ; try to not do this lategame, hence the whole TSA shebang
	(set-goal aready NO)
)


; -----------------------------------------------------
; --- CHAPTER 2B: TOWN SIZE ATTACK LOGIC --- 
; -----------------------------------------------------

; remember, an additional rule sets it to HOLDING-HIGH if EXHAUSTED and at pop cap

; Aggressive needs to keep launching pressure instead of letting TSA swallow
; a ready attack into a hold state when it has already piled up.
(defrule
	(goal aready YES)
	(goal openingstyle STYLE-AGRESSIVE)
	(goal attacktype TSA)
=>
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal aready NO)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 240)
	(chat-local-to-self "WAFFLE: Aggressive TSA bypass attack. AT 240s")
)

; occurs in any age
; we could have separate rules for "start TSA" and "continue TSA" and will probably do that later but not right now
(defrule
	(goal aready YES)
	(goal attacktype TSA)
=>
	(chat-local-to-self "WAFFLE: TSA. Attack. Set to HIGH")
	(set-goal attackTSAhold HOLDING-HIGH)
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt) ; we don't want it to interrupt our TSA
	(disable-timer t-attackgroup-hold) ; it may have been doing something but we got a join in 
)

(defrule
	(population < stop-junk-threshold-lower) ; when population is smaller than the threshold
	(goal attackTSAhold HOLDING-HIGH)
=>
	(set-goal attackTSAhold HOLDING-LOW) ; start the timer to call off TSA in however many min
	(disable-timer t-attackgroup-hold)
	(enable-timer t-attackgroup-hold 360)
	(chat-local-to-self "WAFFLE: TSA hit lower pop threshold. Holding for 360s more")
)

(defrule
	(population < stop-junk-threshold) ; when population is smaller than the threshold
	(goal attackTSAhold HOLDING-HIGH)
=>
	(set-goal attackTSAhold HOLDING-LOW) ; start the timer to call off TSA
	(disable-timer t-attackgroup-hold)
	(enable-timer t-attackgroup-hold 420)
	(chat-local-to-self "WAFFLE: TSA hit low pop threshold. Holding for 420s more")
)
; thanks to a bit of lucky script we can have it so that if the pop is lower, TSA goes on for shorter, without breaking it
; (as in, if it was low, then went to lower, we don't want the timer to restart)


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE
(defrule
	(population >= popcap) ; if population then reaches pop cap during this time
	(goal attackTSAhold HOLDING-LOW)
=>
	(set-goal attackTSAhold HOLDING-HIGH) ; reset and wait for pop to fall back down again
	(disable-timer t-attackgroup-hold)
	(chat-local-to-self "WAFFLE: TSA re-reached popcap, holding indefinitely")
)
#end-if
#end-if
#end-if ; closes #load-if-not-defined DIFFICULTY-EASY
#end-if ; closes #load-if-not-defined DIFFICULTY-EASIEST
#end-if

; force abort conditions
(defrule
	(or
		(military-population <= 20)
		(building-type-count BCORE-MAIN == 0) ; no CC
	)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
	(disable-timer t-attackgroup-hold)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 900)
	(chat-local-to-self "WAFFLE: Force cancelling TSA. 900s cooldown")
)

; when the timer triggers...


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population >= stop-junk-threshold) ; high pop 
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 300)
	(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop high: 300s cooldown.")
)

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population < stop-junk-threshold-lower) ; even lowe rup 
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 600)
	(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop lower: 600s cooldown.")
)

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population < stop-junk-threshold) ; lower pop
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 480)
	(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop low: 480s cooldown.")
)

#end-if
#end-if

; keep in mind even if it's on cooldown due to rules above, reaching max pop will always send an attack off anyway



; lower difficulty stuff to handle longer cooldowns
#load-if-defined DIFFICULTY-EASIEST
(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0) 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 3600)
	;(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Easiest: 3600s cooldown.")
)
#end-if
#load-if-defined DIFFICULTY-EASY
(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0) 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 1500)
	;(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Easy: 1500s cooldown.")
)
#end-if
#load-if-defined DIFFICULTY-MODERATE
(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0) 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 750)
	(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Moderate: 750s cooldown.")
)
#end-if


; -----------------------------------------------------
; --- CHAPTER 2B-II: INCREMENTING TOWN SIZE LOGIC --- 
; -----------------------------------------------------
; this is the bit that makes town size attack actually attack
; ordering of sections is important due to shenanigans

; add an extra tick for processing as enemy-buildings-in-town takes till the next script pass to update
; whereas goals update immediately
(defrule
	(goal attackTSAvar NULL)
=>
	(set-goal attackTSAvar NULL2)
)


(defrule
	(goal attackTSAlevel 0)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 1)
)
(defrule
	(goal attackTSAlevel 1)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
