)

; LAND core and loss recovery. AoC has no per-type idle counter, so subtract
; the upper bound of ALL attacking ground soldiers from completed core counts.
; This is conservative when attackers mix types. Queued units never count.
; Recovery is an observed group-count collapse, not a local battle simulation.
#load-if-not-defined MONUMENT-RACE
(defrule
	(true)
=>
	(set-goal land-regroup-phase 0)
	(set-goal land-regroup-debug 0)
	(disable-self)
)

(defrule
	(true)
=>
	(set-goal land-attack-policy NO)
	(set-goal land-core-ready NO)
)

(defrule
	(current-age >= tech-level-3)
	(goal special-map LAND)
	(not (goal combat-arm AIR))
	(not (goal combat-arm SEA))
=>
	(set-goal land-attack-policy YES)
)

(defrule
	(goal land-attack-policy NO)
=>
	(set-goal land-regroup-phase 0)
)

; Trooper core
(defrule
	(goal land-attack-policy YES)
	(or (goal combat-arm TROOP) (goal combat-arm TROOP/HW))
	(attack-soldier-count <= 0)
	(or (unit-type-count UNIT-LASER-LINE >= land-core-spare-0) (unit-type-count UNIT-MOUNTED-LINE >= land-core-spare-0))
=>
	(set-goal land-core-ready YES)
)

(defrule
	(goal land-attack-policy YES)
	(or (goal combat-arm TROOP) (goal combat-arm TROOP/HW))
	(attack-soldier-count > 0)
	(attack-soldier-count <= 1)
	(or (unit-type-count UNIT-LASER-LINE >= land-core-spare-1) (unit-type-count UNIT-MOUNTED-LINE >= land-core-spare-1))
=>
	(set-goal land-core-ready YES)
)

