	(goal attack-batch-debug-phase 1)
	(goal ground-release-state GROUND-READY)
=>
	(chat-to-all "ATTACK GROUP: READY")
	(chat-local "ATTACK GROUP: READY")
	(set-goal attack-batch-debug-phase 2)
)

(defrule
	(goal aready YES)
	(goal ground-release-state GROUND-HELD)
	(not (goal special-map WATER))
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

#end-if

; A direct ground pulse already committed this pass. Do not issue an ordinary
; ground attack immediately afterward; WATER can still launch fleet/air alone.
#load-if-not-defined MONUMENT-RACE
(defrule
	(current-age >= tech-level-3)
	(goal aready YES)
	(or (goal special-map LAND) (goal special-map HYBRID))
	(not (goal combat-arm AIR))
	(not (goal combat-arm SEA))
	(goal ground-release-state GROUND-COMMITTED)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)
#end-if

; CHITCHAT
; LOADED BEFOREHAND BECAUSE IT'S EASIER THIS WAY (as aready is set to NO as part of attack script)

(defrule
	(goal aready YES)
	(goal reasonforattack attack-is-me)
	(goal attack-strength-hold NO)
=>
	(chat-to-player every-computer "234")      	; sends taunt 234 to other Computer to summon them in
	(set-goal messagestatus msg-ATTACKING)		; there is no every computer ally so this has to call every computer to avoid spamming humans - corresponding taunt incoming logic can check if it was actually an ally, tho
)

(defrule
	(goal aready YES)
	(goal reasonforattack attack-is-AI)
=>
	(set-goal messagestatus msg-JOININ) ; do NOT call in other AI with this
)

(defrule
	(goal aready YES)
	(goal reasonforattack attack-is-human)
=>
	;(chat-to-player every-computer "234")      	; summon other Computer is not needed since the taunt will (likely) be sent to all AI
	(do-nothing) ; message to player not needed as it was already sent in the "I saw a taunt 31" response
)

; RESET TO NORMAL

(defrule
	(goal aready YES)
=>
	(set-goal reasonforattack attack-is-me) ; this means that the next pass, unless something else happened, it will default to it going on the attack
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(not (goal aready YES))
=>
	(set-goal reasonforattack attack-is-me) ; this one's a bit of a bugger to get your head around, but basically if the AI gets a joinin while it is holding its attacks (eg: getting techs), the joinin is never cleared
)

; Single owner of ordinary attack commitment settings. Keep this load after
; readiness vetoes and before attack-now/TSA starts; its rule order is significant.
(load "/Computer Prototype/groups")

(defrule
	(goal aready YES)
	(goal attacktype NORM)
	(current-age == tech-level-1)
	(goal raid-launch-open YES)
=>
	;(set-strategic-number sn-maximum-town-size 30)
	(attack-now)
	(set-goal opening-attack-target TARGET-WORKERS)
	(set-goal aready NO) 						
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(goal aready YES)
	(current-age == tech-level-2)
	(goal attacktype NORM)
	(goal raid-launch-open YES)
=>
	;(set-strategic-number sn-maximum-town-size 43) ; gets reset by homebase ; seems to be causing weird worker dogpile issues
	(attack-now)
	(set-goal opening-attack-target TARGET-WORKERS)
	(set-goal aready NO)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(goal aready YES)
	(current-age == tech-level-3)
	(goal attacktype NORM)
	(goal raid-launch-open YES)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
=>
	;(set-strategic-number sn-maximum-town-size 70)
	(attack-now)
	(set-goal aready NO)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(goal aready YES)
	(current-age == tech-level-4)
	(goal attacktype NORM)
	(goal raid-launch-open YES)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
=>
	;(set-strategic-number sn-maximum-town-size 150)
	(attack-now) ; try to not do this lategame, hence the whole TSA shebang
	(set-goal aready NO)
	(do-nothing) ; RAID diagnostics disabled
)


; -----------------------------------------------------
; --- CHAPTER 5B: TOWN SIZE ATTACK CONTROL
; -----------------------------------------------------

; remember, an additional rule sets it to HOLDING-HIGH if EXHAUSTED and at pop cap

; occurs in any age
; we could have separate rules for "start TSA" and "continue TSA" and will probably do that later but not right now
(defrule
	(goal aready YES)
	(goal attacktype TSA)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
=>
	; (chat-local-to-self "WAFFLE: TSA. Attack. Set to HIGH")
	(set-goal attackTSAhold HOLDING-HIGH)
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt) ; we don't want it to interrupt our TSA
	(disable-timer t-attackgroup-hold) ; it may have been doing something but we got a join in 
)

(defrule
	(population < stop-junk-threshold-lower) ; when population is smaller than the threshold
	(goal attackTSAhold HOLDING-HIGH)
=>
	(set-goal attackTSAhold HOLDING-LOW) ; start the timer to call off TSA in however many min
	(disable-timer t-attackgroup-hold)
	(enable-timer t-attackgroup-hold 90)
	; (chat-local-to-self "WAFFLE: TSA hit lower pop threshold. Holding for 90s more")
)

(defrule
	(population < stop-junk-threshold) ; when population is smaller than the threshold
	(goal attackTSAhold HOLDING-HIGH)
=>
	(set-goal attackTSAhold HOLDING-LOW) ; start the timer to call off TSA
	(disable-timer t-attackgroup-hold)
	(enable-timer t-attackgroup-hold 120)
	; (chat-local-to-self "WAFFLE: TSA hit low pop threshold. Holding for 120s more")
)
; thanks to a bit of lucky script we can have it so that if the pop is lower, TSA goes on for shorter, without breaking it
; (as in, if it was low, then went to lower, we don't want the timer to restart)


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-MODERATE
(defrule
	(population >= popcap) ; if population then reaches pop cap during this time
	(goal attackTSAhold HOLDING-LOW)
=>
	(set-goal attackTSAhold HOLDING-HIGH) ; reset and wait for pop to fall back down again
	(disable-timer t-attackgroup-hold)
	; (chat-local-to-self "WAFFLE: TSA re-reached popcap, holding indefinitely")
)
#end-if
#end-if
#end-if

; force abort conditions
(defrule
	(or
		(military-population <= 20)
		(building-type-count BLDG-MAIN == 0) ; no CC
	)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
	(disable-timer t-attackgroup-hold)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 900)
	; (chat-local-to-self "WAFFLE: Force cancelling TSA. 900s cooldown")
)

; when the timer triggers...


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population >= stop-junk-threshold) ; high pop 
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 300)
	; (chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop high: 300s cooldown.")
)

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population < stop-junk-threshold-lower) ; even lowe rup 
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 600)
	; (chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop lower: 600s cooldown.")
)

(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(population < stop-junk-threshold) ; lower pop
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED) ; turn off TSA
	(set-goal attackTSAlevel 0) ; this belongs here 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 480)
	; (chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Pop low: 480s cooldown.")
)

#end-if
#end-if

; keep in mind even if it's on cooldown due to rules above, reaching max pop will always send an attack off anyway



; lower difficulty stuff to handle longer cooldowns
#load-if-defined DIFFICULTY-EASIEST
(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0) 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 3600)
	;(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Easiest: 3600s cooldown.")
)
#end-if
#load-if-defined DIFFICULTY-EASY
(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0) 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 1500)
	;(chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Easy: 1500s cooldown.")
)
#end-if
#load-if-defined DIFFICULTY-MODERATE
(defrule
	(timer-triggered t-attackgroup-hold)
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
=>
	(disable-timer t-attackgroup-hold)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0) 
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 750)
	; (chat-local-to-self "WAFFLE: TSA timer ran out, turning off. Moderate: 750s cooldown.")
)
#end-if


; -----------------------------------------------------
; --- CHAPTER 5C: INCREMENTING TSA TOWN SIZE
; -----------------------------------------------------
; this is the bit that makes town size attack actually attack
; ordering of sections is important due to shenanigans

; add an extra tick for processing as enemy-buildings-in-town takes till the next script pass to update
; whereas goals update immediately
(defrule
	(goal attackTSAvar NULL)
=>
	(set-goal attackTSAvar NULL2)
)


(defrule
	(goal attackTSAlevel 0)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 1)
)
(defrule
	(goal attackTSAlevel 1)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 2)
)
(defrule
	(goal attackTSAlevel 2)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 3)
)
(defrule
	(goal attackTSAlevel 3)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 4)
)
(defrule
	(goal attackTSAlevel 4)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 5)
)
(defrule
	(goal attackTSAlevel 5)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 6)
)
(defrule
	(goal attackTSAlevel 6)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 7)
)
(defrule
	(goal attackTSAlevel 7)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 8)
)
(defrule
	(goal attackTSAlevel 8)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 9)
)
(defrule
	(goal attackTSAlevel 9)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 10) ; final value
)
(defrule
	(goal attackTSAlevel 10)
	(goal attackTSAvar INCREMENT)
=>
	(set-goal attackTSAvar NULL)
	(set-goal attackTSAlevel 11)
)


(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 0)
	(not (strategic-number sn-maximum-town-size == 40))
=>
	(set-strategic-number sn-maximum-town-size 40)
	; (chat-local-to-self "WAFFLE: Level 0, TS 40")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 1)
	(not (strategic-number sn-maximum-town-size == 60))
=>
	(set-strategic-number sn-maximum-town-size 60)
	; (chat-local-to-self "WAFFLE: Level 1, TS 60")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 2)
	(not (strategic-number sn-maximum-town-size == 80))
=>
	(set-strategic-number sn-maximum-town-size 80)
	; (chat-local-to-self "WAFFLE: Level 2, TS 80")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 3)
	(not (strategic-number sn-maximum-town-size == 100))
=>
	(set-strategic-number sn-maximum-town-size 100)
	; (chat-local-to-self "WAFFLE: Level 3, TS 100")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 4)
	(not (strategic-number sn-maximum-town-size == 120))
=>
	(set-strategic-number sn-maximum-town-size 120)
	; (chat-local-to-self "WAFFLE: Level 4, TS 120")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 5)
	(not (strategic-number sn-maximum-town-size == 140))
=>
	(set-strategic-number sn-maximum-town-size 140)
	; (chat-local-to-self "WAFFLE: Level 5, TS 140")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 6)
	(not (strategic-number sn-maximum-town-size == 160))
=>
	(set-strategic-number sn-maximum-town-size 160)
	; (chat-local-to-self "WAFFLE: Level 6, TS 160")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 7)
	(not (strategic-number sn-maximum-town-size == 180))
=>
	(set-strategic-number sn-maximum-town-size 180)
	; (chat-local-to-self "WAFFLE: Level 7, TS 180")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 8)
	(not (strategic-number sn-maximum-town-size == 200))
=>
	(set-strategic-number sn-maximum-town-size 200)
	; (chat-local-to-self "WAFFLE: Level 8, TS 200")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 9)
	(not (strategic-number sn-maximum-town-size == 220))
=>
	(set-strategic-number sn-maximum-town-size 220)
	; (chat-local-to-self "WAFFLE: Level 9, TS 220")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 10)
	(not (strategic-number sn-maximum-town-size == 255))
=>
	(set-strategic-number sn-maximum-town-size 255)
	; (chat-local-to-self "WAFFLE: Level 10, TS 255")
)
(defrule
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAlevel 11)
	(not (strategic-number sn-maximum-town-size == 255))
=>
	(set-strategic-number sn-maximum-town-size 255)
	; (chat-local-to-self "WAFFLE: Level 11, TS 255")
)



(defrule
	(not (enemy-buildings-in-town))
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(goal attackTSAvar NULL2)
=>
	(set-goal attackTSAvar INCREMENT)
	; (chat-local-to-self "WAFFLE: TSA is HOLDING but no enemy buildings. INCREMENT")
)

; If TSA is expanding and still sees no buildings, send scouts before the
; attack radius maxes out. This gives the next attack update real sight instead
; of only stale building memory.
(defrule
	(not (enemy-buildings-in-town))
	(or
		(goal attackTSAhold HOLDING-HIGH)
		(goal attackTSAhold HOLDING-LOW)
	)
	(or
		(goal attackTSAlevel 3)
		(or
			(goal attackTSAlevel 4)
			(goal attackTSAlevel 5)
		)
	)
=>
	(set-goal scouting PULSEYES)
	(set-strategic-number sn-blot-exploration-map 1)
	(set-strategic-number sn-blot-size 25)
)




; -----------------------------------------------------
; --- CHAPTER 6A: COMPUTER ALLY JOIN-IN
; -----------------------------------------------------


; Original ally-aid behavior created circular call-ins and scattered armies.
; This version only responds to explicit attack calls.

; note to self: called ID 22406 which sent taunt 201, this can be repurposed, clobbered, or generally depreciated
; note to self #2: used timer t-calltoaid, this can be removed



; When one AI attacks, all the others join in
#load-if-not-defined MONUMENT-RACE
(defrule
	;(not (town-under-attack))
	(taunt-detected any-ally 234)
	(military-population > 7) ; 1 scout and over 6 troops worth
	(goal attacksonhold-auto NO)
	(not (current-age == tech-level-1)) ; ignore in T1
	(or
		(not (current-age == tech-level-2))
		;(not (goal rushsize RUSHHALT)) ; had issues whereby before this was rolled the AI would continually attack and never get forces enough to the point where it could roll
		(goal rushsize RUSHCONTINUE)
	)
=> 
	(acknowledge-taunt every-ally 234) ; can recieve multiple in the same tick so needs to call every
	(set-goal reasonforattack attack-is-AI)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 5) ; so it fires immediately; give it a bit
	; (chat-local-to-self "WAFFLE: Asked by ally AI to join in. Joining in 5s")
)

(defrule
	(taunt-detected any-ally 234)
=> 
	(acknowledge-taunt this-any-ally 234)
	(set-goal reasonforattack attack-is-me) ; reset 
	; (chat-local-to-self "WAFFLE: Asked by ally AI to join in. Request denied.")
)



; -----------------------------------------------------
; --- CHAPTER 6B: HUMAN ATTACK COMMANDS
; -----------------------------------------------------

; Incoming taunts

; Do not attack
(defrule
	(taunt-detected any-ally 36)                    ;"attack on my mark"
	(goal attacksonhold-scn NO)
=>
	(acknowledge-taunt this-any-ally 36)
	(set-goal messagestatus msg-COMMANDEDNOTTOATTACK)
	(set-goal attacksonhold-manual YES)
	(disable-timer t-attackgroup-alt) ; resetting of this should be done via taunt 31 
)    

; Go on the attack
(defrule
	(taunt-detected any-ally 31)              ; "attack somebody"
	(or
		(goal attacksonhold-auto NO)
		(goal attacksonhold-auto MAYBE)
	)
	(goal attacksonhold-scn NO)
=>
	(acknowledge-taunt this-any-ally 31)
	(set-goal messagestatus msg-COMMANDEDTOATTACK)
	(set-goal attacksonhold-manual NO)
	(set-goal attacksonhold-auto NO)
	(set-goal reasonforattack attack-is-human)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 8) ; give a few seconds for taunt to clear
)

(defrule
	(taunt-detected any-ally 31)              ; "attack somebody"
	(goal attacksonhold-auto YES)			; if AI is teching, it sends a confirm message before attacking
	(goal attacksonhold-scn NO)
=>
	(acknowledge-taunt this-any-ally 31)
	(set-goal messagestatus msg-BUSYTECHING)
	(set-goal attacksonhold-auto MAYBE)
)
#end-if


; -----------------------------------------------------
; --- CHAPTER 7A: CENTER COMMANDS
; -----------------------------------------------------

; reset town size when done; edit: automatically done by sn homebase now

; chattiness done by warboat island now


; Go on the MEGAattack (Go to center)
#load-if-not-defined MONUMENT-RACE
; Actually go to center
(defrule
	(taunt-detected any-ally 185)              ; "Send troops to defend that area"
	(goal scn-detected NO)
	(goal attacksonhold-scn NO)
=>
	(acknowledge-taunt this-any-ally 185)
	(set-goal messagestatus msg-CENTER)
	(set-goal center-override YES)
	(set-strategic-number sn-gather-defense-units 1)
	(set-strategic-number sn-gather-idle-soldiers-at-center 1)
)

; Don't do the thing
(defrule
	(taunt-detected any-ally 172)              ; "Retreat!"
	(goal scn-detected NO)
	(goal attacksonhold-scn NO)
=>
	(acknowledge-taunt this-any-ally 172)
	(set-goal messagestatus msg-CANCELCENTER)
	(set-goal center-override NO)
	(set-strategic-number sn-gather-defense-units 1)
	(set-strategic-number sn-gather-idle-soldiers-at-center 0)
)
#end-if


