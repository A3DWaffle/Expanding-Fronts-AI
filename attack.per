(defrule
	(goal land-attack-policy YES)
	(goal land-regroup-phase 0)
	(attack-soldier-count >= land-loss-arm)
=>
	(set-goal land-regroup-phase 1)
)

(defrule
	(goal land-attack-policy YES)
	(goal land-regroup-phase 1)
	(attack-soldier-count <= land-loss-left)
=>
	(set-goal land-regroup-phase 2)
	(set-goal attackTSAhold EXHAUSTED)
	(set-goal attackTSAlevel 0)
	(set-goal attackTSAvar NULL)
	(disable-timer t-attackgroup-hold)
)

(defrule
	(goal land-regroup-phase 2)
	(goal land-regroup-debug 0)
=>
	(chat-to-all "ATTACK GROUP: LOSSES - REGROUP")
	(chat-local "ATTACK GROUP: LOSSES - REGROUP")
	(set-goal land-regroup-debug 1)
)

(defrule
	(goal land-regroup-phase 2)
	(goal land-core-ready YES)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
	(goal openingstyle STYLE-RUSH)
	(defend-soldier-count >= land-rebuild-rush)
=>
	(set-goal land-regroup-phase 0)
)

(defrule
	(goal land-regroup-phase 2)
	(goal land-core-ready YES)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
	(goal openingstyle STYLE-AGGRESSIVE)
	(defend-soldier-count >= land-rebuild-aggressive)
=>
	(set-goal land-regroup-phase 0)
)

(defrule
	(goal land-regroup-phase 2)
	(goal land-core-ready YES)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
	(goal openingstyle STYLE-DEFENSIVE)
	(defend-soldier-count >= land-rebuild-defensive)
=>
	(set-goal land-regroup-phase 0)
)

(defrule
	(goal land-regroup-debug 1)
	(goal land-regroup-phase 0)
	(goal land-attack-policy YES)
=>
	(chat-to-all "ATTACK GROUP: REBUILT - READY")
	(chat-local "ATTACK GROUP: REBUILT - READY")
	(set-goal land-regroup-debug 2)
)

(defrule
	(goal land-regroup-phase 2)
=>
	(set-goal raid-launch-open NO)
	(set-strategic-number sn-number-attack-groups 0)
)

#end-if

; A strength hold must also stop automatic groups, not just attack-now.
(defrule
	(goal attack-strength-hold YES)
	(not (strategic-number sn-number-attack-groups == 0))
=>
	(set-strategic-number sn-number-attack-groups 0)
)

; Town Size Attack can form groups without an explicit attack-now.
(defrule
	(goal fortress-siege-hold YES)
	(not (strategic-number sn-number-attack-groups == 0))
=>
	(set-strategic-number sn-number-attack-groups 0)
)

#end-if

(defrule
	(current-age >= tech-level-3)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
	(not (goal land-regroup-phase 2))
	(strategic-number sn-number-attack-groups == 0)
=>
	(set-strategic-number sn-number-attack-groups 1)
)

; Compute release permission after current core/recovery facts and before pulses.
(load "/Computer Prototype/ground")

; -----------------------------------------------------
; --- CHAPTER 1B: RE-ENABLING AUTOMATIC ATTACK HOLDS
; -----------------------------------------------------

; Basically, if the AI is teching up, or hasn't got its super important techs yet, do not attack
; attacksonhold-auto is set to YES whenever the AI techs up in age-advancement EXCEPT for T2-3. So all we need to do is reset it

(defrule
	(current-age == tech-level-2)
	(research-completed rt-macrobinoculars)
	(research-completed ut-laser-2)
=>
	(set-goal attacksonhold-auto NO)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
=>
	(set-goal attacksonhold-auto YES) ; wait for the research to come in
	(disable-self)
)

; Do not lock the AI behind importantT3research as that includes Tracking Computers which takes quite a while to get online especially if the AI fails to power its Research Center
(defrule
	(current-age == tech-level-3)
	(research-completed rt-portable-scanners)
	(research-completed ut-laser-3)
	(or
		(research-completed rt-external-sensor-pod)
		(research-completed rt-stimpacks)
	)
=>
	(set-goal attacksonhold-auto NO)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(not (goal openingstyle STYLE-RUSH))
	(goal attacksonhold-auto YES)
	(current-age-time > 480)
	(military-population >= 18)
=>
	(set-goal attacksonhold-auto NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

(defrule
	(current-age == tech-level-4)
	(game-time < 600) ; this rule needed for late starts as attacksonhold is normally set when teching up to T4
=>
	(set-goal attacksonhold-auto YES)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
=>
	(set-goal attacksonhold-auto NO)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(goal attacksonhold-auto YES)
	(current-age-time > 600)
	(military-population >= 24)
=>
	(set-goal attacksonhold-auto NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)


;********************************
; CHAPTER 2A: EASIEST/EASY ATTACK TIMERS

#load-if-defined DIFFICULTY-EASIEST
;attack timer - almost never attack 

(defrule
	(players-current-age every-human >= tech-level-3)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 3600)
=>
	(enable-timer t-attackgroup-alt 1)
	(disable-self)
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 3600)
	(set-goal aready YES)
)

(defrule
	(not (goal rushsize RUSHHALT))
=>
	(set-goal rushsize RUSHHALT)
)
#end-if

#load-if-defined DIFFICULTY-EASY

(defrule
	(players-current-age every-human >= tech-level-3)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 2400) ; 40min mark
=>
	(enable-timer t-attackgroup-alt 1)
	(set-goal attack-timer YES)
	(disable-self)
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-scn NO)
	(goal attacksonhold-manual NO)
=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 1500) ; 25min 
	(set-goal aready YES)
)

(defrule
	(not (goal rushsize RUSHHALT))
=>
	(set-goal rushsize RUSHHALT)
)
#end-if

;********************************
; CHAPTER 2B: MODERATE/HARD/HARDEST ATTACK TIMER START

#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY

;attack timer - once in tech-2, or if rushing, launch attacks every 10 minutes (<-- og dev comment)
;once in tech-4, launch attack every 5 minutes ; 5min is too small, AI has no forces
; try 12min? ; nope that's WAY too long ; 8 min? 

; these rules, which reset several variables when timer retriggers, need to be first
; otherwise by the time they're called, the timer will have been reset and no longer triggering
(defrule
	(timer-triggered t-attackgroup-alt)
	(goal maxpopattack SENTOFF)
=>
	(set-goal maxpopattack ALLOW) 
)
(defrule
	(timer-triggered t-attackgroup-hold)
	(goal maxpopattack SENTOFF)
=>
	(set-goal maxpopattack ALLOW) 
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(goal rushsize RUSHHALT)
=>
	(set-goal rushsize NULL) ; can happen in very long T2
)

; This rule catches situations where the timer will not start, such as starting in T4, or if the T1/2 check never went off

(defrule
	(not (goal attack-timer YES))
	(current-age >= tech-level-3)
	(game-time > 900) ; 15min mark
	(goal attacksonhold-manual NO)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 5) ; Attack immediately
	; (chat-local-to-self "WAFFLE: No attack timer. Commencing attack")
	(set-goal attack-timer YES)
	(disable-self)
)

; -----------------------------------------------------
; --- CHAPTER 3A: TL1 ATTACK READINESS
; -----------------------------------------------------

; T1 attack rules.
(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(goal attack-timer NO)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 25)
	(set-goal attack-timer YES)
)

(defrule
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(goal gremlinstate GREMLIN-ZERO)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal gremlinstate GREMLIN-ONE)
)

(defrule
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(goal gremlinstate GREMLIN-ONE)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 2)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal gremlinstate GREMLIN-TWO)
)

(defrule
	(current-age == tech-level-1)
	(or
		(goal openingstyle STYLE-RUSH)
		(goal openingstyle STYLE-DEFENSIVE)
	)
	(goal gremlintrick GREMLINTRICK-ACTIVE)
	(goal gremlinstate GREMLIN-TWO)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 3)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal gremlinstate GREMLIN-DONE)
	(set-goal gremlintrick GREMLINTRICK-DONE)
)

; RAID: split oversized prerequisite list
(defrule
	(true)
=>
	(set-goal raid-rule-check YES)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal aready YES))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (current-age == tech-level-1))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal attacksonhold-auto NO))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal attacksonhold-manual NO))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal attacksonhold-scn NO))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (shared-goal treatytimer 0) (shared-goal treatytimer 1)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (goal openingstyle STYLE-RUSH) (goal openingstyle STYLE-DEFENSIVE)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (goal gremlinstate GREMLIN-ONE) (or (goal gremlinstate GREMLIN-TWO) (goal gremlinstate GREMLIN-DONE))))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal raid-launch-open YES))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
=>
	(set-goal reasonforattack attack-is-me)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
	(set-goal opening-attack-target TARGET-WORKERS)
	(set-goal aready NO)
	(do-nothing) ; RAID diagnostics disabled
)



(defrule
	(current-age == tech-level-1)
	(timer-triggered t-attackgroup-alt)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(set-goal aready YES)
	(disable-timer t-attackgroup-alt) ; do not start the timer for another attack in T1
	; (chat-local-to-self "WAFFLE: T1 attack. Does not start timer")
	(set-goal attack-timer NO) ; and let it be restarted as needed
)
(defrule
	(current-age == tech-level-1) ; only way attacks fire in T1 like this is with taunt 31
	(timer-triggered t-attackgroup-alt)
	(unit-type-count-total UNIT-MOUNTED-LINE < 1)
	=>
	(set-goal messagestatus msg-NOMILITARY)
	(disable-timer t-attackgroup-alt)
	(set-goal attack-timer NO)
)

; one direct T1 shove for Rush so it does not sit on the first real little army
(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-RUSH)
	(unit-type-count-total UNIT-MOUNTED-LINE >= 1)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
=>
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal attack-timer YES)
	(disable-self)
)

; -----------------------------------------------------
; --- CHAPTER 3B: TL2 RUSH READINESS
; -----------------------------------------------------

; TL3 Knights join a normal combined wave instead of firing a ground-only pulse.
; The regular core/batch checks below can defer this request and retry it.
(defrule
	(current-age == tech-level-3)
	(goal padawanattack PADAWANATTACK-READY)
	(goal fortress-siege-hold NO)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(or (shared-goal treatytimer 0) (shared-goal treatytimer 1))
=>
	(set-goal holocroncollectionservices HOLOCRON-DISABLED)
	(set-goal reasonforattack attack-is-me)
	(set-goal aready YES)
	(set-goal padawanattack PADAWANATTACK-DONE)
)

; RAID: split oversized prerequisite list
(defrule
	(true)
=>
	(set-goal raid-rule-check YES)
)

(defrule
	(goal raid-rule-check YES)
	(not (not (current-age == tech-level-3)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal padawanattack PADAWANATTACK-READY))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal attacksonhold-auto NO))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal attacksonhold-manual NO))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal attacksonhold-scn NO))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (shared-goal treatytimer 0) (shared-goal treatytimer 1)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal raid-launch-open YES))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(goal fortress-siege-hold YES)
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
=>
	(set-goal holocroncollectionservices HOLOCRON-DISABLED)
	(set-goal reasonforattack attack-is-me)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 0)
	(set-strategic-number sn-percent-attack-boats 0)
	(attack-now)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(set-goal padawanattack PADAWANATTACK-DONE)
	(set-goal opening-attack-target TARGET-WORKERS)
	(do-nothing) ; RAID diagnostics disabled
)



; Experimental late-game Jedi pulse.
; Use one full ground-only attack-now when Masters appear. The previous tiny
; commander-selection pulse was too easy for the attack group builder to miss.
(defrule
	(current-age == tech-level-4)
	(goal jediattack JEDIATTACK-NO)
	(goal support-masters YES)
	(unit-type-count-total UNIT-MASTER-LINE >= 1)
	(or
		(shared-goal treatytimer 0)
		(shared-goal treatytimer 1)
	)
=>
	(set-goal holocroncollectionservices HOLOCRON-DISABLED)
	(set-goal attacksonhold-auto NO)
	(set-goal jediattack JEDIATTACK-READY)
)

(defrule
	(goal jediattack JEDIATTACK-READY)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal ground-pulse-open YES)
	(goal fortress-siege-hold NO)
=>
	(set-goal holocroncollectionservices HOLOCRON-DISABLED)
	(set-goal reasonforattack attack-is-me)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 0)
	(set-strategic-number sn-percent-attack-boats 0)
	(attack-now)
	(set-goal ground-release-state GROUND-COMMITTED)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(set-goal jediattack JEDIATTACK-DONE)
	(set-goal ground-pulse-open NO) ; consume this pass's direct-ground permission
)

; If the Master pulse did not create a real attack group, give it one bounded
; retry. This catches support units the generic attack builder missed without
; turning into a constant attack-now loop.
(defrule
	(current-age == tech-level-4)
	(goal jediattack JEDIATTACK-DONE)
	(goal support-masters YES)
	(unit-type-count-total UNIT-MASTER-LINE >= 1)
	(attack-soldier-count < 3)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(or
		(shared-goal treatytimer 0)
		(shared-goal treatytimer 1)
	)
=>
	(set-goal jediattack JEDIATTACK-RETRY)
)

(defrule
	(goal jediattack JEDIATTACK-RETRY)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal ground-pulse-open YES)
	(goal fortress-siege-hold NO)
=>
	(set-goal holocroncollectionservices HOLOCRON-DISABLED)
	(set-goal reasonforattack attack-is-me)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-air 0)
	(set-strategic-number sn-percent-attack-boats 0)
	(attack-now)
	(set-goal ground-release-state GROUND-COMMITTED)
	(set-strategic-number sn-percent-attack-air 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(set-goal jediattack JEDIATTACK-WAITING)
	(set-goal ground-pulse-open NO) ; consume this pass's direct-ground permission
)

(defrule
	(goal jediattack JEDIATTACK-WAITING)
	(unit-type-count-total UNIT-MASTER-LINE == 0)
=>
	(set-goal jediattack JEDIATTACK-NO)
)

; some T2 logic that probably needs to be loaded before other logic

; if rush is paused and reach T3
(defrule
	(current-age == tech-level-3)
	(goal rushsize RUSHHALT)
=>
	(set-goal rushsize NULL)
	; (chat-local-to-self "WAFFLE: T3 reached with HALT rushes. AT 180s, keep in mind onhold-auto")
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 180)
	(disable-self)
)

; stop rushing if walled (eg: arena)
(defrule
	(current-age == tech-level-2)
	(or
		(goal rushsize RUSHDONE)
		(goal rushsize RUSHCONTINUE)
	)
	(cc-players-building-type-count every-enemy BLDG-BARRIER-LINE >= 10)
=>
	(set-goal rushsize RUSHHALT)
	; (chat-local-to-self "WAFFLE: Everyone has walls. No more T2 rushes. AT 900s")
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 900)
	(disable-self)
)

; human override to continue rushing
(defrule
	(goal rushsize RUSHHALT)
	(goal reasonforattack attack-is-human)
=>
	(set-goal rushsize RUSHCONTINUE)
)




; MODERATE SPECIFIC LOGIC
; become Sleepy and do not attack immediately
#load-if-defined DIFFICULTY-MODERATE

(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize SMOL)
		(military-population >= 7) 
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20) ; give time for scenario to set in 
	=>
	; (chat-local-to-self "WAFFLE: T2 RUSH SMOL. MOD, SLEEPING FOR 240s")
	(set-goal rushsize RUSHSLEEPY)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 240)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize NORM)
		(military-population >= 10)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
	=>
	; (chat-local-to-self "WAFFLE: T2 RUSH NORM. MOD, SLEEPING FOR 240s")
	(set-goal rushsize RUSHSLEEPY)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 240)
	(disable-self)
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(or
		(goal rushsize RUSHSLEEPY) ; sleepy or woke up
		(goal rushsize RUSHWAKEUP)
	)
	(current-age == tech-level-2)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
=>
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me) ; ensures no silliness on message
	(set-goal rushsize RUSHHALT) ; stop rushing, go defensive, no more research etc
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 600)
	(set-goal attack-timer YES)	
	; (chat-local-to-self "WAFFLE: Mod, attacking.  AT 900s") ; in a regular game, this means rush once
	(disable-self) ; once-off rule to start the rush
)

; n.b. I expect this rule to almost never fire
; the only cases where it can do so are:
; manual human order 
; extremely long T2 fights
; it won't trigger on an ally AI joinin because that requires rushcontinue which is not set here
(defrule
	(timer-triggered t-attackgroup-alt)
	(current-age == tech-level-2)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
=>
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 600)
	; (chat-local-to-self "WAFFLE: Mod, attacking.  AT 600s")
)

(defrule
	(town-under-attack)
	(goal rushsize RUSHSLEEPY)
=>
	(set-goal rushsize RUSHWAKEUP) ; allows training more military units again
)

#end-if

; HARD AND HARDEST RUSH RULES
#load-if-not-defined DIFFICULTY-MODERATE

; T2 attacks
; begin a rush. setting of rushsize is above
; we tried defend-soldier-count which worked better but mostly worked worse because this would never fire as the AI was continually being called by its ally to attack
(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize SMOL)
		(military-population >= 7) 
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20) ; give time for scenario to set in 
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150) ; short to try and get the AI to reinforce
	; (chat-local-to-self "WAFFLE: T2 RUSH SMOL. AT 150s")
	(set-goal rushsize RUSHDONE)
	(set-goal attack-timer YES)
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me) ; ensures no silliness on message
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize NORM)
		(military-population >= 11)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150) ; short to try and get the AI to reinforce
	; (chat-local-to-self "WAFFLE: T2 RUSH NORM. AT 150s")
	(set-goal rushsize RUSHDONE)
	(set-goal aready YES)
	(set-goal attack-timer YES)
	(set-goal reasonforattack attack-is-me) ; ensures no silliness on message
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(and
		(goal rushsize BIG)
		(military-population >= 15)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(game-time > 20)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150) ; short to try and get the AI to reinforce
	; (chat-local-to-self "WAFFLE: T2 RUSH BIG. AT 150s")
	(set-goal rushsize RUSHDONE)
	(set-goal aready YES)
	(set-goal attack-timer YES)
	(set-goal reasonforattack attack-is-me) ; ensures no silliness on message
	(disable-self)
)

; what happens after a rush
; hard: 67% chance to continue rush
#load-if-defined DIFFICULTY-HARD
(defrule
	(current-age == tech-level-2)
	(goal rushsize RUSHDONE)
=>
	(generate-random-number 3)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(goal rushsize RUSHDONE)
	(random-number == 1)
=>
	(set-goal rushsize RUSHHALT)
	; (chat-local-to-self "WAFFLE: Hard 33%: No more T2 rush attacks. Attack timer set to 900s")
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 900)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(goal rushsize RUSHDONE)
	(not (random-number == 1))
=>
	(set-goal rushsize RUSHCONTINUE)
	; (chat-local-to-self "WAFFLE: Hard 67%: Continue rushing as usual")
	(disable-self)
)
#end-if

; hardest: always continue rushing
#load-if-defined DIFFICULTY-HARDEST
(defrule
	(current-age == tech-level-2)
	(goal rushsize RUSHDONE)
=>
	(set-goal rushsize RUSHCONTINUE)
	(disable-self)
)
#end-if

; so when the attack timer runs out, it will try to reinforce:

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(defend-soldier-count > 5) ; if we have reinforcements
	(attack-soldier-count > 3) ; and the attack group is still alive
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150) ; short to try and get the AI to reinforce
	; (chat-local-to-self "WAFFLE: T2 attack reinforce. AT 150s")
	(set-goal aready YES) ; whichever message is used here can and should depend
)

; if the attack group is dead; 

; then two cases happen
; a) we do not have enough defending soldiers, go on cooldown
; b) we do have enough defending soldiers, go on the attack

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(or
		(defend-soldier-count >= 9)         ; if we have plenty of spare soldiers at home
		(and
			(goal reasonforattack attack-is-AI)
			(defend-soldier-count >= 7) ; allow if fewer soldiers but an ally AI joinin
		)
	)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 150) ; short to try and get the AI to reinforce
	; (chat-local-to-self "WAFFLE: T2 rush dead soldiers home . AT 150s")
	(set-goal aready YES)
)

; anything else
; major case when this fires: if an attack has already been sent off
; defend soldier count is like 0-1 despite military population being high because it's all in the attack force
; there are no reinforcements to send
; so going on cooldown still makes sense

; if a human called them in and none of the above have triggered so far, bypass nearly all the time

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(military-population >= 3)
	(goal reasonforattack attack-is-human)
	=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 150)
	(set-goal aready YES)
)

(defrule
	(current-age == tech-level-2) 
	(timer-triggered t-attackgroup-alt)
	(military-population <= 3)
	(goal reasonforattack attack-is-human)
	=>
	(set-goal messagestatus msg-NOMILITARY)
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 270) ; go on cooldown
	(set-goal aready NO)
	(set-goal reasonforattack attack-is-me) ; clear
)

(defrule
	(current-age == tech-level-2)
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 270) ; go on cooldown
	; (chat-local-to-self "WAFFLE: T2 Army is probably dead. NOTATTACK. 270s cooldown.")
	(set-goal aready NO)
	(set-goal reasonforattack attack-is-me) ; clear
)



#end-if ; of if moderate




; -----------------------------------------------------
; --- CHAPTER 3C: TL3/TL4 ATTACK READINESS
; -----------------------------------------------------

; higher tech levels are much simpler to get your head around
; moderate uses this logic too 

(defrule
	(current-age == tech-level-3)
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal fortress-siege-hold NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 540) ; wait just a bit
	; (chat-local-to-self "WAFFLE: T3 Attack. AT 540s")
	(set-goal aready YES)
)

(defrule
	(current-age == tech-level-4)
	(timer-triggered t-attackgroup-alt)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal fortress-siege-hold NO)
	=>
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 720) ; was 540 which behaves better, HOWEVER TSA logic usually kicks which has its own timers so this is essentially a lower-force attack
	; (chat-local-to-self "WAFFLE: T4 Attack. AT 720s")
	(set-goal aready YES)
)


; so now that we have Town Size Attack
; what we want is the following
; a) population reaches maximum. begin TSA. hold until further notice 
; a-i) if timer triggered - which could be regular attack timer or a joinin - begin TSA just the same
; b) if population drops below 225 or whatever the constant is, put TSA on a 5-ish min timer and continue to hold
; c) after 10min of TSA-ing, stop and wait for maximum population again

; HOWEVER
; keep in mind maximium population does not neccessarily occur on Moderate as lategame comp is disabled 
; on Moderate, therefore we should stick to the 10min timer attack but for TSA - essentially, its own logic

#load-if-not-defined DIFFICULTY-MODERATE ; give players a break

(defrule
	(population >= popcap)
	(goal attackTSAhold EXHAUSTED)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal attacktype TSA)
	(goal fortress-siege-hold NO)
	(goal attack-strength-hold NO)
=>
	(set-goal aready YES) ; is what sends an attack off
	; (chat-local-to-self "WAFFLE: Pop cap reached. TSA ON")
)
; for max pop attacks that are NOT under TSA

(defrule
	(population >= popcap)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(goal attacktype NORM)
	(goal maxpopattack ALLOW)
	(goal fortress-siege-hold NO)
=>
	(set-goal aready YES) ; is what sends an attack off
	(set-goal maxpopattack SENTOFF) ; stop this from firing again
	(disable-timer t-attackgroup-alt)
    (enable-timer t-attackgroup-alt 120)
	; (chat-local-to-self "WAFFLE: Maxpop. AT 120s")
)
#end-if

; If idle military is piling up, launch an attack even before popcap.
; This relieves base clutter without using sn-task-ungrouped-soldiers.
; This currently bypasses attacksonhold-auto, so tech-switch holds can be broken
; by a large idle army. Add attacksonhold-auto NO here if that proves harmful.
(defrule
	(current-age >= tech-level-3)
	(goal openingstyle STYLE-DEFENSIVE)
	(military-population >= 18)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(not (goal maxpopattack SENTOFF))
	(goal fortress-siege-hold NO)
=>
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal maxpopattack SENTOFF)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 180)
	; (chat-local-to-self "WAFFLE: Defensive military pop >= 18. Pressure attack. AT 180s")
)

(defrule
	(military-population >= 12)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(not (goal maxpopattack SENTOFF))
	(goal fortress-siege-hold NO)
=>
	(set-goal aready YES)
	(set-goal reasonforattack attack-is-me)
	(set-goal maxpopattack SENTOFF)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 240)
	; (chat-local-to-self "WAFFLE: Military pop >= 12. Pressure attack. AT 240s")
)

; chat to humans to say we should attack if on hold
(defrule
	(population >= popcap)
	(not (goal maxpopattack PLEASECONFIRM))
	(goal attacksonhold-manual YES)
	(goal attacksonhold-scn NO)
=>
	(set-goal maxpopattack PLEASECONFIRM)
	(set-goal messagestatus msg-MAXPOP)
)



#load-if-not-defined DIFFICULTY-MODERATE

; gremlin mountie on Hard/Hardest

(defrule
	(unit-type-count UNIT-MOUNTED-LINE > 0)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(current-age == tech-level-1)
	(game-time > 20) ; give time for scenario effects to trigger if needed
=>
	(set-goal aready YES)
	(disable-self)
)


#end-if
#end-if
#end-if

; -----------------------------------------------------
; --- CHAPTER 4B: SWITCHING BETWEEN NORMAL ATTACK AND TSA
; -----------------------------------------------------

(defrule
	(population >= 120)
	(military-population >= 40)
	(not (goal attacktype TSA))
=>
	(set-goal attacktype TSA)
)

(defrule
	(not (and
	(population >= 120)
	(military-population >= 40)
	)	) ; aka not the above
	(not (goal attacktype NORM	))
=>
	(set-goal attacktype NORM)
)


; -----------------------------------------------------
; --- CHAPTER 5A: REGULAR ATTACK EXECUTION
; -----------------------------------------------------

; THE CORE OF IT ALL
; When aready is YES, execute the attack. Different TLs keep separate rules
; because each age used to tune town size differently.

; 22410 was 
; 	(chat-to-player-using-id any-computer-ally 22410)      ;sends taunt 200 to summon them in
; but we can just do this without ID and also pick a better taunt; 234 "Get in there you big furry oaf! I don't care what you smell!"

; Clear queued attacks during treaty before any regular attack execution.

(defrule
	(not 
		(or
			(shared-goal treatytimer 0) ; treaty timer was never turned on
			(shared-goal treatytimer 1) ; treaty timer expired
		) 
	)
	(goal aready YES)
=>
	(set-goal aready NO)
)

; Keep the older TL3 reinforcement check on ASTEROID only.
; WATER gates just the ground commitment below, so it cannot stall the fleet.
; LAND/HYBRID use the broader TL3/TL4 spare-batch gate before CHITCHAT.
; Retry in 30 game seconds so a small batch does not wait a full attack interval.
(defrule
	(current-age == tech-level-3)
	(goal aready YES)
	(goal attacktype NORM)
	(not (goal combat-arm AIR))
	(not (goal combat-arm SEA))
	(attack-soldier-count > 0)
	(goal openingstyle STYLE-RUSH)
	(defend-soldier-count < 8)
	(goal special-map ASTEROID)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

(defrule
	(current-age == tech-level-3)
	(goal aready YES)
	(goal attacktype NORM)
	(not (goal combat-arm AIR))
	(not (goal combat-arm SEA))
	(attack-soldier-count > 0)
	(goal openingstyle STYLE-AGGRESSIVE)
	(defend-soldier-count < 11)
	(goal special-map ASTEROID)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

(defrule
	(current-age == tech-level-3)
	(goal aready YES)
	(goal attacktype NORM)
	(not (goal combat-arm AIR))
	(not (goal combat-arm SEA))
	(attack-soldier-count > 0)
	(goal openingstyle STYLE-DEFENSIVE)
	(defend-soldier-count < 16)
	(goal special-map ASTEROID)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

(defrule
	(true)
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(current-age == tech-level-3)
	(goal attacktype NORM)
	(or (not (goal special-map LAND)) (goal combat-arm AIR))
	(not (goal special-map WATER))
=>
	(set-goal raid-rule-check YES)
)

; TL3 core composition checks. Completed counts exclude queued production.
; Subtract a conservative upper bound for ALL attackers in the same domain:
; e.g. 1-4 attacking ground units require 8 owned Strike Mechs to prove 4 spare.
; Bands increase by 4 through 32 attackers, 8 through 64, 16 through 128,
; and 32 through 256. Five attackers need 12 core units; 17 need 24.
; This can wait longer when attackers are mixed; it never credits them twice.
; Troop lineups need four Lasers OR four Mounties. AIR needs four Fighters.
; Percent allocation still applies afterwards. These are composition minimums,
; not a guarantee of escorts or positioning. TSA and TL4 keep their own behavior.
; Very small population caps retain their existing attack behavior.
#load-if-not-defined POPULATION-CAP-25
#load-if-not-defined POPULATION-CAP-50

; Strike Mechs: require at least four completed core units outside attack groups.
(defrule
	(current-age == tech-level-3)
	(goal aready YES)
	(goal raid-rule-check YES)
	(or
		(goal combat-arm STRIKE/HW)
		(or (goal combat-arm MECHBALL) (goal combat-arm DEATHBALL))
	)
	(attack-soldier-count <= 0)
	(unit-type-count UNIT-MECH1-LINE < 4)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

