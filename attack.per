(defrule
	(current-age == tech-level-1)
	(goal raid-worker-memory 0)
=>
	(set-strategic-number sn-ignore-attack-group-under-attack 0)
)

(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-1)
	(not (goal raid-worker-memory 0))
=>
	(set-strategic-number sn-ignore-attack-group-under-attack 1)
)

(defrule
	(current-age >= tech-level-2)
=>
	(set-strategic-number sn-ignore-attack-group-under-attack 0)
)

(defrule
	(not (goal special-map WATER))
	(current-age <= tech-level-2)
=>
	(set-strategic-number sn-special-attack-type2 UNIT-WORKER)
	(set-strategic-number sn-special-attack-influence2 2147483647)
)

; Attack orchestration for regular games.

; TABLE OF CONTENTS
; Chapter 1: Setup and attack holds
; Chapter 2: Difficulty attack timers
; Chapter 3: Rush and regular attack readiness
; Chapter 4: Max-pop pressure and TSA selection
; Chapter 5: Attack execution and TSA control
; Chapter 6: Ally/human attack commands
; Chapter 7: Center/monument/scenario commands

; t-attackgroup-alt is the regular attack/join-in timer.
; t-attackgroup-hold is the TSA hold timer. They stay separate because a join-in
; can arrive while TSA is already holding town size.

; -----------------------------------------------------
; --- CHAPTER 1A: INITIAL ATTACK GOALS
; -----------------------------------------------------

(defrule
	(true)
=>
	(set-goal attacksonhold-auto NO)								; locks attacks when researching techs
	(set-goal attacksonhold-manual NO)								; locks attacks and prevents new attacks, from taunt 36, only cleared with taunt 31
	(set-goal attacksonhold-scn NO)									; idem but scenario
	(set-goal maxpopattack TOOLOWPOP)								; overrides regular attack system with max pop attack system
	(set-strategic-number sn-gather-idle-soldiers-at-center 0)		; used for center gather taunt 185
	(set-goal center-override NO)									; idem
	(set-goal attacktype NORM)										; used for switching between attack now and town size attack
	(set-goal attackTSAlevel 0)										; needed to initialize
	(set-goal attackTSAhold EXHAUSTED)								; what TSA is up to
	(set-goal attackTSAvar NULL)									; starting value so the logic doesn't break
	(set-goal reasonforattack attack-is-me)							; helps organize chatting
	(set-goal opening-attack-target TARGET-UNROLLED)
	(disable-self)
)

; Scenario attack hold needs to run before any attack execution rules.
(defrule
	(event-detected trigger 2)
	(goal attacksonhold-scn NO)
=>
	(set-goal attacksonhold-scn YES)
	(set-goal attack-timer YES)
	(disable-timer t-attackgroup-alt)
	(disable-self)
)

; openingstyle is selected by load-random in randomgame.per.
; The selected personality file then sets openingstyle itself.

(defrule
	(goal opening-announced NO)
	(goal openingstyle STYLE-AGGRESSIVE)
=>
	(set-goal rushsize NORM)
	(generate-random-number 10)
	(set-goal opening-announced YES)
)

(defrule
	(goal opening-announced NO)
	(goal openingstyle STYLE-DEFENSIVE)
=>
	(set-goal rushsize SMOL)
	(generate-random-number 10)
	(set-goal opening-announced YES)
)

(defrule
	(goal opening-announced NO)
	(goal openingstyle STYLE-RUSH)
=>
	(set-goal rushsize BIG)
	(generate-random-number 10)
	(set-goal opening-announced YES)
)

(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-3)
	(or
		(not (strategic-number sn-special-attack-type2 == UNIT-WORKER))
		(not (strategic-number sn-special-attack-influence2 == 2147483647))
	)
=>
	(set-strategic-number sn-special-attack-type2 UNIT-WORKER)
	(set-strategic-number sn-special-attack-influence2 2147483647)
	(set-goal opening-attack-target TARGET-WORKERS)
)

; From TL4 onward, use special targeting to punish high-value threats first.
; If those are not present, crack AA/power so follow-up groups have cleaner
; paths instead of spending the whole attack on random fogged buildings.
(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-4)
	(players-unit-type-count any-enemy UNIT-MECH3-LINE > TL4-mech3-arm-p1)
	(or
		(not (strategic-number sn-special-attack-type2 == UNIT-MECH3-LINE))
		(not (strategic-number sn-special-attack-influence2 == 2147483647))
	)
=>
	(set-strategic-number sn-special-attack-type2 UNIT-MECH3-LINE)
	(set-strategic-number sn-special-attack-influence2 2147483647)
)

(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-4)
	(players-unit-type-count any-enemy UNIT-MECH3-LINE <= TL4-mech3-arm-p1)
	(cc-players-unit-type-count any-enemy SIEGE-ARTILLERY-LINE > TL4-artillery-arm-p1)
	(or
		(not (strategic-number sn-special-attack-type2 == SIEGE-ARTILLERY-LINE))
		(not (strategic-number sn-special-attack-influence2 == 2147483647))
	)
=>
	(set-strategic-number sn-special-attack-type2 SIEGE-ARTILLERY-LINE)
	(set-strategic-number sn-special-attack-influence2 2147483647)
)

(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-4)
	(players-unit-type-count any-enemy UNIT-MECH3-LINE <= TL4-mech3-arm-p1)
	(cc-players-unit-type-count any-enemy SIEGE-ARTILLERY-LINE <= TL4-artillery-arm-p1)
	(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE > TL4-attacker-arm-p1)
	(or
		(not (strategic-number sn-special-attack-type2 == UNIT-ATTACKER-LINE))
		(not (strategic-number sn-special-attack-influence2 == 2147483647))
	)
=>
	(set-strategic-number sn-special-attack-type2 UNIT-ATTACKER-LINE)
	(set-strategic-number sn-special-attack-influence2 2147483647)
)

(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-4)
	(players-unit-type-count any-enemy UNIT-MECH3-LINE <= TL4-mech3-arm-p1)
	(cc-players-unit-type-count any-enemy SIEGE-ARTILLERY-LINE <= TL4-artillery-arm-p1)
	(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE <= TL4-attacker-arm-p1)
	(cc-players-building-type-count any-enemy BLDG-MISSILE-LINE > 0)
	(or
		(not (strategic-number sn-special-attack-type2 == BLDG-MISSILE-LINE))
		(not (strategic-number sn-special-attack-influence2 == 2147483647))
	)
=>
	(set-strategic-number sn-special-attack-type2 BLDG-MISSILE-LINE)
	(set-strategic-number sn-special-attack-influence2 2147483647)
)

(defrule
	(not (goal special-map WATER))
	(current-age == tech-level-4)
	(players-unit-type-count any-enemy UNIT-MECH3-LINE <= TL4-mech3-arm-p1)
	(cc-players-unit-type-count any-enemy SIEGE-ARTILLERY-LINE <= TL4-artillery-arm-p1)
	(cc-players-unit-type-count any-enemy UNIT-ATTACKER-LINE <= TL4-attacker-arm-p1)
	(cc-players-building-type-count any-enemy BLDG-MISSILE-LINE == 0)
	(cc-players-building-type-count any-enemy BLDG-POWERCORE > 0)
	(or
		(not (strategic-number sn-special-attack-type2 == BLDG-POWERCORE))
		(not (strategic-number sn-special-attack-influence2 == 2147483647))
	)
=>
	(set-strategic-number sn-special-attack-type2 BLDG-POWERCORE)
	(set-strategic-number sn-special-attack-influence2 2147483647)
)

; TL1/TL2 opening attacks roll a building target, weighted toward carbon, then
; swap back to workers after the first attack is launched.






; Restore worker targeting after the opening building-target attack launches.
; Keeping this separate prevents the TL1/TL2 attack launchers from exceeding
; the rule-size limit.
(defrule
	(not (goal special-map WATER))
	(current-age <= tech-level-2)
	(goal opening-attack-target TARGET-WORKERS)
=>
	(set-strategic-number sn-special-attack-type2 UNIT-WORKER)
	(set-strategic-number sn-special-attack-influence2 2147483647)
	(disable-self)
)

; WATER shares LAND's intelligent attacks and response to incoming fire, but
; its fleet and landing force cannot share a forced land/air object preference.
; Leave distance/reachability evaluation to the engine. Clear both values every
; pass so changing age or losing a preferred target cannot leave a stale bias.
; Do not replace this with a global boat preference: it also affects land troops.
(defrule
	(goal special-map WATER)
=>
	(set-strategic-number sn-special-attack-type2 -1)
	(set-strategic-number sn-special-attack-influence2 0)
	(set-strategic-number sn-attack-intelligence 1)
	(set-strategic-number sn-ignore-attack-group-under-attack 0)
)

; Initial strength gate: AoC facts only, no diplomacy or target override.
; Apply only to TL3+ LAND with exactly one active enemy. With several enemies,
; AoC cannot reliably expose the engine's selected target, so leave attacks alone.
; Recompute the opponent and population band each pass; preserve the hold between
; passes for hysteresis. The small-enemy bypass comes from the population package.
; Bands approximate 70% to hold and 85% to release. They count unseen troops too.
; This is total military population, not a simulation of the available field army.
#load-if-not-defined MONUMENT-RACE
(defrule
	(true)
=>
	(set-goal attack-strength-hold NO)
	(set-goal attack-strength-debug-phase 0)
	(set-goal attack-batch-debug-phase 0)
	(disable-self)
)
(defrule
	(true)
=>
	(set-goal attack-strength-opponent 0)
	(set-goal attack-strength-band 0)
)
