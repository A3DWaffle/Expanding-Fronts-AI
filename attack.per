; TL2 ground batches use the population package's smaller wave target
; after personality allocation (100/75/50 percent). Total military includes
; troops already deployed and cannot prove a spare reinforcement batch.
(defrule
	(current-age == tech-level-2)
	(goal aready YES)
	(goal attacktype NORM)
	(or (goal special-map LAND) (goal special-map HYBRID))
	(not (goal combat-arm AIR))
	(not (goal combat-arm SEA))
	(goal openingstyle STYLE-RUSH)
	(defend-soldier-count < land-tl2-wave-rush)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

(defrule
	(current-age == tech-level-2)
	(goal aready YES)
	(goal attacktype NORM)
	(or (goal special-map LAND) (goal special-map HYBRID))
	(not (goal combat-arm AIR))
	(not (goal combat-arm SEA))
	(goal openingstyle STYLE-AGGRESSIVE)
	(defend-soldier-count < land-tl2-wave-aggressive)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

