)


; -----------------------------------------------------
; --- CHAPTER 7C: MONUMENT AND HOLOCRON TARGETS
; -----------------------------------------------------

; one of the few pieces of the original attack script that made sense

#load-if-not-defined VICTORY-CONQUEST
;kill the wonder!

(defrule
        (or
                (cc-players-building-type-count any-enemy BLDG-MONUMENT > 0)
                (cc-players-building-type-count any-neutral BLDG-MONUMENT > 0)
        )
        =>
        (set-strategic-number sn-special-attack-type3 1)
)

(defrule
        (enemy-captured-holocrons)
        =>
        (set-strategic-number sn-special-attack-type1 1)
)

(defrule
		(and
			(cc-players-building-type-count any-enemy BLDG-MONUMENT == 0)
			(and
				(cc-players-building-type-count any-neutral BLDG-MONUMENT == 0)
				(not (enemy-captured-holocrons) )
			)
		)
        =>
        (set-strategic-number sn-special-attack-type1 0)
)

#load-if-not-defined TEAMS-LOCKED
(defrule
		(cc-players-building-type-count any-neutral BLDG-MONUMENT > 0)
        =>
        (set-stance this-any-neutral enemy)
)

#end-if
#end-if

; RAID EXPERIMENT: allocation and tracking.
(defrule
	(current-age == tech-level-1)
	(goal raid-phase 0)
	(attack-soldier-count > 0)
=>
	(set-goal raid-phase 1)
	(do-nothing) ; RAID diagnostics disabled
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
=>
	(set-goal aready NO)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-gather-defense-units 1)
)



(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-AGGRESSIVE)
=>
	(set-strategic-number sn-number-attack-groups 1)
)

(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-AGGRESSIVE)
	(goal attacksonhold-auto NO)
	(goal attacksonhold-manual NO)
	(goal attacksonhold-scn NO)
	(or (shared-goal treatytimer 0) (shared-goal treatytimer 1))
	(defend-soldier-count >= TL2-trooper-core-p1)
	(goal raid-cooldown 0)
=>
	(set-goal aready YES)
	(set-goal raid-cooldown 6)
)
