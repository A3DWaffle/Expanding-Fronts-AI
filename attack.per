	(event-detected trigger 14)
	(player-number 4)
=>
	(set-goal aready YES) 
	(acknowledge-event trigger 14)
)
(defrule
	(event-detected trigger 15)
	(player-number 5)
=>
	(set-goal aready YES) 
	(acknowledge-event trigger 15)
)
(defrule
	(event-detected trigger 16)
	(player-number 6)
=>
	(set-goal aready YES) 
	(acknowledge-event trigger 16)
)
