(defrule
	(event-detected trigger 2)
	(goal attacksonhold-scn NO)
=>
	(set-goal attacksonhold-scn YES)	; should bypass all attack logic if I got them all 
	(set-goal attack-timer YES) 		; causes other thingymajigies to not fire
	(disable-timer t-attackgroup-alt)
	(disable-self)
)



(defrule
	(event-detected trigger 11)
	(player-number 1)
=>
	(set-goal aready YES) ; send an attack
	(acknowledge-event trigger 11)
)

