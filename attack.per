; Temporary playtest messages: one hold and one clear per AI per match.
; Do not say an attack launched: independent siege/readiness checks still apply.
(defrule
	(goal attack-strength-debug-phase 0)
	(goal attack-strength-hold YES)
=>
	(chat-to-all "ATTACK STRENGTH: LOWER - HOLD")
	(chat-local "ATTACK STRENGTH: LOWER - HOLD")
	(set-goal attack-strength-debug-phase 1)
)

(defrule
	(goal attack-strength-debug-phase 1)
	(goal attack-strength-hold NO)
=>
	(chat-to-all "ATTACK STRENGTH: RECOVERED - CLEAR")
	(chat-local "ATTACK STRENGTH: RECOVERED - CLEAR")
	(set-goal attack-strength-debug-phase 2)
)
#end-if

; Remember observed enemy Fortresses and recompute siege readiness each pass.
#load-if-not-defined MONUMENT-RACE
(defrule
	(goal enemy-fortress-seen NO)
	(players-building-type-count any-enemy BLDG-GOVTCTR > 0)
=>
	(set-goal enemy-fortress-seen YES)
)

(defrule
	(true)
=>
	(set-goal fortress-siege-hold NO)
)

(defrule
	(current-age >= tech-level-3)
	(goal enemy-fortress-seen YES)
=>
	(set-goal fortress-siege-hold YES)
)

(defrule
	(goal fortress-siege-hold YES)
	(current-age == tech-level-3)
	(goal special-map LAND)
	(unit-type-count SIEGE-ARTILLERY-LINE >= TL3-artillery-core-p2)
=>
	(set-goal fortress-siege-hold NO)
)

(defrule
	(goal fortress-siege-hold YES)
	(current-age == tech-level-3)
	(goal special-map WATER)
	(unit-type-count SIEGE-ARTILLERY-LINE >= TL3-artillery-core-p2-water)
=>
	(set-goal fortress-siege-hold NO)
)

(defrule
	(goal fortress-siege-hold YES)
	(current-age == tech-level-3)
	(goal special-map ASTEROID)
	(unit-type-count SIEGE-ARTILLERY-LINE >= TL3-artillery-core-p2-asteroid)
=>
	(set-goal fortress-siege-hold NO)
)

(defrule
	(goal fortress-siege-hold YES)
	(current-age == tech-level-3)
	(goal special-map HYBRID)
	(unit-type-count SIEGE-ARTILLERY-LINE >= TL3-artillery-core-p2-hybrid)
=>
	(set-goal fortress-siege-hold NO)
)

(defrule
	(goal fortress-siege-hold YES)
	(current-age == tech-level-4)
	(goal special-map LAND)
	(or
		(unit-type-count SIEGE-CANNON-LINE >= TL4-cannon-arm-p2)
		(unit-type-count SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2)
	)
=>
	(set-goal fortress-siege-hold NO)
)

(defrule
	(goal fortress-siege-hold YES)
	(current-age == tech-level-4)
	(goal special-map WATER)
	(or
		(unit-type-count SIEGE-CANNON-LINE >= TL4-cannon-arm-p2-water)
		(unit-type-count SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2-water)
	)
=>
	(set-goal fortress-siege-hold NO)
)

(defrule
	(goal fortress-siege-hold YES)
	(current-age == tech-level-4)
	(goal special-map ASTEROID)
	(or
		(unit-type-count SIEGE-CANNON-LINE >= TL4-cannon-arm-p2-asteroid)
		(unit-type-count SIEGE-ARTILLERY-LINE >= TL4-artillery-arm-p2-asteroid)
