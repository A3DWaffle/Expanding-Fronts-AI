)

; Final LAND composition/recovery vetoes run before batch debug and ally signals.
; Keep existing readiness queued through the regular 30-second retry path.
(defrule
	(goal land-attack-policy YES)
	(goal aready YES)
	(goal ground-release-state GROUND-CORE-LOW)
	(goal attack-batch-debug-phase 0)
=>
	(chat-to-all "ATTACK GROUP: CORE LOW - WAIT")
	(chat-local "ATTACK GROUP: CORE LOW - WAIT")
	(set-goal attack-batch-debug-phase 1)
)

(defrule
	(goal land-attack-policy YES)
	(goal aready YES)
	(goal ground-release-state GROUND-CORE-LOW)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

(defrule
	(goal ground-release-state GROUND-REBUILDING)
	(goal aready YES)
=>
	(set-goal aready NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 30)
)

; TL3/TL4 LAND/HYBRID spare ground batches, including initial TSA starts.
; Committed wave sizes and personality allocations come from population packages.
; Total military and troops already attacking do not satisfy this check.
#load-if-not-defined MONUMENT-RACE
(defrule
	(current-age >= tech-level-3)
