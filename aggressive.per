; =====================================================
; FILE: AGGRESSIVE
; PURPOSE:
;   Aggressive personality overlay for opening posture and attack thresholds.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: LOGIC
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(goal openingstyle UNDEFINED)
=>
	(set-goal openingstyle STYLE-AGGRESSIVE)
	(set-goal passiveage NO)
	(disable-self)
)

(defrule
	(goal openingstyle STYLE-AGGRESSIVE)
	(not (goal passiveage NO))
=>
	(set-goal passiveage NO)
)

(defrule
	(current-age >= tech-level-2)
	(goal openingstyle STYLE-AGGRESSIVE)
	(goal attacksonhold-auto YES)
	(military-population >= 4)
=>
	(set-goal attacksonhold-auto NO)
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 15)
)
