; =====================================================
; FILE: ore
; PURPOSE:
;   Builds ore processing centers and tracks ore resource availability.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: ORE CTR
;	Chapter 2: RESOURCE-FOUND
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(cc-players-unit-type-count 0 GAIA-ORE-LINE >= 6) ; this has several issues detailed elsewhere but does work at game start
=>
	(set-goal ore-found YES)
	(disable-self)
)

; -----------------------------------------------------
; *** Chapter 1: ORE CTR *** 
; -----------------------------------------------------

; TL1 Defensive rule: get the ore proc online early so the ore-opening is real.
(defrule
	(current-age == tech-level-1)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPMETAL < 1)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(can-build-with-escrow BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund cmetalproc)
	(build BLDG-DROPMETAL)
)

; T2 rule: Defensive is the only personality that should force early ore processing.
(defrule
	(current-age == tech-level-2)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPMETAL < 1)
	(or
		(and
			(building-type-count-total BLDG-TRAINTROOPER > 0) ; get these buildings up first (if you haven't already)
			(building-type-count-total BLDG-POWERCORE > 0 )
		)
		(carbon-amount > 400) ; override
	)
	;(dropsite-min-distance metal > 4)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cmetalproc)
	(build BLDG-DROPMETAL)
)

; T3+ rule
(defrule
	(current-age >= tech-level-3)
	(goal camplevel 2)
	(building-type-count-total BLDG-DROPMETAL < 3)
	(goal ore-found YES) ; checks several things
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance metal > 7)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cmetalproc)
	(build BLDG-DROPMETAL)
)

(defrule
	(current-age >= tech-level-3)
	(goal camplevel 3)
	(building-type-count-total BLDG-DROPMETAL < 5)
	(goal ore-found YES)
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance metal > 7)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cmetalproc)
	(build BLDG-DROPMETAL)
)

(defrule
	(current-age >= tech-level-3)
	(goal camplevel 4)
	(building-type-count-total BLDG-DROPMETAL < 7)
	(goal ore-found YES)
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance metal > 7)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cmetalproc)
	(build BLDG-DROPMETAL)
)

(defrule
	(current-age >= tech-level-3)
	(goal camplevel 5)
	(building-type-count-total BLDG-DROPMETAL < 9)
	(goal ore-found YES)
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance metal > 7)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cmetalproc)
	(build BLDG-DROPMETAL)
)

(defrule
	(current-age >= tech-level-3)
	(and
		(goal camplevel 6)
		(building-type-count-total BLDG-DROPMETAL < 12)  
	)
	(goal ore-found YES)
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance metal > 7)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cmetalproc)
	(build BLDG-DROPMETAL)
)


(defrule
    ; Beamdrill Mining Ore
	(or
		(current-age >= tech-level-3)
		(and
			(current-age == tech-level-2)
			(goal agingup YES)
		)
	)
	(can-research rt-beamdrill-metal)
	(or
		(goal agingup YES)
		(food-amount > 800)
	)
=>
	(research rt-beamdrill-metal) ; allow researching without escrow if affordable
)

(defrule
    ; Beamdrill Mining Ore ALT
	(or
		(current-age >= tech-level-3)
		(and
			(current-age == tech-level-2)
			(goal agingup YES)
		)
	)
    (can-research-with-escrow rt-beamdrill-metal)
=>
	(release-escrow food)
	(release-escrow carbon)
    (research rt-beamdrill-metal)
)

(defrule
    ; Beamdrill Mining Ore, TL3
    (current-age >= tech-level-3)
    (can-research-with-escrow rt-heavy-beamdrill-metal)
=>
	(release-escrow food)
	(release-escrow carbon)
    (research rt-heavy-beamdrill-metal)
)

(defrule        
    ; TF Fusion Extractor Ore, TL4
    (current-age >= tech-level-4)
    (can-research-with-escrow rt-fusion-extractor)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow carbon)
    (research rt-fusion-extractor)
)

; -----------------------------------------------------
; *** Chapter 2: RESOURCE-FOUND *** 
; -----------------------------------------------------

; turn off once either too far or none on map
(defrule
	(not (goal ore-found NO))
	(dropsite-min-distance metal >= 70) ; too far
=>
	(set-goal ore-found NO)
)

(defrule
	(not (goal ore-found NO))
	(dropsite-min-distance metal == -1) ; not found
	(game-time > 1800) ; 30min 
=>
	(set-goal ore-found NO)
)

(defrule
	(goal ore-found NO)
	(building-type-count BLDG-DROPMETAL > 1)
=>
	(delete-building BLDG-DROPMETAL)
)

; ordering is a little awkward, but bear with me here: 

; rule 1: check for ore on game start. if so, we find ore. already done above

; rule 3: if we have ore miners, there must be ore on the map. This resets cooldown if needed
(defrule
    (not (goal ore-found YES))
    (or
	    (unit-type-count 124 > 0)
	    (unit-type-count 220 > 0)
    )
=>
    (set-goal ore-found YES)
)

; rule 4: if timer triggered and still no ore miners, there's no ore left on the map
(defrule
    (goal ore-found MAYBENOT)
    (and
	    (unit-type-count 124 == 0)
	    (unit-type-count 220 == 0)
    )
    (game-time > 3000) ; 50min
    (goal resource-search SEARCH) ; essentially the timer going off
=>
    (set-goal ore-found NO)
    ; (chat-local-to-self "WAFFLE: No ore.")
)

; rule 2: if timer triggered and we have no ore miners, maybe there's no ore left on the map.
(defrule
    (goal ore-found YES)
    (and
	    (unit-type-count 124 == 0)
	    (unit-type-count 220 == 0)
    )
    (game-time > 3000) ; 50min
    (goal resource-search SEARCH) ; essentially the timer going off
=>
    (set-goal ore-found MAYBENOT)
    ; (chat-local-to-self "WAFFLE: maybe no ore?")
)

; =====================================================
; CHAPTER X: CIV PROCESSING TECH CATCHUP
; =====================================================

(defrule
	; TF Fusion Extractor (Ore)
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-fusion-extractor)
	(goal importantT4research DONE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-fusion-extractor)
)

; -------------------
; --- Tidy Up ---
; -------------------

(defrule
    (goal resource-search SEARCH)
=>
    (set-goal resource-search DONE)
)
