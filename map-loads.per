; =====================================================
; FILE: map-loads
; PURPOSE:
;   Detects map types, resources, fish, hunt, and special map conditions.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: MAP DETECTION
;	Chapter 2: RESOURCE DETECTION
;	Chapter 3: SPECIAL MAPS
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal fish-present NO)
	(set-goal ore-found NO)
	(set-goal nova-found NO)
	(set-goal berries-present NO)
	(set-goal hunt-present NO)
	(set-strategic-number snc-lure-amount 0)
	(disable-self)
)

; #load-if-defined CUSTOM-MAP ; these rules now fire for all maps

(defrule
	(cc-players-unit-type-count 0 GAIA-BERRY-LINE >= 10) ; if any berries do exist on map
=>
	(set-goal berries-present YES)
	(disable-self)
)

(defrule
	(cc-players-unit-type-count 0 GAIA-ANIMAL-HUNT-LINE >= 4) ; if there's at least one huntable
=>
	(set-goal hunt-present YES)
	(disable-self)
)

(defrule
	(or
		(cc-players-unit-type-count 0 6482 > 0) ; carbon gas vent
		(cc-players-unit-type-count 0 7091 > 0) ; tropical variant
	)
	(game-time > 3)
=>
	(set-goal fish-present VENTSIGHTED) ; increased priority, disables deleting fishing boats
	(disable-self)
)


#load-if-defined TINY-MAP ; 2p sized map
(defrule
	(cc-players-unit-type-count 0 GAIA-FISH-LINE >= 20) ; 10 fish total on map
=>
	(set-goal fish-present YES)
	(set-goal special-map WATER)
	(disable-self)
)

; Assume: More than 15 berries per player would be funny
; Since the AI sees double, this is 30b per player
; A Tiny map should have 2 players on it, soooo
; 60 berries
(defrule
	(goal berries-present YES)
	(cc-players-unit-type-count 0 GAIA-BERRY-LINE >= 60) ; remember, AI sees double
=>
	(set-goal berries-present PLENTY)
	(disable-self)
)

; one lure per player: two players is two lure
; AI sees double so make that 4 lure
(defrule
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 4)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 1)
	(disable-self)
)
; two lure per player: two players is 4 lure
; AI sees double so make that 8 lure
(defrule
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 8)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 2)
	(disable-self)
)
(defrule
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 12)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 3)
	(disable-self)
)
(defrule
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 16)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 4)
	(disable-self)
)

#end-if

#load-if-defined SMALL-MAP ; 3p sized map

(defrule
	(cc-players-unit-type-count 0 GAIA-FISH-LINE >= 30) ; 15 fish total on map
=>
	(set-goal fish-present YES)
	(set-goal special-map WATER)
	(disable-self)
)

(defrule
	(goal berries-present YES)
	(cc-players-unit-type-count 0 GAIA-BERRY-LINE >= 90) 
=>
	(set-goal berries-present PLENTY)
	(disable-self)
)

