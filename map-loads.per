#load-if-defined TUNDRA-MAP

(defrule
        (not (goal special-map NOTWATER)) ; can't just be true as seems to be overwritten by fish logic 
=>
        (set-goal special-map NOTWATER)
)

#end-if
;*******************************
#load-if-defined DESERT-MAP

(defrule
        (true)
=>
        (do-nothing)
        (disable-self)
)
#end-if
