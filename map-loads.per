#load-if-defined LARGE-MAP ; 8p sized map

(defrule
	(cc-players-unit-type-count 0 GAIA-FISH-LINE >= 70)
=>
	(set-goal fish-present YES)
	(set-goal special-map WATER)
	(disable-self)
)

(defrule
	(goal berries-present YES)
	(cc-players-unit-type-count 0 GAIA-BERRY-LINE >= 240) 
=>
	(set-goal berries-present PLENTY)
	(disable-self)
)
; lure rules a duplicate of Giant below
		
#end-if

; #load-if-defined GIANT-MAP ; load if any map (handling for odd or extra-massive sizes)

(defrule
	(cc-players-unit-type-count 0 GAIA-FISH-LINE >= 80)
=>
	(set-goal fish-present YES)
	(set-goal special-map WATER)
	(disable-self)
)

(defrule
	(goal berries-present YES)
	(cc-players-unit-type-count 0 GAIA-BERRY-LINE >= 240) 
=>
	(set-goal berries-present PLENTY)
	(disable-self)
)

; one lure per player is 8 lure
; AI sees double so make that 16
(defrule
	(strategic-number snc-lure-amount < 1)
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 16)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 1)
	(disable-self)
)
(defrule
	(strategic-number snc-lure-amount < 2)
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 32)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 2)
	(disable-self)
)
(defrule
	(strategic-number snc-lure-amount < 3)
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 48)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 3)
	(disable-self)
)
(defrule
	(strategic-number snc-lure-amount < 4)
	(cc-players-unit-type-count 0 GAIA-ANIMAL-LURE-LINE >= 64)
	(game-time < 10)
=>
	(set-strategic-number snc-lure-amount 4)
	(disable-self)
)

; check type of lure
(defrule
		(or
	(cc-players-unit-type-count 0 4423 >= 4); Flit, 120f
		(or
	(cc-players-unit-type-count 0 7401 >= 4); Splox, 150f
		(or
	(cc-players-unit-type-count 0 7437 >= 4); Ksomethingslug, 200f
		(or
	(cc-players-unit-type-count 0 7496 >= 4); Lisk, 200f
		(or
	(cc-players-unit-type-count 0 7606 >= 4); Exoboar, 220f
		(or
	(cc-players-unit-type-count 0 7659 >= 4); Scazz, 210f
		(or
	(cc-players-unit-type-count 0 7661 >= 4); Horranth, 220f
	(cc-players-unit-type-count 0 7673 >= 4); BGlider, 210f
	)))))))
=>
	(set-goal allowgarbage LOWLUREFOOD) ; this goal does double duty
	(disable-self)
)

(defrule
	(current-age >= tech-level-2)
=>
	(set-goal allowgarbage NO) ; reset and let this goal be used for its other purpose
	(disable-self)
)


		
; #end-if

(defrule
	(goal fish-present VENTSIGHTED)
=>
	(set-goal special-map WATER)
	(disable-self)
)
; if there's a vent, no matter map sizes or fish count, go on the water

; #end-if ; end of custom map




