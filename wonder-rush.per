)

; 10d-iii: Hvy Weapons Factory

(defrule
	(goal get-mad DOOMSDAY)
	(unit-type-count-total SIEGE-MISSILE-LINE < TL4-aa-mobile-detect-air-alert-low-p1)
	(can-train SIEGE-MISSILE-LINE)
	(not (goal support-aircraft YES))
=>
	(train SIEGE-MISSILE-LINE)
)

(defrule
	(goal get-mad DOOMSDAY)
	(unit-type-count-total SIEGE-RAM-LINE < TL4-ram-arm)
	(can-train SIEGE-RAM-LINE)
=>
	(train SIEGE-RAM-LINE)
)

(defrule
	(goal get-mad DOOMSDAY)
	(unit-type-count-total SIEGE-ARTILLERY-LINE < TL4-artillery-arm)
	(can-train SIEGE-ARTILLERY-LINE)
=>
	(train SIEGE-ARTILLERY-LINE)
)

; 10d-iv: Airbase
; Uses rotation system

(defrule
	(goal get-mad DOOMSDAY)
=>
	(set-goal airtotrain FIGHTER)
	(set-goal airtotraininternal 1)
	(disable-self)
)

(defrule
	(goal airtotrain FIGHTER) 										; if we should be training a fighter
	(unit-type-count-total UNIT-FIGHTER-LINE >= TL4-fighter-arm) 	; but if they're at cap
=>
	(set-goal airtotrain ADVANCE)									; then skip and move onto next unit type
)
(defrule
	(goal airtotrain BOMBER)
	(unit-type-count UNIT-BOMBER-LINE >= TL4-bomber-arm)
=>
	(set-goal airtotrain ADVANCE)
)

(defrule
	(goal airtotrain INTERCEPTOR)
	(unit-type-count UNIT-INTERCEPTOR-LINE >= TL4-interceptor-arm)
=>
	(set-goal airtotrain ADVANCE)
)

(defrule
	(goal airtotrain ATTACKER)
	(unit-type-count UNIT-ATTACKER-LINE >= TL4-attacker-arm)
=>
	(set-goal airtotrain ADVANCE)
)

(defrule
	(goal airtotrain FIGHTER)
	(can-train UNIT-FIGHTER-LINE)
=>
	(train UNIT-FIGHTER-LINE)
	(set-goal airtotrain ADVANCE)
)

(defrule
	(goal airtotrain BOMBER)
	(can-train UNIT-BOMBER-LINE)
=>
	(train UNIT-BOMBER-LINE)
	(set-goal airtotrain ADVANCE)
)

(defrule
	(goal airtotrain ATTACKER)
	(can-train UNIT-ATTACKER-LINE)
=>
	(train UNIT-ATTACKER-LINE)
	(set-goal airtotrain ADVANCE)
)

(defrule
	(goal airtotrain INTERCEPTOR)
	(can-train UNIT-INTERCEPTOR-LINE)
=>
	(train UNIT-INTERCEPTOR-LINE)
	(set-goal airtotrain ADVANCE)
)

; rules which control the next in the queue

(defrule
	(goal airtotrain ADVANCE)
	(goal airtotraininternal 1) ; fighter
=>
	(set-goal airtotraininternal 2)
	(set-goal airtotrain FIGHTER)
)

(defrule
	(goal airtotrain ADVANCE)
	(goal airtotraininternal 2)
=>
	(set-goal airtotraininternal 3)
	(set-goal airtotrain INTERCEPTOR)
)

(defrule
	(goal airtotrain ADVANCE)
	(goal airtotraininternal 3)
=>
	(set-goal airtotraininternal 4)
	(set-goal airtotrain INTERCEPTOR)
)

(defrule
	(goal airtotrain ADVANCE)
	(goal airtotraininternal 4)
=>
	(set-goal airtotraininternal 5)
	(set-goal airtotrain ATTACKER)
)

(defrule
	(goal airtotrain ADVANCE)
	(goal airtotraininternal 5)
=>
	(set-goal airtotraininternal 6)
	(set-goal airtotrain BOMBER)
)

(defrule
	(goal airtotrain ADVANCE)
	(goal airtotraininternal 6)
=>
	(set-goal airtotraininternal 1)
	(set-goal airtotrain FIGHTER)
)

; 10d-v: Fort

(defrule
	(unit-type-count-total UNIT-AIR-CRUISER < TL4-air-cruiser-arm)
	(can-train-with-escrow UNIT-AIR-CRUISER)
	(goal get-mad DOOMSDAY)
	=>
	(release-escrow food)
	(release-escrow nova)
	(train UNIT-AIR-CRUISER)
)

(defrule
	(unit-type-count-total SIEGE-CANNON-LINE < TL4-cannon-arm)
	(can-train SIEGE-CANNON-LINE)
	(goal get-mad DOOMSDAY)
=>
	(train SIEGE-CANNON-LINE)
)

(defrule
	(unit-type-count-total SIEGE-CANNON-LINE < 2)
	(can-train-with-escrow SIEGE-CANNON-LINE)
	(not (can-train SIEGE-CANNON-LINE))
	(goal get-mad DOOMSDAY)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(train SIEGE-CANNON-LINE)
)

(defrule
	(unit-type-count-total my-unique-unit-line < TL4-unique-unit-arm)
	(can-train my-unique-unit-line)
	(goal get-mad DOOMSDAY)
=>
	(train my-unique-unit-line)
)

; 10d-vi: Shipyard

; random junk-unit shipyard training removed
