; -------------------------
; --- 10b: Attack Logic ---
; -------------------------

(defrule
	(game-time > 60)
=>
	(set-goal attacksonhold-manual YES)
	(set-goal attack-timer YES)
	(set-goal rushsize 0)
	(disable-self)
)

(defrule
	(goal get-mad DOOMSDAY)
	(military-population > 10)
	(or
		(shared-goal treatytimer 0)
		(shared-goal treatytimer 1)
	)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 60) ; 1min
	(set-goal aready YES)
	(disable-self)
)

(defrule
	(timer-triggered t-attackgroup-alt)
	(or
		(shared-goal treatytimer 0)
		(shared-goal treatytimer 1)
	)
=>
	(disable-timer t-attackgroup-alt)
	(enable-timer t-attackgroup-alt 60) ; 1min
	(set-goal aready YES)
)


(defrule
	(goal get-mad DOOMSDAY)
	(cc-players-building-type-count any-human BLDG-MONUMENT > 0)
	(or
		(shared-goal treatytimer 0)
		(shared-goal treatytimer 1)
	)
=>
	(set-goal aready YES)
	(disable-self)
)

; -------------------------
; --- 10c: Construction ---
; -------------------------

(defrule
	(goal get-mad DOOMSDAY)
	(current-age >= tech-level-3)
	(can-build-with-escrow BLDG-TRAINTROOPER)
	(building-type-count-total BLDG-TRAINTROOPER < 4)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINTROOPER)
)

