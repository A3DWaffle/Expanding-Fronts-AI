; -------------------------
; --- 10d: Unit Training ---
; -------------------------

; 10d-i: Troop Center

(defrule
	(goal get-mad DOOMSDAY)
	(unit-type-count-total UNIT-MISSILE-LINE  < TL4-aa-trooper-arm-air-alert-low-p1)
	(can-train UNIT-MISSILE-LINE)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(not (goal support-aircraft YES))
=>
	(train UNIT-MISSILE-LINE)
)

(defrule
	(goal get-mad DOOMSDAY)
	(unit-type-count-total UNIT-LASER-LINE < TL4-trooper-arm)
	(can-train UNIT-LASER-LINE)
=>
	(train UNIT-LASER-LINE)
)

(defrule
	(goal get-mad DOOMSDAY)
	(unit-type-count-total UNIT-MOUNTED-LINE < TL3-mounted-core)
	(can-train UNIT-MOUNTED-LINE)
=>
	(train UNIT-MOUNTED-LINE)
)

(defrule
	(goal get-mad DOOMSDAY)
	(unit-type-count-total UNIT-GRENADE-LINE < TL4-grenade-arm)
	(can-train UNIT-GRENADE-LINE)
=>
	(train UNIT-GRENADE-LINE)
)

