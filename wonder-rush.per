; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-goal tryingtobuild NULL)
	(set-goal get-mad NO)
	(set-goal buildpause NO)
	(set-shared-goal age-match-human NO)
	(set-shared-goal treatytimer 0)
	(set-shared-goal customdifficulty NULL)
	(set-shared-goal resignoverride NO)
	(disable-self)
)

(defrule ;Escrow
        (current-age >= tech-level-2)
=>
        (set-escrow-percentage carbon 50)
        (set-escrow-percentage food 50)
        (set-escrow-percentage nova 50)
        (set-escrow-percentage metal 50)
)

; Had to just rewrite these rules from sn-gather
(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)		; All relevant T1 buildings done
	(building-type-count-total BLDG-DROPCARBON > 0)
	(not (or
		(goal savetheanimals YES)
		(goal savetheanimals WAITING)
	))
	(carbon-amount > 300)
=>
	(set-strategic-number sn-carbon-gatherer-percentage 30) ; need to afford farms and prefabs
	(set-strategic-number sn-food-gatherer-percentage 60)  ; it's actually quite a lot of carb
	(disable-self)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(not (or
		(goal savetheanimals YES)
		(goal savetheanimals WAITING)
	))
	(carbon-amount > 500) ; lotsa carbon
=>
	(set-strategic-number sn-carbon-gatherer-percentage 10) 
	(set-strategic-number sn-food-gatherer-percentage 70)  
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(game-time > latestart-nerf-timeout)
	(building-type-count-total BLDG-MAIN > 0)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-WARCTR > 0)
	(carbon-amount > 250) ; So all buildings done and some carbon to spare
=>
	(set-strategic-number sn-carbon-gatherer-percentage 30) 
	(set-strategic-number sn-food-gatherer-percentage 40)
	;(set-strategic-number sn-nova-gatherer-percentage 15)
	(set-strategic-number sn-metal-gatherer-percentage 10)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	(building-type-count-total BLDG-MAIN >= 2)
=>
	(set-strategic-number sn-metal-gatherer-percentage 10)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(game-time > latestart-nerf-timeout)
	=>
	(set-strategic-number sn-carbon-gatherer-percentage 40)
	(set-strategic-number sn-food-gatherer-percentage 30)
	(set-strategic-number sn-nova-gatherer-percentage 20)
	(set-strategic-number sn-metal-gatherer-percentage 10)
	(disable-self)
)


;  CC LOS cheat tech - needs to be loaded before workers
#load-if-defined DIFFICULTY-EASIEST
(defrule
	(can-research aic-cc-los)
	(false)
=>
	(research aic-cc-los)
	(disable-self)
)
#end-if
#load-if-defined DIFFICULTY-EASY
(defrule
	(can-research aic-cc-los)
	(game-time > 300)
=>
	(research aic-cc-los)
	(disable-self)
)
#end-if
#load-if-defined DIFFICULTY-MODERATE
(defrule
	(can-research aic-cc-los)
	(game-time > 120)
=>
	(research aic-cc-los)
	(disable-self)
)
#end-if
#load-if-defined DIFFICULTY-HARD
(defrule
	(can-research aic-cc-los)
	(game-time > 120)
=>
	(research aic-cc-los)
	(disable-self)
)
#end-if
#load-if-defined DIFFICULTY-HARDEST
(defrule
	(can-research aic-cc-los)
	(game-time > 60)
=>
	(research aic-cc-los)
	(disable-self)
)
#end-if



; -----------------------------------------------------
; *** Chapter 2: MONUMENT *** 
; -----------------------------------------------------

(defrule
        (can-build-with-escrow BLDG-MONUMENT)
	(not (goal buildpause YES))
=>
        (release-escrow carbon)
        (release-escrow nova)
        (release-escrow metal)
        (set-strategic-number sn-percent-civilian-builders 90)
        (set-strategic-number sn-cap-civilian-builders 50)
        (set-strategic-number sn-percent-civilian-gatherers 10)
        (build BLDG-MONUMENT)
        (disable-self)
)

; sell excess

(defrule
	(current-age == tech-level-4)
	(carbon-amount >= 3200)
	(not (can-research rt-galactic-trade-comm))
	(can-sell-commodity carbon)
=>
	(sell-commodity carbon)
)

(defrule
	(current-age == tech-level-4)
	(food-amount >= 1500)
	(not (can-research rt-galactic-trade-comm))
	(can-sell-commodity food)
=>
	(sell-commodity food)
)

(defrule
	(current-age == tech-level-4)
	(metal-amount >= 3300)
	(not (can-research rt-galactic-trade-comm))
	(can-sell-commodity metal)
=>
	(sell-commodity metal)
)

; buy as needed

(defrule
	(current-age == tech-level-4)
	(nova-amount >= 3000)
	(metal-amount <= 3000)
	(not (can-research rt-galactic-trade-comm))
	(can-buy-commodity metal)
=>
	(buy-commodity metal)
)

; food not needed to build a monument, silly me! 
; (defrule
;         (current-age == tech-level-4)
;         (nova-amount >= 3000)
; 		(metal-amount >= 3000)
; 		(food-amount <= 3000)
; 		(not (can-research rt-galactic-trade-comm))
; 		(can-buy-commodity food)
; =>
; 		(buy-commodity food)
; )

(defrule
	(current-age == tech-level-4)
	(nova-amount >= 3000)
	(metal-amount >= 3000)
	(carbon-amount <= 3000)
	(not (can-research rt-galactic-trade-comm))
	(can-buy-commodity carbon)
=>
	(buy-commodity carbon)
)




; -----------------------------------------------------
; *** Chapter 3: AGE ADVANCEMENT *** 
; --- 3a: NORM AGEUP ---
; --- 3b: SHARED AGEUP ---
; --- 3c: TURN OFF AGINGUP ---
; -----------------------------------------------------

; on Easy and Easiest, wait for humans to tech up 
#load-if-not-defined DIFFICULTY-MODERATE
#load-if-not-defined DIFFICULTY-HARD 
#load-if-not-defined DIFFICULTY-HARDEST

(defrule
	(true)
=>
	(set-shared-goal age-match-human YES)
	(disable-self)
)

#end-if
#end-if
#end-if 

; --- 3a: NORM AGEUP ---

(defrule
	(not (player-in-game any-human))
=>
	(set-shared-goal age-match-human NO) ; accounts for all AI matches
	(disable-self)
)

(defrule
	(can-research-with-escrow tech-level-2)
	(shared-goal age-match-human NO) ; default config settings
=>
	(release-escrow food)
	(set-goal agingup YES)
	(research tech-level-2)
)

(defrule
	(can-research-with-escrow tech-level-3)
	(shared-goal age-match-human NO)
=>
	(release-escrow food)
	(release-escrow nova)
	(set-goal agingup YES)
	(research tech-level-3)
)

(defrule
	(can-research-with-escrow tech-level-4)
	(shared-goal age-match-human NO)
=>
	(release-escrow food)
	(release-escrow nova)
	(set-goal agingup YES)
	(research tech-level-4)
)

; --- 3b: SHARED AGEUP ---

(defrule
	(can-research-with-escrow tech-level-2)
	(shared-goal age-match-human YES)
	(players-current-age any-human >= tech-level-2)
=>
	(release-escrow food)
	(set-goal agingup YES)
	(research tech-level-2)
)
(defrule
	(can-research-with-escrow tech-level-3)
	(shared-goal age-match-human YES)
	(players-current-age any-human >= tech-level-3)
=>
	(release-escrow food)
	(release-escrow nova)
	(research tech-level-3)
	(set-goal agingup YES)
)

(defrule
	(can-research-with-escrow tech-level-4)
	(shared-goal age-match-human YES)
	(players-current-age any-human >= tech-level-4)
=>
	(release-escrow food)
	(release-escrow nova)
	(set-goal agingup YES)
	(research tech-level-4)
)

; --- 3c: TURN OFF AGINGUP ---

(defrule
	(current-age == tech-level-1)
=>
	(set-goal agingup NO) ; convenient initial reset
	(disable-self)
)
(defrule
	(current-age == tech-level-2)
=>
	(set-goal agingup NO)
	(disable-self)
)
(defrule
	(current-age == tech-level-3)
=>
	(set-goal agingup NO)
	(disable-self)
)
(defrule
	(current-age == tech-level-4)
=>
	(set-goal agingup NO)
	(disable-self)
)

; -----------------------------------------------------
; *** Chapter 4: SHIPYARD *** 
; --- 4a: SHIPYARD ---
; --- 4b: FRIGATE ---
; --- 4c: TRAWLER ---
; -----------------------------------------------------

; --- 4a: SHIPYARD ---

(defrule
	(goal special-map WATER)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINBOAT == 0)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(current-age == tech-level-1)
	(goal special-map WATER)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINBOAT < 2)
	(can-build BLDG-TRAINBOAT)
	(not (goal buildpause YES))
=>
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(current-age == tech-level-2)
	(goal special-map WATER)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-TRAINBOAT < 2)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(or
		(current-age == tech-level-3)
		(current-age == tech-level-4)
	)
	(goal special-map WATER)
	(building-type-count-total BLDG-TRAINBOAT < 4)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

(defrule
	(current-age == tech-level-4)
	(or
		(civ-selected GUNGANS)
		(or
			(civ-selected NABOO)
			(or
				(civ-selected FEDERATION)
				(civ-selected IMPERIALREMNANT)
			)
		)
	)
	(goal special-map WATER)
	(building-type-count-total BLDG-TRAINBOAT < 5)
	(can-build-with-escrow BLDG-TRAINBOAT)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-TRAINBOAT)
	(set-goal resourcerefund cshipyard)
)

; --- 4b: FRIGATE ---

(defrule
	(unit-type-count-total BOAT-LASER-LINE < 2)
	(can-train BOAT-LASER-LINE)
	=>
	(train BOAT-LASER-LINE)
)

; --- 4c: TRAWLER ---

(defrule
	(current-age == tech-level-1)
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(not (goal fish-present NO)) ; fish or vent
	(not (population > stop-junk-threshold))
	(can-train BOAT-WORKER)
	=>
	(train BOAT-WORKER)
)

(defrule
	(current-age == tech-level-2)
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(not (population > stop-junk-threshold))
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
=>
	(train BOAT-WORKER)
)

(defrule
	(current-age == tech-level-3) 
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(not (population > stop-junk-threshold))
	(or
		(goal lategamefish NO)
		(goal fish-present VENTSIGHTED) ; allow still training if vent exists
	)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
	=>
	(train BOAT-WORKER)
)

(defrule
	(current-age == tech-level-4) 
	(unit-type-count-total BOAT-WORKER < TL4-max-fishing-boats)
	(not (population > stop-junk-threshold))
	(or
		(goal lategamefish NO)
		(goal fish-present VENTSIGHTED) ; allow still training if vent exists
	)
	(not (goal fish-present NO))
	(can-train BOAT-WORKER)
	=>
	(train BOAT-WORKER)
)

