; -------------------------
; --- 10a: Setup ---
; -------------------------

(defrule
	(cc-players-unit-type-count any-ally SIEGE-ARTILLERY-LINE > 0)
=>
	(chat-to-player this-any-ally "Careful with those Artillery, Commander...")
	(disable-self)
)

(defrule
	(cc-players-unit-type-count any-ally UNIT-GRENADE-LINE > 0)
=>
	(chat-to-player this-any-ally "Watch what you're doing with those Grenade Troopers, Commander...")
	(disable-self)
)

(defrule
	(cc-players-unit-type-count any-ally UNIT-AIRCRUISER-LINE > 0)
=>
	(chat-to-player this-any-ally "I'm watching that Air Cruiser of yours, Commander...")
	(disable-self)
)

; 224 is the dead "Worker" eg from bashing predators, so ignore that one
(defrule
	(true)
=>
	(set-goal wonder-attempt 0)
	(disable-self)
)

(defrule
	(or
		(unit-type-count 58 > 0)
		(or
		(unit-type-count 223 > 0)
		(or
		(unit-type-count 225 > 0)
		(or
		(unit-type-count 226 > 0)
		(or
		(unit-type-count 227 > 0)
		(or
		(unit-type-count 228 > 0)
		(or
		(unit-type-count 229 > 0)
		(or
		(unit-type-count 353 > 0)
		(or
		(unit-type-count 593 > 0)
		(false)
	)))))))))
	(goal wonder-attempt 0)
=>
	(set-goal wonder-attempt 101) ; dead workers
)
(defrule
	(goal wonder-attempt 101)
	(and
		(unit-type-count 58 == 0)
		(and
		(unit-type-count 223 == 0)
		(and
		(unit-type-count 225 == 0)
		(and
		(unit-type-count 226 == 0)
		(and
		(unit-type-count 227 == 0)
		(and
		(unit-type-count 228 == 0)
		(and
		(unit-type-count 229 == 0)
		(and
		(unit-type-count 353 == 0)
		(and
		(unit-type-count 593 == 0)
		(true)
	)))))))))
=>
	(set-goal wonder-attempt 0) ; no dead workers
)

(defrule
	(goal wonder-attempt 101)
	(or
		(or
			(cc-players-unit-type-count 1 UNIT-AIRCRUISER-LINE > 0)
			(or
				(cc-players-unit-type-count 1 UNIT-GRENADE-LINE > 0)
				(cc-players-unit-type-count 1 SCN-SPACE-LINE > 0)
			)
			
		)
		(cc-players-unit-type-count 1 SIEGE-ARTILLERY-LINE > 0)
	)
	(player-human 1)
=>
	(chat-to-player 1 "That's enough! If you're going to cheese this with Attack Ground,")
	(chat-to-player 1 "then I'm going to cheese YOU!")
	(set-stance 1 neutral)
	(set-stance 1 enemy)
	(set-goal get-mad DOOMSDAY)
	(disable-self)
)

(defrule
	(goal wonder-attempt 101)
	(or
		(or
			(cc-players-unit-type-count 2 UNIT-AIRCRUISER-LINE > 0)
			(or
				(cc-players-unit-type-count 2 UNIT-GRENADE-LINE > 0)
