; -----------------------------------------------------
; *** Chapter 6: BUILDINGS *** 
; --- 6a: Command Ctr ---
; --- 6b: Prefab Shelter ---
; --- 6c: Farm ---
; --- 6d: Power Core ---
; --- 6e: Food Ctr ---
; --- 6f: Carbon Ctr ---
; --- 6g: Nova Ctr ---
; --- 6h: Ore Ctr ---
; -----------------------------------------------------

; --- 6a: Command Ctr ---

; always build one
(defrule
	(game-time > raiders-timeout) ; raiders starts are very odd and this does not often work properly
	(building-type-count-total BLDG-MAIN == 0)
	(can-build-with-escrow BLDG-MAIN)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-MAIN) 
)

#load-if-defined DIFFICULTY-MODERATE

(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-MAIN < 2)
	(or
		(cc-players-building-type-count any-enemy BLDG-MAIN  >= 2) ; only build 2 CCs if an enemy has them
		(cc-players-building-type-count any-ally BLDG-MAIN  >= 2)
	)
	
	(can-build-with-escrow BLDG-MAIN)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-MAIN)
)

(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-MAIN < 3)
	(or
		(cc-players-building-type-count any-enemy BLDG-MAIN  >= 3) ; only build 3 CCs if an enemy has them
		(cc-players-building-type-count any-ally BLDG-MAIN  >= 3)
	)
	(can-build-with-escrow BLDG-MAIN)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-MAIN)
)

#end-if

#load-if-not-defined DIFFICULTY-MODERATE
; easy, easiest this value is 1 anyway so no rules needed
(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-MAIN < TL3-CCs)
	(can-build-with-escrow BLDG-MAIN)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(release-escrow metal)
	(build BLDG-MAIN)
)
#end-if

(defrule
	(current-age == tech-level-4)
	(building-type-count-total BLDG-MAIN < TL4-CCs)
	(can-build-with-escrow BLDG-MAIN)
	(metal-amount > 110) ; try to not release escrow in T4
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-MAIN)
)

; --- 6b: Prefab Shelter ---

; as-needed
(defrule
	(building-type-count BLDG-MAIN > 0)
	(housing-headroom < 5)			; "do we need a house" check
	(population-headroom > 0)		; check for if you still have headroom against the pop limit
	(can-build-with-escrow BLDG-PREFAB)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
	(current-age == tech-level-2)
	(housing-headroom < 10)	
	(population-headroom > 0)
	(can-build-with-escrow BLDG-PREFAB)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

(defrule
	(building-type-count BLDG-MAIN > 0)
	(current-age >= tech-level-3)
	(housing-headroom < 15) ; build lots of extra prefabs to prevent production from being capped
	(population-headroom > 0)
	(can-build-with-escrow BLDG-PREFAB)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

; Recovery path: if housing was destroyed and current pop exceeds housing,
; the normal population-headroom/buildpause gates can block rebuilding.
(defrule
	(building-type-count BLDG-MAIN > 0)
	(housing-headroom < 1)
	(can-build-with-escrow BLDG-PREFAB)
=>
	(release-escrow carbon)
	(build BLDG-PREFAB)
)

; --- 6c: Farm ---

(defrule
	(true)
=>
	(set-goal allowfarm YES)
	(disable-self)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(not (goal savetheanimals YES)) ; do not waste carbon on farms when nursery is needed
	(idle-farm-count < 1)
	(can-build BLDG-FARM)
	(not (goal berries-present YES))
	(not (goal berries-present PLENTY))
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(not (goal savetheanimals YES)) ; do not waste carbon on farms when nursery is needed
	(idle-farm-count < 1)
	(can-build BLDG-FARM)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY)
	)
	(sheep-and-forage-too-far)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(idle-farm-count < 3)    ; build 3 spare farms by the
	(current-age-time > 420) ; 7min mark
	(can-build BLDG-FARM)    ; was a savetheanimals check here too but honestly at the 8min mark I'd rather they get farms up
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-2)
	(idle-farm-count < 5) ; maintain 4 spare farms
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-3)
	(idle-farm-count < 10) ; maintain 9
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-4)
	(idle-farm-count < 15) ; maintain LOTS
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age == tech-level-4)
	(building-type-count-total BLDG-FARM < 15) ; always have 15 on hand regardless of idle count
	(can-build BLDG-FARM)
	(goal allowfarm YES)
	(not (goal buildpause YES))
=>
	(build BLDG-FARM)
)

(defrule
	(current-age >= tech-level-2)
	(game-time > 600)
	(building-type-count-total BLDG-FARM > 0)
	(building-type-count BLDG-MAIN == 0) ; if we do not have a CC
	(building-type-count-total BLDG-MAIN > 0) ; but one is building
=>
	(set-goal allowfarm NO)
)

(defrule
	(current-age >= tech-level-2)
	(game-time > 600)
	(dropsite-min-distance food > 8)
	(building-type-count BLDG-FARM > 0)
=>
	(set-goal allowfarm NO)
)

(defrule
	(goal allowfarm NO)
	(building-type-count BLDG-FARM > 0)
=>
	(delete-complete-building BLDG-FARM)
)

(defrule
	(goal allowfarm NO)
	(building-type-count-total BLDG-FARM == 0)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal allowfarm YES)
)

; --- 6d: Power Core ---

(defrule
	(building-type-count-total BLDG-TRAINBOAT <= 1)
	(not (strategic-number sn-max-unpowered-buildings == 1))
=>
	(set-strategic-number sn-max-unpowered-buildings 1) ; This variable had ranges between 0 and 2, but it triggers on 1 higher (so a value of 1 means it fires if 2 buildings are unpowered)
)

(defrule
	(building-type-count-total BLDG-TRAINBOAT > 1) 
	(building-type-count-total BLDG-TRAINBOAT <= 3) ; 2 or 3 shipyards
	(not (strategic-number sn-max-unpowered-buildings == 2))
=>
	(set-strategic-number sn-max-unpowered-buildings 2) ; so two buildings being unpowered is fine - one random building and one shipyard (hopefully), any more means power core
)

(defrule
	(building-type-count-total BLDG-TRAINBOAT >= 4)
	(not (strategic-number sn-max-unpowered-buildings == 3))
=>
	(set-strategic-number sn-max-unpowered-buildings 3) ; three buildings being unpowered is fine, two shipyards and one other random building
)

(defrule
	(building-type-count BLDG-POWERCORE == 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count BLDG-MAIN > 0)
	(can-build BLDG-POWERCORE)
	(not (goal buildpause YES))
	=>
	(build BLDG-POWERCORE)
	(set-goal resourcerefund cpowercore) ; carbon cheat that refunds based on difficulty
)

(defrule
	(too-many-unpowered-buildings)
	(building-type-count BLDG-MAIN > 0)
	(can-build-with-escrow BLDG-POWERCORE)
	(or
		(and
			(current-age == tech-level-2)
			(building-type-count-total BLDG-POWERCORE < 4)
		)
		(or
			(and
				(current-age == tech-level-3)
				(building-type-count-total BLDG-POWERCORE < 9)
			)
			(and
				(current-age == tech-level-4)
				(building-type-count-total BLDG-POWERCORE < 18)
			)
		)
	)
	(not (goal buildpause YES))
	=>
	(release-escrow carbon)
	(set-goal resourcerefund cpowercore) 
	(build BLDG-POWERCORE)
)

; split off into its own rule to save on string table space
(defrule
	(goal resourcerefund cpowercore)
=>
	; (chat-local-to-self "WAFFLE: Releasing escrow for power core") ; see cheats file for, well, the cheat
	(disable-self)
)

; --- 6e: Food Ctr ---

(defrule
	(game-time > 60) ; give the AI a bit to scout its berries
	(or
		(goal berries-present YES) ; this trigger uses cc so essentially fires before the AI finds its berries
		(goal berries-present PLENTY)
	)
	(not (dropsite-min-distance food == -1)) ; try and find them
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (goal savetheanimals YES))
	(can-build BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCHOW)
)

; rule for building if we don't have berries
(defrule
	(game-time > 90) ; timeout
	(building-type-count-total BLDG-DROPCHOW == 0)
	(can-build BLDG-DROPCHOW)
	(or
		(not (goal savetheanimals YES))
		(game-time > 240) ; abort timeout for animals
	)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCHOW)
)

(defrule
	(or
		(current-age == tech-level-1)
		(current-age == tech-level-2)
	)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 2) ; Build a second in T1, but only after all other buildings are done
	(building-type-count-total BLDG-POWERCORE > 0)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY) ; only build a second one if berries
	)
	(not (town-under-attack))
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-3)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(can-build BLDG-DROPCHOW)
	(not (town-under-attack))
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(building-type-count-total BLDG-DROPCHOW < 4)
	(can-build BLDG-DROPCHOW)
	(not (town-under-attack))
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(not (town-under-attack))
	(goal berries-present PLENTY)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-DROPCHOW < 4)
	(or
		(building-type-count-total BLDG-POWERCORE > 0 )
		(carbon-amount > 400) ; override
	)
	(not (town-under-attack))
	(goal berries-present PLENTY)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCHOW)
)

; DISTANCES

(defrule
	(true)
=>
	(set-strategic-number sn-mill-max-distance 12) ; starting value
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0) ; one is being built
=>
	(set-strategic-number sn-mill-max-distance 16)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2) 
=>
	(set-strategic-number sn-mill-max-distance 18)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0) ; one is being built
	(goal berries-present PLENTY) ; allow further
=>
	(set-strategic-number sn-mill-max-distance 20)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2) 
	(goal berries-present PLENTY) ; allow further
=>
	(set-strategic-number sn-mill-max-distance 30)
	(disable-self)
)

; --- 6f: Carbon Ctr ---

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON == 0)
	(dropsite-min-distance carbon > 3)
	(can-build BLDG-DROPCARBON)
	(not (goal savetheanimals YES)) ; wanna get those nerfs housed ASAP
	(game-time > 60) ; do not do immediately
	(not (goal buildpause YES))
=>
	(build BLDG-DROPCARBON)
)

; timeout
(defrule
	(game-time > 180)
	(building-type-count-total BLDG-DROPCARBON == 0)
	(can-build BLDG-DROPCARBON)
	(not (goal buildpause YES))
	=>
	(build BLDG-DROPCARBON)
)

(defrule
        (dropsite-min-distance carbon > 3)
	(not (dropsite-min-distance carbon == 255)) ; not on island
	(not (dropsite-min-distance carbon == -1)) ; none found
	(building-type-count BLDG-DROPCARBON < 12) ; cap of 12, but these can and should be deleted
	(game-time > 180) ; 3min
	(can-build-with-escrow BLDG-DROPCARBON)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
        (build BLDG-DROPCARBON)
)

(defrule
	(building-type-count-total BLDG-DROPCARBON > 10)
=>
	(delete-complete-building BLDG-DROPCARBON)
)

; --- 6g: Nova Ctr ---

; T1 rule: only occasionally
(defrule
	(or
		(and
			(current-age == tech-level-1)
			(strategic-number sn-nova-gatherer-percentage > 1) 
		)
		(current-age == tech-level-2)
	)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPNOVA < 1) 
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-DROPNOVA)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-DROPNOVA)
)

; T2 rule: Always build two for near and far nova, to avoid these spaces being used up
(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(or
		(building-type-count-total BLDG-POWERCORE > 0 )
		(carbon-amount > 400) ; override
	)
	(building-type-count-total BLDG-DROPNOVA < 2) ; Forcibly build 2 nova procs in T2 for near and far nova
	(can-build BLDG-DROPNOVA)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPNOVA)
)

; Generic rule for T3+, controlled by camplevel which is set in sn homebase
; Camplevel:
; 0: Game start (ignore)
; 1: TL2 after 1 of each dropoff built (ignore)
; 2: TL3
; 3: TL4 
; 4: In TL4 for 30min
; 5: In TL4 for 1hr (or T3 for 1hr)
; 6: In TL4 for 1h30m
(defrule
	(or
		(or
			(and
				(goal camplevel 2)
				(building-type-count-total BLDG-DROPNOVA < 4)  
			)
			(and
				(goal camplevel 3)
				(building-type-count-total BLDG-DROPNOVA < 5) 
			)
		)
		(or
			(and
				(goal camplevel 4)
				(building-type-count-total BLDG-DROPNOVA < 7)
			)
			(and
				(goal camplevel 5)
				(building-type-count-total BLDG-DROPNOVA < 8)
			)
		)
	)
	(goal nova-found YES) ; checks several things
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance nova > 7)
	(can-build BLDG-DROPNOVA)
=>
	(build BLDG-DROPNOVA)
)

(defrule
	(and
		(goal camplevel 6)
		(building-type-count-total BLDG-DROPNOVA < 10)  
	)
	(goal nova-found YES)
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance nova > 7)
	(can-build BLDG-DROPNOVA)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPNOVA)
)

; --- 6h: Ore Ctr ---

; T2 rule: build two 
(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPMETAL < 2) ; Forcibly build 2 ore procs in TL2 for near and far ore
	(or
		(building-type-count-total BLDG-POWERCORE > 0 )
		(carbon-amount > 400) ; override
	)
	;(dropsite-min-distance metal > 4)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPMETAL)
)

; T3+ rule
(defrule
	(or
		(or
			(and
				(goal camplevel 2)
				(building-type-count-total BLDG-DROPMETAL < 3)
			)
			(and
				(goal camplevel 3)
				(building-type-count-total BLDG-DROPMETAL < 4)
			)
		)
		(or
			(and
				(goal camplevel 4)
				(building-type-count-total BLDG-DROPMETAL < 6)
			)
			(and
				(goal camplevel 5)
				(building-type-count-total BLDG-DROPMETAL < 7)
			)
		)
	)
	(goal ore-found YES) ; checks several things
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance metal > 7)
	(can-build BLDG-DROPMETAL)
=>
	(build BLDG-DROPMETAL)
)

(defrule
	(and
		(goal camplevel 6)
		(building-type-count-total BLDG-DROPMETAL < 10)  
	)
	(goal ore-found YES)
	(building-type-count-total BLDG-MAIN > 0)
	(dropsite-min-distance metal > 7)
	(can-build BLDG-DROPMETAL)
	(not (goal buildpause YES))
=>
	(build BLDG-DROPMETAL)
)

; -----------------------------------------------------
; *** Chapter 7: RESOURCE FOUND *** 
; --- 7a: Nothing Found ---
; --- 7b: Nova Miners ---
; --- 7c: Ore Miners ---
; --- 7d: Tidy Up ---
; -----------------------------------------------------

; --- 7a: Nothing Found ---

; turn off once either too far or none on map

(defrule
	(not (goal nova-found NO))
	(dropsite-min-distance nova >= 70) ; too far
=>
	(set-goal nova-found NO)
)
(defrule
	(not (goal ore-found NO))
	(dropsite-min-distance metal >= 70) ; too far
=>
	(set-goal ore-found NO)
)


(defrule
	(not (goal nova-found NO))
	(dropsite-min-distance nova == -1) ; not found
	(game-time > 1800) ; 30min 
=>
	(set-goal nova-found NO)
)
(defrule
	(not (goal ore-found NO))
	(dropsite-min-distance metal == -1) ; not found
	(game-time > 1800) ; 30min 
=>
	(set-goal ore-found NO)
)

(defrule
	(goal nova-found NO)
	(building-type-count BLDG-DROPNOVA > 1)
=>
	(delete-building BLDG-DROPNOVA)
)

(defrule
	(goal ore-found NO)
	(building-type-count BLDG-DROPMETAL > 1)
=>
	(delete-building BLDG-DROPMETAL)
)

; --- 7b: Nova Miners ---

; COMPLICATED RULES TO CHECK FOR NOVA AND ORE BY MINERS

; ordering is a little awkward, but bear with me here: 

; rule 1: check for nova on game start. if so, we find nova. already done above

; rule 3: if we have nova miners, there must be nova on the map. This resets cooldown if needed
(defrule
	(not (goal nova-found YES))
	(or
		(unit-type-count 579 > 0)
		(unit-type-count 581 > 0)
	)
=>
	(set-goal nova-found YES)
)

; rule 4: if timer triggered and still no nova miners, there's no nova left on the map
(defrule
	(goal nova-found MAYBENOT)
	(and
		(unit-type-count 579 == 0)
		(unit-type-count 581 == 0)
	)
	(game-time > 3000) ; 50min
	(goal resource-search SEARCH) ; essentially the timer going off
=>
	(set-goal nova-found NO)
	; (chat-local-to-self "WAFFLE: No nova.")
)

; rule 2: if timer triggered and we have no nova miners, maybe there's no nova left on the map.
(defrule
	(goal nova-found YES)
	(and
		(unit-type-count 579 == 0)
		(unit-type-count 581 == 0)
	)
	(game-time > 3000) ; 50min
	(goal resource-search SEARCH) ; essentially the timer going off
=>
	(set-goal nova-found MAYBENOT)
	; (chat-local-to-self "WAFFLE: maybe no nova?")
)

; --- 7c: Ore Miners ---

; ordering is a little awkward, but bear with me here: 
; also yes I did copypaste the nova rules 

; rule 1: check for ore on game start. if so, we find ore. already done above

; rule 3: if we have nova miners, there must be nova on the map. This resets cooldown if needed
(defrule
    (not (goal ore-found YES))
    (or
	    (unit-type-count 124 > 0)
	    (unit-type-count 220 > 0)
    )
=>
    (set-goal ore-found YES)
)

; rule 4: if timer triggered and still no nova miners, there's no nova left on the map
(defrule
    (goal ore-found MAYBENOT)
    (and
	    (unit-type-count 124 == 0)
	    (unit-type-count 220 == 0)
    )
    (game-time > 3000) ; 50min
    (goal resource-search SEARCH) ; essentially the timer going off
=>
    (set-goal ore-found NO)
    ; (chat-local-to-self "WAFFLE: No ore.")
)

; rule 2: if timer triggered and we have no nova miners, maybe there's no nova left on the map.
(defrule
    (goal ore-found YES)
    (and
	    (unit-type-count 579 == 0)
	    (unit-type-count 581 == 0)
    )
    (game-time > 3000) ; 50min
    (goal resource-search SEARCH) ; essentially the timer going off
=>
    (set-goal ore-found MAYBENOT)
    ; (chat-local-to-self "WAFFLE: maybe no ore?")
)

; --- 7d: Tidy Up ---

(defrule
    (goal resource-search SEARCH)
=>
    (set-goal resource-search DONE)
)

; -----------------------------------------------------
; *** Chapter 8: TECH LEVELS *** 
; --- 8a: TL1 ---
; --- 8b: TL2 ---
; --- 8c: TL3 ---
; --- 8d: TL4 ---
; -----------------------------------------------------
; Waffle Guide: Oddly ordered sns and building commands. Just going to put train workers here as well.

#load-if-defined DIFFICULTY-EASIEST

(defrule
	(unit-type-count-total UNIT-WORKER <= worker-easiest)
	(can-train UNIT-WORKER)
=>
	(train UNIT-WORKER)
)

#end-if

#load-if-defined DIFFICULTY-EASY

(defrule
	(unit-type-count-total UNIT-WORKER <= worker-easy)
	(can-train UNIT-WORKER)
=>
	(train UNIT-WORKER)
)

#end-if


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY

(defrule
	(current-age == tech-level-1)
	(civilian-population < civ-dark-hard) ; this value can be very high, like 50, so not an issue (it's per pop)
	(can-train UNIT-WORKER)
=>
	(train UNIT-WORKER)
)

; this T2 check is a mess but it works so I'm not going to poke it
; update: I poked it
(defrule
	(current-age == tech-level-2)
	(or
		(and
			(unit-type-count-total UNIT-WORKER < TL4-max-workers-ally)
			(cc-players-building-type-count any-ally BLDG-SPACEPORT > 0) ; budget check for ally
		)
		(and
			(unit-type-count-total UNIT-WORKER < TL4-max-workers-noally)
			(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)) ; budget check for no ally
		)
	)
	(can-train UNIT-WORKER)
=>
	(train UNIT-WORKER)
)

; case 1: no fish, yes ally
(defrule
		(or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(goal fish-present NO)
        (unit-type-count-total UNIT-WORKER < TL4-max-workers-ally)
		(cc-players-building-type-count any-ally BLDG-SPACEPORT > 0) ; budget check for ally
		(not (population > stop-junk-threshold)) ; stop training these once the 10% headroom threshold is reached
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)

; case 2: no fish, no ally
(defrule
        (or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(goal fish-present NO)
        (unit-type-count-total UNIT-WORKER < TL4-max-workers-noally)
		(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)) ; budget check for no ally
		(not (population > stop-junk-threshold)) ; stop training these once the 10% headroom threshold is reached
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)


; if the map DOES have fish (includes carbon gas vent)
; case 3: yes fish, yes ally
(defrule
        (or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(not (goal fish-present NO))
		(unit-type-count-total UNIT-WORKER < TL4-max-workers-ally-water)
		(cc-players-building-type-count any-ally BLDG-SPACEPORT > 0) ; budget check for ally
		(not (population > stop-junk-threshold))
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)
; case 4: yes fish, no ally
(defrule
        (or
			(current-age == tech-level-3)
			(current-age == tech-level-4)
		)
		(not (goal fish-present NO))
        (unit-type-count-total UNIT-WORKER < TL4-max-workers-noally-water)
		(not (cc-players-building-type-count any-ally BLDG-SPACEPORT > 0)) ; budget check for no ally
		(not (population > stop-junk-threshold))
		(goal lategameworker NO)
        (can-train UNIT-WORKER)
        =>
        (train UNIT-WORKER)
)

; if epic lategame

(defrule
	(true)
=>
	(set-goal lategameworker NO)
	(disable-self)
)

#end-if
#end-if

; ---------------
; --- 8a: TL1 ---
; ---------------

(defrule
        (true)  ; monument race rules
=>
        (set-strategic-number sn-coop-share-information 1)
        (set-strategic-number sn-maximum-town-size 15)
        (set-strategic-number sn-zero-priority-distance 250)

        (set-strategic-number sn-maximum-gaia-attack-response 2)
        (set-strategic-number sn-minimum-boar-hunt-group-size 3)

        (set-strategic-number sn-metal-dropsite-distance 3)
        (set-strategic-number sn-nova-dropsite-distance 3)
        (set-strategic-number sn-retask-gather-amount 5)

        (set-strategic-number sn-camp-max-distance 20)
        (set-strategic-number sn-mill-max-distance 20)
        (set-strategic-number sn-group-form-distance 10)
        (disable-self)
)

(defrule
        (true)
=>
        (set-strategic-number sn-allow-civilian-defense 1)
        (set-strategic-number sn-town-defend-priority 1)
        (set-strategic-number sn-nova-defend-priority 2)

        (set-strategic-number sn-metal-defend-priority 3)
        (set-strategic-number sn-forage-defend-priority 0)
        (set-strategic-number sn-holocron-defend-priority 0)

        (set-strategic-number sn-cap-civilian-builders 250)
        (set-strategic-number sn-percent-civilian-builders 15)
        (set-strategic-number sn-percent-civilian-gatherers 85)
        (set-strategic-number sn-minimum-civilian-explorers 0)

        (set-strategic-number sn-cap-civilian-explorers 0)
        (set-strategic-number sn-percent-civilian-explorers 0)
        (disable-self)
)

(defrule
        (true)
=>
        (set-strategic-number sn-maximum-carbon-drop-distance 20)
        (set-strategic-number sn-maximum-food-drop-distance 20)
        (set-strategic-number sn-maximum-hunt-drop-distance 30)

        (set-strategic-number sn-maximum-fish-boat-drop-distance 30)
        (set-strategic-number sn-maximum-nova-drop-distance 20)
        (set-strategic-number sn-maximum-metal-drop-distance 20)
        (disable-self)
)

;start exploring
(defrule
        (or
                (game-time > 600)
                (and
                        (starting-resources < high-resources)
                        (difficulty > 0)
                )
        )
=>
        (set-strategic-number sn-percent-civilian-builders 15)
        (set-strategic-number sn-percent-civilian-gatherers 85)
        (disable-self)
)

(defrule
        (or
                (starting-resources == high-resources)
                (difficulty == hardest)
        )
=>
        (set-strategic-number sn-percent-civilian-builders 85)
        (set-strategic-number sn-percent-civilian-gatherers 15)
        (disable-self)
)

; explore a bit at need
(defrule
        (game-time < 600)
        (military-population == 0)
        (civilian-population < 15)
        (or
                (dropsite-min-distance food == -1)
                (civilian-population > 10)
        )
=>
        (set-strategic-number sn-minimum-civilian-explorers 1)
        (set-strategic-number sn-cap-civilian-explorers 1)
        (set-strategic-number sn-percent-civilian-explorers 5)
        (set-strategic-number sn-percent-civilian-builders 15)
        (set-strategic-number sn-percent-civilian-gatherers 80)
)

; Shut the explorers off when we get enough food
(defrule
        (strategic-number sn-percent-civilian-explorers > 0)
        (or
                (or
                        (game-time > 900)
                        (dropsite-min-distance food > -1)
                )
                (military-population > 0)
        )
=>
        (set-strategic-number sn-percent-civilian-explorers 0)
        (set-strategic-number sn-minimum-civilian-explorers 0)
        (set-strategic-number sn-cap-civilian-explorers 0)
        (set-strategic-number sn-percent-civilian-builders 15)
        (set-strategic-number sn-percent-civilian-gatherers 85)
)

(defrule
        (strategic-number sn-number-explore-groups != 1)
=>
        (set-strategic-number sn-number-explore-groups 1)
)

(defrule
	(current-age >= tech-level-2)
    (building-type-count-total BLDG-TRAINTROOPER == 0)
    (can-build-with-escrow BLDG-TRAINTROOPER)
	(current-age-time > 120) ; give it a slight delay
	(not (goal buildpause YES))
=>
    (release-escrow carbon)
    (build BLDG-TRAINTROOPER)
)

(defrule
	(current-age >= tech-level-2)
    (building-type-count-total BLDG-TRAINTROOPER == 1)
	(unit-type-count-total UNIT-MOUNTED-LINE <= 1)
=>
    (train UNIT-MOUNTED-LINE)
)

; ---------------
; --- 8b: TL2 ---
; ---------------

(defrule
        (current-age >= tech-level-2)
=>
        (set-strategic-number sn-maximum-town-size TL2-townsize)
        (set-strategic-number sn-percent-civilian-builders 15)
        (set-strategic-number sn-percent-civilian-gatherers 85)
        (set-strategic-number sn-minimum-boar-hunt-group-size 2)

        (set-strategic-number sn-camp-max-distance 35)
        (set-strategic-number sn-mill-max-distance 35)
        (set-strategic-number sn-group-form-distance 20)
        (disable-self)
)

(defrule
        (current-age == tech-level-2)
        (current-age-time < 600)
        (carbon-amount > 500)
=>
        (set-strategic-number sn-percent-civilian-builders 50)
        (set-strategic-number sn-percent-civilian-gatherers 50)
        (disable-self)
)

(defrule
        (current-age == tech-level-2)
        (current-age-time >= 600)
=>
        (set-strategic-number sn-percent-civilian-builders 15)
        (set-strategic-number sn-percent-civilian-gatherers 85)
        (disable-self)
)

(defrule
        (building-type-count-total BLDG-SPACEPORT == 0)
        (can-build-with-escrow BLDG-SPACEPORT)
	(not (goal buildpause YES))
=>
        (release-escrow carbon)
        (build BLDG-SPACEPORT)
)

(defrule
        (building-type-count-total BLDG-SPACEPORT > 0)
        (building-type-count-total BLDG-TRAINJEDI == 0)
        (can-build-with-escrow BLDG-TRAINJEDI)
	(not (goal buildpause YES))
=>
        (release-escrow carbon)
        (build BLDG-TRAINJEDI)
)

(defrule
	(not (civ-selected BLACKSUN))
	(unit-type-count-total UNIT-JEDIHOLO-LINE == 0)
	(unit-type-count-total UNIT-JEDI-LINE == 0)
	(can-train UNIT-JEDI-LINE)
	=>
	(train UNIT-JEDI-LINE)
)

(defrule
	(or	
		(civ-selected NABOO)
		(civ-selected REPUBLIC)
	)
	(unit-type-count-total UNIT-JEDI-LINE == 0)
	(can-train UNIT-JEDI-LINE)
	=>
	(train UNIT-JEDI-LINE)
)

(defrule
	(civ-selected BLACKSUN)
	(not (or
		(unit-type-count-total UU-JEDIALT-LINE >= 2) ; 2 spare
		(and
			(unit-type-count-total UU-JEDIALT-LINE == 1) ; 1 holo, one idle
			(unit-type-count-total UNIT-JEDIHOLO-LINE == 1)
		)
	)) ; if NOT that, train
	(can-train-with-escrow UU-JEDIALT-LINE)
	=>
	(release-escrow food)
	(release-escrow nova)
	(train UU-JEDIALT-LINE)
)

(defrule
	(not (civ-selected BLACKSUN))
	(unit-type-count-total UNIT-JEDIHOLO-LINE == 0)
	(unit-type-count-total UNIT-JEDI-LINE == 0)
	(can-train-with-escrow UNIT-JEDI-LINE)
	(not (can-train UNIT-JEDI-LINE))
	=>
	(release-escrow food)
	(release-escrow nova)
	(train UNIT-JEDI-LINE)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-maximum-jedi-support-group-size 0) ; holocron collectors no longer get stuck
	(disable-self)
)

; ---------------
; --- 8c: TL3 ---
; ---------------

(defrule
        (current-age >= tech-level-3)
=>
        (set-strategic-number sn-maximum-town-size TL3-townsize)
        (set-strategic-number sn-percent-civilian-builders 15)

        (set-strategic-number sn-percent-civilian-gatherers 85)
        (set-strategic-number sn-blot-exploration-map 0)
        (set-strategic-number sn-camp-max-distance 50)
        (set-strategic-number sn-minimum-boar-hunt-group-size 1)

        (set-strategic-number sn-mill-max-distance 50)

        (disable-self)
)

(defrule
        (building-type-count-total BLDG-RESCTR == 0)
        (can-build-with-escrow BLDG-RESCTR)
	(not (goal buildpause YES))
=>
        (release-escrow carbon)
        (build BLDG-RESCTR)
)

(defrule
        (building-type-count-total BLDG-TRAINAIR == 0)
        (can-build-with-escrow BLDG-TRAINAIR)
	(not (goal buildpause YES))
=>
        (release-escrow carbon)
        (build BLDG-TRAINAIR)
)

; ---------------
; --- 8d: TL4 ---
; ---------------

(defrule
        (current-age == tech-level-4)
=>
        (set-strategic-number sn-maximum-town-size TL4-townsize)
        (set-strategic-number sn-percent-civilian-builders 15)
        (set-strategic-number sn-percent-civilian-gatherers 85)
        (set-strategic-number sn-camp-max-distance 100)
        (set-strategic-number sn-mill-max-distance 50)
        (disable-self)
)

(defrule
        (current-age == tech-level-4)
		(carbon-amount > 1000)
		(food-amount > 1000)
		(metal-amount > 1000)
		(nova-amount > 1000)
=>
	(set-strategic-number sn-maximum-town-size TL4-townsize-big)
        (disable-self)
)

; -----------------------------------------------------
; *** Chapter 9: CHEATS *** 
; --- 9a: Moderate ---
; --- 9b: Hard ---
; --- 9c: Hardest ---
; --- 9d: Miscellaneous ---
; -----------------------------------------------------
; Zel Guide: Need unique cheats file to prevent silly amounts of resource generating

(defrule
	(true)
=>
	(enable-timer t-aicheat 180) ; This timer runs on a 3min interval, but this can be changed
	(disable-self)
)

; ---------------
; --- 9a: Moderate ---
; ---------------

; free worker cheat, moderate and above
#load-if-not-defined DIFFICULTY-EASY
#load-if-not-defined DIFFICULTY-EASIEST

(defrule
	(game-time < 10)
	(food-amount > 100)
=>
	(cc-add-resource food 4) ; large enough to tip over the food at start so it's not zero when they train all their workers
	(disable-self)
)

#load-if-defined DIFFICULTY-MODERATE
(defrule
	(current-age == tech-level-1)
	(food-amount < 50)
	(not (food-amount < 2)) ; handles cases in scenarios where starting with 0 res
	(game-time > 150) ; worker train time is 25s, so this means 4 workers (starting 200f) are trained with downtime for 2
=>
	(cc-add-resource food 10)
)
#end-if
#load-if-not-defined DIFFICULTY-MODERATE
(defrule
	(current-age == tech-level-1)
	(food-amount < 50)
	(not (food-amount < 2)) ; handles cases in scenarios where starting with 0 res
=>
	(cc-add-resource food 10)
)
#end-if

#end-if
#end-if


#load-if-defined DIFFICULTY-MODERATE
; MODERATE CHEATS
; Recieves worker cheat in T1
; And a tiny bit of catchup resources

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-1)
	(or
		(players-current-age any-enemy >= tech-level-2)
		(players-current-age any-ally >= tech-level-2)
	)
	(food-amount != 0) ; don't get these in scenario with 0 res
	(carbon-amount != 0)
=>
	(cc-add-resource carbon 100) 
	(cc-add-resource food 100) ; this is quite a lot, but being stuck in T1 is kinda brutal
)


(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
	(or
		(players-current-age any-enemy >= tech-level-3)
		(players-current-age any-ally >= tech-level-3)
	)
	(food-amount != 0) ; don't get these in scenario with 0 res
	(carbon-amount != 0)
=>
	(cc-add-resource carbon 100) 
	(cc-add-resource food 100)
	(cc-add-resource nova 0)
)

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-3)
	(or
		(players-current-age any-enemy >= tech-level-4)
		(players-current-age any-ally >= tech-level-4)
	)
	(food-amount != 0) ; don't get these in scenario with 0 res
	(carbon-amount != 0)
=>
	(cc-add-resource carbon 100) 
	(cc-add-resource food 150)
	(cc-add-resource nova 100)
) 


#end-if

; ---------------
; --- 9b: Hard ---
; ---------------


#load-if-defined DIFFICULTY-HARD

; Resources on timer

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-1)
=>
	(cc-add-resource carbon 0)
	(cc-add-resource food 0)
)

(defrule
	(current-age == tech-level-1)
	(game-time > 300) ; 5min mark
=>
	(set-goal cheatlure YES)
	(disable-self)
)

; (defrule
; 	(current-age == tech-level-1)
; 	(game-time > 360) ; 6min mark
; =>
; 	(set-goal cheatlure YES)
; 	(disable-self)
; )
(defrule
	(current-age == tech-level-1)
	(game-time > 420) ; 7min mark
=>
	(set-goal cheatlure YES)
	(disable-self)
)
; (defrule
; 	(current-age == tech-level-1)
; 	(game-time > 480) ; 8min mark
; =>
; 	(set-goal cheatlure YES)
; 	(disable-self)
; )
(defrule
	(current-age == tech-level-1)
	(game-time > 540) ; 9min mark 
=>
	(set-goal cheatlure YES)
	(disable-self)
)
(defrule
	(current-age == tech-level-1)
	(game-time > 600) ; 10min mark
=>
	(set-goal cheatlure YES)
	(disable-self)
)
(defrule
	(goal cheatlure YES)
	(strategic-number snc-lure-amount == 0)
=>
	(set-goal cheatlure NO)
)

; the reason for this stupid is to pad out the AI's tech times a bit
; otherwise the food influx all comes in at the same time and they go OO I CAN AFFORD IT at the same time
; results in like 3 AI teching up at EXACTLY the same moment
; feels a bit bad
(defrule
	(goal cheatlure YES)
=>
	(generate-random-number 20) ; between 1 and X
)

(defrule
	(goal cheatlure YES)
	(random-number == 1)
	(strategic-number snc-lure-amount > 0)
	(goal allowgarbage LOWLUREFOOD)
=>
	; (chat-local-to-self "WAFFLE: T1 Lure Cheat activate. Low food")
	(cc-add-resource food 100)
	(set-goal cheatlure SUBTRACT)
)

(defrule
	(goal cheatlure YES)
	(random-number == 1)
	(strategic-number snc-lure-amount > 0)
	(not (goal allowgarbage LOWLUREFOOD))
=>
	; (chat-local-to-self "WAFFLE: T1 Lure Cheat activate. Normal food")
	(cc-add-resource food 200)
	(set-goal cheatlure SUBTRACT)
)

(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 4)
=>
	(set-strategic-number snc-lure-amount 3)
	(set-goal cheatlure NO)
)
(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 3)
=>
	(set-strategic-number snc-lure-amount 2)
	(set-goal cheatlure NO)
)
(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 2)
=>
	(set-strategic-number snc-lure-amount 1)
	(set-goal cheatlure NO)
)
(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 1)
=>
	(set-strategic-number snc-lure-amount 0)
	(set-goal cheatlure NO)
)




; if someone is in the next tech level, or panic time
; this basically functions as a later game chek
(defrule
	(current-age == tech-level-1)
	(or
		(game-time > 900) ; 15min
		(or
			(players-current-age any-enemy >= tech-level-2)
			(players-current-age any-ally >= tech-level-2)
		)
	)
	(goal agingup NO) ; and we're not teching up
	(food-amount < 500)
=>
	(cc-add-resource carbon 10) 
	(cc-add-resource food 50)
	; (chat-local-to-self "WAFFLE: Enemy in T2 or timer, panic res")
) 


; tech level 2 cheats

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
=>
	(cc-add-resource carbon 150) 
	(cc-add-resource food 100)
	(cc-add-resource nova 0)
)

; if someone is in the next tech level
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
	(or
		(players-current-age any-enemy >= tech-level-3)
		(players-current-age any-ally >= tech-level-3)
	)
	(goal agingup NO) ; and we're not teching up
=>
	(cc-add-resource carbon 50) 
	(cc-add-resource food 100)
	(cc-add-resource nova 50)
) 


; tech level 3 cheats

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-3)
=>
	(cc-add-resource carbon 200) 
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
	(cc-add-resource metal 0)
) 


; if someone is in the next tech level
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-3)
	(or
		(players-current-age any-enemy >= tech-level-4)
		(players-current-age any-ally >= tech-level-4)
	)
	(goal agingup NO) ; and we're not teching up
=>
	(cc-add-resource carbon 100) 
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
	(cc-add-resource metal 0)
) 


; tech level 4 cheats

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
=>
	(cc-add-resource carbon 300)
	(cc-add-resource food 200)
	(cc-add-resource nova 100)
	(cc-add-resource metal 0)
)

#end-if


; -------------------
; --- 9c: Hardest ---
; -------------------

#load-if-defined DIFFICULTY-HARDEST

; Like Hard, but more! 

; first, cancel the hardcoded cheats

	(defrule
			(current-age == tech-level-1)
	=>
			(cc-add-resource carbon -500)
			(cc-add-resource food -500)
			(cc-add-resource nova -500)
			(cc-add-resource metal -500)
			(disable-self)
	)
	(defrule
			(current-age == tech-level-2)
	=>
			(cc-add-resource carbon -500)
			(cc-add-resource food -500)
			(cc-add-resource nova -500)
			(cc-add-resource metal -500)
			(disable-self)
	) 
	(defrule
			(current-age == tech-level-3)
	=>
			(cc-add-resource carbon -500)
			(cc-add-resource food -500)
			(cc-add-resource nova -500)
			(cc-add-resource metal -500)
			(disable-self)
	) 
	(defrule
			(current-age == tech-level-4)
	=>
			(cc-add-resource carbon -500)
			(cc-add-resource food -500)
			(cc-add-resource nova -500)
			(cc-add-resource metal -500)
			(disable-self)
	)  
; Resources on timer

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-1)
=>
	(cc-add-resource carbon 0)
	(cc-add-resource food 0)
)

(defrule
	(current-age == tech-level-1)
	(game-time > 300) ; 5min mark
=>
	(set-goal cheatlure YES)
	(disable-self)
)

; (defrule
; 	(current-age == tech-level-1)
; 	(game-time > 360) ; 6min mark
; =>
; 	(set-goal cheatlure YES)
; 	(disable-self)
; )
(defrule
	(current-age == tech-level-1)
	(game-time > 420) ; 7min mark
=>
	(set-goal cheatlure YES)
	(disable-self)
)
; (defrule
; 	(current-age == tech-level-1)
; 	(game-time > 480) ; 8min mark
; =>
; 	(set-goal cheatlure YES)
; 	(disable-self)
; )
(defrule
	(current-age == tech-level-1)
	(game-time > 540) ; 9min mark 
=>
	(set-goal cheatlure YES)
	(disable-self)
)
(defrule
	(current-age == tech-level-1)
	(game-time > 600) ; 10min mark
=>
	(set-goal cheatlure YES)
	(disable-self)
)
(defrule
	(goal cheatlure YES)
	(strategic-number snc-lure-amount == 0)
=>
	(set-goal cheatlure NO)
)

(defrule
	(goal cheatlure YES)
=>
	(generate-random-number 20) ; between 1 and X
)

(defrule
	(goal cheatlure YES)
	(random-number == 1)
	(strategic-number snc-lure-amount > 0)
	(goal allowgarbage LOWLUREFOOD)
=>
	; (chat-local-to-self "WAFFLE: T1 Lure Cheat activate. Low food")
	(cc-add-resource food 200)
	(set-goal cheatlure SUBTRACT)
)

(defrule
	(goal cheatlure YES)
	(random-number == 1)
	(strategic-number snc-lure-amount > 0)
	(not (goal allowgarbage LOWLUREFOOD))
=>
	; (chat-local-to-self "WAFFLE: T1 Lure Cheat activate. Normal food")
	(cc-add-resource food 300)
	(set-goal cheatlure SUBTRACT)
)

(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 4)
=>
	(set-strategic-number snc-lure-amount 3)
	(set-goal cheatlure NO)
)
(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 3)
=>
	(set-strategic-number snc-lure-amount 2)
	(set-goal cheatlure NO)
)
(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 2)
=>
	(set-strategic-number snc-lure-amount 1)
	(set-goal cheatlure NO)
)
(defrule
	(goal cheatlure SUBTRACT)
	(strategic-number snc-lure-amount == 1)
=>
	(set-strategic-number snc-lure-amount 0)
	(set-goal cheatlure NO)
)




; if someone is in the next tech level, or panic time
; this basically functions as a later game chek
(defrule
	(current-age == tech-level-1)
	(or
		(game-time > 900) ; 15min
		(or
			(players-current-age any-enemy >= tech-level-2)
			(players-current-age any-ally >= tech-level-2)
		)
	)
	(goal agingup NO) ; and we're not teching up
	(food-amount < 500)
=>
	(cc-add-resource carbon 10) 
	(cc-add-resource food 50)
	; (chat-local-to-self "WAFFLE: Enemy in T2 or timer, panic res")
) 


; tech level 2 cheats

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
=>
	(cc-add-resource carbon 200) 
	(cc-add-resource food 200)
	(cc-add-resource nova 0)
)

; if someone is in the next tech level
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
	(or
		(players-current-age any-enemy >= tech-level-3)
		(players-current-age any-ally >= tech-level-3)
	)
	(goal agingup NO) ; and we're not teching up
=>
	(cc-add-resource carbon 100) 
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
) 


; tech level 3 cheats

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-3)
=>
	(cc-add-resource carbon 200) 
	(cc-add-resource food 200)
	(cc-add-resource nova 0)
	(cc-add-resource metal 0)
) 


; if someone is in the next tech level
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-3)
	(or
		(players-current-age any-enemy >= tech-level-4)
		(players-current-age any-ally >= tech-level-4)
	)
	(goal agingup NO) ; and we're not teching up
=>
	(cc-add-resource carbon 200) 
	(cc-add-resource food 200)
	(cc-add-resource nova 200)
	(cc-add-resource metal 0)
) 


; tech level 4 cheats

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
=>
	(cc-add-resource carbon 300)
	(cc-add-resource food 200)
	(cc-add-resource nova 100)
	(cc-add-resource metal 0)
)



#end-if


