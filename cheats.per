	(current-age == tech-level-4)
	(current-age-time > 180)
	(unit-type-count UNIT-WORKER >= 45)
=>
	(cc-add-resource carbon 150)
	(cc-add-resource food 115)
	(cc-add-resource nova 70)
	(cc-add-resource metal 15)
)


; Long-game TL4 reinforcement.
; This is split so worker raids reduce the bonus without turning off the whole late-game support.

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(current-age-time > 1800)
=>
	(cc-add-resource carbon 700)
	(cc-add-resource food 625)
	(cc-add-resource nova 400)
	(cc-add-resource metal 100)
)

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(current-age-time > 1800)
	(unit-type-count UNIT-WORKER >= 30)
=>
	(cc-add-resource carbon 250)
	(cc-add-resource food 225)
	(cc-add-resource nova 140)
	(cc-add-resource metal 35)
)

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(current-age-time > 1800)
	(unit-type-count UNIT-WORKER >= 40)
=>
	(cc-add-resource carbon 250)
	(cc-add-resource food 225)
	(cc-add-resource nova 140)
	(cc-add-resource metal 35)
)


; Targeted TL4 research support

(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(current-age-time > 180)
	(or
		(carbon-amount < 2800)
		(or
			(food-amount < 2000)
			(nova-amount < 1000)
		)
	)
	(not (goal importantT4research DONE))
=>
	(cc-add-resource carbon 325)
	(cc-add-resource food 325)
	(cc-add-resource nova 425)
	(cc-add-resource metal 80)
)

#end-if

;********************************
; Random map Extreme cheats:

; Wait, but there isn't an Extreme difficulty in the settings? What gives?
; This is enabled in the config by Taunt 85
; (shared-goal customdifficulty EXTREME)
; Note that these WILL STACK with whatever the cheats for current difficulty were set to 

; Resources on age up


(defrule
	(shared-goal customdifficulty EXTREME)
	(current-age == tech-level-1)
	(game-time > cheat-timeout)
=>
	(cc-add-resource carbon 50)
	(cc-add-resource food 100)
	(disable-self)
)       

(defrule
	(current-age == tech-level-2)
	(shared-goal customdifficulty EXTREME)
	(current-age-time > cheat-timeout)
=>
	(cc-add-resource carbon 100)
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
	(cc-add-resource metal 50)
	(disable-self)
) 

(defrule
	(current-age == tech-level-3)
	(shared-goal customdifficulty EXTREME)
	(current-age-time > cheat-timeout)
=>
	(cc-add-resource carbon 200)
	(cc-add-resource food 100)
	(cc-add-resource nova 50)
	(cc-add-resource metal 50)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(shared-goal customdifficulty EXTREME)
	(current-age-time > cheat-timeout)
=>
	(cc-add-resource carbon 200)
	(cc-add-resource food 100)
	(cc-add-resource nova 100)
	(cc-add-resource metal 100)
	(disable-self)
)       


; Resources on timer
; keep in mind THESE STACK

; tech level 1
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-1)
	(shared-goal customdifficulty EXTREME)
=>
	(cc-add-resource food 50)
) 

; tech level 2
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
	(shared-goal customdifficulty EXTREME)
=>
	(cc-add-resource carbon 100) 
	(cc-add-resource food 100)
	(cc-add-resource nova 50)
) 

; tech level 3
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-3)
	(shared-goal customdifficulty EXTREME)
=>
	(cc-add-resource carbon 200) 
	(cc-add-resource food 150)
	(cc-add-resource nova 100)
	(cc-add-resource metal 50)
) 


; tech level 4
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-4)
	(unit-type-count UNIT-WORKER > 25) 
	(shared-goal customdifficulty EXTREME)
=>
	(cc-add-resource carbon 300)
	(cc-add-resource food 200)
	(cc-add-resource nova 150)
	(cc-add-resource metal 50)
)








;********************************
; ADDITIONAL CHEAT SHENANIGANS

(defrule
	(town-under-attack)
	(goal buildpause NO)
=>
	(set-goal buildpause YES)
	(enable-timer t-buildpause 30)
)

(defrule
	(timer-triggered t-buildpause)
	(goal buildpause YES)
	(town-under-attack)
=>
	(set-goal buildpause DONE)
	(disable-timer t-buildpause)
)

(defrule
	(timer-triggered t-buildpause)
	(goal buildpause YES)
	(not (town-under-attack))
=>
	(set-goal buildpause NO)
	(disable-timer t-buildpause)
)

(defrule
	(goal buildpause DONE)
	(not (town-under-attack))
=>
	(set-goal buildpause NO)
)

(defrule
	(goal buildpause YES)
	(not (goal resourcerefund NULL))
=>
	(set-goal resourcerefund NULL)
)

(defrule
	(goal buildpause YES)
	(not (goal tryingtobuild NULL))
=>
	(set-goal tryingtobuild NULL)
)


#load-if-not-defined DIFFICULTY-EASIEST
#load-if-not-defined DIFFICULTY-EASY

; One-time TL1 opener bridge. Only fires if the first Troop Center is late,
; so normal openers still need to gather most of their follow-on carbon.
(defrule
	(current-age == tech-level-1)
	(game-time > 240)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-TRAINTROOPER == 0)
	(carbon-amount < 100)
=>
	(cc-add-resource carbon 40)
	(disable-self)
)

; used for construction of military buildings without need to escrow
(defrule
	(metal-amount < 30)
=>
	(cc-add-resource metal 5)
)

#end-if
#end-if


; shipyard carbon refund cause the AI has no idea how to power it
; shipyards are 160c
#load-if-defined DIFFICULTY-HARDEST
(defrule
