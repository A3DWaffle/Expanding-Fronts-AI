#load-if-defined DIFFICULTY-HARDEST

; HARDEST CHEATS
; Stronger than Hard, but still built around baseline + worker bonus scaling.
; Worker raids should reduce the extra bonus, not shut off the whole difficulty.

; Resources on age up
; Hardest receives an engine-side +500 stockpile to every resource on each age-up.
; These scripted values are reduced by that amount so the effective grant remains
; the intended difficulty support instead of stacking an extra 500 each time.

(defrule
	(current-age == tech-level-1)
	(game-time > cheat-timeout)
	(strategic-number snc-lure-amount > 0)
=>
	(cc-add-resource carbon 35)
	(cc-add-resource food 50)
	(disable-self)
)

(defrule
	(current-age == tech-level-1)
	(game-time > cheat-timeout)
	(strategic-number snc-lure-amount == 0)
=>
	(cc-add-resource carbon 65)
	(cc-add-resource food 50)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(game-time > cheat-timeout)
=>
	(cc-add-resource carbon -50)
	(cc-add-resource food -250)
	(cc-add-resource nova -375)
	(cc-add-resource metal -275)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(game-time > cheat-timeout)
=>
	(cc-add-resource carbon 1300)
	(cc-add-resource food 350)
	(cc-add-resource nova 100)
	(cc-add-resource metal 25)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(game-time > cheat-timeout)
=>
	(cc-add-resource carbon 550)
	(cc-add-resource food 75)
	(cc-add-resource nova 25)
	(cc-add-resource metal -125)
	(disable-self)
)


