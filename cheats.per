; If Easy lingers in an age for a while, add a tiny extra worker-scaled packet.
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-1)
	(current-age-time > 240)
	(goal agingup NO)
	(unit-type-count UNIT-WORKER >= 10)
	(or
		(carbon-amount < 425)
		(food-amount < 275)
	)
=>
	(cc-add-resource food 4)
)
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-2)
	(current-age-time > 240)
	(goal agingup NO)
	(unit-type-count UNIT-WORKER >= 15)
	(or
		(carbon-amount < 950)
		(or
			(food-amount < 575)
			(nova-amount < 175)
		)
	)
=>
	(cc-add-resource carbon 8)
	(cc-add-resource food 5)
	(cc-add-resource nova 2)
)
(defrule
	(timer-triggered t-aicheat)
	(current-age == tech-level-3)
	(current-age-time > 240)
	(goal agingup NO)
	(unit-type-count UNIT-WORKER >= 20)
	(or
		(carbon-amount < 1700)
		(or
			(food-amount < 925)
			(or
				(nova-amount < 375)
				(metal-amount < 160)
			)
		)
	)
=>
	(cc-add-resource carbon 20)
	(cc-add-resource food 14)
	(cc-add-resource nova 4)
	(cc-add-resource metal 2)
)
#end-if

#load-if-defined DIFFICULTY-MODERATE
; MODERATE CHEATS - former Prototype Hard
; Stronger than Moderate in TL2/TL3, but still driven by actual worker count and stockpile need.

(defrule
	(current-age == tech-level-1)
=>
	(disable-self)
)       

(defrule
	(current-age == tech-level-1)
	(game-time > cheat-timeout)
	(strategic-number snc-lure-amount > 0)
=>
	(cc-add-resource carbon 15)
	(cc-add-resource food 60)
	(disable-self)
)       

(defrule
	(current-age == tech-level-1)
	(game-time > cheat-timeout)
	(strategic-number snc-lure-amount == 0)
=>
	(cc-add-resource carbon 30)
	(cc-add-resource food 80)
	(disable-self)
)       

(defrule
	(current-age == tech-level-2)
	(current-age-time > cheat-timeout)
	(unit-type-count UNIT-WORKER > 10)
=>
	(cc-add-resource carbon 220)
	(cc-add-resource food 265)
	(cc-add-resource nova 110)
	(cc-add-resource metal 100)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(current-age-time > cheat-timeout)
	(unit-type-count UNIT-WORKER > 18)
=>
	(cc-add-resource carbon 320)
	(cc-add-resource food 355)
	(cc-add-resource nova 125)
	(cc-add-resource metal 75)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(current-age-time > cheat-timeout)
