; =====================================================
; FILE: sn-homebase
; PURPOSE:
;   Controls homebase strategic numbers, town size, camp distance, and expansion posture.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: TL1 TOWN SIZE
;	Chapter 2: CAMP DISTANCE
;	Chapter 3: EXPANSION
;	Chapter 4: LATEGAME
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(true)
=>
	(set-strategic-number sn-initial-exploration-required 0) ; >.<
	(set-goal camplevel 0)
	(disable-self)
)


; ============ BORING UNIMPORTANT SNs =====================

(defrule
	(true)
=>
	(set-strategic-number sn-food-dropsite-distance 4)
	(set-strategic-number sn-carbon-dropsite-distance 4) ; these sn's affect dropsite placement more than anything else apparently
	(set-strategic-number sn-metal-dropsite-distance 3)
	(set-strategic-number sn-nova-dropsite-distance 3)
	(set-strategic-number sn-retask-gather-amount 5)

	(set-strategic-number sn-allow-civilian-defense 1)
	(set-strategic-number sn-garrison-rams 1) ; don't think this does anything

	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-town-defend-priority 1) ; don't think this is needed but oh well
	(set-strategic-number sn-nova-defend-priority 2)
	(set-strategic-number sn-metal-defend-priority 3)

	(set-strategic-number sn-forage-defend-priority 0)
	(set-strategic-number sn-holocron-defend-priority 0)
	(set-strategic-number sn-cap-civilian-builders 250) ; very high please!

	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-maximum-carbon-drop-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 14)
	(set-strategic-number sn-maximum-hunt-drop-distance 40) ; This isn't hunt "drop" distance as per se, but sheer HUNT distance. If a lure is out of this range, it will just not be targeted

	(set-strategic-number sn-maximum-fish-boat-drop-distance -1) ; infinite
	(set-strategic-number sn-maximum-nova-drop-distance 15)
	(set-strategic-number sn-maximum-metal-drop-distance 15)
	(disable-self)
)

(defrule
	(or
		(players-current-age any-enemy >= tech-level-2)
		(players-military-population any-enemy > 2)
	)
=>
	(set-strategic-number sn-allow-civilian-defense 0)
	(disable-self)
)




;=======================TIMER LOGIC

(defrule
	(current-age >= tech-level-2)
=>
	(disable-timer t-townsize)
	(enable-timer t-townsize 60) ; 60s = 1min ; remind me, why is this timer turned on at the start of T2 anyway? ; for looping big check, easiest to just have it on
	(set-goal townsizetrackertwo NULL)
	(disable-self)
)

;======================= CAMP MAX DISTANCES
; mill over in food

(defrule
	(game-time > 3)
	(building-type-count-total BLDG-DROPCARBON == 0) ; none built, none under construction
=>
	(set-strategic-number sn-camp-max-distance 13)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCARBON > 0) ; one is being built
=>
	(set-strategic-number sn-camp-max-distance 18)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCARBON >= 2) ; two built
	(dropsite-min-distance carbon > 6) ; and carbon's still really far away
	(strategic-number sn-camp-max-distance <= 30)
=>
	(set-strategic-number sn-camp-max-distance 30) ; map shenanigans
	(set-strategic-number sn-maximum-carbon-drop-distance 30) ; allow walking ages for it
	(set-goal camplevel 2)
	(disable-self)
)

(defrule
	(or
		(building-type-count BLDG-DROPMETAL > 0) ; or to alleviate minor issues where two nova procs were being built before ore proc/etc
		(building-type-count BLDG-DROPNOVA > 0)
	)
	(building-type-count BLDG-DROPCARBON > 0)
	(strategic-number sn-camp-max-distance < 30)
=>
	(set-strategic-number sn-camp-max-distance 30)
	(set-goal camplevel 2)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(strategic-number sn-camp-max-distance < 30)
=>
	(set-strategic-number sn-camp-max-distance 30)
	(set-goal camplevel 2)
	(disable-self)
)
(defrule
	(current-age == tech-level-4)
	(strategic-number sn-camp-max-distance < 40)
=>
	(set-strategic-number sn-camp-max-distance 40)
	(set-goal camplevel 3)
	(disable-self)
)

(defrule
	(current-age == tech-level-2)
	(game-time > 2700) ; 45min
	(strategic-number sn-camp-max-distance < 40)
=>
	(set-strategic-number sn-camp-max-distance 40)
	(set-goal camplevel 3)
	(disable-self)
)
(defrule
	(current-age == tech-level-3)
	(game-time > 2700) ; 45min
	(strategic-number sn-camp-max-distance < 40)
=>
	(set-strategic-number sn-camp-max-distance 40)
	(set-goal camplevel 3)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(game-time > 3600) ; 1hr 
	(strategic-number sn-camp-max-distance < 60)
=>
	(set-strategic-number sn-camp-max-distance 60)
	(set-goal camplevel 4)
	(disable-self)
)

(defrule
	(current-age == tech-level-3)
	(game-time > 5400) ; 1h30
	(strategic-number sn-camp-max-distance < 70)
=>
	(set-strategic-number sn-camp-max-distance 70)
	(set-goal camplevel 5)
	(disable-self)
)
(defrule
	(current-age == tech-level-4)
	(game-time > 5400) ; 1h30
	(strategic-number sn-camp-max-distance < 70)
=>
	(set-strategic-number sn-camp-max-distance 70)
	(set-goal camplevel 5)
	(disable-self)
)
(defrule
	(current-age == tech-level-4)
	(game-time > 7200) ; 2hr
	(strategic-number sn-camp-max-distance < 80)
=>
	(set-strategic-number sn-camp-max-distance 80)
	(set-goal camplevel 6)
	(disable-self)
)


;======================= TOWN SIZE ATTACK ASSIST

; so, when town size attack is turned off
; it is set to EXHAUSTED

; we need to reset town size to the value it was previously
; this is pretty easy to do

; the issue is that
; we need to reset it
; AND WAIT A BIT FOR ENEMY BUILDINGS IN TOWN TO UPDATE
; before the rest of the script is allowed to activate

; we tried with file order but that didn't work
; packaging it into exhausted would require changing every check for exhausted into exhausted-a and exhausted-b (technically possible)
; it cannot be packed into trackertwo as that contains information about what the timer is doing (eg could get stuck at smol)
; therefore we need a new variable

(defrule
	(not (goal attackTSAhold EXHAUSTED)) ; anything else
	(not (goal townsizetrackerthree DENIED))
=>
	(set-goal townsizetrackerthree DENIED)
)

; takes a LOT of ticks to update apparently - so instead of writing out disable-n rules, we'll just slap it on a timer, and conveniently one already exists

(defrule
	(goal attackTSAhold EXHAUSTED)
	(goal townsizetrackerthree DENIED) 
=>
	(set-goal townsizetrackerthree DISABLE-1)
	(disable-timer t-townsize)
	(enable-timer t-townsize 60) ; tons of time
)

(defrule
	(goal townsizetrackerthree DISABLE-1)
	(timer-triggered t-townsize)
=>
	(set-goal townsizetrackerthree ALLOW)
	(disable-timer t-townsize)
	(enable-timer t-townsize 30) ; in case something else needed it
)







; tech 2
(defrule
	(current-age == tech-level-2)
	(goal attackTSAhold EXHAUSTED)
	(goal townsizetracker SMOL)
	(not (strategic-number sn-maximum-town-size == TL2-townsize-smol))
=>
	(set-strategic-number sn-maximum-town-size TL2-townsize-smol)
	(set-strategic-number sn-sentry-distance TL2-townsize-smol)
	(chat-local-to-self "WAFFLE: TS Mismatch, TS now SMOL")
)
(defrule
	(current-age == tech-level-2)
	(goal attackTSAhold EXHAUSTED)
	(goal townsizetracker NORM)
	(not (strategic-number sn-maximum-town-size == TL2-townsize))
=>
	(set-strategic-number sn-maximum-town-size TL2-townsize)
	(set-strategic-number sn-sentry-distance TL2-townsize)
	(chat-local-to-self "WAFFLE: TS Mismatch, TS now NORM")
)
(defrule
	(current-age == tech-level-2)
	(goal attackTSAhold EXHAUSTED)
	(goal townsizetracker BIG)
	(not (strategic-number sn-maximum-town-size == TL2-townsize-big))
=>
	(set-strategic-number sn-maximum-town-size TL2-townsize-big)
	(set-strategic-number sn-sentry-distance TL2-townsize-big)
	(chat-local-to-self "WAFFLE: TS Mismatch, TS now BIG")
)
(defrule
	(current-age == tech-level-2)
	(goal attackTSAhold EXHAUSTED)
	(goal townsizetracker BIGGER)
	(not (strategic-number sn-maximum-town-size == TL2-townsize-bigger))
=>
	(set-strategic-number sn-maximum-town-size TL2-townsize-bigger)
	(set-strategic-number sn-sentry-distance TL2-townsize-bigger)
	(chat-local-to-self "WAFFLE: TS Mismatch, TS now BIGGER")
)


