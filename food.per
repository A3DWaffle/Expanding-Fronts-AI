; =====================================================
; FILE: food
; PURPOSE:
;   Builds food processing centers and manages hunt, berry, and food-dropoff expansion.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: FIRST FOOD PROCESSING CENTER
;	Chapter 2: HUNT PHASE
;	Chapter 3: EXTRA FOOD PROCESSING CENTERS
;	Chapter 4: FOOD ECONOMY TECHS
;	Chapter 5: DROP-OFF DISTANCES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; =====================================================
; *** Chapter 1: FIRST FOOD PROCESSING CENTER ***
; =====================================================

(defrule
	(game-time > 60)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY)
	)
	(goal hunt-present NO)
	(not (dropsite-min-distance food == -1))
	(dropsite-min-distance food > 2)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (goal savetheanimals YES))
	(can-build BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; Hunt starts use the early Carbon Proc as an eco anchor, then force the first
; Food Proc while hunt is still present so the opener can continue.
(defrule
	(game-time > 120)
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCARBON > 0)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (dropsite-min-distance food == -1))
	(dropsite-min-distance food > 1)
	(can-build-with-escrow BLDG-DROPCHOW)
	(or
		(not (goal savetheanimals YES))
		(or
			(goal allowgarbage LOWLUREFOOD)
			(strategic-number snc-lure-amount > 0)
		)
	)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(game-time > 150)
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(strategic-number snc-lure-amount > 0)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(can-build-with-escrow BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(game-time > 300)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY)
	)
	(goal hunt-present YES)
	(not (unit-type-count GAIA-ANIMAL-LURE-LINE > 0))
	(not (dropsite-min-distance food == -1))
	(dropsite-min-distance food > 2)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (goal savetheanimals YES))
	(can-build BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; If no food can be detected at all, build one processor to unlock farms.
; Extra processors still require actual food distance checks below.
(defrule
	(game-time > 180)
	(current-age == tech-level-1)
	(food-amount < 120)
	(carbon-amount > 150)
	(unit-type-count-total UNIT-WORKER > 10)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (dropsite-min-distance food == -1))
	(dropsite-min-distance food > 2)
	(can-build BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(game-time > 120)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(dropsite-min-distance food == -1)
	(can-build BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; If berries are missing, fall back to a timed first food processor.
(defrule
	(game-time > 90)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (dropsite-min-distance food == -1))
	(dropsite-min-distance food > 2)
	(can-build BLDG-DROPCHOW)
	(goal hunt-present NO)
	(or
		(not (goal savetheanimals YES))
		(game-time > 240)
	)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; If hunt exists, let workers live off the first kills before dropping a food processor.
(defrule
	(game-time > 360)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (dropsite-min-distance food == -1))
	(dropsite-min-distance food > 2)
	(can-build BLDG-DROPCHOW)
	(goal hunt-present YES)
	(not (unit-type-count GAIA-ANIMAL-LURE-LINE > 0))
	(not (goal savetheanimals YES))
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; =====================================================
; *** Chapter 2: HUNT PHASE ***
; =====================================================

; once the first food proc is online on a hunt map, give workers a short hunt window
; before deciding whether they need a second dropoff near the food.
(defrule
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(goal hunt-food-phase NO)
	(building-type-count-total BLDG-DROPCHOW == 1)
=>
	(disable-timer t-huntfood)
	(enable-timer t-huntfood 12)
	(set-goal hunt-food-phase WAITING)
)

(defrule
	(goal hunt-food-phase WAITING)
	(timer-triggered t-huntfood)
=>
	(disable-timer t-huntfood)
	(set-goal hunt-food-phase ALLOW)
)


; Extra processors should only extend to genuinely distant food. Once farms exist,
; broad count-only rules tend to place processors around the CC/farm core.

(defrule
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(goal hunt-food-phase ALLOW)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(dropsite-min-distance food > 5)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; =====================================================
; *** Chapter 3: EXTRA FOOD PROCESSING CENTERS ***
; =====================================================

; Carbon-rich TL1 economies with poor food should extend to remaining food
; instead of turning the first town food site into the whole food economy.
(defrule
	(current-age == tech-level-1)
	(food-amount < 250)
	(carbon-amount > 350)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(dropsite-min-distance food > 4)
	(can-build BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; TL2 can still have enough hunt/berries left to justify more food coverage,
; but stop before this turns into late-game proc spam.
(defrule
	(current-age == tech-level-2)
	(goal hunt-present YES)
	(food-amount < 350)
	(carbon-amount > 300)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(dropsite-min-distance food > 5)
	(can-build BLDG-DROPCHOW)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(or
		(current-age == tech-level-1)
		(current-age == tech-level-2)
	)
	(goal openingstyle STYLE-DEFENSIVE)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY)
	)
	(dropsite-min-distance food > 8)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(or
		(current-age == tech-level-1)
		(current-age == tech-level-2)
	)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(building-type-count-total BLDG-DROPNOVA > 0)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY)
	)
	(dropsite-min-distance food > 8)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; On hunt maps, TL2 should keep extending toward live food instead of immediately
; defaulting to farms. Build a second chow proc fairly early if the walk is still bad.
(defrule
	(current-age == tech-level-2)
	(current-age-time > 120)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(dropsite-min-distance food > 5)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-2)
	(current-age-time > 120)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-DROPNOVA > 0)
	(dropsite-min-distance food > 5)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; If TL2 hunt is still stretched after the second proc, allow a third before
; the AI falls back to farms as the main answer.
(defrule
	(current-age == tech-level-2)
	(current-age-time > 360)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(building-type-count-total BLDG-DROPCHOW >= 2)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(dropsite-min-distance food > 8)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-2)
	(current-age-time > 360)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(building-type-count-total BLDG-DROPCHOW >= 2)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-DROPNOVA > 0)
	(dropsite-min-distance food > 8)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-3)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 4)
	(dropsite-min-distance food > 6)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(building-type-count-total BLDG-DROPCHOW < 5)
	(dropsite-min-distance food > 8)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; If there are abundant berries, allow extra processors without waiting on hunt distance.

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(goal berries-present PLENTY)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(can-build BLDG-DROPCHOW)
	(dropsite-min-distance food > 8)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(goal berries-present PLENTY)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-DROPNOVA > 0)
	(can-build BLDG-DROPCHOW)
	(dropsite-min-distance food > 8)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(or
		(and
			(building-type-count-total BLDG-TRAINTROOPER > 0)
			(building-type-count-total BLDG-POWERCORE > 0 )
		)
		(carbon-amount > 400)
	)
	(goal openingstyle STYLE-DEFENSIVE)
	(building-type-count-total BLDG-DROPMETAL > 0)
	(goal berries-present PLENTY)
	(dropsite-min-distance food > 9)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(or
		(and
			(building-type-count-total BLDG-TRAINTROOPER > 0)
			(building-type-count-total BLDG-POWERCORE > 0 )
		)
		(carbon-amount > 400)
	)
	(not (goal openingstyle STYLE-DEFENSIVE))
	(building-type-count-total BLDG-DROPNOVA > 0)
	(goal berries-present PLENTY)
	(dropsite-min-distance food > 9)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
	(not (goal buildpause YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; =====================================================
; *** Chapter 4: FOOD ECONOMY TECHS ***
; =====================================================

(defrule
	(or
		(current-age >= tech-level-3)
		(and
			(current-age == tech-level-2)
			(goal agingup YES)
		)
	)
	(can-research-with-escrow rt-irrigation)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-irrigation)
)

(defrule 
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-harvesting)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-harvesting)
)

(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-adv-harvesting)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-adv-harvesting)
)

; =====================================================
; *** Chapter 5: DROP-OFF DISTANCES ***
; =====================================================

(defrule
	(true)
=>
	(set-strategic-number sn-mill-max-distance 12)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0)
=>
	(set-strategic-number sn-mill-max-distance 16)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0)
	(goal hunt-present YES)
=>
	(set-strategic-number sn-mill-max-distance 32)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2) 
=>
	(set-strategic-number sn-mill-max-distance 18)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2)
	(goal hunt-present YES)
=>
	(set-strategic-number sn-mill-max-distance 36)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0)
	(goal berries-present PLENTY)
=>
	(set-strategic-number sn-mill-max-distance 20)
	(disable-self)
)


(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2) 
	(goal berries-present PLENTY)
=>
	(set-strategic-number sn-mill-max-distance 30)
	(disable-self)
)

; TL1 hunt maps need a tighter food search radius. The broad hunt values above
; can make workers chase edge animals instead of clearing the local food patch.
(defrule
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW == 1)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-mill-max-distance == 20))
=>
	(set-strategic-number sn-mill-max-distance 20)
)

(defrule
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW >= 2)
	(not (goal savetheanimals YES))
	(not (goal savetheanimals WAITING))
	(not (strategic-number sn-mill-max-distance == 24))
=>
	(set-strategic-number sn-mill-max-distance 24)
)
