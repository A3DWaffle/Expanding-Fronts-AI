; =====================================================
; FILE: food
; PURPOSE:
;   Builds food processing centers and manages hunt, berry, and food-dropoff expansion.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: FOOD CTR
;	Chapter 2: HUNT PHASE
;	Chapter 3: TL2+ FOOD CTR
;	Chapter 4: DISTANCES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

(defrule
	(game-time > 60) ; give the AI a bit to scout its berries
	(or
		(goal berries-present YES) ; this trigger uses cc so essentially fires before the AI finds its berries
		(goal berries-present PLENTY)
	)
	(not (dropsite-min-distance food == -1)) ; try and find them
	(building-type-count-total BLDG-DROPCHOW == 0)
	(not (goal savetheanimals YES))
	(can-build BLDG-DROPCHOW)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; rule for building if we don't have berries
(defrule
	(game-time > 90) ; timeout
	(building-type-count-total BLDG-DROPCHOW == 0)
	(can-build BLDG-DROPCHOW)
	(goal hunt-present NO)
	(or
		(not (goal savetheanimals YES))
		(game-time > 240) ; abort timeout for animals
	)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; if hunt exists, let workers live off the first kills for a bit before dropping a food proc
(defrule
	(game-time > 180)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(can-build BLDG-DROPCHOW)
	(goal hunt-present YES)
	(not (goal savetheanimals YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(game-time > 60)
	(building-type-count-total BLDG-DROPCHOW == 0)
	(can-build BLDG-DROPCHOW)
	(goal hunt-present YES)
	(unit-type-count GAIA-ANIMAL-HUNT-LINE < 4)
	(not (goal savetheanimals YES))
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; once the first food proc is online on a hunt map, give workers a short hunt window
; before deciding whether they need a second dropoff near the food.
(defrule
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(goal hunt-food-phase NO)
	(building-type-count-total BLDG-DROPCHOW == 1)
=>
	(disable-timer t-huntfood)
	(enable-timer t-huntfood 12)
	(set-goal hunt-food-phase WAITING)
)

(defrule
	(goal hunt-food-phase WAITING)
	(timer-triggered t-huntfood)
=>
	(disable-timer t-huntfood)
	(set-goal hunt-food-phase ALLOW)
)


; so it turns out (dropsite-min-distance food > 3) doesn't really... work, lategame
; one way or another
; probably due to one random farm by a food proc

; so we probably should do the old-fashioned way of specifying counts per TL

(defrule
	(current-age == tech-level-1)
	(goal hunt-present YES)
	(goal hunt-food-phase ALLOW)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(dropsite-min-distance food > 6)
	(not (town-under-attack))
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(or
		(current-age == tech-level-1)
		(current-age == tech-level-2)
	)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 2) ; Build a second in T1, but only after all other buildings are done
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(or
		(and
			(goal openingstyle STYLE-DEFENSIVE)
			(building-type-count-total BLDG-DROPMETAL > 0)
		)
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-DROPNOVA > 0)
		)
	)
	(or
		(goal berries-present YES)
		(goal berries-present PLENTY) ; only build a second one if berries
	)
	(not (town-under-attack))
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; On hunt maps, TL2 should keep extending toward live food instead of immediately
; defaulting to farms. Build a second chow proc fairly early if the walk is still bad.
(defrule
	(current-age == tech-level-2)
	(current-age-time > 120)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(building-type-count-total BLDG-DROPCHOW > 0)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(or
		(and
			(goal openingstyle STYLE-DEFENSIVE)
			(building-type-count-total BLDG-DROPMETAL > 0)
		)
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-DROPNOVA > 0)
		)
	)
	(dropsite-min-distance food > 6)
	(not (town-under-attack))
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; If TL2 hunt is still stretched after the second proc, allow a third before
; the AI falls back to farms as the main answer.
(defrule
	(current-age == tech-level-2)
	(current-age-time > 360)
	(goal hunt-present YES)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(building-type-count-total BLDG-DROPCHOW >= 2)
	(or
		(and
			(goal openingstyle STYLE-DEFENSIVE)
			(building-type-count-total BLDG-DROPMETAL > 0)
		)
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-DROPNOVA > 0)
		)
	)
	(dropsite-min-distance food > 8)
	(not (town-under-attack))
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-3)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 3)
	(can-build BLDG-DROPCHOW)
	(not (town-under-attack))
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-4)
	(current-age-time > 600)
	(building-type-count-total BLDG-DROPCHOW < 4)
	(can-build BLDG-DROPCHOW)
	(not (town-under-attack))
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

; and if there are silly berries on the map

(defrule
	(current-age == tech-level-1)
	(building-type-count-total BLDG-TRAINTROOPER > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(current-age-time > 300)
	(building-type-count-total BLDG-DROPCHOW < 2)
	(not (town-under-attack))
	(goal berries-present PLENTY)
	(or
		(and
			(goal openingstyle STYLE-DEFENSIVE)
			(building-type-count-total BLDG-DROPMETAL > 0)
		)
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-DROPNOVA > 0)
		)
	)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-DROPCHOW < 4)
	(or
		(and
			(building-type-count-total BLDG-TRAINTROOPER > 0) ; get these buildings up first (if you haven't already)
			(building-type-count-total BLDG-POWERCORE > 0 )
		)
		(carbon-amount > 400) ; override
	)
	(or
		(and
			(goal openingstyle STYLE-DEFENSIVE)
			(building-type-count-total BLDG-DROPMETAL > 0)
		)
		(and
			(not (goal openingstyle STYLE-DEFENSIVE))
			(building-type-count-total BLDG-DROPNOVA > 0)
		)
	)
	(not (town-under-attack))
	(goal berries-present PLENTY)
	(can-build BLDG-DROPCHOW)
	(building-type-count BLDG-MAIN > 0)
=>
	(set-goal resourcerefund cfoodproc)
	(build BLDG-DROPCHOW)
)

(defrule
	; Irrigation
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-irrigation)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-irrigation)
)

(defrule 
	; Harvesting Program
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-harvesting)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-harvesting)
)

(defrule
	; Advanced Harvesting Program
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-adv-harvesting)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-adv-harvesting)
)

; DISTANCES

(defrule
	(true)
=>
	(set-strategic-number sn-mill-max-distance 12) ; starting value
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0) ; one is being built
=>
	(set-strategic-number sn-mill-max-distance 16)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0)
	(goal hunt-present YES)
=>
	(set-strategic-number sn-mill-max-distance 24)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2) 
=>
	(set-strategic-number sn-mill-max-distance 18)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2)
	(goal hunt-present YES)
=>
	(set-strategic-number sn-mill-max-distance 28)
	(disable-self)
)

(defrule
	(building-type-count-total BLDG-DROPCHOW > 0) ; one is being built
	(goal berries-present PLENTY) ; allow further
=>
	(set-strategic-number sn-mill-max-distance 20)
	(disable-self)
)


(defrule
	(building-type-count-total BLDG-DROPCHOW >= 2) 
	(goal berries-present PLENTY) ; allow further
=>
	(set-strategic-number sn-mill-max-distance 30)
	(disable-self)
)
