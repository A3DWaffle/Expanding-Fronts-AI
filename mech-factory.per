; =====================================================
; FILE: mech-factory
; PURPOSE:
;   Builds Mech Factories, researches mech upgrades, and trains mech packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL3 PACKAGES
;	Chapter 4: TL4 CORE MECH ARM
;	Chapter 5: TL4 SUPPORT MECHS
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; =====================================================
; *** Chapter 1: BUILDINGS ***
; =====================================================

(defrule
	(current-age == tech-level-2)
	;(or
	;	(goal openingstyle STYLE-AGGRESSIVE)
	;	(or
	;		(and
	;			(goal openingstyle STYLE-RUSH)
	;			(goal support-masters NO)
	;		)
	;		(and
	;			(goal openingstyle STYLE-DEFENSIVE)
	;			(goal support-masters NO)
	;		)
	;	)
	;)
	(goal support-aircraft NO)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-TRAINMECH == 0)
	(building-type-count BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINMECH)
)

; --- T3 Mech Factories ---
; RAID: split oversized prerequisite list
(defrule
	(true)
=>
	(set-goal raid-rule-check YES)
)

(defrule
	(goal raid-rule-check YES)
	(not (current-age == tech-level-3))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (or (goal combat-arm TROOP) (or (goal combat-arm STRIKE/HW) (or (goal combat-arm MECHBALL) (goal combat-arm DEATHBALL)))))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-TRAINMECH < 2))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (building-type-count-total BLDG-POWERCORE > 0))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (can-build-with-escrow BLDG-TRAINMECH))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (metal-amount > 25))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (not (goal buildpause YES)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (not (too-many-unpowered-buildings)))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
	(not (goal raid-build-open YES))
=>
	(set-goal raid-rule-check NO)
)

(defrule
	(goal raid-rule-check YES)
=>
	(build BLDG-TRAINMECH)
)



