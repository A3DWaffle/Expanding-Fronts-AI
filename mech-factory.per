	(current-age == tech-level-3)
	(or
		(goal combat-arm MECHBALL)
		(goal combat-arm DEATHBALL)
	)
	(not (goal passiveage YES))
	(goal special-map WATER)
	(and
	(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p1-water)
	(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p2-water)
	)
	(can-train UNIT-MECH1-LINE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm MECHBALL)
		(goal combat-arm DEATHBALL)
	)
	(not (goal passiveage YES))
	(goal special-map ASTEROID)
	(and
	(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p1-asteroid)
	(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p2-asteroid)
	)
	(can-train UNIT-MECH1-LINE)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm MECHBALL)
		(goal combat-arm DEATHBALL)
	)
	(not (goal passiveage YES))
	(goal special-map HYBRID)
	(and
	(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p1-hybrid)
	(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p2-hybrid)
	)
	(can-train UNIT-MECH1-LINE)
