(defrule
	(current-age == tech-level-4)
	(goal combat-arm TROOP)
	(building-type-count-total BLDG-TRAINMECH < 3)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
	(goal raid-build-open YES)
=>
	(build BLDG-TRAINMECH)
)
; =====================================================
; *** Chapter 2: UPGRADES ***
; =====================================================

; --- Heavy Strike Mech ---
(defrule
	(can-research-with-escrow ut-single-mech-2)
	(current-age >= tech-level-4)
	(goal support-strike YES)
	(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p1)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-single-mech-2)
)

; --- Heavy Mech Destroyer ---
; Upgrade actual Destroyers, including detection-counter units. Do not wait
; for a land package target or a support flag that counter training ignores.
(defrule
	(can-research-with-escrow ut-dual-mech-2)
	(current-age >= tech-level-4)
	(unit-type-count UNIT-MECH2-LINE >= 1)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-dual-mech-2)
)

; --- Heavy Assault Mech ---
(defrule
	(can-research-with-escrow ut-multi-mech-2)
	(current-age >= tech-level-4)
	(goal support-assault-mech YES)
	(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p1)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-multi-mech-2)
)

(defrule
    ; Technicians
	(can-research-with-escrow rt-wookiee-mechanics)
	(current-age >= tech-level-4)
	(or
		(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p2)
		(or
			(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
			(or
				(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p2)
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-wookiee-mechanics)
)

(defrule
    ; Wookiee Ingenuity
	(can-research-with-escrow rt-wookiee-ingenuity)
	(current-age >= tech-level-4)
	(or
		(research-completed rt-wookiee-mechanics)
		(not (research-available rt-wookiee-mechanics))
	)
	(or
		(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p2)
		(or
			(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
			(or
				(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p2)
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-wookiee-ingenuity)
)

(defrule
    ; Advanced Redesign / Adv Redesign
	(can-research-with-escrow rt-adv-redesign)
	(current-age >= tech-level-4)
	(or
		(research-completed rt-wookiee-ingenuity)
		(not (research-available rt-wookiee-ingenuity))
	)
	(or
		(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p2)
		(or
			(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
			(or
				(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p2)
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-adv-redesign)
)

(defrule
	; Auxiliary Power Cells
	(current-age >= tech-level-4)
	(goal support-assault-mech YES)
	(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p1)
	(can-research-with-escrow rt-aux-power-cells)
	(or
		(research-completed ut-multi-mech-2)
		(not (research-available ut-multi-mech-2))
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-aux-power-cells)
)

(defrule
	; Upgraded Generator
	(can-research-with-escrow rt-upgraded-generators)
	(current-age >= tech-level-4)
	(or
		(research-completed rt-adv-redesign)
		(not (research-available rt-adv-redesign))
	)
	(or
		(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p2)
		(or
			(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
			(or
				(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p2)
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-upgraded-generators)
)

(defrule
	; Advanced Generator
	(can-research-with-escrow rt-adv-generator)
	(current-age >= tech-level-4)
	(or
		(research-completed rt-upgraded-generators)
		(not (research-available rt-upgraded-generators))
	)
	(or
		(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p2)
		(or
			(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
			(or
				(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p2)
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
			)
		)
	)
=>
	(release-escrow metal)
	(release-escrow nova)
	(research rt-adv-generator)
)

(defrule
	; GE Walker Research
	(can-research-with-escrow rt-transport-capability)
	(current-age >= tech-level-4)
	(goal support-assault-mech YES)
	(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p1)
	(or
		(research-completed rt-aux-power-cells)
		(not (research-available rt-aux-power-cells))
	)
=>
	(release-escrow metal)
	(release-escrow nova)
	(research rt-transport-capability)
)

(defrule
	; GN Creature Armor
	(can-research-with-escrow rt-goonga-armor)
	(current-age >= tech-level-4)
	(or
		(research-completed rt-adv-redesign)
		(not (research-available rt-adv-redesign))
	)
	(or
		(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p2)
		(or
			(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
			(or
				(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p2)
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-goonga-armor)
)

(defrule
	; ZC Phased Pulse Cannons
	(can-research-with-escrow rt-phased-pulse)
	(current-age >= tech-level-4)
	(or
		(research-completed rt-adv-redesign)
		(not (research-available rt-adv-redesign))
	)
	(or
		(unit-type-count-total UNIT-MECH1-LINE >= TL4-mech1-arm-p2)
		(or
			(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p2)
			(or
				(unit-type-count-total UNIT-MECH3-LINE >= TL4-mech3-arm-p2)
				(unit-type-count-total UNIT-MECH4-LINE >= TL4-mech4-supp-p1)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-phased-pulse)
)

(defrule
	; IR Advanced Particle Cannons
	(can-research-with-escrow rt-advparticlecannon)
	(current-age >= tech-level-4)
	(goal support-destroyer YES)
	(unit-type-count-total UNIT-MECH2-LINE >= TL4-mech2-arm-p1)
	(or
		(research-completed ut-dual-mech-2)
		(not (research-available ut-dual-mech-2))
	)
=>
	(release-escrow food)
	(release-escrow metal)
	(release-escrow nova)
	(research rt-advparticlecannon)
)

(defrule
	; RS Salvaged Components
	(can-research-with-escrow rt-salvcomponents)
	(current-age >= tech-level-4)
	(or
		(goal combat-arm MECHBALL)
		(or
			(goal combat-arm STRIKE/HW)
			(goal support-uu YES)
		)
	)
	(or
		(research-completed rt-adv-redesign)
		(not (research-available rt-adv-redesign))
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-salvcomponents)
)

; =====================================================
; *** Chapter 3: TL3 PACKAGES ***
; =====================================================

; Replace the starting scout if the AI has lost it.
(defrule
	(current-age >= tech-level-2)
	(unit-type-count-total UNIT-FASTBIKE-LINE < 1)
	(can-train UNIT-FASTBIKE-LINE)
=>
	(train UNIT-FASTBIKE-LINE)
	(disable-self)
)

; -----------------------
; STRIKE MECH
; -----------------------


; A small TL3 core floor makes the normal wave composition checks attainable.
; Retain larger existing packages and keep small-cap games on their old targets.
#load-if-not-defined POPULATION-CAP-25
#load-if-not-defined POPULATION-CAP-50
(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm STRIKE/HW)
		(or (goal combat-arm MECHBALL) (goal combat-arm DEATHBALL))
	)
	(unit-type-count-total UNIT-MECH1-LINE < 8)
	(can-train UNIT-MECH1-LINE)
=>
	(train UNIT-MECH1-LINE)
)
#end-if
#end-if

(defrule
	(can-train UNIT-MECH1-LINE)
	(current-age == tech-level-3)
	(goal support-strike YES)
	(goal special-map LAND)
	(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

(defrule
	(can-train UNIT-MECH1-LINE)
	(current-age == tech-level-3)
	(goal support-strike YES)
	(goal special-map WATER)
	(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1-water)
	
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

(defrule
	(can-train UNIT-MECH1-LINE)
	(current-age == tech-level-3)
	(goal support-strike YES)
	(goal special-map ASTEROID)
	(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1-asteroid)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

(defrule
	(can-train UNIT-MECH1-LINE)
	(current-age == tech-level-3)
	(goal support-strike YES)
	(goal special-map HYBRID)
	(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p1-hybrid)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

; A TL4 LAND Strike lineup must be able to rebuild a spare core even at low caps.
#load-if-not-defined POPULATION-CAP-25
#load-if-not-defined POPULATION-CAP-50
(defrule
	(current-age == tech-level-4)
	(goal special-map LAND)
	(goal combat-arm STRIKE/HW)
	(unit-type-count-total UNIT-MECH1-LINE < 8)
	(can-train UNIT-MECH1-LINE)
=>
	(train UNIT-MECH1-LINE)
)
#end-if
#end-if

; --- TL3 Strike core p1 ---
(defrule
	(can-train UNIT-MECH1-LINE)
	(current-age == tech-level-3)
	(or
		(goal combat-arm MECHBALL)
		(goal combat-arm DEATHBALL)
	)
	(not (goal passiveage YES))
	(goal special-map LAND)
	(and
		(unit-type-count-total UNIT-MECH2-LINE >= TL3-mech2-arm-p1)
		(unit-type-count-total UNIT-MECH1-LINE < TL3-mech1-arm-p2)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(train UNIT-MECH1-LINE)
)

