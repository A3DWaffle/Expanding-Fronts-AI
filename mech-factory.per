; =====================================================
; FILE: mech-factory
; PURPOSE:
;   Builds Mech Factories, researches mech upgrades, and trains mech packages.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: UPGRADES
;	Chapter 3: TL3 PACKAGES
;	Chapter 4: TL4 CORE MECH ARM
;	Chapter 5: TL4 SUPPORT MECHS
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; =====================================================
; *** Chapter 1: BUILDINGS ***
; =====================================================

(defrule
	(current-age == tech-level-2)
	(building-type-count-total BLDG-TRAINMECH == 0)
	(building-type-count BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
=>
	(set-goal tryingtobuild MECH)
)

; --- T3 Mech Factories ---
(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-TRAINMECH < 2)
	(or
		(building-type-count-total BLDG-TRAINAIR == 2); Defensive
		(building-type-count BLDG-MAIN > 2) ; Aggressive
	)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Late T3 Mech Factory ---
(defrule
	(current-age == tech-level-3)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(building-type-count-total BLDG-TRAINMECH < 3)
	(building-type-count-total BLDG-TRAINMECH >= 2)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-WARCTR > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- TL3 post-spine Mech Factory scaling ---
(defrule
	(current-age == tech-level-3)
	(building-type-count-total BLDG-TRAINMECH < 4)
	(building-type-count-total BLDG-TRAINMECH >= 3)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-WARCTR > 0)
	(building-type-count-total BLDG-MAIN >= 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(carbon-amount > 600)
	(metal-amount > 50)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Standard TL4 Mech Factory ---
(defrule
	(current-age == tech-level-4)
	(building-type-count-total BLDG-TRAINMECH < 2)
	(building-type-count-total BLDG-MAIN >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Mech package: third factory ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
	(building-type-count-total BLDG-TRAINMECH < 3)
	(building-type-count-total BLDG-RESCTR >= 1)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Mech package: fourth factory ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
	(building-type-count-total BLDG-TRAINMECH < 4)
	(building-type-count-total BLDG-TRAINMECH >= 3)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(current-age-time > 420)
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Mech package: fifth factory ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(building-type-count-total BLDG-TRAINMECH < 5)
	(building-type-count-total BLDG-TRAINMECH >= 4)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(current-age-time > 840)
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; --- Mech package: sixth factory ---
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(building-type-count-total BLDG-TRAINMECH < 6)
	(building-type-count-total BLDG-TRAINMECH >= 5)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 25)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(current-age-time > 1260)
	(not (too-many-unpowered-buildings))
=>
	(set-goal tryingtobuild MECH)
)

; Rich TL4 forward mech scaling. Spend large banks through forward queues
; without changing normal timing caps.
(defrule
	(current-age == tech-level-4)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
	(building-type-count-total BLDG-TRAINMECH >= 6)
	(building-type-count-total BLDG-TRAINMECH < 8)
	(building-type-count-total BLDG-POWERCORE > 0)
	(carbon-amount > 2500)
	(food-amount > 1000)
	(nova-amount > 700)
	(metal-amount > 300)
	(military-population >= MIL_POP_B)
	(can-build-with-escrow BLDG-TRAINMECH)
	(not (goal tryingtobuild MECH))
	(not (goal buildpause YES))
	(not (too-many-unpowered-buildings))
=>
	(release-escrow carbon)
	(build-forward BLDG-TRAINMECH)
)

; =====================================================
; *** Chapter 2: UPGRADES ***
; =====================================================

; --- Heavy Strike Mech ---
(defrule
	(current-age >= tech-level-4)
	(unit-type-count-total UNIT-MECH1-LINE > 0)
	(can-research-with-escrow ut-single-mech-2)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-single-mech-2)
)

; --- Heavy Mech Destroyer ---
(defrule
	(current-age >= tech-level-4)
	(unit-type-count-total UNIT-MECH2-LINE > 0)
	(can-research-with-escrow ut-dual-mech-2)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research ut-dual-mech-2)
)

; --- Heavy Assault Mech ---
(defrule
	(current-age >= tech-level-4)
	(can-research-with-escrow ut-multi-mech-2)
	(unit-type-count-total UNIT-MECH3-LINE > 0)
	(not (research-available ut-dual-mech-2))
	(not (research-available ut-single-mech-2))
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-multi-mech-2)
)

(defrule
    ; Technicians
	(can-research-with-escrow rt-wookiee-mechanics)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(or
				(unit-type-count-total UNIT-MECH3-LINE > 0)
				(unit-type-count-total UNIT-MECH4-LINE > 0)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow metal)
	(research rt-wookiee-mechanics)
)

(defrule
    ; Wookiee Ingenuity
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-wookiee-ingenuity)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(or
				(unit-type-count-total UNIT-MECH3-LINE > 0)
				(unit-type-count-total UNIT-MECH4-LINE > 0)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-wookiee-ingenuity)
)

(defrule
    ; Wookiee Ingenuity rich/late fallback
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-wookiee-ingenuity)
	(or
		(current-age-time > 480)
		(and
			(food-amount > 700)
			(nova-amount > 500)
		)
	)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
	(building-type-count-total BLDG-TRAINMECH > 0)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-wookiee-ingenuity)
)

(defrule
    ; Advanced Redesign / Adv Redesign
	(can-research-with-escrow rt-adv-redesign)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(unit-type-count-total UNIT-MECH3-LINE > 0)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-adv-redesign)
)

(defrule
	; Auxiliary Power Cells
	(current-age >= tech-level-4)
	(goal importantT4research DONE)
	(can-research-with-escrow rt-aux-power-cells)
	(unit-type-count-total UNIT-MECH3-LINE > 0)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-aux-power-cells)
)

(defrule
	; Upgraded Generator
	(can-research-with-escrow rt-upgraded-generators)
	(goal importantT3research DONE)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(unit-type-count-total UNIT-MECH3-LINE > 0)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-upgraded-generators)
)

(defrule
	; Advanced Generator
	(can-research-with-escrow rt-adv-generator)
	(goal importantT4research DONE)
	(or
		(unit-type-count-total UNIT-MECH1-LINE > 0)
		(or
			(unit-type-count-total UNIT-MECH2-LINE > 0)
			(unit-type-count-total UNIT-MECH3-LINE > 0)
		)
	)
=>
	(release-escrow metal)
	(release-escrow nova)
	(research rt-adv-generator)
)

(defrule
	; GE Walker Research
	(can-research-with-escrow rt-transport-capability)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
=>
	(release-escrow metal)
	(release-escrow nova)
	(research rt-transport-capability)
)

(defrule
	; GN Creature Armor
	(can-research-with-escrow rt-goonga-armor)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
