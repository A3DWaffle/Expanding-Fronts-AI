; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; -----------------------------------------------------
; *** Chapter 1: GLOBAL PRIORITY ***
; -----------------------------------------------------

;  Normally, file load order does not matter. However, in the case of the advancement to a tech level, a whole bunch of techs
;  suddenly become available. The prioritization system already handles some of them, but in these specific cases, some techs should
;  be researched over others. By putting them first in the file, it ensures that if the AI has the resources on hand, it will get these
;  as opposed to the other techs

; Update: A train is actually one of the most efficent ways to link data. So what I've done is linked techs to another tech in all unit training buildings
; thereby making this strategy moot but the above is a viable strategy as well.

(defrule
	; Efficient Buildings
	(can-research-with-escrow rt-effbldgs)
	(current-age >= tech-level-3)
=>
	(release-escrow nova)
	(research rt-effbldgs)
)

(defrule
	; Automated Processes
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-automated-processes)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-automated-processes)
)

(defrule
    ; Adv Missile Turret
	(can-research-with-escrow ut-adv-missile-turret) ; important tech
	(current-age >= tech-level-4)
	(not (goal enemyairsighted AIR-ALERT-NONE))
=>
	(release-escrow carbon)
	(release-escrow metal)
    (research ut-adv-missile-turret)
)


;==============================
; *** Chapter 2: SHIPYARD ***
;==============================

(defrule
    ; Redesigned Specifications
	(building-type-count BLDG-TRAINBOAT > 0)
	(current-age >= tech-level-4)
	(goal combat-arm SEA)
	(can-research-with-escrow rt-redesigned-specs)
	=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-redesigned-specs)
)

(defrule
    ; Advanced Propulsion
	(current-age >= tech-level-4)
	(goal combat-arm SEA)
	(can-research-with-escrow rt-adv-propulsion)
	=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-adv-propulsion)
)

(defrule
    ; Redoubled Efforts
	(current-age >= tech-level-4)
	(goal combat-arm SEA)
	(can-research-with-escrow rt-redoubled-efforts)
	=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-redoubled-efforts)
)

(defrule
    ; Advanced Scanning Capabilities
	(current-age >= tech-level-4)
	(goal combat-arm SEA)
	(can-research-with-escrow rt-adv-scanners)
	=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-adv-scanners)
)

; -----------------------------------------------------
; *** Chapter 3: COMMAND CENTER
; -----------------------------------------------------

; Motivators & basic training moved to homebase due to file load issues

(defrule
	; Sensor Beacon
	(can-research rt-sensor-beacon)
	(current-age == tech-level-2)
	(military-population >= MIL_POP_A)
=>
	(research rt-sensor-beacon)
)

(defrule
	; Sensor Beacon
	(can-research rt-sensor-beacon)
	(current-age >= tech-level-3)
	(building-type-count BLDG-MAIN > 3)
	(military-population >= MIL_POP_A)
=>
	(research rt-sensor-beacon)
)

(defrule
	; Sensor Array
	(can-research rt-sensor-array)
	(current-age >= tech-level-3)
	(building-type-count BLDG-MAIN > 3)
	(military-population >= MIL_POP_A)
=>
	(research rt-sensor-array)
)

(defrule        
	; WK Self Regeneration
	(can-research-with-escrow rt-self-regeneration) 
	(current-age >= tech-level-4)
=>
	(release-escrow food)
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-self-regeneration)
)

(defrule        
	; GO Geonosian Diligence
	(can-research-with-escrow rt-diligence)
	(current-age >= tech-level-4)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-diligence)
)

; -----------------------------------------------------
; *** Chapter 4: DEFENSIVE RESEARCH *** 
; -----------------------------------------------------
; TURRETS, WALLS, ALL THOSE FUN THINGS
; All Yittreas approved structures, of course.

(defrule
    ; Hvy Wall
	(can-research-with-escrow ut-heavy-wall)
	(building-type-count BLDG-BARRIER-LINE > 0)
	(goal allow-wall ALLOW)
=>
	(release-escrow carbon)
	(release-escrow metal)
	(research ut-heavy-wall)
)

