	(goal importantT4research DONE)
    (can-research-with-escrow ut-adv-turret)
=>
	(release-escrow carbon)
	(release-escrow food)
    (research ut-adv-turret)
)

(defrule
    ; Anti-Air Battery
	(or
		(and
			(current-age >= tech-level-3)
			(goal importantT3research DONE) ; not the first thing you should get
		)
		(and
			(current-age >= tech-level-4)
			(goal importantT4research DONE)
		)
	)
	(can-research rt-aa-battery)
=>
	;(release-escrow carbon)
	;(release-escrow metal)
	(research rt-aa-battery) ; not escrowed, probably should be, but oh well the AI is a bit garbage with them anyway
)

