(defrule
	; Bundle priority: troop arms finish their TL4 unit upgrade.
	(current-age >= tech-level-4)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(can-research-with-escrow ut-laser-4)
