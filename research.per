; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; Strategy bundles keep the AI from calling an age's "important" research done
; before the rolled combat package has its actual foundation techs.

(defrule
	(goal combat-arm TROOP)
	(research-completed rt-macrobinoculars)
	(research-completed rt-primary-focus-coils)
	(research-completed rt-basic-armor)
=>
	(set-goal researchbundleT2 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm TROOP/HW)
	(research-completed rt-macrobinoculars)
	(research-completed rt-primary-focus-coils)
	(research-completed rt-basic-armor)
=>
	(set-goal researchbundleT2 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm MECH)
	(research-completed rt-macrobinoculars)
	(research-completed rt-primary-focus-coils)
	(research-completed rt-light-plating)
=>
	(set-goal researchbundleT2 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm MECH/HW)
	(research-completed rt-macrobinoculars)
	(research-completed rt-primary-focus-coils)
	(research-completed rt-light-plating)
=>
	(set-goal researchbundleT2 DONE)
	(disable-self)
)

(defrule
	(or
		(goal support-aircraft YES)
		(goal combat-arm SEA)
	)
	(research-completed rt-macrobinoculars)
=>
	(set-goal researchbundleT2 DONE)
	(disable-self)
)

; T3
(defrule
	(goal combat-arm TROOP)
	(research-completed rt-portable-scanners)
	(research-completed ut-laser-3)
	(research-completed rt-light-armor)
=>
	(set-goal researchbundleT3 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm TROOP/HW)
	(research-completed rt-portable-scanners)
	(research-completed ut-laser-3)
	(research-completed rt-light-armor)
=>
	(set-goal researchbundleT3 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm MECH)
	(research-completed rt-elevation-tracking)
	(research-completed rt-external-sensor-pod)
	(research-completed rt-medium-plating)
=>
	(set-goal researchbundleT3 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm MECH/HW)
	(research-completed rt-elevation-tracking)
	(research-completed rt-external-sensor-pod)
	(research-completed rt-medium-plating)
=>
	(set-goal researchbundleT3 DONE)
	(disable-self)
)

(defrule
	(goal support-aircraft YES)
=>
	(set-goal researchbundleT3 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm SEA)
	(research-completed rt-upgraded-motivator)
=>
	(set-goal researchbundleT3 DONE)
	(disable-self)
)

; T4
; Split availability-safe tech checks so bundle rules stay below the rule-size cap.
(defrule
	(current-age == tech-level-4)
	(or
		(research-completed ut-laser-4)
		(not (research-available ut-laser-4))
	)
=>
	(set-goal t4-laser-ready DONE)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(or
		(research-completed rt-heavy-armor)
		(not (research-available rt-heavy-armor))
	)
=>
	(set-goal t4-heavy-armor-ready DONE)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(or
		(research-completed rt-homing-sensors)
		(not (research-available rt-homing-sensors))
	)
=>
	(set-goal t4-homing-ready DONE)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(or
		(research-completed rt-heavy-plating)
		(not (research-available rt-heavy-plating))
	)
=>
	(set-goal t4-heavy-plating-ready DONE)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(or
		(research-completed rt-targetting-sensors)
		(not (research-available rt-targetting-sensors))
	)
=>
	(set-goal t4-targeting-ready DONE)
	(disable-self)
)

(defrule
	(current-age == tech-level-4)
	(or
		(research-completed ut-artillery-2)
		(not (research-available ut-artillery-2))
	)
=>
	(set-goal t4-artillery-ready DONE)
	(disable-self)
)

(defrule
	(goal combat-arm TROOP)
	(goal t4-laser-ready DONE)
	(goal t4-heavy-armor-ready DONE)
	(goal t4-homing-ready DONE)
=>
	(set-goal researchbundleT4 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm TROOP/HW)
	(goal t4-laser-ready DONE)
	(goal t4-heavy-armor-ready DONE)
	(goal t4-homing-ready DONE)
	(goal t4-artillery-ready DONE)
=>
	(set-goal researchbundleT4 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm MECH)
	(goal t4-heavy-plating-ready DONE)
	(goal t4-targeting-ready DONE)
=>
	(set-goal researchbundleT4 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm MECH/HW)
	(goal t4-heavy-plating-ready DONE)
	(goal t4-targeting-ready DONE)
	(goal t4-artillery-ready DONE)
=>
	(set-goal researchbundleT4 DONE)
	(disable-self)
)

; Do not let one missing HW upgrade hold MECH/HW in passive TL4 forever.
(defrule
	(current-age == tech-level-4)
	(goal combat-arm MECH/HW)
	(not (goal researchbundleT4 DONE))
	(current-age-time > 600)
	(military-population >= 24)
=>
	(set-goal researchbundleT4 DONE)
	(disable-self)
)

(defrule
	(goal support-aircraft YES)
	(goal t4-homing-ready DONE)
	(goal t4-targeting-ready DONE)
=>
	(set-goal researchbundleT4 DONE)
	(disable-self)
)

(defrule
	(goal combat-arm SEA)
	(goal t4-homing-ready DONE)
	(goal t4-targeting-ready DONE)
=>
	(set-goal researchbundleT4 DONE)
	(disable-self)
)

(defrule
	(goal researchbundleT2 DONE)
=>
	(set-goal importantT2research DONE)
	(disable-self)
)

(defrule
	(goal researchbundleT3 DONE)
=>
	(set-goal importantT3research DONE)
	(disable-self)
)

(defrule
	(goal researchbundleT4 DONE)
=>
	(set-goal importantT4research DONE)
	(disable-self)
)

; -----------------------------------------------------
; *** Chapter 1: GLOBAL PRIORITY ***
; -----------------------------------------------------

;  Normally, file load order does not matter. However, in the case of the advancement to a tech level, a whole bunch of techs
;  suddenly become available. The prioritization system already handles some of them, but in these specific cases, some techs should
;  be researched over others. By putting them first in the file, it ensures that if the AI has the resources on hand, it will get these
;  as opposed to the other techs

(defrule
	; Shield Modifications - prioritize for real air comps and air UUs
	(can-research-with-escrow rt-shield-mods)
	(or
		(goal support-aircraft YES)
		(or
			(goal support-aircraft YES)
			(or
				(unit-type-count-total UNIT-AIRSPEEDER-LINE > 0)
				(or
					(unit-type-count-total UNIT-GEOFLYR-LINE > 0)
					(or
						(unit-type-count-total UNIT-VWING-LINE > 0)
						(unit-type-count-total UNIT-JEDIFGT-LINE > 0)
					)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-shield-mods)
)

(defrule
	; Bundle priority: troop arms want TL2 damage online.
	(current-age >= tech-level-2)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal combat-arm MECH)
				(goal combat-arm MECH/HW)
			)
		)
	)
	(can-research rt-primary-focus-coils)
=>
	(research rt-primary-focus-coils)
)

(defrule
	; Bundle priority: troop arms want TL2 armor online.
	(current-age >= tech-level-2)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(can-research-with-escrow rt-basic-armor)
=>
	(release-escrow food)
	(research rt-basic-armor)
)

(defrule
	; Bundle priority: mech arms want TL2 plating online.
	(current-age >= tech-level-2)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(can-research-with-escrow rt-light-plating)
=>
	(release-escrow food)
	(research rt-light-plating)
)

(defrule
	; Bundle priority: troop arms need TL3 range.
	(current-age >= tech-level-3)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(can-research-with-escrow rt-portable-scanners)
=>
	(release-escrow food)
	(research rt-portable-scanners)
)

(defrule
	; Bundle priority: troop arms commit to heavy troopers.
	(current-age >= tech-level-3)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(can-research-with-escrow ut-laser-3)
=>
	(release-escrow food)
	(release-escrow nova)
	(research ut-laser-3)
)

(defrule
	; Bundle priority: troop arms want TL3 armor.
	(current-age >= tech-level-3)
	(or
		(goal combat-arm TROOP)
		(goal combat-arm TROOP/HW)
	)
	(can-research-with-escrow rt-light-armor)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-light-armor)
)

(defrule
	; Bundle priority: mech arms want range before expanding into side techs.
	(current-age >= tech-level-3)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(can-research-with-escrow rt-elevation-tracking)
=>
	(release-escrow food)
	(research rt-elevation-tracking)
)

(defrule
	; Bundle priority: mech arms want TL3 follow-up range.
	(current-age >= tech-level-3)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(can-research-with-escrow rt-external-sensor-pod)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-external-sensor-pod)
)

(defrule
	; Bundle priority: mech arms want TL3 plating.
	(current-age >= tech-level-3)
	(or
		(goal combat-arm MECH)
		(goal combat-arm MECH/HW)
	)
	(can-research-with-escrow rt-medium-plating)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-medium-plating)
