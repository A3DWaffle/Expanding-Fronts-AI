(defrule
    ; Adv Missile Turret
	(current-age >= tech-level-4)
	(or
		(goal enemyT4airsighted YES)
		(current-age-time >= 300)
	)
    (can-research-with-escrow ut-adv-missile-turret) ; important tech
=>
	(release-escrow carbon)
	(release-escrow metal)
    (research ut-adv-missile-turret)
)


