	(defconst bounty-window 246)	; Published nonzero estimate permits capped Hunter replenishment
	(defconst enemytroopersighted 247)	; Visible Lasers/Mounties remembered for AIR composition
		(defconst TROOPER-ALERT-NONE 0)
		(defconst TROOPER-ALERT-P1 1)
		(defconst TROOPER-ALERT-P2 2)
	(defconst t4-air-core-p3-ready 248)	; Mixed Fighter/Attacker core qualifies for p3 support
	(defconst t4-air-core-p4-ready 249)	; Mixed Fighter/Attacker core qualifies for p4 support
	(defconst t4-fighter-priority 250)	; Recomputed in airbase; heavy trooper counter takes production priority
	(defconst TARGET-UNROLLED 0)
	(defconst TARGET-ROLLED 1)
	(defconst TARGET-WORKERS 2)
		(defconst UU-NONE 0)
		(defconst TROOP 1)
		(defconst MECH 2)
		(defconst AIR 3)
		(defconst UU-SUPPORT 4)
	(defconst passiveage 154)				; Personality-controlled flag for ages that should favor eco/tech over army mass
	(defconst opening-announced 157)			; Human-visible chat for the chosen opening style
	(defconst workerpause 158)				; Brief TL1 worker throttle when food spikes too high
	(defconst gremlinstate 159)				; Tracks the three small TL1 mounted pokes for Rush/Defensive
		(defconst GREMLIN-ZERO 0)
		(defconst GREMLIN-ONE 1)
		(defconst GREMLIN-TWO 2)
		(defconst GREMLIN-DONE 3)

