; BOAT DETECTION: VISIBLE COMBAT BOATS

(defrule
	(strategic-number snc-enemy-boat-detection == 0)
	(or
		(players-unit-type-count any-enemy BOAT-LASER-LINE > 0)
		(or
			(players-unit-type-count any-enemy BOAT-CUTLASER-LINE > 0)
			(or
				(players-unit-type-count any-enemy BOAT-ARTILLERY-LINE > 0)
				(or
					(players-unit-type-count any-enemy BOAT-MISSILE-LINE > 0)
					(players-unit-type-count any-enemy BOAT-MONITOR-LINE > 0)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-boat-detection 1)
)

(defrule
	(strategic-number snc-enemy-boat-detection < 2)
	(or
		(players-unit-type-count any-enemy BOAT-LASER-LINE > 5)
		(or
			(players-unit-type-count any-enemy BOAT-CUTLASER-LINE > 5)
			(or
				(players-unit-type-count any-enemy BOAT-ARTILLERY-LINE > 5)
				(or
					(players-unit-type-count any-enemy BOAT-MISSILE-LINE > 5)
					(players-unit-type-count any-enemy BOAT-MONITOR-LINE > 5)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-boat-detection 2)
)

(defrule
	(strategic-number snc-enemy-boat-detection < 3)
	(or
		(players-unit-type-count any-enemy BOAT-LASER-LINE > 10)
		(or
			(players-unit-type-count any-enemy BOAT-CUTLASER-LINE > 10)
			(or
				(players-unit-type-count any-enemy BOAT-ARTILLERY-LINE > 10)
				(or
					(players-unit-type-count any-enemy BOAT-MISSILE-LINE > 10)
					(players-unit-type-count any-enemy BOAT-MONITOR-LINE > 10)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-boat-detection 3)
)

(defrule
	(strategic-number snc-enemy-boat-detection < 4)
	(or
		(players-unit-type-count any-enemy BOAT-LASER-LINE > 20)
		(or
			(players-unit-type-count any-enemy BOAT-CUTLASER-LINE > 20)
			(or
				(players-unit-type-count any-enemy BOAT-ARTILLERY-LINE > 20)
				(or
					(players-unit-type-count any-enemy BOAT-MISSILE-LINE > 20)
					(players-unit-type-count any-enemy BOAT-MONITOR-LINE > 20)
				)
			)
		)
	)
=>
	(set-strategic-number snc-enemy-boat-detection 4)
)

