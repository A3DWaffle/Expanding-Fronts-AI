; ============================================================================
; GENERIC GOAL VALUES
; ============================================================================
; Several goals can be set to the same constant without issue
; It's like if a= 1 and b= 1, but "1" is called "yes"

	(defconst NO 0)         ; Used to indicate not set, don't do this, etc
	(defconst NONE 0) 		; 
	(defconst NULL 0)		; used in some logic
	(defconst NORMAL 0)     ; Also used to indicate initial value
	
	(defconst YES 1)        ; Used to indicate set, on, do this, the works 
	(defconst DONE 1) 		; Mostly used for research 
	
	(defconst WAITING 3) 	; Used as a state between yes and no
	(defconst PULSEYES 21) 	; Used to get pulses. Currently used in scout logic. Read: Pulse Yes A
	(defconst PULSEYESA 22)
	(defconst MAYBE 11)		; Currently only used in attack logic
	(defconst MAYBENOT 12)	; Used for resource timeouts

	(defconst ALLOW 801) 		; Allow is used elsewhere on occasion and needs to be not DONE (or other things that have value 1)

	(defconst DENIED 899)	; Used specifically for townsizetrackerthree in conjunction with ALLOW
	(defconst DISABLE-1 901) ; was conflicting with ALLOW
	(defconst DISABLE-2 902)
	(defconst DISABLE-3 903)
	(defconst DISABLE-4 904)
	(defconst DISABLE-5 905)
	(defconst DISABLE-6 906)
	(defconst NULL2 999)	; used occasionally to halt logic between ticks
	(defconst UNDEFINED 999)

	(defconst ONE 1)	; used for num nurseries
	(defconst TWO 2)	; also used for the one escrow cannon check
	(defconst THREE 3)
	(defconst FOUR 4) 
	(defconst FIVE 5)

	(defconst READYTOGO 1) 	; Used for timers
	(defconst COOLDOWN 2)
	(defconst COOLDOWNING 3)

	(defconst SMOL 1)	; Used for town size checks
	(defconst NORM 2)
	(defconst BIG 3)
	(defconst BIGGER 4) 

	(defconst INCREMENT 10)		; Used in very tedious manual math operations
	(defconst INCREMENTALT 11)			; needed to wait a tick
	(defconst SUBTRACT 12)

	; Army package identities used by combat-arm.
