; ============================================================================
; SHARED LOGIC
; ============================================================================

(defrule
	(true)
=>
	(set-goal air-regular-level 0)
	(set-goal air-scenario-level 0)
	(set-goal mech-detection-level 0)
	(set-goal jedi-detection-level 0)
	(disable-self)
)

; Jedi estimates sample every 105s, publish 45s later, and allow one Hunter
; order for 15s. The remaining 90s between windows leaves Fortress units free.
(defrule
 (true)
=>
 (set-goal jedi-intel-phase 0)
 (set-goal jedi-intel-pending 0)
	(set-goal mech-intel-pending 0)
 (set-goal bounty-window NO)
 (enable-timer t-jedi-intel 105)
 (disable-self)
)

; One-shot shared state initialization.
(defrule
	(true)
=>
	(set-goal enemyairsighted NO)
	(set-goal enemyT4airsighted NO)
	(set-goal enemyjedisighted JEDI-ALERT-NONE)
	(set-goal enemyuusighted NO)
	(set-goal enemymechsighted MECH-ALERT-NONE)
	(set-goal enemyboatsighted BOAT-ALERT-NONE)
	(set-strategic-number snc-enemy-boat-detection 0)
	(disable-self)
)

