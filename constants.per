(defrule
	(goal air-regular-level 0)
	(players-unit-type-count any-enemy UNIT-FIGHTER-LINE > 0)
=>
	(set-goal air-regular-level 1)
)

(defrule
	(goal air-regular-level 0)
	(players-unit-type-count any-enemy UNIT-BOMBER-LINE > 0)
=>
	(set-goal air-regular-level 1)
)

(defrule
	(goal air-regular-level 0)
	(players-unit-type-count any-enemy UNIT-ATTACKER-LINE > 0)
=>
	(set-goal air-regular-level 1)
)

(defrule
	(goal air-regular-level 0)
	(players-unit-type-count any-enemy UNIT-INTERCEPTOR-LINE > 0)
=>
	(set-goal air-regular-level 1)
)

(defrule
	(goal air-regular-level 0)
	(players-unit-type-count any-enemy UNIT-GEOFLYR-LINE > 0)
=>
	(set-goal air-regular-level 1)
)

(defrule
	(goal air-regular-level 0)
	(players-unit-type-count any-enemy UNIT-JEDIFGT-LINE > 0)
=>
	(set-goal air-regular-level 1)
)

(defrule
	(goal air-regular-level 0)
	(players-unit-type-count any-enemy UNIT-VWING-LINE > 0)
=>
	(set-goal air-regular-level 1)
)

(defrule
	(goal air-regular-level 0)
