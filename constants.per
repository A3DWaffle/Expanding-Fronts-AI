; UNIQUE UNIT DETECTION

(defrule
	(goal enemyuusighted NO)
	(or
		(players-unit-type-count any-enemy UNIT-AIRSPEEDER-LINE > 0)
		(or
			(players-unit-type-count any-enemy UNIT-DARKTRP-LINE > 0)
			(or
				(players-unit-type-count any-enemy UNIT-KNIGHT-LINE > 0)
				(players-unit-type-count any-enemy UNIT-BERSERK-LINE > 0)
			)
		)
	)
=>
	(set-goal enemyuusighted YES)
)

(defrule
	(goal enemyuusighted NO)
	(or
		(players-unit-type-count any-enemy UNIT-SHIELD-LINE > 0)
		(or
			(players-unit-type-count any-enemy UNIT-DESTDROID-LINE > 0)
			(or
				(players-unit-type-count any-enemy UNIT-JEDIFGT-LINE > 0)
				(players-unit-type-count any-enemy UNIT-MAGNAGUARD-LINE > 0)
			)
		)
	)
=>
	(set-goal enemyuusighted YES)
)

(defrule
	(goal enemyuusighted NO)
	(or
		(players-unit-type-count any-enemy UNIT-GEOFLYR-LINE > 0)
		(or
			(players-unit-type-count any-enemy UNIT-DEFILER-LINE > 0)
			(or
				(players-unit-type-count any-enemy UNIT-SKISPEEDER-LINE > 0)
				(players-unit-type-count any-enemy UNIT-JETTROOPER-LINE > 0)
			)
		)
	)
=>
	(set-goal enemyuusighted YES)
)

(defrule
	(goal enemyuusighted NO)
	(or
		(players-unit-type-count any-enemy UNIT-SHADOWTROOPER-LINE > 0)
		(or
			(players-unit-type-count any-enemy UNIT-VWING-LINE > 0)
			(players-unit-type-count any-enemy UNIT-GLADIATORDROID1-LINE > 0)
		)
	)
=>
	(set-goal enemyuusighted YES)
)

; TROOPER MEMORY: visible Laser Troopers and Mounties only, no hidden counts.
; Four of either type (or two of each) raise P1; twelve (or six of each) raise P2.
; Any continuing sighting of these types refreshes the 180-second memory.
; Expiry runs first so sightings on the boundary can immediately establish a new level.
(defrule
	(true)
=>
	(set-goal enemytroopersighted TROOPER-ALERT-NONE)
	(set-goal t4-air-core-p3-ready NO)
	(set-goal t4-air-core-p4-ready NO)
	(disable-self)
)

(defrule
	(timer-triggered t-trooper-counter-memory)
=>
	(disable-timer t-trooper-counter-memory)
	(set-goal enemytroopersighted TROOPER-ALERT-NONE)
)

(defrule
	(current-age >= tech-level-3)
	(goal enemytroopersighted TROOPER-ALERT-NONE)
	(or
		(players-unit-type-count any-enemy UNIT-LASER-LINE >= 4)
		(or
			(players-unit-type-count any-enemy UNIT-MOUNTED-LINE >= 4)
			(and
				(players-unit-type-count any-enemy UNIT-LASER-LINE >= 2)
				(players-unit-type-count any-enemy UNIT-MOUNTED-LINE >= 2)
			)
		)
	)
=>
	(set-goal enemytroopersighted TROOPER-ALERT-P1)
)

(defrule
	(current-age >= tech-level-3)
	(not (goal enemytroopersighted TROOPER-ALERT-P2))
	(or
		(players-unit-type-count any-enemy UNIT-LASER-LINE >= 12)
		(or
			(players-unit-type-count any-enemy UNIT-MOUNTED-LINE >= 12)
			(and
				(players-unit-type-count any-enemy UNIT-LASER-LINE >= 6)
				(players-unit-type-count any-enemy UNIT-MOUNTED-LINE >= 6)
			)
		)
	)
=>
	(set-goal enemytroopersighted TROOPER-ALERT-P2)
)

(defrule
	(not (goal enemytroopersighted TROOPER-ALERT-NONE))
	(or
		(players-unit-type-count any-enemy UNIT-LASER-LINE > 0)
		(players-unit-type-count any-enemy UNIT-MOUNTED-LINE > 0)
	)
=>
	(disable-timer t-trooper-counter-memory)
	(enable-timer t-trooper-counter-memory 180)
)

; DETECTION MEMORY: SHARED AIR / MECH / JEDI PIPELINE
; Air/mechs retain visible memory; mechs also share delayed Jedi intelligence.
; State belongs in goals: SN 223 is sn-percent-attack-air, NOT custom storage;
; SN 105 is sn-save-scenario-information. Detection must not overwrite either.
; Keep the highest observed level until 300 seconds without a sighting.
; Expiry is processed before sightings; continued visibility immediately renews
; memory. Jedi intelligence is independent of these sighting timers.

(defrule
	(timer-triggered t-air-counter-memory)
=>
	(disable-timer t-air-counter-memory)
	(set-goal air-regular-level 0)
	(set-goal air-scenario-level 0)
)

(defrule
	(timer-triggered t-mech-counter-memory)
=>
	(disable-timer t-mech-counter-memory)
	(set-goal mech-detection-level 0)
)

(defrule
	(true)
=>
	(set-goal air-seen-this-pass NO)
	(set-goal mech-seen-this-pass NO)
)

