; PURGE BYPASS

#load-if-not-defined ALL-TECH

(defrule
	(not (players-civ any-human EMPIRE)) ; sith master 
	(not (players-civ any-human IMPERIALREMNANT))
	(not (players-civ any-human REBEL)) ; jedi master
	(not (players-civ any-human NABOO))
	(not (players-civ any-human REPUBLIC))
	(not (players-civ any-human NEWREPUBLIC))
	(not (players-civ any-human BLACKSUN)) ; nightmother
	(game-time > 1)
=>
	(set-shared-goal purgebypass YES) ; this does not neccessarily need to be a shared goal, but it works as one I guess
	(disable-self)
)

#end-if

; BUILD QUEUE RECOVERY RULES
; Used as a fix to try and stop build queue from breaking due to really not wanting to release escrow of ore for constructions
; No idea if this was actually neccessary or if it was a weird shipyard shore ice fix but this works I guess?

; Another way to break the AI's build queue is to destroy an in-progress construction, which causes the AI to be unable to build any of that building ever
; Particularly devastating if you take out a farm since those can still be sighted at 1 HP unlike other foundations

(defrule
	(goal tryingtobuild MECH)
	(can-build-with-escrow BLDG-TRAINMECH)
	(metal-amount > 26)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-TRAINMECH)
	(set-goal tryingtobuild NULL)
)

(defrule
	(goal tryingtobuild HVYWEAP)
	(can-build-with-escrow BLDG-TRAINHEAVY)
	(metal-amount > 26)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-TRAINHEAVY)
	(set-goal tryingtobuild NULL)
)

(defrule
	(goal tryingtobuild AIRBASE)
	(can-build-with-escrow BLDG-TRAINAIR)
	(metal-amount > 26)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-TRAINAIR)
	(set-goal tryingtobuild NULL)
)

; SCENARIO DETECTION

(defrule
	(true)
=>
	(set-goal scn-detected UNDEFINED)
	(disable-self)
)

(defrule
	(building-type-count 1202 > 0) ; undefeatable object
=>
	(set-goal scn-detected YES)
	(disable-self)
)

(defrule
	(building-count == 0)
	(unit-type-count-total UNIT-WORKER == 0)
	(game-time < scn-timeout)
=>
	(set-goal scn-detected YES)
	(disable-self)
)

(defrule
	(building-type-count BLDG-MAIN != 1) ; does technically fire on raiders starts but those are broken anyway
	(not
		(and
			(unit-type-count-total UNIT-WORKER == 3)
			(population < 5)
		)
	)
	(game-time < scn-timeout)
=>
	(set-goal scn-detected YES)
	(disable-self)
)

(defrule
	(carbon-amount == 0)
	(food-amount == 0)
	(nova-amount == 0)
	(metal-amount == 0)
	(game-time < scn-timeout) ; only in opening seconds of game
=>
	(set-goal scn-detected YES)
	(disable-self)
)


(defrule
	(event-detected trigger 1)
	(not (goal scn-detected NO))
=>
	(set-goal scn-detected YES)
)

(defrule
	(game-time >= 4)
	(goal scn-detected UNDEFINED)
=>
	(set-goal scn-detected NO)
	(disable-self)
)


; SHARED TIMER LOGIC

(defrule
	(true)
=>
	(enable-timer t-tenmin 1)
	(disable-self)
)

(defrule
	(timer-triggered t-tenmin)
=>
	(set-goal resource-search SEARCH) ; see nova for more information
)

; Start holocron collection service attempts after the early TL3 spike has had time to breathe.
(defrule
	(current-age >= tech-level-3)
	(game-time > 1500)
	(goal holocroncollectionservices 0)
=>
	(set-goal holocroncollectionservices 2)
)

; allow training a holocron collector every < 30min (YMMV depending on how far tenmin is through when holocron collector trained)
(defrule
	(timer-triggered t-tenmin)
	(goal holocroncollectionservices 3)
=>
	(set-goal holocroncollectionservices 4)
)

(defrule
	(timer-triggered t-tenmin)
	(goal holocroncollectionservices 2)
=>
	(set-goal holocroncollectionservices 3)
)

(defrule
	(timer-triggered t-tenmin)
	(goal holocroncollectionservices 1)
=>
	(set-goal holocroncollectionservices 2)
)


#load-if-not-defined DIFFICULTY-EASIEST
(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
	(timer-triggered t-tenmin)
=>
	(set-goal lategamecannon TWO) ; see warboat for more information
	(set-goal lategameore ALLOW)
	(set-goal scouting ALLOW) 
	(set-goal lategamemaster ALLOW)
)

#load-if-not-defined DIFFICULTY-EASY

(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
	(timer-triggered t-tenmin)
	(goal lategameac 1)
=>
	(set-goal lategameac 2)
)

(defrule
	(current-age == tech-level-4)
	(goal importantT4research DONE)
	(timer-triggered t-tenmin)
	(goal lategameac 0)
=>
	(set-goal lategameac 1)
)

#end-if

#end-if

(defrule
	(timer-triggered t-tenmin)
=>
	(disable-timer t-tenmin)
	(enable-timer t-tenmin 600) ; reset
)
