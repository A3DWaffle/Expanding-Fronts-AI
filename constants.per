	(set-strategic-number sn-gather-idle-soldiers-at-center 0)
	(set-goal openingstyle UNDEFINED)
	(set-goal gremlintrick NO)
	(set-goal hunt-food-phase NO)
	(set-goal holocroncollectionservices 0)
	(set-goal uu-kind UU-NONE)
	(set-goal opening-announced NO)
	(set-goal gremlinstate GREMLIN-ZERO)
	(set-goal padawanattack PADAWANATTACK-NO)
	(set-goal jediattack JEDIATTACK-NO)
	(set-goal defensive-rally NO)
	(disable-self)
)

