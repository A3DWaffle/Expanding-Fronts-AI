	(defconst TURBO 99)


; ============================================================================
; TIMER IDS
; ============================================================================
; TIMER IDS ARE 1-20
; DO NOT USE NUMBERS OUTSIDE OF THIS AS THEY WILL CRASH OR JUST NOT WORK

(defconst t-tribute 1) 				; used in tribute logic for AI asking each other for res
(defconst t-attackgroup-hold 2)		; duration in which town size attacks hold townsize for - technically can be combined with -alt but that's an absolute nuisance to write logic for
(defconst t-economy 3)	 			; used as a lag reduction in sn gather
(defconst t-resign 4) 				; used to expedite resign
(defconst t-chathelp 5) 			; used in diplomacy timer
(defconst t-townsize 6) 			; used for townsize checks
(defconst t-aicheat 7)				; used for cheats
(defconst t-huntfood 8)				; short TL1 hunt timer before allowing an early second food proc
(defconst t-buildpause 9)			; short anti-raid build/refund pause
(defconst t-tenmin 10)				; used in a few places for a bunch of things which need to be on a 10min timer - some goals check this repeatedly to keep track of longer periods of time
(defconst t-mech-counter-memory 11)	; Reuses unused workerpause slot; visible mech memory
(defconst t-air-counter-memory 12)	; visible air sightings linger briefly for counter-unit production
(defconst t-jedi-intel 13)	; Jedi intelligence cadence; owns only timer 13
(defconst t-boat-counter-memory 14)	; visible boat sightings linger briefly for naval destroyer production
(defconst t-attackgroup-alt 15)		; core of new attack system
(defconst t-nerfs 16)				; timer for nerfs to get home safely
(defconst t-garbage 17)				; timer to throttle garbage unit production
(defconst t-raid-memory 18)		; independent 5-second raid heartbeat; previously unused timer18
(defconst t-config 19)				; used to throttle chat responses in config
(defconst t-trooper-counter-memory 20)	; Previously unused debug slot; visible Lasers/Mounties only

