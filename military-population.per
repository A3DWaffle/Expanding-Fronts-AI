; =====================================================
; FILE: military-population
; PURPOSE:
;   Defines standard-difficulty package constants and military-population thresholds.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: SHARED CONSTANTS
;	Chapter 2: PACKAGE THRESHOLDS
;	Chapter 3: WATER VALUES
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

#load-if-not-defined DIFFICULTY-MODERATE
#load-if-not-defined DIFFICULTY-HARD
#load-if-not-defined DIFFICULTY-HARDEST
#load-if-defined POPULATION-CAP-25
(defrule 
(true)
=>
(set-strategic-number snc-pop-limit 25)
(disable-self)
)
