; =====================================================
; FILE: war-center
; PURPOSE:
;   Builds War Centers and researches War Center-owned combat techs.
;
; =====================================================
; *** Table of Contents *** 
; =====================================================
;
;	Chapter 0: SETUP
;	Chapter 1: BUILDINGS
;	Chapter 2: CORE TECHS
;	Chapter 3: CIV TECHS
;
; =====================================================
; *** Chapter 0: SETUP ***
; =====================================================

; Every WATER personality uses Spaceport + War Center for TL3. Do not let
; optional Temples/Mech Factories, reduced civ prerequisites, or Defensive's
; turret-first build hold replace or delay this shore infrastructure pair.
(defrule
	(goal special-map WATER)
	(current-age == tech-level-2)
	(building-type-count BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-WARCTR == 0)
	(can-build-with-escrow BLDG-WARCTR)
	(not (goal buildpause YES))
=>
	(release-escrow carbon)
	(build BLDG-WARCTR)
)

(defrule
	(current-age >= tech-level-3)
	(or
		(building-type-count-total BLDG-TRAINHEAVY >= 1)
		(or
			(building-type-count-total BLDG-TRAINAIR >= 2)
			(building-type-count-total BLDG-TRAINMECH >= 2)
		)
	)
	(building-type-count-total BLDG-WARCTR < 1)
	(building-type-count-total BLDG-SPACEPORT > 0)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-WARCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-WARCTR)
)

(defrule
	(current-age >= tech-level-4)
	(building-type-count-total BLDG-WARCTR < 2)
	(building-type-count-total BLDG-POWERCORE > 0)
	(can-build-with-escrow BLDG-WARCTR)
	(not (goal buildpause YES))
	(goal raid-build-open YES)
=>
	(release-escrow carbon)
	(build BLDG-WARCTR)
)

; -----------------------------------------------------
; *** Chapter 1: RANGE ***
; -----------------------------------------------------

(defrule
    ; Elevation Tracking, Mech Range TL2
	(can-research-with-escrow rt-elevation-tracking)
	(current-age >= tech-level-3)
	(research-completed rt-primary-focus-coils)
=>
	(release-escrow food)
	(research rt-elevation-tracking)
)

(defrule
    ; External Sensor Pod, Mech Range TL3
	(can-research-with-escrow rt-external-sensor-pod)
	(current-age >= tech-level-3)
	(research-completed rt-cooling-sleeves)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-external-sensor-pod)
)

(defrule
    ; Targeting Sensor, Mech Range TL4
	(can-research-with-escrow rt-targetting-sensors)
	(current-age >= tech-level-4)
	(or
		(research-completed rt-adv-power-pack)
		(not (research-available rt-adv-power-pack))
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-targetting-sensors)
)

