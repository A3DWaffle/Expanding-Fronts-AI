; -----------------------------------------------------
; *** Chapter 5: SUPPORT / UNIQUE TECHS *** 
; -----------------------------------------------------

(defrule
    ; Stimpacks - prioritize for real troop/grenadier armies
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-stimpacks)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-stimpacks)
)

(defrule
    ; Grenadier Training
	(can-research-with-escrow rt-gren-reload)
	(goal importantT2research DONE)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(or
						(civ-selected ZANN)
						(unit-type-count-total UNIT-GRENADE-LINE > 0)
					)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-gren-reload)
)

(defrule
    ; ZC Black Market Components
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-black-market-components)
	(goal importantT4research DONE)
	(or
		(goal combat-arm MECH)
		(or
			(goal combat-arm MECH/HW)
			(goal support-assault-mech YES)
		)
	)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-black-market-components)
)

(defrule
    ; GN Potent Plasma
	(can-research-with-escrow rt-potent-plasma)
	(goal importantT4research DONE)
=>
	(release-escrow metal)
	(release-escrow carbon)
	(research rt-potent-plasma)
)

(defrule
    ; RA Tougher Armor
    (can-research-with-escrow rt-tougher-armor)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
    (research rt-tougher-armor)
)

(defrule
    ; RP Kaminoan Cloners
    (current-age >= tech-level-4)
    (can-research-with-escrow rt-kamclonr)
	(goal importantT4research DONE)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal support-grenadiers YES)
				(or
					(goal support-grenadiers YES)
					(goal uu-kind UU-TROOPER)
				)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
    (research rt-kamclonr)
)

(defrule
    ; CF Battlefield Scanners
    (current-age >= tech-level-4)
    (can-research-with-escrow rt-battlefield-scanners)
	(goal importantT4research DONE)
	(or
		(goal combat-arm TROOP)
		(or
			(goal combat-arm TROOP/HW)
			(or
				(goal combat-arm MECH)
				(goal combat-arm MECH/HW)
			)
		)
	)
=>
	(release-escrow carbon)
	(release-escrow food)
    (research rt-battlefield-scanners)
)

(defrule
    ; RS Sensor Cloak
	(current-age >= tech-level-3)
	(can-research-with-escrow rt-sensorcloak)
	(goal importantT4research DONE)
	(goal support-airlift YES)
=>
	(release-escrow carbon)
	(release-escrow nova)
	(research rt-sensorcloak)
)

(defrule
    ; GN Faster Growth Chambers
	(current-age >= tech-level-4)
	(can-research-with-escrow rt-fast-growth-chambers)
	(goal importantT4research DONE)
	(or
		(goal support-sea YES)
		(or
			(goal special-map WATER)
			(goal special-map HYBRID)
		)
	)
=>
	(release-escrow food)
	(release-escrow carbon)
	(research rt-fast-growth-chambers)
)

