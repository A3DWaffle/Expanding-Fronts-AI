; -----------------------------------------------------
; *** Chapter 3: TROOPER ARMOR ***
; -----------------------------------------------------

(defrule
	; Basic Armor, TL2
	(can-research-with-escrow rt-basic-armor)
	(current-age >= tech-level-3)
	(or
		(goal support-repeater YES)
		(or
			(goal support-mounted YES)
			(or
				(goal support-grenadiers YES)
				(goal uu-kind TROOP)
			)
		)
	)
=>
	(release-escrow food)
	(research rt-basic-armor)
)

(defrule
	; Light Armor, TL3
	(can-research-with-escrow rt-light-armor)
	(current-age >= tech-level-3)
	(or
		(goal support-repeater YES)
		(or
			(goal support-mounted YES)
			(or
				(goal support-grenadiers YES)
				(goal uu-kind TROOP)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-light-armor)
)

(defrule
	; Heavy Armor, TL4
	(can-research-with-escrow rt-heavy-armor)
	(current-age >= tech-level-3)
	(or
		(goal support-repeater YES)
		(or
			(goal support-mounted YES)
			(or
				(goal support-grenadiers YES)
				(goal uu-kind TROOP)
			)
		)
	)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-heavy-armor)
)

; -----------------------------------------------------
; *** Chapter 4: MECH PLATING *** 
; -----------------------------------------------------

(defrule
	; Light Plating, TL2
	(can-research-with-escrow rt-light-plating)
	(current-age >= tech-level-3)
	(or
		(goal support-strike YES)
		(or
			(goal support-destroyer YES)
			(or
				(goal support-apc YES)
				(or
					(goal support-assault-mech YES)
					(goal uu-kind MECH)
				)
			)
		)
	)
	(research-completed rt-elevation-tracking)
=>
	(release-escrow food)
	(research rt-light-plating)
)

(defrule
	; Medium Plating, TL3 
	(can-research-with-escrow rt-medium-plating)
	(current-age >= tech-level-3)
	(or
		(goal support-strike YES)
		(or
			(goal support-destroyer YES)
			(or
				(goal support-apc YES)
				(or
					(goal support-assault-mech YES)
					(goal uu-kind MECH)
				)
			)
		)
	)
	(research-completed rt-external-sensor-pod)
=>
	(release-escrow food)
	(release-escrow nova)
	(research rt-medium-plating)
)

(defrule
	; Heavy Plating, TL4
	(can-research-with-escrow rt-heavy-plating)
	(current-age >= tech-level-3)
	(or
		(goal support-strike YES)
		(or
			(goal support-destroyer YES)
			(or
				(goal support-apc YES)
				(or
					(goal support-assault-mech YES)
					(goal uu-kind MECH)
				)
